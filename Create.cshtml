@* Họ và tên: ĐIỀN HỌ TÊN CỦA BẠN | Mã sinh viên: ĐIỀN MSSV CỦA BẠN | Nội dung: Module 5. *@
@using QuanLyHienMau_UNETI2_TI17A5HN.ViewModels
@model KetQuaFormVm
@{Layout="_AdminLayout";ViewData["Title"]="Nhập kết quả hiến máu";}

<link rel="stylesheet" href="~/css/module5-integration.css" asp-append-version="true"/><div class="m5-ui p-space-lg max-w-[1600px] mx-auto w-full"><partial name="_Module5Messages"/>
<div class="page-head">
<div>

<h1>Nhập kết quả hiến máu</h1><div class="text-on-surface-variant mt-2">@Model.ThongTinPhieu</div>

</div>
</div>
<section class="card form-card">
<form asp-action="Create" method="post" onsubmit="return confirm('Xác nhận công bố kết quả cuối cùng cho phiếu này?')">
<input asp-for="MaPhieu" type="hidden"/>
<div asp-validation-summary="All">
</div>
<div class="grid2">
<div class="field">
<label asp-for="DiemDanhGia">Điểm đánh giá (không bắt buộc, 0–100)</label>
<input asp-for="DiemDanhGia" type="number" min="0" max="100"/>
</div>
<div class="field">
<label asp-for="KetQua">Kết quả cuối cùng</label>
<select asp-for="KetQua" required>
<option value="">— Chọn kết quả —</option>
<option>@TrangThaiPhieu.ThanhCong</option>
<option>@TrangThaiPhieu.KhongDat</option>
</select>
</div>
<div class="field full">
<label asp-for="NhanXet">Nhận xét chuyên môn</label>
<textarea asp-for="NhanXet" required maxlength="2000">
</textarea>
</div>
</div>

<button>Xác nhận kết quả</button>
<a class="button quiet" asp-action="Index">Quay lại</a>
</form>
</section>

</div>
