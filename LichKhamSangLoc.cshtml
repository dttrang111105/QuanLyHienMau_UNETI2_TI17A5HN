@* Họ và tên: ĐIỀN HỌ TÊN CỦA BẠN | Mã sinh viên: ĐIỀN MSSV CỦA BẠN | Nội dung: Module 5. *@
@model List<LichKhamSangLoc>
@using QuanLyHienMau_UNETI2_TI17A5HN.ViewModels
@{Layout="_AdminLayout";ViewData["Title"]="Quản Lý Lịch Khám Sàng Lọc";}
<link rel="stylesheet" href="~/css/module5-integration.css" asp-append-version="true"/>
<div class="m5-ui p-space-lg max-w-[1600px] mx-auto w-full"><partial name="_Module5Messages"/>
@{DateTime week=(DateTime)ViewBag.Week;bool calendar=(bool)ViewBag.Calendar;}
<div class="page-head"><div><div class="text-on-surface-variant text-xs mb-2">Hệ thống Quản trị Y tế / Quản lý Y tế</div><h1 class="font-headline-lg">Quản Lý Lịch Khám Sàng Lọc</h1></div><a class="button" asp-controller="LichKhamSangLoc" asp-action="Create"><span class="material-symbols-outlined">add_circle</span>Lập lịch khám</a></div>
<div class="metrics">@foreach(var m in new[]{("Tổng lịch khám",(int)ViewBag.Total,"event_note"),("Lịch khám sắp tới",(int)ViewBag.Upcoming,"schedule"),("Đã hoàn thành",(int)ViewBag.Completed,"task_alt"),("Đã hủy",(int)ViewBag.Cancelled,"event_busy")}){<article class="metric"><span>@m.Item1</span><strong>@m.Item2</strong><i class="material-symbols-outlined">@m.Item3</i></article>}</div>
<section class="card"><form method="get" asp-controller="Admin" asp-action="LichKhamSangLoc" class="filters"><input type="hidden" name="view" value="@(calendar?"calendar":"list")"/><input type="hidden" name="ngay" value="@week.ToString("yyyy-MM-dd")"/><label><span>Tìm người hiến, bác sĩ, đợt</span><input name="q" value="@ViewBag.Q"/></label><label><span>Trạng thái</span><select name="trangThai"><option value="">Tất cả</option>@foreach(var s in new[]{TrangThaiLich.DaLenLich,TrangThaiLich.HoanThanh,TrangThaiLich.DaHuy}){<option selected="@(s==(string?)ViewBag.TrangThai)" value="@s">@s</option>}</select></label><label><span>Từ ngày</span><input type="date" name="tuNgay" value="@ViewBag.TuNgay"/></label><button>Lọc</button><a class="button quiet" asp-action="LichKhamSangLoc">Đặt lại</a></form></section>
<section class="card"><div class="flex items-center justify-between flex-wrap gap-3 mb-5"><div class="flex gap-2"><a class="button @(calendar?"":"quiet")" asp-action="LichKhamSangLoc" asp-route-view="calendar" asp-route-q="@ViewBag.Q" asp-route-trangThai="@ViewBag.TrangThai" asp-route-tuNgay="@ViewBag.TuNgay" asp-route-ngay="@week.ToString("yyyy-MM-dd")"><span class="material-symbols-outlined">calendar_view_week</span>Lịch biểu</a><a class="button @(!calendar?"":"quiet")" asp-action="LichKhamSangLoc" asp-route-view="list" asp-route-q="@ViewBag.Q" asp-route-trangThai="@ViewBag.TrangThai" asp-route-tuNgay="@ViewBag.TuNgay"><span class="material-symbols-outlined">table_rows</span>Danh sách</a></div>@if(calendar){<div class="flex gap-3 items-center"><a class="button quiet small" aria-label="Tuần trước" asp-action="LichKhamSangLoc" asp-route-ngay="@week.AddDays(-7).ToString("yyyy-MM-dd")" asp-route-q="@ViewBag.Q" asp-route-trangThai="@ViewBag.TrangThai">‹</a><strong>@week.ToString("dd/MM") – @week.AddDays(6).ToString("dd/MM/yyyy")</strong><a class="button quiet small" aria-label="Tuần sau" asp-action="LichKhamSangLoc" asp-route-ngay="@week.AddDays(7).ToString("yyyy-MM-dd")" asp-route-q="@ViewBag.Q" asp-route-trangThai="@ViewBag.TrangThai">›</a></div>}</div>
@if(calendar){<div class="table-wrap"><div class="week">@for(int i=0;i<7;i++){var day=week.AddDays(i);var rows=Model.Where(x=>x.ThoiGianBatDau.Date==day).ToList();<div class="day"><h3>@(i==6?"Chủ nhật":"Thứ "+(i+2)) · @day.ToString("dd/MM")</h3>@foreach(var l in rows){<article class="appointment"><strong>@l.ThoiGianBatDau.ToString("HH:mm")–@l.ThoiGianKetThuc.ToString("HH:mm")</strong><b>@l.Phieu.NguoiHien.HoTen</b><small>Phiếu #@l.MaPhieu · @l.Phieu.Dot.TenDot</small><small>@l.BacSiSangLoc</small><small>@l.DiaDiemHoacLienKet</small><span class="badge">@l.TrangThai</span><partial name="_Module5LichActions" model="l"/></article>}@if(rows.Count==0){<div class="muted mt-5">Không có lịch khám</div>}</div>}</div></div>}
else{<div class="table-wrap"><table><thead><tr><th>Lịch / Phiếu</th><th>Người hiến / Đợt</th><th>Thời gian</th><th>Bác sĩ / Địa điểm</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody>@foreach(var l in Model){<tr><td>#@l.MaLichKhamSangLoc<small>Phiếu #@l.MaPhieu</small></td><td><b>@l.Phieu.NguoiHien.HoTen</b><small>@l.Phieu.Dot.TenDot</small></td><td>@l.ThoiGianBatDau.ToString("dd/MM/yyyy HH:mm")<small>đến @l.ThoiGianKetThuc.ToString("dd/MM/yyyy HH:mm")</small></td><td>@l.BacSiSangLoc<small>@l.HinhThucTiepNhan · @l.DiaDiemHoacLienKet</small><small>@l.GhiChu</small></td><td><span class="badge">@l.TrangThai</span></td><td><partial name="_Module5LichActions" model="l"/></td></tr>}@if(Model.Count==0){<tr><td colspan="6" class="empty">Không có lịch khám phù hợp.</td></tr>}</tbody></table></div><div class="pager"><span class="muted">@ViewBag.Count lịch · Trang @ViewBag.Page / @ViewBag.Pages</span>@for(int n=1;n<=(int)ViewBag.Pages;n++){if(n==(int)ViewBag.Page){<strong>@n</strong>}else{<a asp-action="LichKhamSangLoc" asp-route-page="@n" asp-route-view="list" asp-route-q="@ViewBag.Q" asp-route-trangThai="@ViewBag.TrangThai" asp-route-tuNgay="@ViewBag.TuNgay">@n</a>}}</div>}</section>
</div>
