@{
    ViewData["Title"] = "Từ Chối Quyền Truy Cập";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var rawRole = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
    var roleDisplay = rawRole switch
    {
        "Admin" => "Quản trị viên",
        "Medical Staff" => "Nhân viên y tế",
        "Donor" => "Người hiến máu",
        _ => "Khách"
    };
}

<div class="flex-1 flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-md w-full bg-surface-container-lowest rounded-3xl p-8 shadow-xl border border-surface-container text-center space-y-6">
        <div class="w-20 h-20 rounded-2xl bg-error-container text-error flex items-center justify-center mx-auto shadow-md">
            <span class="material-symbols-outlined text-[42px]">gpp_maybe</span>
        </div>

        <div class="space-y-2">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-error-container text-error font-label-sm text-label-sm font-bold">
                THÔNG BÁO PHÂN QUYỀN HỆ THỐNG
            </span>
            <h1 class="font-headline-md text-headline-md text-on-surface font-bold">
                Không Có Quyền Truy Cập
            </h1>
            <p class="font-body-md text-body-md text-on-surface-variant leading-relaxed">
                Tài khoản của bạn không được cấp quyền để truy cập vào khu vực này. Chức năng này chỉ dành riêng cho Quản trị viên hoặc Nhân viên y tế phụ trách.
            </p>
        </div>

        <div class="p-4 rounded-2xl bg-surface-container-low text-left space-y-2 text-body-sm">
            <div class="flex items-center justify-between text-on-surface">
                <span class="text-on-surface-variant">Tài khoản đang đăng nhập:</span>
                <strong class="font-semibold">@(User.Identity?.Name ?? "Chưa đăng nhập")</strong>
            </div>
            <div class="flex items-center justify-between text-on-surface">
                <span class="text-on-surface-variant">Vai trò hiện tại:</span>
                <span class="px-2 py-0.5 rounded bg-surface-container-high text-primary font-bold text-xs">
                    @roleDisplay
                </span>
            </div>
        </div>

        <div class="flex flex-col sm:flex-row items-center gap-3 pt-2">
            <a asp-controller="Home" asp-action="Index" class="w-full py-3 px-4 rounded-xl bg-surface-container hover:bg-surface-container-high text-on-surface font-label-md text-label-md font-semibold transition-all text-center">
                Về Trang Chủ
            </a>
            <a asp-controller="Account" asp-action="Login" class="w-full py-3 px-4 rounded-xl bg-primary hover:bg-primary-container text-on-primary font-label-md text-label-md font-bold transition-all text-center">
                Đổi Tài Khoản
            </a>
        </div>
    </div>
</div>
