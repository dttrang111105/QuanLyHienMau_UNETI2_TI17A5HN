@{
    ViewData["Title"] = "Xác Thực CCCD / VNeID Cổng Định Danh Y Tế Số";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="flex flex-col w-full pb-space-xl">
    <!-- Top Trust & Security Ribbon -->
    <div class="w-full bg-surface-container py-2.5 px-4 sm:px-6 border-b border-surface-container-high/60">
        <div class="max-w-[1240px] mx-auto flex flex-wrap items-center justify-between gap-3 text-xs sm:text-sm">
            <div class="flex items-center gap-2">
                <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-primary/10 text-primary">
                    <span class="material-symbols-outlined text-[15px]" style="font-variation-settings: 'FILL' 1;">verified_user</span>
                </span>
                <span class="font-label-md text-label-md text-on-surface font-extrabold">CỔNG XÁC THỰC QUỐC GIA LIÊN THÔNG VNeID</span>
                <span class="hidden md:inline-block text-secondary">•</span>
                <span class="hidden md:inline-block font-body-sm text-body-sm text-secondary">Hạ tầng CSDL Dân cư C06 - Bộ Công An &amp; Viện Huyết học - Truyền máu TW</span>
            </div>
            <div class="flex items-center gap-4 text-secondary font-label-sm text-label-sm">
                <span class="flex items-center gap-1.5 bg-surface-container-lowest px-2.5 py-1 rounded-md shadow-xs border border-surface-container-high">
                    <span class="inline-block w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                    <span class="text-on-surface font-semibold">Bảo mật chuẩn AES-256 &amp; FIPS 140-3</span>
                </span>
                <span class="hidden sm:inline-flex items-center gap-1">
                    <span class="material-symbols-outlined text-[16px] text-primary">lock</span>
                    <span class="font-medium">OpenID Connect 2.0</span>
                </span>
            </div>
        </div>
    </div>

    <!-- Main Split Authentication Section -->
    <div class="w-full max-w-[1240px] mx-auto px-4 sm:px-6 py-8 sm:py-12">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
            <!-- LEFT COLUMN: Brand Identity & National Data Linkage Showcase (5 cols on lg) -->
            <div class="lg:col-span-5 flex flex-col space-y-6">
                <!-- Hero Title Block -->
                <div class="space-y-3">
                    <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-primary-fixed text-primary font-label-sm text-label-sm uppercase tracking-wider font-bold">
                        <span class="material-symbols-outlined text-[15px]" style="font-variation-settings: 'FILL' 1;">volunteer_activism</span>
                        <span>Hệ thống Định danh Y tế Số</span>
                    </div>
                    <h1 class="font-headline-lg text-headline-lg text-on-surface font-extrabold tracking-tight leading-tight">
                        Một Điểm Chạm – <br class="hidden sm:inline">
                        <span class="text-primary bg-gradient-to-r from-primary to-primary-container bg-clip-text text-transparent">Gắn Kết Triệu Giọt Máu</span>
                    </h1>
                    <p class="font-body-md text-body-md text-on-surface-variant leading-relaxed">
                        Đăng nhập an toàn một bước qua định danh Căn cước công dân gắn chip hoặc tài khoản VNeID Mức 2. Miễn trừ 100% hồ sơ giấy tại các điểm hiến máu lưu động toàn quốc.
                    </p>
                </div>

                <!-- Highlight Community Photo Card -->
                <div class="relative rounded-2xl overflow-hidden shadow-md group border border-surface-container">
                    <img class="w-full h-56 sm:h-64 object-cover transition-transform duration-500 group-hover:scale-105" src="~/images/hero_donor.png" alt="Tình nguyện viên hiến máu">
                    <div class="absolute inset-0 bg-gradient-to-t from-inverse-surface/90 via-inverse-surface/40 to-transparent flex flex-col justify-end p-5 text-white">
                        <div class="flex items-center gap-2 mb-1.5">
                            <span class="inline-flex items-center justify-center p-1 rounded-full bg-primary text-white text-xs">
                                <span class="material-symbols-outlined text-[14px]" style="font-variation-settings: 'FILL' 1;">favorite</span>
                            </span>
                            <span class="font-label-sm text-label-sm font-bold tracking-wide uppercase text-primary-fixed">Nghĩa Cử Nhân Ái</span>
                        </div>
                        <p class="font-headline-sm text-headline-sm font-extrabold text-white leading-snug">
                            “Mỗi giọt máu cho đi, một cuộc đời ở lại”
                        </p>
                        <p class="font-body-sm text-body-sm text-surface-container-high/90 mt-1">
                            Đồng hành cùng hơn 380.000 tình nguyện viên hiến máu tích cực trên cả nước.
                        </p>
                    </div>
                </div>

                <!-- Security & Legal Pillars (Card Stack) -->
                <div class="bg-surface-container-lowest rounded-2xl p-6 shadow-sm border border-surface-container space-y-4">
                    <h3 class="font-title-md text-title-md text-on-surface font-extrabold flex items-center gap-2">
                        <span class="material-symbols-outlined text-primary text-[20px]" style="font-variation-settings: 'FILL' 1;">verified</span>
                        <span>Quyền lợi khi định danh qua VNeID</span>
                    </h3>
                    <div class="space-y-3.5">
                        <div class="flex items-start gap-3">
                            <div class="w-8 h-8 rounded-xl bg-surface-container flex items-center justify-center text-primary shrink-0 mt-0.5">
                                <span class="material-symbols-outlined text-[18px]">account_balance</span>
                            </div>
                            <div>
                                <p class="font-label-md text-label-md text-on-surface font-bold">Liên thông CSDL Quốc gia về Dân cư</p>
                                <p class="font-body-sm text-body-sm text-on-surface-variant">Tự động xác minh danh tính Bộ Công An C06, bảo đảm danh tính chính xác tuyệt đối.</p>
                            </div>
                        </div>
                        <div class="flex items-start gap-3">
                            <div class="w-8 h-8 rounded-xl bg-surface-container flex items-center justify-center text-primary shrink-0 mt-0.5">
                                <span class="material-symbols-outlined text-[18px]">bloodtype</span>
                            </div>
                            <div>
                                <p class="font-label-md text-label-md text-on-surface font-bold">Hồ sơ nhóm máu ABO / Rh &amp; ISBT 128</p>
                                <p class="font-body-sm text-body-sm text-on-surface-variant">Lưu trữ chỉ số sinh hóa, kết quả xét nghiệm miễn dịch tự động sau 24h hiến tặng.</p>
                            </div>
                        </div>
                        <div class="flex items-start gap-3">
                            <div class="w-8 h-8 rounded-xl bg-surface-container flex items-center justify-center text-primary shrink-0 mt-0.5">
                                <span class="material-symbols-outlined text-[18px]">badge</span>
                            </div>
                            <div>
                                <p class="font-label-md text-label-md text-on-surface font-bold">Giấy chứng nhận hiến máu điện tử tức thì</p>
                                <p class="font-body-sm text-body-sm text-on-surface-variant">Tích hợp trực tiếp vào Ví giấy tờ ứng dụng VNeID, có giá trị bồi hoàn máu toàn quốc.</p>
                            </div>
                        </div>
                    </div>

                    <!-- Compliance Badges -->
                    <div class="pt-4 mt-2 bg-surface-container-low p-3.5 rounded-xl flex items-center justify-between border border-surface-container-high">
                        <div class="flex items-center gap-2">
                            <span class="material-symbols-outlined text-primary text-[20px]">format_image_left</span>
                            <span class="font-label-sm text-label-sm font-bold text-on-surface">Tiêu chuẩn quốc gia</span>
                        </div>
                        <div class="flex items-center gap-2">
                            <span class="font-label-sm text-label-sm px-2 py-0.5 rounded bg-surface-container-lowest text-secondary font-bold border border-surface-container">ISO 27001</span>
                            <span class="font-label-sm text-label-sm px-2 py-0.5 rounded bg-surface-container-lowest text-secondary font-bold border border-surface-container">C06 - BCA</span>
                            <span class="font-label-sm text-label-sm px-2 py-0.5 rounded bg-surface-container-lowest text-secondary font-bold border border-surface-container">Cục ATTT</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- RIGHT COLUMN: Interactive Tabbed Authentication Gateway (7 cols on lg) -->
            <div class="lg:col-span-7 flex flex-col">
                <div class="bg-surface-container-lowest rounded-3xl p-6 sm:p-8 shadow-md border border-surface-container">
                    <!-- Role Selector Navigation Tabs -->
                    <div class="flex rounded-2xl bg-surface-container-low p-1.5 mb-6 border border-surface-container-high/60">
                        <button class="flex-1 py-3 px-4 rounded-xl font-label-md text-label-md font-bold transition-all duration-200 flex items-center justify-center gap-2 bg-surface-container-lowest text-primary shadow-sm cursor-pointer" id="tab-btn-donor" onclick="switchAuthRole('donor')">
                            <span class="material-symbols-outlined text-[18px]">favorite</span>
                            <span>Người Hiến Máu &amp; Tình Nguyện</span>
                        </button>
                        <button class="flex-1 py-3 px-4 rounded-xl font-label-md text-label-md font-semibold text-secondary hover:text-on-surface transition-all duration-200 flex items-center justify-center gap-2 cursor-pointer" id="tab-btn-medic" onclick="switchAuthRole('medic')">
                            <span class="material-symbols-outlined text-[18px]">stethoscope</span>
                            <span>Cán Bộ Y Tế &amp; Điều Phối</span>
                        </button>
                    </div>

                    <!-- TAB CONTENT 1: DONOR AUTHENTICATION (DEFAULT) -->
                    <div class="flex flex-col space-y-6" id="tab-content-donor">
                        <!-- VNeID Priority QR Check-in Box -->
                        <div class="bg-surface-container-low rounded-2xl p-5 sm:p-6 flex flex-col items-center text-center relative overflow-hidden border border-surface-container-high/60">
                            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-secondary-fixed text-primary font-label-sm text-label-sm font-bold mb-3">
                                <span class="material-symbols-outlined text-[15px]" style="font-variation-settings: 'FILL' 1;">bolt</span>
                                <span>Phương thức nhanh chóng &amp; bảo mật nhất</span>
                            </div>
                            <h2 class="font-headline-sm text-headline-sm font-extrabold text-on-surface">
                                Quét mã QR bằng ứng dụng VNeID
                            </h2>
                            <p class="font-body-sm text-body-sm text-on-surface-variant max-w-md mt-1 mb-5">
                                Mở ứng dụng <strong>VNeID</strong> trên điện thoại thông minh, chọn biểu tượng <strong>Quét mã QR</strong> tại thanh tác vụ để đăng nhập tức thời.
                            </p>

                            <!-- QR Card Display -->
                            <div class="relative bg-surface-container-lowest p-4 rounded-2xl shadow-sm flex flex-col items-center mb-4 border border-surface-container">
                                <div class="relative w-48 h-48 bg-surface flex items-center justify-center rounded-xl overflow-hidden p-2">
                                    <div class="absolute top-2 left-2 w-6 h-6 border-t-4 border-l-4 border-primary rounded-tl-md"></div>
                                    <div class="absolute top-2 right-2 w-6 h-6 border-t-4 border-r-4 border-primary rounded-tr-md"></div>
                                    <div class="absolute bottom-2 left-2 w-6 h-6 border-b-4 border-l-4 border-primary rounded-bl-md"></div>
                                    <div class="absolute bottom-2 right-2 w-6 h-6 border-b-4 border-r-4 border-primary rounded-br-md"></div>
                                    
                                    <!-- QR SVG Data Illustration -->
                                    <svg id="vneid-qr-svg" class="w-40 h-40 text-on-surface transition-opacity duration-300" fill="currentColor" viewBox="0 0 100 100">
                                        <rect fill="none" height="28" rx="4" stroke="currentColor" stroke-width="4" width="28" x="5" y="5"></rect>
                                        <rect fill="currentColor" height="16" rx="2" width="16" x="11" y="11"></rect>
                                        <rect fill="none" height="28" rx="4" stroke="currentColor" stroke-width="4" width="28" x="67" y="5"></rect>
                                        <rect fill="currentColor" height="16" rx="2" width="16" x="73" y="11"></rect>
                                        <rect fill="none" height="28" rx="4" stroke="currentColor" stroke-width="4" width="28" x="5" y="67"></rect>
                                        <rect fill="currentColor" height="16" rx="2" width="16" x="11" y="73"></rect>
                                        <rect height="6" rx="1" width="6" x="40" y="8"></rect>
                                        <rect height="6" rx="1" width="6" x="52" y="8"></rect>
                                        <rect height="6" rx="1" width="6" x="40" y="20"></rect>
                                        <rect height="6" rx="1" width="6" x="48" y="26"></rect>
                                        <rect height="6" rx="1" width="6" x="8" y="42"></rect>
                                        <rect height="6" rx="1" width="6" x="20" y="42"></rect>
                                        <rect height="6" rx="1" width="6" x="14" y="50"></rect>
                                        <rect height="6" rx="1" width="6" x="40" y="40"></rect>
                                        <rect height="6" rx="1" width="6" x="54" y="44"></rect>
                                        <rect height="6" rx="1" width="6" x="68" y="40"></rect>
                                        <rect height="6" rx="1" width="6" x="80" y="44"></rect>
                                        <rect height="6" rx="1" width="6" x="88" y="52"></rect>
                                        <rect height="6" rx="1" width="6" x="40" y="68"></rect>
                                        <rect height="6" rx="1" width="6" x="48" y="76"></rect>
                                        <rect height="6" rx="1" width="6" x="60" y="68"></rect>
                                        <rect height="6" rx="1" width="6" x="74" y="74"></rect>
                                        <rect height="6" rx="1" width="6" x="86" y="68"></rect>
                                        <rect height="6" rx="1" width="6" x="68" y="86"></rect>
                                        <rect height="6" rx="1" width="6" x="82" y="86"></rect>
                                        <circle cx="50" cy="50" fill="#a30428" r="14"></circle>
                                        <path d="M50 43 C46 43 44 47 50 54 C56 47 54 43 50 43 Z" fill="#ffffff"></path>
                                    </svg>
                                    <!-- Scanning laser -->
                                    <div class="absolute inset-x-4 top-1/2 h-0.5 bg-primary/80 shadow-[0_0_8px_rgba(163,4,40,0.8)] animate-pulse"></div>
                                </div>

                                <!-- Timer & Refresh Action -->
                                <div class="mt-3 flex items-center justify-between w-full text-xs text-secondary px-1">
                                    <span class="flex items-center gap-1 font-medium">
                                        <span class="material-symbols-outlined text-[14px]">timer</span>
                                        Mã làm mới sau: <span class="font-bold text-primary font-mono" id="countdown-timer">58s</span>
                                    </span>
                                    <button class="text-primary hover:underline font-bold flex items-center gap-1 cursor-pointer" onclick="refreshQr()" type="button">
                                        <span class="material-symbols-outlined text-[14px]">refresh</span>
                                        Tạo lại mã
                                    </button>
                                </div>
                            </div>

                            <!-- Quick Instruction Badges -->
                            <div class="grid grid-cols-3 gap-2 w-full max-w-md mb-4 text-left">
                                <div class="bg-surface-container-lowest p-2.5 rounded-xl shadow-xs border border-surface-container">
                                    <span class="font-label-sm text-label-sm text-primary font-bold block mb-0.5">BƯỚC 1</span>
                                    <span class="font-body-sm text-[12px] leading-tight text-on-surface-variant block">Mở app VNeID trên điện thoại</span>
                                </div>
                                <div class="bg-surface-container-lowest p-2.5 rounded-xl shadow-xs border border-surface-container">
                                    <span class="font-label-sm text-label-sm text-primary font-bold block mb-0.5">BƯỚC 2</span>
                                    <span class="font-body-sm text-[12px] leading-tight text-on-surface-variant block">Chọn Quét QR ở thanh tác vụ</span>
                                </div>
                                <div class="bg-surface-container-lowest p-2.5 rounded-xl shadow-xs border border-surface-container">
                                    <span class="font-label-sm text-label-sm text-primary font-bold block mb-0.5">BƯỚC 3</span>
                                    <span class="font-body-sm text-[12px] leading-tight text-on-surface-variant block">Xác thực FaceID / Passcode</span>
                                </div>
                            </div>

                            <!-- Primary VNeID Red Button Trigger -->
                            <button onclick="simulateVNeIDSSO()" class="w-full max-w-md inline-flex items-center justify-center gap-3 bg-gradient-to-r from-primary to-primary-container text-on-primary font-label-md text-label-md py-3.5 px-6 rounded-xl shadow-md hover:shadow-lg hover:-translate-y-0.5 active:translate-y-0 transition-all font-bold cursor-pointer" type="button">
                                <span class="material-symbols-outlined text-[20px]" style="font-variation-settings: 'FILL' 1;">fingerprint</span>
                                <span>ĐĂNG NHẬP QUA CỔNG VNeID SSO BỘ CÔNG AN</span>
                            </button>
                        </div>

                        <!-- Divider: Or Regular Login -->
                        <div class="flex items-center gap-4 my-2">
                            <div class="flex-1 h-px bg-surface-container-highest"></div>
                            <span class="font-label-sm text-label-sm text-secondary uppercase tracking-wider font-bold">Hoặc dùng số CCCD &amp; Mật khẩu</span>
                            <div class="flex-1 h-px bg-surface-container-highest"></div>
                        </div>

                        <!-- Form: National ID / CCCD Login -->
                        <form class="space-y-4" onsubmit="handleDonorSubmit(event)">
                            <div>
                                <label class="block font-label-md text-label-md font-semibold text-on-surface mb-1.5" for="donor-cccd">
                                    Số Căn cước công dân (12 số) <span class="text-primary">*</span>
                                </label>
                                <div class="relative">
                                    <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-secondary">
                                        <span class="material-symbols-outlined text-[20px]">badge</span>
                                    </div>
                                    <input class="w-full h-12 pl-11 pr-16 bg-surface-container-low text-on-surface placeholder:text-secondary rounded-xl font-body-md text-body-md focus:bg-surface-container-lowest focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all font-mono" id="donor-cccd" maxlength="12" name="cccd" pattern="[0-9]{12}" placeholder="VD: 001099028891" required type="text">
                                    <div class="absolute inset-y-0 right-0 pr-3.5 flex items-center text-xs text-secondary font-mono font-bold">
                                        12 số
                                    </div>
                                </div>
                            </div>

                            <div>
                                <div class="flex items-center justify-between mb-1.5">
                                    <label class="font-label-md text-label-md font-semibold text-on-surface" for="donor-pwd">
                                        Mật khẩu Vitalis <span class="text-primary">*</span>
                                    </label>
                                    <a class="font-label-sm text-label-sm text-primary hover:underline font-bold" href="javascript:void(0)" onclick="alert('Đã gửi liên kết đặt lại mật khẩu.')">
                                        Quên mật khẩu?
                                    </a>
                                </div>
                                <div class="relative">
                                    <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-secondary">
                                        <span class="material-symbols-outlined text-[20px]">lock</span>
                                    </div>
                                    <input class="w-full h-12 pl-11 pr-11 bg-surface-container-low text-on-surface placeholder:text-secondary rounded-xl font-body-md text-body-md focus:bg-surface-container-lowest focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all" id="donor-pwd" name="password" placeholder="••••••••••••" required type="password">
                                    <button aria-label="Hiện mật khẩu" class="absolute inset-y-0 right-0 pr-3.5 flex items-center text-secondary hover:text-on-surface cursor-pointer" onclick="togglePasswordVisibility('donor-pwd', this)" type="button">
                                        <span class="material-symbols-outlined text-[20px]">visibility</span>
                                    </button>
                                </div>
                            </div>

                            <div class="flex items-center justify-between pt-1">
                                <label class="flex items-center gap-2 cursor-pointer select-none">
                                    <input checked class="w-4 h-4 rounded text-primary focus:ring-primary/20 accent-primary" type="checkbox">
                                    <span class="font-body-sm text-body-sm text-on-surface-variant">Ghi nhớ đăng nhập trên thiết bị an toàn</span>
                                </label>
                                <span class="inline-flex items-center gap-1 font-label-sm text-label-sm text-emerald-700 font-bold">
                                    <span class="material-symbols-outlined text-[14px]">shield</span>
                                    <span>Mã hóa SSL</span>
                                </span>
                            </div>

                            <button class="w-full bg-inverse-surface hover:bg-on-surface text-inverse-on-surface font-label-md text-label-md py-3.5 px-6 rounded-xl shadow hover:shadow-md transition-all font-bold flex items-center justify-center gap-2 cursor-pointer" type="submit">
                                <span>ĐĂNG NHẬP HỒ SƠ CÁ NHÂN</span>
                                <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
                            </button>

                            <div class="text-center pt-2">
                                <span class="font-body-sm text-body-sm text-on-surface-variant">Chưa từng tham gia hiến máu?</span>
                                <a asp-controller="DangKy" asp-action="Create" class="font-label-md text-label-md text-primary font-bold hover:underline ml-1.5">
                                    Đăng ký hồ sơ người hiến máu mới
                                </a>
                            </div>
                        </form>
                    </div>

                    <!-- TAB CONTENT 2: MEDICAL PROFESSIONAL / ADMIN / LIS STAFF (HIDDEN BY DEFAULT) -->
                    <div class="hidden flex flex-col space-y-6" id="tab-content-medic">
                        <div class="bg-surface-container-low rounded-2xl p-5 border-l-4 border-primary">
                            <div class="flex items-start gap-3">
                                <span class="material-symbols-outlined text-primary text-[24px] mt-0.5" style="font-variation-settings: 'FILL' 1;">verified_user</span>
                                <div>
                                    <h3 class="font-title-md text-title-md font-extrabold text-on-surface">Cổng Chuyên Môn Y Tế &amp; Tiếp Nhận Máu</h3>
                                    <p class="font-body-sm text-body-sm text-on-surface-variant mt-0.5 leading-relaxed">
                                        Dành cho Bác sĩ khám lâm sàng, Kỹ thuật viên xét nghiệm sàng lọc LIS/HIS, và Ban tổ chức điểm hiến máu lưu động.
                                    </p>
                                </div>
                            </div>
                        </div>

                        <!-- PKI / Digital Signature Card -->
                        <div class="bg-surface-container rounded-2xl p-5 flex flex-col sm:flex-row items-center justify-between gap-4 border border-surface-container-high">
                            <div class="flex items-center gap-3">
                                <div class="w-12 h-12 rounded-xl bg-surface-container-lowest flex items-center justify-center text-primary shadow-xs">
                                    <span class="material-symbols-outlined text-[28px]">token</span>
                                </div>
                                <div>
                                    <h4 class="font-label-md text-label-md font-bold text-on-surface">Đăng nhập Ký số Y tế (PKI / USB Token)</h4>
                                    <p class="font-body-sm text-body-sm text-secondary">Hỗ trợ SmartCA, VNPT-CA, Viettel-CA, BKAV-CA</p>
                                </div>
