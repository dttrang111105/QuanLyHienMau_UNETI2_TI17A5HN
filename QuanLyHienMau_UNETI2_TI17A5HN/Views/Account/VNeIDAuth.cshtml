@section Scripts {
<script>
    function switchAuthRole(role) {
        const donorTabBtn = document.getElementById('tab-btn-donor');
        const medicTabBtn = document.getElementById('tab-btn-medic');
        const donorContent = document.getElementById('tab-content-donor');
        const medicContent = document.getElementById('tab-content-medic');

        if (role === 'donor') {
            donorTabBtn.className = "flex-1 py-3 px-4 rounded-xl font-label-md text-label-md font-bold transition-all duration-200 flex items-center justify-center gap-2 bg-surface-container-lowest text-primary shadow-sm cursor-pointer";
            medicTabBtn.className = "flex-1 py-3 px-4 rounded-xl font-label-md text-label-md font-semibold text-secondary hover:text-on-surface transition-all duration-200 flex items-center justify-center gap-2 cursor-pointer";
            donorContent.classList.remove('hidden');
            donorContent.classList.add('flex');
            medicContent.classList.add('hidden');
            medicContent.classList.remove('flex');
        } else {
            medicTabBtn.className = "flex-1 py-3 px-4 rounded-xl font-label-md text-label-md font-bold transition-all duration-200 flex items-center justify-center gap-2 bg-surface-container-lowest text-primary shadow-sm cursor-pointer";
            donorTabBtn.className = "flex-1 py-3 px-4 rounded-xl font-label-md text-label-md font-semibold text-secondary hover:text-on-surface transition-all duration-200 flex items-center justify-center gap-2 cursor-pointer";
            donorContent.classList.add('hidden');
            donorContent.classList.remove('flex');
            medicContent.classList.remove('hidden');
            medicContent.classList.add('flex');
        }
    }

    function togglePasswordVisibility(fieldId, triggerBtn) {
        const field = document.getElementById(fieldId);
        const icon = triggerBtn.querySelector('.material-symbols-outlined');
        if (!field || !icon) return;

        if (field.type === 'password') {
            field.type = 'text';
            icon.textContent = 'visibility_off';
        } else {
            field.type = 'password';
            icon.textContent = 'visibility';
        }
    }

    // QR Code Timer logic
    let qrSecondsLeft = 58;
    const timerElement = document.getElementById('countdown-timer');

    const countdownInterval = setInterval(() => {
        if (timerElement) {
            qrSecondsLeft--;
            if (qrSecondsLeft <= 0) {
                qrSecondsLeft = 60;
            }
            timerElement.textContent = (qrSecondsLeft < 10 ? '0' : '') + qrSecondsLeft + 's';
        }
    }, 1000);

    function refreshQr() {
        qrSecondsLeft = 60;
        if (timerElement) {
            timerElement.textContent = '60s';
        }
        const svgBox = document.getElementById('vneid-qr-svg');
        if (svgBox) {
            svgBox.classList.add('opacity-40');
            setTimeout(() => {
                svgBox.classList.remove('opacity-40');
            }, 300);
        }
    }

    function simulateVNeIDSSO() {
        alert("Đang chuyển tiếp tới Cổng Xác thực Quốc gia VNeID SSO (Bộ Công An)...");
        setTimeout(() => {
            window.location.href = '/NguoiHienMau/HoSoCaNhan';
        }, 800);
    }

    function handleDonorSubmit(e) {
        e.preventDefault();
        const cccd = document.getElementById('donor-cccd').value;
        alert('Đang xác thực CCCD [' + cccd + '] với CSDL Dân cư Quốc gia VNeID...');
        setTimeout(() => {
            window.location.href = '/NguoiHienMau/HoSoCaNhan';
        }, 800);
    }

    function handleStaffSubmit(e) {
        e.preventDefault();
        const medicId = document.getElementById('medic-id').value;
        const dept = document.getElementById('medic-dept').value;
        alert('Đang xác thực tài khoản y tế chuyên môn [' + medicId + '] tại kíp khám: ' + dept);
    }
</script>
}
