@{
    ViewData["Title"] = "Thống kê & Báo cáo lưu lượng máu chuyên sâu";
    Layout = "_AdminLayout";
}

<!-- Container with responsive fluid bounds & generous spatial breathing -->
<div class="w-full max-w-[1360px] mx-auto px-space-md sm:px-space-lg lg:px-margin py-space-lg space-y-space-lg">
    <!-- Section 1: Page Header & Real-time Control Bar -->
    <header class="flex flex-col gap-space-md bg-surface-container-lowest rounded-xl p-space-lg shadow-sm">
        <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-space-md">
            <!-- Breadcrumb & Title Hierarchy -->
            <div class="space-y-space-xs">
                <nav aria-label="Đường dẫn hệ thống" class="flex items-center gap-2 font-label-sm text-label-sm text-secondary">
                    <a asp-controller="Admin" asp-action="Dashboard" class="hover:text-primary transition-colors">Hệ thống Quản trị Y tế</a>
                    <span class="material-symbols-outlined text-[14px]">chevron_right</span>
                    <span class="text-secondary">Tổng Quan</span>
                    <span class="material-symbols-outlined text-[14px]">chevron_right</span>
                    <span class="text-primary font-semibold">Thống kê &amp; Báo cáo</span>
                </nav>
                <div class="flex flex-wrap items-center gap-space-sm pt-1">
                    <h1 class="font-headline-lg text-headline-lg text-on-surface tracking-tight">
                        Thống Kê &amp; Báo Cáo Lưu Lượng Máu Chuyên Sâu
                    </h1>
                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-secondary-fixed text-tertiary font-label-sm text-label-sm">
                        <span class="h-2 w-2 rounded-full bg-primary animate-ping"></span>
                        Real-time Sync (LIS &amp; HIS)
                    </span>
                </div>
                <p class="font-body-sm text-body-sm text-on-surface-variant max-w-4xl">
                    Báo cáo giám sát thu nhận, xử lý, tồn kho và điều phối lâm sàng toàn mạng lưới theo chuẩn Thông tư 26/2013/TT-BYT &amp; Chuẩn quốc tế ISBT 128.
                </p>
            </div>
            <!-- Action Control Group -->
            <div class="flex flex-wrap items-center gap-space-sm shrink-0">
                <button class="inline-flex items-center gap-2 h-10 px-4 rounded-xl bg-surface-container-low text-on-surface font-label-md text-label-md hover:bg-surface-container transition-all" type="button" onclick="alert('Đang trích xuất toàn bộ dữ liệu lưu lượng máu ra file Excel (XLSX)...')">
                    <span class="material-symbols-outlined text-[18px] text-secondary">table_view</span>
                    <span>Xuất Excel (XLSX)</span>
                </button>
                <button class="inline-flex items-center gap-2 h-10 px-4 rounded-xl bg-primary text-on-primary font-label-md text-label-md shadow-sm hover:bg-tertiary-container transition-all" type="button" onclick="alert('Đang tạo báo cáo theo biểu mẫu Bộ Y Tế với chữ ký số SmartCA/VNPT...')">
                    <span class="material-symbols-outlined text-[18px]">verified_user</span>
                    <span>Báo cáo BYT (PDF ký số)</span>
                </button>
                <button class="inline-flex items-center gap-2 h-10 px-3.5 rounded-xl bg-secondary-container text-on-secondary-container font-label-md text-label-md hover:bg-outline-variant/40 transition-all" title="Lập lịch gửi tự động" type="button" onclick="alert('Mở bảng cấu hình lập lịch gửi báo cáo tự động.')">
                    <span class="material-symbols-outlined text-[18px]">schedule_send</span>
                    <span class="hidden sm:inline">Lập lịch</span>
                </button>
            </div>
        </div>

        <!-- Filter Controls Strip -->
        <div class="pt-space-sm flex flex-col md:flex-row items-stretch md:items-center justify-between gap-space-md">
            <!-- Date Selector & Presets -->
            <div class="flex flex-wrap items-center gap-space-xs sm:gap-space-sm">
                <div class="relative">
                    <button class="flex items-center gap-2 h-10 px-3.5 rounded-xl bg-surface-container font-label-md text-label-md text-on-surface" type="button">
                        <span class="material-symbols-outlined text-[18px] text-primary">calendar_month</span>
                        <span>Quý IV/2025 (01/10/2025 - 31/12/2025)</span>
                        <span class="material-symbols-outlined text-[16px] text-secondary">expand_more</span>
                    </button>
                </div>
                <div class="flex items-center bg-surface-container-low p-1 rounded-xl">
                    <button class="px-2.5 py-1 rounded-lg font-label-sm text-label-sm text-secondary hover:text-on-surface transition-colors" type="button">Hôm nay</button>
                    <button class="px-2.5 py-1 rounded-lg font-label-sm text-label-sm text-secondary hover:text-on-surface transition-colors" type="button">7 ngày</button>
                    <button class="px-2.5 py-1 rounded-lg font-label-sm text-label-sm text-secondary hover:text-on-surface transition-colors" type="button">Tháng này</button>
                    <button class="px-2.5 py-1 rounded-lg bg-surface-container-lowest text-primary font-semibold shadow-sm" type="button">Năm 2025</button>
                </div>
            </div>
            <!-- Facility Location Filter -->
            <div class="flex items-center gap-2">
                <span class="material-symbols-outlined text-[20px] text-secondary">local_hospital</span>
                <select aria-label="Chọn cơ sở tiếp nhận" class="h-10 pl-3 pr-8 rounded-xl bg-surface-container font-body-sm text-body-sm text-on-surface focus:outline-none focus:bg-surface-container-lowest transition-all">
                    <option selected>Tất cả cơ sở (Viện Huyết học TW + 14 Điểm lưu động)</option>
                    <option>Viện Huyết học - Truyền máu TW (Trụ sở chính)</option>
                    <option>Trung tâm Máu Quốc gia - Kíp lưu động 01</option>
                    <option>Trung tâm Máu Quốc gia - Kíp lưu động 02</option>
                    <option>Điểm hiến cố định BV Bạch Mai</option>
                </select>
            </div>
        </div>
    </header>

    <!-- Section 2: Top 4 High-Impact KPI Cards -->
    <section aria-label="Chỉ số hoạt động tổng thể" class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-space-md">
        <!-- Card 1: Tổng thu nhận -->
        <article class="p-space-lg bg-surface-container-lowest rounded-xl shadow-sm flex flex-col justify-between relative overflow-hidden group">
            <div class="absolute -right-6 -bottom-6 w-28 h-28 rounded-full bg-primary/5 pointer-events-none transition-transform group-hover:scale-125"></div>
            <div class="flex items-start justify-between">
                <div>
                    <span class="font-label-sm text-label-sm text-secondary uppercase tracking-wider">Tổng Lưu Lượng Thu Nhận</span>
                    <div class="mt-1 flex items-baseline gap-2">
                        <span class="font-headline-lg text-headline-lg text-on-surface">12,450</span>
                        <span class="font-label-md text-label-md text-secondary">Đơn vị</span>
                    </div>
                    <span class="font-body-sm text-body-sm text-on-surface-variant font-medium">~ 4,357.5 Lít máu toàn phần</span>
                </div>
                <div class="w-12 h-12 rounded-xl bg-secondary-fixed flex items-center justify-center text-primary shrink-0">
                    <span class="material-symbols-outlined text-[26px]">water_drop</span>
                </div>
            </div>
            <div class="pt-space-md mt-space-md space-y-2">
                <div class="flex items-center justify-between">
                    <span class="inline-flex items-center gap-1 font-label-sm text-label-sm text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-full font-bold">
                        <span class="material-symbols-outlined text-[14px]">trending_up</span>
                        +14.8% so với Q3
                    </span>
                    <span class="font-label-sm text-label-sm text-secondary">Đạt 103.7% chỉ tiêu</span>
                </div>
                <div class="h-1.5 w-full bg-surface-container rounded-full overflow-hidden flex">
                    <div class="bg-primary" style="width: 68%" title="Túi 350 mL (68%)"></div>
                    <div class="bg-tertiary-container" style="width: 22%" title="Túi 250 mL (22%)"></div>
                    <div class="bg-outline-variant" style="width: 10%" title="Túi 450 mL (10%)"></div>
                </div>
                <div class="flex justify-between font-label-sm text-[11px] text-secondary pt-0.5">
                    <span>350mL: 68%</span>
                    <span>250mL: 22%</span>
                    <span>450mL: 10%</span>
                </div>
            </div>
        </article>

        <!-- Card 2: Cấp phát lâm sàng -->
        <article class="p-space-lg bg-surface-container-lowest rounded-xl shadow-sm flex flex-col justify-between relative overflow-hidden group">
            <div class="absolute -right-6 -bottom-6 w-28 h-28 rounded-full bg-surface-container pointer-events-none transition-transform group-hover:scale-125"></div>
            <div class="flex items-start justify-between">
                <div>
                    <span class="font-label-sm text-label-sm text-secondary uppercase tracking-wider">Cấp Phát Lâm Sàng</span>
                    <div class="mt-1 flex items-baseline gap-2">
                        <span class="font-headline-lg text-headline-lg text-on-surface">11,890</span>
                        <span class="font-label-md text-label-md text-secondary">Đơn vị</span>
                    </div>
                    <span class="font-body-sm text-body-sm text-on-surface-variant font-medium">Hỗ trợ 35,670 lượt bệnh nhân</span>
                </div>
                <div class="w-12 h-12 rounded-xl bg-surface-container flex items-center justify-center text-secondary shrink-0">
                    <span class="material-symbols-outlined text-[26px]">medical_services</span>
                </div>
            </div>
            <div class="pt-space-md mt-space-md space-y-1.5">
                <div class="flex items-center justify-between">
                    <span class="inline-flex items-center gap-1 font-label-sm text-label-sm text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-full font-bold">
                        <span class="material-symbols-outlined text-[14px]">verified</span>
                        Đáp ứng cấp cứu: 98.4%
                    </span>
                </div>
                <p class="font-body-sm text-body-sm text-secondary line-clamp-1 pt-0.5">
                    Việt Đức (32%) • Bạch Mai (28%) • Nhi TW (19%)
                </p>
            </div>
        </article>

        <!-- Card 3: Cân bằng Cung - Cầu -->
        <article class="p-space-lg bg-surface-container-lowest rounded-xl shadow-sm flex flex-col justify-between relative overflow-hidden group">
            <div class="absolute -right-6 -bottom-6 w-28 h-28 rounded-full bg-secondary-fixed pointer-events-none transition-transform group-hover:scale-125"></div>
            <div class="flex items-start justify-between">
                <div>
                    <span class="font-label-sm text-label-sm text-secondary uppercase tracking-wider">Chỉ Số Cung / Cầu</span>
                    <div class="mt-1 flex items-baseline gap-2">
                        <span class="font-headline-lg text-headline-lg text-on-surface">1.05</span>
                        <span class="font-label-md text-label-md text-emerald-700 font-semibold">Cân bằng</span>
                    </div>
                    <span class="font-body-sm text-body-sm text-on-surface-variant">Ngưỡng chuẩn quy định: 1.00 – 1.10</span>
                </div>
                <div class="w-12 h-12 rounded-xl bg-surface-container flex items-center justify-center text-on-surface shrink-0">
                    <span class="material-symbols-outlined text-[26px]">balance</span>
                </div>
            </div>
            <div class="pt-space-md mt-space-md">
                <div class="p-2 rounded-lg bg-error-container/40 flex items-start gap-2">
                    <span class="material-symbols-outlined text-error text-[18px] shrink-0 mt-0.5">warning</span>
                    <p class="font-label-sm text-label-sm text-on-surface leading-tight">
                        <strong class="text-error font-bold">O Rh(-) 0.62:</strong> Thâm hụt cục bộ. Cần bổ sung ngay 45 ĐV dự trữ.
                    </p>
                </div>
            </div>
        </article>

        <!-- Card 4: Tỷ lệ hủy an toàn sinh học -->
        <article class="p-space-lg bg-surface-container-lowest rounded-xl shadow-sm flex flex-col justify-between relative overflow-hidden group">
            <div class="absolute -right-6 -bottom-6 w-28 h-28 rounded-full bg-surface-container-high pointer-events-none transition-transform group-hover:scale-125"></div>
            <div class="flex items-start justify-between">
                <div>
                    <span class="font-label-sm text-label-sm text-secondary uppercase tracking-wider">Hủy / Thất Thoát Kỹ Thuật</span>
                    <div class="mt-1 flex items-baseline gap-2">
                        <span class="font-headline-lg text-headline-lg text-on-surface">1.12%</span>
                        <span class="font-label-sm text-label-sm text-emerald-700 font-bold bg-emerald-50 px-2 py-0.5 rounded-full">Chuẩn Vàng</span>
                    </div>
                    <span class="font-body-sm text-body-sm text-on-surface-variant">Giới hạn BYT: &lt; 2.50%</span>
                </div>
                <div class="w-12 h-12 rounded-xl bg-surface-container flex items-center justify-center text-primary shrink-0">
                    <span class="material-symbols-outlined text-[26px]">health_and_safety</span>
                </div>
            </div>
            <div class="pt-space-md mt-space-md space-y-1">
                <div class="flex justify-between font-label-sm text-label-sm text-secondary">
                    <span>Dương tính NAT: 0.70%</span>
                    <span>Vỡ cơ học: 0.42%</span>
                </div>
                <div class="w-full bg-surface-container h-1.5 rounded-full overflow-hidden">
                    <div class="bg-primary h-full rounded-full" style="width: 44.8%"></div>
                </div>
            </div>
        </article>
    </section>

    <!-- Section 3: Visual Analytics Row 1 -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-space-lg items-stretch">
        <!-- Chart Panel 1: Bar & Line Trend (12 Months) -->
        <article class="lg:col-span-8 bg-surface-container-lowest rounded-xl p-space-lg shadow-sm flex flex-col justify-between">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-space-sm mb-space-md">
                <div>
                    <h2 class="font-headline-sm text-headline-sm text-on-surface">
                        Biểu Đồ Xu Hướng Thu Nhận vs Cấp Phát Điều Phối
                    </h2>
                    <p class="font-body-sm text-body-sm text-on-surface-variant">
                        Chuỗi thời gian 12 tháng qua (So sánh lưu lượng tiếp nhận và cấp phát cứu chữa lâm sàng)
                    </p>
                </div>
                <!-- Toggle Tabs -->
                <div class="flex items-center p-1 bg-surface-container-low rounded-xl self-start">
                    <button class="px-3 py-1 rounded-lg bg-surface-container-lowest text-primary font-semibold font-label-sm text-label-sm shadow-sm" type="button">Theo Túi (ĐV)</button>
                    <button class="px-3 py-1 rounded-lg text-secondary font-label-sm text-label-sm hover:text-on-surface" type="button">Thể tích (mL)</button>
                    <button class="px-3 py-1 rounded-lg text-secondary font-label-sm text-label-sm hover:text-on-surface" type="button">Chế phẩm</button>
                </div>
            </div>

            <!-- Legend indicators -->
            <div class="flex flex-wrap items-center gap-space-md text-label-sm font-label-sm mb-space-md">
                <span class="inline-flex items-center gap-1.5 text-on-surface">
                    <span class="w-3 h-3 rounded-sm bg-primary"></span>
                    Lưu lượng thu nhận
                </span>
                <span class="inline-flex items-center gap-1.5 text-on-surface">
                    <span class="w-3 h-3 rounded-sm bg-inverse-surface"></span>
                    Cấp phát lâm sàng
                </span>
                <span class="inline-flex items-center gap-1.5 text-secondary">
                    <span class="w-4 h-0.5 border-t-2 border-dashed border-tertiary"></span>
                    Ngưỡng an toàn dự trữ (900 ĐV)
                </span>
            </div>

            <!-- Visual High-Fidelity SVG Bar Chart Canvas -->
            <div class="relative w-full h-72 sm:h-80 flex flex-col justify-end pt-6">
                <!-- Threshold line -->
                <div class="absolute inset-x-0 bottom-24 border-b border-dashed border-tertiary/40 flex items-center justify-end pr-2 pointer-events-none">
                    <span class="font-label-sm text-[10px] text-tertiary bg-surface-container-lowest px-1">Ngưỡng 900 ĐV</span>
                </div>
                <!-- Highlight Annotation Tooltip (Peak Month) -->
                <div class="absolute top-2 left-[44%] -translate-x-1/2 bg-inverse-surface text-inverse-on-surface px-3 py-1.5 rounded-xl shadow-md font-label-sm text-label-sm flex items-center gap-1.5 z-10">
                    <span class="material-symbols-outlined text-[16px] text-tertiary-fixed">celebration</span>
                    <span>Tháng 6: Hành Trình Đỏ đạt <strong>1,420 ĐV</strong></span>
                </div>
                <!-- The Bars Grid -->
                <div class="w-full h-full flex items-end justify-between gap-1 sm:gap-3 px-2">
                    <!-- T1 -->
                    <div class="flex-1 flex flex-col items-center gap-1 h-full justify-end group">
                        <div class="w-full flex items-end justify-center gap-0.5 sm:gap-1 h-full">
                            <div class="w-1/2 max-w-[14px] bg-primary rounded-t-sm transition-all group-hover:brightness-110" style="height: 59%;" title="Thu: 890 ĐV"></div>
                            <div class="w-1/2 max-w-[14px] bg-inverse-surface rounded-t-sm transition-all group-hover:brightness-110" style="height: 56%;" title="Cấp: 840 ĐV"></div>
                        </div>
                        <span class="font-label-sm text-[11px] text-secondary">T1</span>
                    </div>
                    <!-- T2 (Tet) -->
                    <div class="flex-1 flex flex-col items-center gap-1 h-full justify-end group">
                        <div class="w-full flex items-end justify-center gap-0.5 sm:gap-1 h-full">
                            <div class="w-1/2 max-w-[14px] bg-primary/70 rounded-t-sm transition-all" style="height: 50%;" title="Thu: 750 ĐV (Tết)"></div>
                            <div class="w-1/2 max-w-[14px] bg-inverse-surface rounded-t-sm transition-all" style="height: 58%;" title="Cấp: 870 ĐV"></div>
                        </div>
                        <span class="font-label-sm text-[11px] text-secondary">T2</span>
                    </div>
                    <!-- T3 -->
                    <div class="flex-1 flex flex-col items-center gap-1 h-full justify-end group">
                        <div class="w-full flex items-end justify-center gap-0.5 sm:gap-1 h-full">
                            <div class="w-1/2 max-w-[14px] bg-primary rounded-t-sm transition-all" style="height: 75%;" title="Thu: 1,120 ĐV"></div>
                            <div class="w-1/2 max-w-[14px] bg-inverse-surface rounded-t-sm transition-all" style="height: 68%;" title="Cấp: 1,010 ĐV"></div>
                        </div>
                        <span class="font-label-sm text-[11px] text-secondary">T3</span>
                    </div>
                    <!-- T4 -->
                    <div class="flex-1 flex flex-col items-center gap-1 h-full justify-end group">
                        <div class="w-full flex items-end justify-center gap-0.5 sm:gap-1 h-full">
                            <div class="w-1/2 max-w-[14px] bg-primary rounded-t-sm transition-all" style="height: 65%;" title="Thu: 980 ĐV"></div>
                            <div class="w-1/2 max-w-[14px] bg-inverse-surface rounded-t-sm transition-all" style="height: 63%;" title="Cấp: 950 ĐV"></div>
                        </div>
                        <span class="font-label-sm text-[11px] text-secondary">T4</span>
                    </div>
                    <!-- T5 -->
                    <div class="flex-1 flex flex-col items-center gap-1 h-full justify-end group">
                        <div class="w-full flex items-end justify-center gap-0.5 sm:gap-1 h-full">
                            <div class="w-1/2 max-w-[14px] bg-primary rounded-t-sm transition-all" style="height: 70%;" title="Thu: 1,050 ĐV"></div>
                            <div class="w-1/2 max-w-[14px] bg-inverse-surface rounded-t-sm transition-all" style="height: 66%;" title="Cấp: 990 ĐV"></div>
                        </div>
                        <span class="font-label-sm text-[11px] text-secondary">T5</span>
                    </div>
                    <!-- T6 Peak Month -->
                    <div class="flex-1 flex flex-col items-center gap-1 h-full justify-end group">
                        <div class="w-full flex items-end justify-center gap-0.5 sm:gap-1 h-full">
                            <div class="w-1/2 max-w-[14px] bg-primary rounded-t-sm transition-all shadow-sm" style="height: 95%;" title="Thu: 1,420 ĐV"></div>
                            <div class="w-1/2 max-w-[14px] bg-inverse-surface rounded-t-sm transition-all" style="height: 78%;" title="Cấp: 1,180 ĐV"></div>
                        </div>
                        <span class="font-label-sm text-[11px] text-primary font-bold">T6</span>
                    </div>
                    <!-- T7 -->
                    <div class="flex-1 flex flex-col items-center gap-1 h-full justify-end group">
                        <div class="w-full flex items-end justify-center gap-0.5 sm:gap-1 h-full">
                            <div class="w-1/2 max-w-[14px] bg-primary rounded-t-sm transition-all" style="height: 92%;" title="Thu: 1,380 ĐV"></div>
                            <div class="w-1/2 max-w-[14px] bg-inverse-surface rounded-t-sm transition-all" style="height: 80%;" title="Cấp: 1,200 ĐV"></div>
                        </div>
                        <span class="font-label-sm text-[11px] text-secondary">T7</span>
                    </div>
                    <!-- T8 -->
                    <div class="flex-1 flex flex-col items-center gap-1 h-full justify-end group">
                        <div class="w-full flex items-end justify-center gap-0.5 sm:gap-1 h-full">
                            <div class="w-1/2 max-w-[14px] bg-primary rounded-t-sm transition-all" style="height: 73%;" title="Thu: 1,100 ĐV"></div>
                            <div class="w-1/2 max-w-[14px] bg-inverse-surface rounded-t-sm transition-all" style="height: 71%;" title="Cấp: 1,060 ĐV"></div>
                        </div>
                        <span class="font-label-sm text-[11px] text-secondary">T8</span>
                    </div>
                    <!-- T9 -->
                    <div class="flex-1 flex flex-col items-center gap-1 h-full justify-end group">
                        <div class="w-full flex items-end justify-center gap-0.5 sm:gap-1 h-full">
                            <div class="w-1/2 max-w-[14px] bg-primary rounded-t-sm transition-all" style="height: 68%;" title="Thu: 1,020 ĐV"></div>
                            <div class="w-1/2 max-w-[14px] bg-inverse-surface rounded-t-sm transition-all" style="height: 66%;" title="Cấp: 990 ĐV"></div>
                        </div>
                        <span class="font-label-sm text-[11px] text-secondary">T9</span>
                    </div>
                    <!-- T10 -->
                    <div class="flex-1 flex flex-col items-center gap-1 h-full justify-end group">
                        <div class="w-full flex items-end justify-center gap-0.5 sm:gap-1 h-full">
                            <div class="w-1/2 max-w-[14px] bg-primary rounded-t-sm transition-all" style="height: 83%;" title="Thu: 1,250 ĐV"></div>
                            <div class="w-1/2 max-w-[14px] bg-inverse-surface rounded-t-sm transition-all" style="height: 74%;" title="Cấp: 1,110 ĐV"></div>
                        </div>
                        <span class="font-label-sm text-[11px] text-secondary">T10</span>
                    </div>
                    <!-- T11 -->
