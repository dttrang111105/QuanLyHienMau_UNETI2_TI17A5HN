<link rel="stylesheet" href="~/css/module5-integration.css" asp-append-version="true"/><div class="m5-ui"><partial name="_Module5Messages"/><div class="page-head"><h1 class="font-headline-lg">Bảng Điều Hành &amp; Quản Lý Hiến Máu</h1><a class="button" asp-controller="LichKhamSangLoc" asp-action="Create"><span class="material-symbols-outlined">add_circle</span>Lập lịch khám</a></div>
