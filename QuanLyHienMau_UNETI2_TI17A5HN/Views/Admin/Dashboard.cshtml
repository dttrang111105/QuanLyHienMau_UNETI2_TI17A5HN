@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Bảng Điều Hành & Quản Lý Hiến Máu";

    int tongNguoiHien = ViewBag.TongNguoiHien ?? 0;
    int tongPhieu = ViewBag.TongPhieu ?? 0;
    int phieuChoXacNhan = ViewBag.PhieuChoXacNhan ?? 0;
    int phieuDaXacNhan = ViewBag.PhieuDaXacNhan ?? 0;
    int phieuDaKham = ViewBag.PhieuDaKham ?? 0;
    int hienMauThanhCong = ViewBag.HienMauThanhCong ?? 0;
    int khongDuDieuKien = ViewBag.KhongDuDieuKien ?? 0;
    int dotDangMo = ViewBag.DotDangMo ?? 0;
    int tongDonVi = ViewBag.TongDonVi ?? 0;
    int tongLichKham = ViewBag.TongLichKham ?? 0;

    var dotList = ViewBag.DotList as List<QuanLyHienMau_UNETI2_TI17A5HN.Models.DotHienMau> ?? new List<QuanLyHienMau_UNETI2_TI17A5HN.Models.DotHienMau>();
    var recentTickets = ViewBag.RecentTickets as List<QuanLyHienMau_UNETI2_TI17A5HN.Models.PhieuDangKyHienMau> ?? new List<QuanLyHienMau_UNETI2_TI17A5HN.Models.PhieuDangKyHienMau>();

    double successRate = (hienMauThanhCong + khongDuDieuKien) > 0 
        ? Math.Round((double)hienMauThanhCong / (hienMauThanhCong + khongDuDieuKien) * 100, 1) 
        : 100;
}

<div class="flex flex-col w-full">
    <!-- TOAST ALERT NOTIFICATION -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="fixed top-20 right-8 z-50 flex items-center gap-space-sm bg-surface-container-lowest px-space-md py-3 rounded-xl shadow-xl border border-emerald-200" id="toastNotification">
            <div class="w-8 h-8 rounded-full bg-emerald-500/10 flex items-center justify-center shrink-0">
                <span class="material-symbols-outlined text-emerald-600 text-[18px]">verified</span>
            </div>
            <p class="font-body-sm text-body-sm text-on-surface font-semibold pr-2">@TempData["SuccessMessage"]</p>
            <button class="p-1 text-on-surface-variant hover:text-on-surface" onclick="this.parentElement.remove()">
                <span class="material-symbols-outlined text-[16px]">close</span>
            </button>
        </div>
    }

    <div class="p-space-lg max-w-[1600px] mx-auto w-full space-y-space-lg">
        <!-- 1. HEADER & KHU VỰC ĐIỀU HÀNH TỔNG QUAN -->
        <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-space-md bg-surface-container-lowest p-space-lg rounded-2xl shadow-sm">
            <div class="space-y-1">
                <div class="flex items-center gap-2 text-on-surface-variant font-label-sm text-label-sm">
                    <span>Hệ thống Quản trị Y tế UNETI</span>
                    <span class="material-symbols-outlined text-[14px]">chevron_right</span>
                    <span class="text-primary font-semibold">Điều Hành Chiến Dịch &amp; Tiếp Nhận Lâm Sàng</span>
                </div>
                <div class="flex flex-wrap items-center gap-3">
                    <h1 class="font-headline-lg text-headline-lg text-on-surface tracking-tight font-bold">Bảng Điều Hành &amp; Quản Lý Hiến Máu</h1>
                    <div class="flex items-center gap-1.5 px-3 py-1 rounded-full bg-primary/10 text-primary font-label-sm text-label-sm font-bold">
                        <span class="w-2 h-2 rounded-full bg-primary animate-ping"></span>
                        <span>Dữ Liệu Hệ Thống Trực Tiếp</span>
                    </div>
                </div>
                <p class="font-body-md text-body-md text-on-surface-variant">
                    Thống kê thời gian thực giữa Kíp khám sàng lọc, Ngân hàng Máu và Cổng tiếp nhận hiến máu.
                </p>
            </div>
            <div class="flex flex-wrap items-center gap-space-sm">
                <a asp-action="KetQuaHienMau" class="flex items-center gap-2 px-4 py-2.5 rounded-xl bg-surface-container hover:bg-surface-container-high text-on-surface font-label-md text-label-md transition-all shadow-sm font-semibold">
                    <span class="material-symbols-outlined text-[18px]">biotech</span>
                    <span>Quản lý kết quả (@(hienMauThanhCong + khongDuDieuKien))</span>
                </a>
                <a asp-controller="DotHienMau" asp-action="Index" class="flex items-center gap-2 px-5 py-2.5 rounded-xl bg-primary hover:bg-primary-container text-on-primary font-label-md text-label-md shadow-md transition-all font-bold">
                    <span class="material-symbols-outlined text-[20px]">event_available</span>
                    <span>Danh Sách Đợt (@dotDangMo đợt mở)</span>
                </a>
            </div>
        </div>

        <!-- 2. HÀNG THẺ KPI CHỈ SỐ VĨ MÔ (4 STATISTIC CARDS) -->
        <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-space-md">
            <!-- Card 1: Tổng người hiến -->
            <div class="bg-surface-container-lowest p-space-lg rounded-2xl shadow-sm flex flex-col justify-between">
                <div class="flex items-start justify-between">
                    <div class="space-y-1">
                        <span class="font-label-sm text-label-sm uppercase tracking-wider text-on-surface-variant font-semibold">Tổng Người Hiến Máu</span>
                        <div class="font-headline-lg text-headline-lg text-on-surface font-bold">@tongNguoiHien <span class="font-title-md text-title-md font-normal text-on-surface-variant">người</span></div>
                    </div>
                    <div class="w-12 h-12 rounded-2xl bg-surface-container-low flex items-center justify-center text-primary">
                        <span class="material-symbols-outlined text-[26px]">how_to_reg</span>
                    </div>
                </div>
                <div class="mt-4 pt-3 flex items-center justify-between font-body-sm text-body-sm bg-surface-container-low/50 px-3 py-1.5 rounded-xl">
                    <span class="text-primary font-semibold flex items-center gap-1">
                        <span class="material-symbols-outlined text-[16px]">person</span> Đã đăng ký tài khoản
                    </span>
                    <span class="text-on-surface-variant font-semibold">Hồ sơ cá nhân</span>
                </div>
            </div>

            <!-- Card 2: Đợt đang mở -->
            <div class="bg-surface-container-lowest p-space-lg rounded-2xl shadow-sm flex flex-col justify-between">
                <div class="flex items-start justify-between">
                    <div class="space-y-1">
                        <span class="font-label-sm text-label-sm uppercase tracking-wider text-on-surface-variant font-semibold">Đợt Hiến Đang Mở</span>
                        <div class="font-headline-lg text-headline-lg text-on-surface font-bold">@dotDangMo <span class="font-title-md text-title-md font-normal text-on-surface-variant">/ @dotList.Count đợt</span></div>
                    </div>
                    <div class="w-12 h-12 rounded-2xl bg-surface-container-low flex items-center justify-center text-primary">
                        <span class="material-symbols-outlined text-[26px]">event_repeat</span>
                    </div>
                </div>
                <div class="mt-4 pt-3 flex items-center justify-between font-body-sm text-body-sm bg-surface-container-low/50 px-3 py-1.5 rounded-xl">
                    <span class="text-emerald-700 font-semibold flex items-center gap-1">
                        <span class="material-symbols-outlined text-[16px]">apartment</span> @tongDonVi đơn vị tổ chức
                    </span>
                    <span class="text-on-surface-variant">Đang nhận hồ sơ</span>
                </div>
            </div>

            <!-- Card 3: Tổng phiếu đăng ký -->
            <div class="bg-surface-container-lowest p-space-lg rounded-2xl shadow-sm flex flex-col justify-between">
                <div class="flex items-start justify-between">
                    <div class="space-y-1">
                        <span class="font-label-sm text-label-sm uppercase tracking-wider text-on-surface-variant font-semibold">Tổng Phiếu Đăng Ký</span>
                        <div class="font-headline-lg text-headline-lg text-on-surface font-bold">@tongPhieu <span class="font-title-md text-title-md font-normal text-on-surface-variant">phiếu</span></div>
                    </div>
                    <div class="w-12 h-12 rounded-2xl bg-surface-container-low flex items-center justify-center text-primary">
                        <span class="material-symbols-outlined text-[26px]">assignment</span>
                    </div>
                </div>
                <div class="mt-4 pt-3 flex items-center justify-between font-body-sm text-body-sm bg-surface-container-low/50 px-3 py-1.5 rounded-xl">
                    <span class="text-amber-700 font-semibold flex items-center gap-1">
                        <span class="material-symbols-outlined text-[16px]">pending_actions</span> @phieuChoXacNhan chờ duyệt
                    </span>
                    <span class="text-on-surface-variant">@phieuDaXacNhan đã duyệt</span>
                </div>
            </div>

            <!-- Card 4: Hiến máu thành công -->
            <div class="bg-surface-container-lowest p-space-lg rounded-2xl shadow-sm flex flex-col justify-between">
                <div class="flex items-start justify-between">
                    <div class="space-y-1">
                        <span class="font-label-sm text-label-sm uppercase tracking-wider text-emerald-800 font-semibold">Hiến Máu Thành Công</span>
                        <div class="font-headline-lg text-headline-lg text-emerald-700 font-bold">@hienMauThanhCong <span class="font-title-md text-title-md font-normal text-emerald-600">ca</span></div>
                    </div>
                    <div class="w-12 h-12 rounded-2xl bg-emerald-50 flex items-center justify-center text-emerald-600">
                        <span class="material-symbols-outlined text-[26px]">water_drop</span>
                    </div>
                </div>
                <div class="mt-4 space-y-1.5">
                    <div class="flex justify-between font-label-sm text-label-sm font-semibold">
                        <span class="text-emerald-700">Tỷ lệ đạt chuẩn: @successRate%</span>
                        <span class="text-rose-700">@khongDuDieuKien hoãn hiến</span>
                    </div>
                    <div class="w-full bg-surface-container h-2 rounded-full overflow-hidden">
                        <div class="bg-emerald-600 h-full rounded-full transition-all duration-500" style="width: @successRate%"></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 3. HÀNG CHỈ SỐ TRỰC BAN & TIẾP NHẬN Y TẾ (4 METRIC MINI CARDS) -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-space-md">
            <!-- Mini 1: Chờ duyệt -->
            <div class="bg-surface-container-lowest p-space-md rounded-2xl shadow-sm flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-amber-500/10 text-amber-700 flex items-center justify-center shrink-0">
                        <span class="material-symbols-outlined text-[22px]">pending_actions</span>
                    </div>
                    <div>
                        <div class="flex items-center gap-1.5">
                            <span class="font-headline-sm text-headline-sm text-on-surface font-bold">@phieuChoXacNhan</span>
                            <span class="font-label-sm text-label-sm px-2 py-0.5 rounded-full bg-amber-100 text-amber-800 font-bold">Chờ duyệt</span>
                        </div>
                        <p class="font-body-sm text-body-sm text-on-surface-variant">Phiếu chờ thẩm định</p>
                    </div>
                </div>
                <a asp-action="PhieuDangKyHienMau" asp-route-trangThai="Chờ xác nhận" class="px-3 py-1.5 rounded-lg bg-primary hover:bg-primary-container text-on-primary font-label-sm text-label-sm font-bold shadow-sm transition-all shrink-0">
                    Duyệt ngay
                </a>
            </div>

            <!-- Mini 2: Đã xác nhận -->
            <div class="bg-surface-container-lowest p-space-md rounded-2xl shadow-sm flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-sky-500/10 text-sky-700 flex items-center justify-center shrink-0">
                        <span class="material-symbols-outlined text-[22px]">verified</span>
                    </div>
                    <div>
                        <div class="flex items-center gap-1.5">
                            <span class="font-headline-sm text-headline-sm text-on-surface font-bold">@phieuDaXacNhan</span>
                            <span class="font-label-sm text-label-sm px-2 py-0.5 rounded-full bg-sky-100 text-sky-800 font-semibold">Đã duyệt</span>
                        </div>
                        <p class="font-body-sm text-body-sm text-on-surface-variant">Sẵn sàng điều phối khám</p>
                    </div>
                </div>
                <a asp-action="LichKhamSangLoc" class="material-symbols-outlined text-surface-variant hover:text-primary text-[24px]">calendar_month</a>
            </div>

            <!-- Mini 3: Đã khám sàng lọc -->
            <div class="bg-surface-container-lowest p-space-md rounded-2xl shadow-sm flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-purple-500/10 text-purple-700 flex items-center justify-center shrink-0">
                        <span class="material-symbols-outlined text-[22px]">stethoscope</span>
                    </div>
                    <div>
                        <div class="flex items-center gap-1.5">
                            <span class="font-headline-sm text-headline-sm text-on-surface font-bold">@phieuDaKham</span>
                            <span class="font-label-sm text-label-sm px-2 py-0.5 rounded-full bg-purple-100 text-purple-800 font-bold">Đã khám</span>
                        </div>
                        <p class="font-body-sm text-body-sm text-on-surface-variant">Chờ nhập kết quả lấy máu</p>
                    </div>
                </div>
                <a asp-action="KetQuaHienMau" class="px-3 py-1.5 rounded-lg bg-purple-600 hover:bg-purple-700 text-on-primary font-label-sm text-label-sm font-bold shadow-sm transition-all shrink-0">
                    Nhập KQ
                </a>
            </div>

            <!-- Mini 4: Không đủ điều kiện -->
            <div class="bg-surface-container-lowest p-space-md rounded-2xl shadow-sm flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-rose-500/10 text-rose-700 flex items-center justify-center shrink-0">
                        <span class="material-symbols-outlined text-[22px]">do_not_disturb_on</span>
                    </div>
                    <div>
                        <div class="flex items-center gap-1.5">
                            <span class="font-headline-sm text-headline-sm text-on-surface font-bold">@khongDuDieuKien</span>
                            <span class="font-label-sm text-label-sm px-2 py-0.5 rounded-full bg-rose-100 text-rose-800 font-bold">Hoãn hiến</span>
                        </div>
                        <p class="font-body-sm text-body-sm text-on-surface-variant">Huyết áp / Thể trạng</p>
                    </div>
                </div>
                <span class="material-symbols-outlined text-rose-600 text-[24px]">cancel</span>
            </div>
        </div>

        <!-- 4. KHU VỰC BẢNG THỐNG KÊ THEO ĐỢT HIẾN MÁU (LINQ DỮ LIỆU THẬT) -->
        <div class="bg-surface-container-lowest p-space-lg rounded-2xl shadow-sm space-y-space-md">
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-space-md">
                <div>
                    <div class="flex items-center gap-2">
                        <span class="material-symbols-outlined text-primary text-[24px]">campaign</span>
                        <h2 class="font-title-md text-title-md text-on-surface font-bold">Thống Kê Tiến Độ Các Đợt Hiến Máu Toàn Hệ Thống</h2>
                    </div>
                    <p class="font-body-sm text-body-sm text-on-surface-variant">Tổng hợp số lượng đăng ký, khám sàng lọc và kết quả thực tế theo từng đợt</p>
                </div>
                <a asp-action="PhieuDangKyHienMau" class="px-4 py-2 rounded-xl bg-surface-container hover:bg-surface-container-high text-on-surface font-label-sm text-label-sm font-bold flex items-center gap-1 transition-all">
                    <span>Xem tất cả phiếu</span>
                    <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
                </a>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full text-left font-body-md text-body-md border-collapse">
                    <thead>
                        <tr class="bg-surface-container-low text-on-surface-variant font-label-sm text-label-sm uppercase tracking-wider">
                            <th class="py-3.5 px-4 rounded-l-xl">Tên Đợt Hiến Máu</th>
                            <th class="py-3.5 px-4">Đơn Vị Tổ Chức</th>
                            <th class="py-3.5 px-4 text-center">Chỉ Tiêu</th>
                            <th class="py-3.5 px-4 text-center">Số Đăng Ký</th>
                            <th class="py-3.5 px-4 text-center">Đã Khám</th>
                            <th class="py-3.5 px-4 text-center">Thành Công</th>
                            <th class="py-3.5 px-4 text-center">Không Đạt</th>
                            <th class="py-3.5 px-4">Trạng Thái</th>
                            <th class="py-3.5 px-4 rounded-r-xl text-right">Thao Tác</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-surface-container text-on-surface">
                        @if (!dotList.Any())
                        {
                            <tr>
                                <td colspan="9" class="py-8 text-center text-on-surface-variant">
                                    Chưa có đợt hiến máu nào trong hệ thống.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var d in dotList)
                            {
                                int soDangKy = d.PhieuDangKyHienMaus.Count(p => p.TrangThai != "Đã hủy");
                                int daKham = d.PhieuDangKyHienMaus.Count(p => p.TrangThai == "Đã khám sàng lọc" || p.TrangThai == "Hiến máu thành công" || p.TrangThai == "Không đủ điều kiện hiến");
                                int thanhCong = d.PhieuDangKyHienMaus.Count(p => p.TrangThai == "Hiến máu thành công");
                                int khongDat = d.PhieuDangKyHienMaus.Count(p => p.TrangThai == "Không đủ điều kiện hiến");
                                double pct = d.ChiTieuDonViMau > 0 ? Math.Min(100.0, Math.Round((double)thanhCong / d.ChiTieuDonViMau * 100, 1)) : 0;

                                <tr class="hover:bg-surface-container-low/60 transition-colors">
                                    <td class="py-4 px-4 font-body-sm text-body-sm">
                                        <a asp-controller="DotHienMau" asp-action="Details" asp-route-id="@d.MaDot" class="font-bold text-on-surface hover:text-primary block">
                                            @d.TenDot
                                        </a>
                                        <span class="text-[12px] text-on-surface-variant">@d.NgayBatDauDangKy.ToString("dd/MM/yyyy") - @d.HanDangKy.ToString("dd/MM/yyyy")</span>
                                    </td>
                                    <td class="py-4 px-4 font-body-sm text-body-sm">
                                        <div class="font-semibold text-on-surface">@(d.DonViToChuc?.TenDonViToChuc ?? "UNETI")</div>
                                        <span class="text-[12px] text-on-surface-variant">@(d.DonViToChuc?.EmailLienHe ?? "Cơ sở UNETI")</span>
                                    </td>
                                    <td class="py-4 px-4 text-center font-bold text-on-surface">
                                        @d.ChiTieuDonViMau ĐV
                                    </td>
                                    <td class="py-4 px-4 text-center">
                                        <span class="px-2.5 py-1 rounded-full text-xs font-bold bg-surface-container text-on-surface">
                                            @soDangKy
                                        </span>
                                    </td>
                                    <td class="py-4 px-4 text-center">
                                        <span class="px-2.5 py-1 rounded-full text-xs font-bold bg-purple-100 text-purple-800">
                                            @daKham
                                        </span>
                                    </td>
                                    <td class="py-4 px-4 text-center">
                                        <span class="px-2.5 py-1 rounded-full text-xs font-bold bg-emerald-100 text-emerald-800">
                                            @thanhCong
                                        </span>
                                    </td>
                                    <td class="py-4 px-4 text-center">
                                        <span class="px-2.5 py-1 rounded-full text-xs font-bold bg-rose-100 text-rose-800">
                                            @khongDat
                                        </span>
                                    </td>
                                    <td class="py-4 px-4">
                                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-bold @(d.TrangThai == "Đang mở đăng ký" ? "bg-emerald-100 text-emerald-800" : "bg-surface-container text-on-surface-variant")">
                                            @d.TrangThai
                                        </span>
                                    </td>
                                    <td class="py-4 px-4 text-right">
                                        <div class="flex items-center justify-end gap-1">
                                            <a asp-action="PhieuDangKyHienMau" asp-route-maDot="@d.MaDot" class="p-1.5 rounded-lg hover:bg-surface-container text-on-surface-variant hover:text-primary" title="Xem phiếu của đợt">
                                                <span class="material-symbols-outlined text-[18px]">view_list</span>
                                            </a>
                                            <a asp-action="KetQuaHienMau" asp-route-maDot="@d.MaDot" class="p-1.5 rounded-lg hover:bg-surface-container text-on-surface-variant hover:text-primary" title="Xem kết quả của đợt">
                                                <span class="material-symbols-outlined text-[18px]">biotech</span>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- 5. DANH SÁCH PHIẾU ĐĂNG KÝ GẦN ĐÂY -->
        <div class="bg-surface-container-lowest p-space-lg rounded-2xl shadow-sm space-y-space-md">
            <div class="flex items-center justify-between border-b border-surface-container pb-space-sm">
                <div class="flex items-center gap-2">
                    <span class="material-symbols-outlined text-primary text-[22px]">history</span>
                    <h2 class="font-title-md text-title-md text-on-surface font-bold">Hồ Sơ Đăng Ký Mới Tiếp Nhận</h2>
                </div>
                <a asp-action="PhieuDangKyHienMau" class="text-primary font-bold text-sm hover:underline">
                    Xem tất cả (@tongPhieu)
                </a>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-space-sm">
                @foreach (var p in recentTickets)
                {
                    var stClass = p.TrangThai == "Hiến máu thành công" ? "bg-emerald-100 text-emerald-800" :
                                  p.TrangThai == "Không đủ điều kiện hiến" ? "bg-rose-100 text-rose-800" :
                                  p.TrangThai == "Chờ xác nhận" ? "bg-amber-100 text-amber-800" :
                                  "bg-sky-100 text-sky-800";

                    <div class="p-4 rounded-xl bg-surface-container-low border border-surface-container flex flex-col justify-between space-y-2">
                        <div class="flex items-start justify-between gap-2">
                            <div>
                                <span class="font-mono text-xs font-bold text-primary">#DKHM-@p.MaPhieu.ToString("D5")</span>
                                <h3 class="font-title-md text-sm font-bold text-on-surface mt-0.5">@(p.NguoiHienMau?.HoTen ?? "Người hiến")</h3>
                                <p class="text-xs text-on-surface-variant">@(p.DotHienMau?.TenDot ?? "UNETI")</p>
                            </div>
                            <span class="px-2 py-0.5 rounded-full text-[11px] font-bold @stClass">
                                @p.TrangThai
                            </span>
                        </div>
                        <div class="pt-2 border-t border-surface-container flex items-center justify-between text-xs text-on-surface-variant">
                            <span>Ngày nộp: @p.NgayNop.ToString("dd/MM/yyyy HH:mm")</span>
                            <a asp-action="ChiTietPhieuDangKy" asp-route-id="@p.MaPhieu" class="text-primary font-bold hover:underline">
                                Chi tiết
                            </a>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
