                    <span>Khi xác nhận, hệ thống ASP.NET Core sẽ kích hoạt webhook phát hành <strong>Thẻ Hiến Máu Điện Tử QR</strong> qua tin nhắn Zalo/SMS cho người hiến.</span>
                </div>
            </div>
            <div class="p-space-lg bg-surface-container-low flex items-center justify-end gap-3">
                <button class="px-4 py-2 rounded-xl bg-surface-container hover:bg-surface-container-high text-on-surface font-label-md text-label-md" onclick="closeApprovalModal()" type="button">
                    Hủy bỏ
                </button>
                <button class="px-5 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-label-md text-label-md font-bold shadow-md" onclick="confirmApproval()" type="button">
                    Xác Nhận Hợp Lệ &amp; Phát Mã QR
                </button>
            </div>
        </div>
    </div>

    <!-- MODAL TỪ CHỐI THẨM ĐỊNH HỒ SƠ -->
    <div class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-inverse-surface/40 backdrop-blur-sm" id="rejectModal">
        <div class="bg-surface-container-lowest max-w-lg w-full rounded-2xl shadow-xl overflow-hidden animate-in fade-in zoom-in-95 duration-200">
            <div class="p-space-lg bg-rose-50 flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-rose-600/10 text-rose-700 flex items-center justify-center">
                        <span class="material-symbols-outlined text-[24px]">cancel</span>
                    </div>
                    <div>
                        <h3 class="font-headline-sm text-headline-sm text-rose-900 font-bold">Từ Chối Tiếp Nhận Lâm Sàng</h3>
                        <span class="font-mono text-rose-800 font-bold text-xs" id="rejectTicketCode">#VTL-08993</span>
                    </div>
                </div>
                <button class="p-2 text-on-surface-variant hover:text-on-surface rounded-xl" onclick="closeRejectModal()">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>
            <div class="p-space-lg space-y-space-md">
                <p class="font-body-md text-body-md text-on-surface">
                    Đang thẩm định từ chối hồ sơ người hiến: <strong class="font-bold" id="rejectDonorName">Phạm Hoàng Anh</strong>
                </p>
                <div class="space-y-2">
                    <label class="block font-label-sm text-label-sm font-semibold text-on-surface">Lý do từ chối chuyên môn y tế:</label>
                    <select class="w-full h-11 px-3 rounded-xl bg-surface-container-low font-body-sm text-body-sm text-on-surface focus:outline-none cursor-pointer" id="rejectReasonSelect">
                        <option selected="">Chưa đủ khoảng cách 84 ngày theo quy định Bộ Y tế</option>
                        <option>Cân nặng dưới 45kg (Nữ) hoặc dưới 48kg (Nam)</option>
                        <option>Đang sử dụng thuốc kháng sinh / Kháng viêm trong 7 ngày</option>
                        <option>Có tiền sử bệnh tim mạch / Huyết áp không ổn định</option>
                        <option>Xăm hình, xỏ khuyên dưới 6 tháng gần nhất</option>
                        <option>Khác (Ghi chú chi tiết)</option>
                    </select>
                </div>
                <div class="space-y-2">
                    <label class="block font-label-sm text-label-sm font-semibold text-on-surface">Lời khuyên của bác sĩ gửi tới người hiến:</label>
                    <textarea class="w-full p-3 rounded-xl bg-surface-container-low font-body-sm text-body-sm text-on-surface focus:outline-none resize-none" placeholder="Nhập lời dặn dò y tế và ngày có thể quay lại đăng ký hiến máu an toàn..." rows="3"></textarea>
                </div>
            </div>
            <div class="p-space-lg bg-surface-container-low flex items-center justify-end gap-3">
                <button class="px-4 py-2 rounded-xl bg-surface-container hover:bg-surface-container-high text-on-surface font-label-md text-label-md" onclick="closeRejectModal()" type="button">
                    Đóng
                </button>
                <button class="px-5 py-2 rounded-xl bg-rose-600 hover:bg-rose-700 text-white font-label-md text-label-md font-bold shadow-md" onclick="confirmReject()" type="button">
                    Gửi Thông Báo Từ Chối
                </button>
            </div>
        </div>
    </div>

    <!-- MODAL THÊM ĐỢT HIẾN MÁU MỚI -->
    <div class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-inverse-surface/40 backdrop-blur-sm" id="newCampaignModal">
        <div class="bg-surface-container-lowest max-w-2xl w-full rounded-2xl shadow-xl overflow-hidden animate-in fade-in zoom-in-95 duration-200">
            <div class="p-space-lg bg-surface-container-low flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-primary/10 text-primary flex items-center justify-center">
                        <span class="material-symbols-outlined text-[24px]">add_circle</span>
                    </div>
                    <div>
                        <h3 class="font-headline-sm text-headline-sm text-on-surface font-bold">Thêm Mới Đợt Hiến Máu Trọng Điểm</h3>
                        <span class="font-body-sm text-body-sm text-on-surface-variant">Lập kế hoạch chiến dịch và kích hoạt tiếp nhận</span>
                    </div>
                </div>
                <button class="p-2 text-on-surface-variant hover:text-on-surface rounded-xl" onclick="document.getElementById('newCampaignModal').classList.add('hidden')">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>
            <div class="p-space-lg space-y-space-md">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-space-md">
                    <div class="space-y-1.5">
                        <label class="block font-label-sm text-label-sm font-semibold text-on-surface">Tên đợt hiến máu *</label>
                        <input class="w-full h-11 px-3 rounded-xl bg-surface-container-low font-body-sm text-body-sm text-on-surface focus:outline-none" placeholder="Ví dụ: Giọt Hồng Mùa Xuân 2026" type="text">
                    </div>
                    <div class="space-y-1.5">
                        <label class="block font-label-sm text-label-sm font-semibold text-on-surface">Đơn vị chủ trì *</label>
                        <select class="w-full h-11 px-3 rounded-xl bg-surface-container-low font-body-sm text-body-sm text-on-surface focus:outline-none cursor-pointer">
                            <option>Viện Huyết Học - Truyền Máu TW</option>
                            <option>Bệnh viện Chợ Rẫy TP.HCM</option>
                            <option>Hội Chữ Thập Đỏ TP. Hà Nội</option>
                        </select>
                    </div>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-space-md">
                    <div class="space-y-1.5">
                        <label class="block font-label-sm text-label-sm font-semibold text-on-surface">Thời gian bắt đầu</label>
                        <input class="w-full h-11 px-3 rounded-xl bg-surface-container-low font-body-sm text-body-sm text-on-surface focus:outline-none" type="date" value="2025-11-20">
                    </div>
                    <div class="space-y-1.5">
                        <label class="block font-label-sm text-label-sm font-semibold text-on-surface">Thời gian kết thúc</label>
                        <input class="w-full h-11 px-3 rounded-xl bg-surface-container-low font-body-sm text-body-sm text-on-surface focus:outline-none" type="date" value="2025-11-28">
                    </div>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-space-md">
                    <div class="space-y-1.5">
                        <label class="block font-label-sm text-label-sm font-semibold text-on-surface">Chỉ tiêu thu nạp (Đơn vị máu)</label>
                        <input class="w-full h-11 px-3 rounded-xl bg-surface-container-low font-body-sm text-body-sm text-on-surface focus:outline-none" placeholder="200" type="number" value="250">
                    </div>
                    <div class="space-y-1.5">
                        <label class="block font-label-sm text-label-sm font-semibold text-on-surface">Nhóm máu ưu tiên cấp cứu</label>
                        <input class="w-full h-11 px-3 rounded-xl bg-surface-container-low font-body-sm text-body-sm text-on-surface focus:outline-none" placeholder="O+, B+, A-" type="text" value="O+, B+ (Khẩn)">
                    </div>
                </div>
                <div class="space-y-1.5">
                    <label class="block font-label-sm text-label-sm font-semibold text-on-surface">Địa điểm tổ chức &amp; Bố trí tiếp nhận</label>
                    <input class="w-full h-11 px-3 rounded-xl bg-surface-container-low font-body-sm text-body-sm text-on-surface focus:outline-none" placeholder="Ví dụ: Sảnh Tòa A, Đại học Quốc Gia Hà Nội" type="text">
                </div>
            </div>
            <div class="p-space-lg bg-surface-container-low flex items-center justify-end gap-3">
                <button class="px-4 py-2 rounded-xl bg-surface-container hover:bg-surface-container-high text-on-surface font-label-md text-label-md" onclick="document.getElementById('newCampaignModal').classList.add('hidden')" type="button">
                    Đóng
                </button>
                <button class="px-5 py-2 rounded-xl bg-primary hover:bg-primary-container text-on-primary font-label-md text-label-md font-bold shadow-md" onclick="document.getElementById('newCampaignModal').classList.add('hidden'); showToast('Đã khởi tạo thành công đợt hiến máu mới!')" type="button">
                    Lưu &amp; Kích Hoạt Tiếp Nhận
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function scrollToApprovalTable() {
            const section = document.getElementById('approvalSection');
            if (section) {
                section.scrollIntoView({ behavior: 'smooth' });
            }
        }

        function openApprovalModal(code, name, group, weight, lastTime) {
            document.getElementById('modalTicketCode').innerText = code;
            document.getElementById('modalDonorName').innerText = name;
            document.getElementById('modalDonorStats').innerText = group + ' • ' + weight;
            document.getElementById('approvalModal').classList.remove('hidden');
        }

        function closeApprovalModal() {
            document.getElementById('approvalModal').classList.add('hidden');
        }

        function confirmApproval() {
            closeApprovalModal();
            showToast('Đã duyệt thành công hồ sơ #VTL-08991. Thẻ QR đã được gửi SMS tới TNV!');
        }

        function openRejectModal(code, name, reason) {
            document.getElementById('rejectTicketCode').innerText = code;
            document.getElementById('rejectDonorName').innerText = name;
            if (reason) {
                document.getElementById('rejectReasonSelect').value = reason;
            }
            document.getElementById('rejectModal').classList.remove('hidden');
        }

        function closeRejectModal() {
            document.getElementById('rejectModal').classList.add('hidden');
        }

        function confirmReject() {
            closeRejectModal();
            showToast('Đã cập nhật từ chối hồ sơ kèm lý do chuyên môn và gửi thông báo cho người hiến.');
        }

        function batchApprove() {
            showToast('Đã tự động phê duyệt hàng loạt các hồ sơ đủ 10/10 điều kiện y tế!');
        }

        function showToast(message) {
            const toast = document.getElementById('toastNotification');
            if (toast) {
                toast.querySelector('p').innerText = message;
                toast.style.display = 'flex';
                toast.classList.remove('opacity-0');
                toast.classList.add('opacity-100');
                setTimeout(() => {
                    toast.classList.remove('opacity-100');
                    toast.classList.add('opacity-0');
                    setTimeout(() => { toast.style.display = 'none'; }, 300);
                }, 4000);
            }
        }

        // Checkbox select all handling
        const selectAll = document.getElementById('selectAllCheckbox');
        if (selectAll) {
            selectAll.addEventListener('change', function() {
                const countSpan = document.getElementById('selectedCount');
                if (this.checked) {
                    countSpan.innerText = '24';
                } else {
                    countSpan.innerText = '0';
                }
            });
        }
    </script>
}
