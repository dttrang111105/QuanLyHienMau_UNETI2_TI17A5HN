@* // Họ và tên: Nguyễn Tiến Nam
// Mã sinh viên: 23103100275
// Nội dung thực hiện: Quản lí đơn vị tổ chức hiến máu
// Thiết kế giao diện *@

@model IEnumerable<QuanLyHienMau_UNETI2_TI17A5HN.Models.DonViToChuc>

@{
    ViewData["Title"] = "Quản lý đơn vị tổ chức & Điểm hiến máu lưu động";
    Layout = "_AdminLayout";
    var currentSearch = ViewBag.CurrentSearch as string;
    var currentStatus = ViewBag.CurrentStatus as string;
    var totalCount = Model?.Count() ?? 0;
    var activeCount = Model?.Count(d => d.TrangThai == "Hoạt động") ?? 0;
    var inactiveCount = totalCount - activeCount;
}

<div class="p-space-lg space-y-space-lg max-w-[1600px] mx-auto w-full">
    <!-- Notifications -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="p-4 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 flex items-center justify-between">
            <div class="flex items-center gap-2">
                <span class="material-symbols-outlined text-emerald-600">check_circle</span>
                <span class="font-body-md text-body-md font-medium">@TempData["SuccessMessage"]</span>
            </div>
            <button onclick="this.parentElement.remove()" class="text-emerald-600 hover:text-emerald-900"><span class="material-symbols-outlined">close</span></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="p-4 rounded-xl bg-error-container/40 border border-error text-error flex items-center justify-between">
            <div class="flex items-center gap-2">
                <span class="material-symbols-outlined text-error">error</span>
                <span class="font-body-md text-body-md font-medium">@TempData["ErrorMessage"]</span>
            </div>
            <button onclick="this.parentElement.remove()" class="text-error hover:text-red-900"><span class="material-symbols-outlined">close</span></button>
        </div>
    }

    <!-- 1. Page Header & Medical Breadcrumb & Actions -->
    <div class="flex flex-col xl:flex-row xl:items-center justify-between gap-space-md">
        <div class="space-y-1">
            <nav class="flex items-center gap-2 font-label-sm text-label-sm text-on-surface-variant">
                <a asp-controller="Admin" asp-action="Dashboard" class="hover:text-primary transition-colors">Hệ thống Quản trị Y tế</a>
                <span class="material-symbols-outlined text-[14px]">chevron_right</span>
                <span class="text-on-surface-variant">Đối tác &amp; Dữ liệu</span>
                <span class="material-symbols-outlined text-[14px]">chevron_right</span>
                <span class="text-primary font-semibold">Đơn vị tổ chức &amp; Điểm lưu động</span>
            </nav>
            <div class="flex items-center gap-3">
                <h1 class="font-headline-lg text-headline-lg text-on-surface tracking-tight">Quản Lý Đơn Vị Tổ Chức &amp; Điểm Hiến Máu Lưu Động</h1>
                <span class="px-2.5 py-1 rounded-full bg-primary-fixed text-primary font-label-sm text-label-sm font-bold flex items-center gap-1">
                    <span class="w-2 h-2 rounded-full bg-primary animate-ping"></span>
                    Khu Vực Phía Bắc
                </span>
            </div>
            <p class="font-body-md text-body-md text-on-surface-variant max-w-4xl">
                Điều phối các đơn vị đối tác liên kết, điểm lấy máu cố định/ngoại viện của hệ thống Đại học UNETI.
            </p>
        </div>
        <div class="flex flex-wrap items-center gap-3">
            <button class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-primary text-on-primary font-label-md text-label-md shadow-md shadow-primary/20 hover:bg-primary-container transition-all cursor-pointer" type="button" onclick="openCreateModal()">
                <span class="material-symbols-outlined text-[18px]">add_business</span>
                <span>+ Thêm Đơn Vị Đối Tác Mới</span>
            </button>
        </div>
    </div>

    <!-- 2. Top Metric Cards (4 Cards) -->
    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-space-md">
        <!-- Metric 1 -->
        <div class="bg-surface-container-lowest p-space-md rounded-2xl shadow-sm flex flex-col justify-between relative overflow-hidden group">
            <div class="absolute right-0 top-0 w-24 h-24 bg-gradient-to-bl from-primary/10 via-transparent to-transparent rounded-bl-full pointer-events-none"></div>
            <div class="flex items-start justify-between">
                <div>
                    <p class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider">Tổng đối tác liên kết</p>
                    <h3 class="font-display-hero text-display-hero text-on-surface mt-1 leading-none font-bold">@totalCount <span class="font-title-md text-title-md font-medium text-on-surface-variant">Đơn vị</span></h3>
                </div>
                <div class="w-12 h-12 rounded-xl bg-primary/10 text-primary flex items-center justify-center">
                    <span class="material-symbols-outlined text-[24px]">corporate_fare</span>
                </div>
            </div>
            <div class="pt-4 flex items-center justify-between text-on-surface-variant">
                <div class="flex items-center gap-1.5 font-label-sm text-label-sm text-primary font-semibold">
                    <span class="material-symbols-outlined text-[16px]">trending_up</span>
                    <span>Đang quản lý</span>
                </div>
                <span class="font-label-sm text-label-sm">UNETI &amp; Đối tác Y tế</span>
            </div>
        </div>

        <!-- Metric 2 -->
        <div class="bg-surface-container-lowest p-space-md rounded-2xl shadow-sm flex flex-col justify-between relative overflow-hidden group">
            <div class="absolute right-0 top-0 w-24 h-24 bg-gradient-to-bl from-emerald-500/10 via-transparent to-transparent rounded-bl-full pointer-events-none"></div>
            <div class="flex items-start justify-between">
                <div>
                    <p class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider">Đơn vị đang hoạt động</p>
                    <h3 class="font-display-hero text-display-hero text-on-surface mt-1 leading-none font-bold">@activeCount <span class="font-title-md text-title-md font-medium text-on-surface-variant">Đơn vị</span></h3>
                </div>
                <div class="w-12 h-12 rounded-xl bg-emerald-100 text-emerald-700 flex items-center justify-center">
                    <span class="material-symbols-outlined text-[24px]">verified</span>
                </div>
            </div>
            <div class="pt-4 flex items-center justify-between">
                <div class="flex items-center gap-1.5 px-2 py-0.5 rounded-full bg-emerald-50 text-emerald-700 font-label-sm text-label-sm font-semibold">
                    <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                    <span>Hoạt động bình thường</span>
                </div>
                <span class="font-label-sm text-label-sm text-on-surface-variant">Sẵn sàng điều phối</span>
            </div>
        </div>

        <!-- Metric 3 -->
        <div class="bg-surface-container-lowest p-space-md rounded-2xl shadow-sm flex flex-col justify-between relative overflow-hidden group">
            <div class="absolute right-0 top-0 w-24 h-24 bg-gradient-to-bl from-blue-500/10 via-transparent to-transparent rounded-bl-full pointer-events-none"></div>
            <div class="flex items-start justify-between">
                <div>
                    <p class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider">Tổng đợt hiến máu</p>
                    <h3 class="font-display-hero text-display-hero text-on-surface mt-1 leading-none font-bold">@(Model?.Sum(d => d.DotHienMaus?.Count ?? 0) ?? 0) <span class="font-title-md text-title-md font-medium text-on-surface-variant">Đợt</span></h3>
                </div>
                <div class="w-12 h-12 rounded-xl bg-blue-100 text-blue-700 flex items-center justify-center">
                    <span class="material-symbols-outlined text-[24px]">event_note</span>
                </div>
            </div>
            <div class="pt-4 flex items-center justify-between">
                <span class="font-label-sm text-label-sm text-on-surface-variant">Toàn hệ thống</span>
                <span class="px-2 py-0.5 rounded bg-surface-container text-on-surface font-label-sm text-label-sm font-medium">Chiến dịch UNETI</span>
            </div>
        </div>

        <!-- Metric 4 -->
        <div class="bg-surface-container-lowest p-space-md rounded-2xl shadow-sm flex flex-col justify-between relative overflow-hidden group">
            <div class="absolute right-0 top-0 w-24 h-24 bg-gradient-to-bl from-primary/10 via-transparent to-transparent rounded-bl-full pointer-events-none"></div>
            <div class="flex items-start justify-between">
                <div>
                    <p class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider">Trạng thái tạm dừng</p>
                    <h3 class="font-display-hero text-display-hero text-primary mt-1 leading-none font-bold">@inactiveCount <span class="font-title-md text-title-md font-medium text-on-surface-variant">Đơn vị</span></h3>
                </div>
                <div class="w-12 h-12 rounded-xl bg-primary-fixed text-primary flex items-center justify-center">
                    <span class="material-symbols-outlined text-[24px]">pause_circle</span>
                </div>
            </div>
            <div class="pt-4 flex items-center justify-between">
                <span class="font-label-sm text-label-sm text-on-surface-variant">Đang bảo trì / cập nhật</span>
                <span class="font-label-sm text-label-sm font-bold text-on-surface">SQL Server Live</span>
            </div>
        </div>
    </div>

    <!-- 5. Partner Organizations Directory & Tiered Management Table -->
    <div class="bg-surface-container-lowest rounded-2xl shadow-sm p-space-lg space-y-space-md">
        <!-- Table Header & Controls -->
        <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-space-md">
            <div>
                <div class="flex items-center gap-3">
                    <h2 class="font-headline-sm text-headline-sm text-on-surface">Danh Mục Đơn Vị Tổ Chức</h2>
                    <span class="px-2.5 py-0.5 rounded-full bg-primary/10 text-primary font-label-sm text-label-sm font-bold">@totalCount Đơn Vị</span>
                </div>
                <p class="font-body-sm text-body-sm text-on-surface-variant">Dữ liệu đơn vị tổ chức được truy xuất trực tiếp từ cơ sở dữ liệu</p>
            </div>
            <!-- Filter buttons -->
            <div class="flex flex-wrap items-center gap-2">
                <a asp-action="DonViToChuc" asp-route-status="all" class="px-3.5 py-2 rounded-xl @(string.IsNullOrEmpty(currentStatus) || currentStatus == "all" ? "bg-primary text-on-primary font-semibold" : "bg-surface-container text-on-surface hover:bg-surface-container-high") font-label-md text-label-md transition-all">Tất cả (@totalCount)</a>
                <a asp-action="DonViToChuc" asp-route-status="Hoạt động" class="px-3.5 py-2 rounded-xl @(currentStatus == "Hoạt động" ? "bg-primary text-on-primary font-semibold" : "bg-surface-container text-on-surface hover:bg-surface-container-high") font-label-md text-label-md transition-all">Hoạt động (@activeCount)</a>
                <a asp-action="DonViToChuc" asp-route-status="Tạm dừng" class="px-3.5 py-2 rounded-xl @(currentStatus == "Tạm dừng" ? "bg-primary text-on-primary font-semibold" : "bg-surface-container text-on-surface hover:bg-surface-container-high") font-label-md text-label-md transition-all">Tạm dừng (@inactiveCount)</a>
            </div>
        </div>

        <!-- Advanced Search and Selector Bar -->
        <form method="get" asp-controller="Admin" asp-action="DonViToChuc" class="grid grid-cols-1 md:grid-cols-4 gap-3 bg-surface-container-low p-3 rounded-xl">
            <div class="relative md:col-span-3">
                <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant text-[20px]">search</span>
                <input name="search" value="@currentSearch" class="w-full h-10 pl-10 pr-4 bg-surface-container-lowest rounded-xl font-body-sm text-body-sm text-on-surface placeholder:text-on-surface-variant/70 focus:outline-none focus:ring-2 focus:ring-primary/20 transition-all shadow-xs" placeholder="Tìm kiếm tên đơn vị, email liên hệ, mô tả..." type="text">
            </div>
            <div class="flex gap-2">
                <select name="status" onchange="this.form.submit()" class="w-full h-10 px-3 bg-surface-container-lowest rounded-xl font-body-sm text-body-sm text-on-surface focus:outline-none focus:ring-2 focus:ring-primary/20 shadow-xs">
                    <option value="all" selected="@(string.IsNullOrEmpty(currentStatus) || currentStatus == "all")">Tất cả trạng thái</option>
                    <option value="Hoạt động" selected="@(currentStatus == "Hoạt động")">Hoạt động</option>
                    <option value="Tạm dừng" selected="@(currentStatus == "Tạm dừng")">Tạm dừng</option>
                </select>
                <button type="submit" class="px-4 h-10 rounded-xl bg-primary text-on-primary font-label-md text-label-md hover:bg-primary-container transition-all shrink-0 cursor-pointer">
                    Tìm
                </button>
            </div>
        </form>

        <!-- Table Section -->
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-surface-container font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider">
                        <th class="py-3 px-4 rounded-l-xl">Mã &amp; Đơn Vị Tổ Chức</th>
                        <th class="py-3 px-4">Email Liên Hệ</th>
                        <th class="py-3 px-4">Mô Tả / Địa Điểm</th>
                        <th class="py-3 px-4">Số Đợt Hiến Máu</th>
                        <th class="py-3 px-4">Trạng Thái</th>
                        <th class="py-3 px-4 text-right rounded-r-xl">Thao Tác</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-surface-container font-body-sm text-body-sm text-on-surface">
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            var initials = string.Join("", item.TenDonViToChuc.Split(' ', StringSplitOptions.RemoveEmptyEntries).Select(w => w[0])).ToUpper();
                            if (initials.Length > 2) { initials = initials.Substring(0, 2); }

                            <tr class="hover:bg-surface-container-low/60 transition-colors">
                                <td class="py-4 px-4">
                                    <div class="flex items-center gap-3">
                                        <div class="w-10 h-10 rounded-xl bg-primary/10 text-primary flex items-center justify-center font-headline-sm font-bold shrink-0">
                                            @initials
                                        </div>
                                        <div>
                                            <div class="flex items-center gap-2">
                                                <span class="font-label-md text-label-md font-bold text-on-surface">@item.TenDonViToChuc</span>
                                                <span class="px-2 py-0.5 rounded-full bg-surface-container text-on-surface-variant font-label-sm text-[10px]">#@item.MaDonViToChuc</span>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                                <td class="py-4 px-4">
                                    <div class="flex items-center gap-1.5 text-on-surface font-body-sm">
                                        <span class="material-symbols-outlined text-[16px] text-primary">email</span>
                                        <span>@(string.IsNullOrEmpty(item.EmailLienHe) ? "Chưa cập nhật" : item.EmailLienHe)</span>
                                    </div>
                                </td>
                                <td class="py-4 px-4 max-w-xs">
                                    <p class="line-clamp-2 text-on-surface-variant text-[13px]">
                                        @(string.IsNullOrEmpty(item.MoTa) ? "Chưa có mô tả" : item.MoTa)
                                    </p>
                                </td>
                                <td class="py-4 px-4">
                                    <div class="font-label-md text-label-md font-bold text-primary">@(item.DotHienMaus?.Count ?? 0) Đợt</div>
                                </td>
                                <td class="py-4 px-4">
                                    @if (item.TrangThai == "Hoạt động")
                                    {
                                        <span class="px-2.5 py-1 rounded-full bg-emerald-100 text-emerald-800 font-label-sm text-[11px] font-bold flex items-center gap-1 w-fit">
                                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                                            Hoạt Động
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="px-2.5 py-1 rounded-full bg-gray-100 text-gray-700 font-label-sm text-[11px] font-bold flex items-center gap-1 w-fit">
                                            <span class="w-1.5 h-1.5 rounded-full bg-gray-400"></span>
                                            Tạm Dừng
                                        </span>
                                    }
                                </td>
                                <td class="py-4 px-4 text-right">
                                    <div class="flex items-center justify-end gap-1">
                                        <button class="p-2 text-on-surface-variant hover:text-primary hover:bg-surface-container rounded-lg transition-colors cursor-pointer" title="Chỉnh sửa đơn vị" type="button" onclick='openEditModal(@item.MaDonViToChuc, @Html.Raw(System.Text.Json.JsonSerializer.Serialize(item.TenDonViToChuc)), @Html.Raw(System.Text.Json.JsonSerializer.Serialize(item.MoTa ?? "")), @Html.Raw(System.Text.Json.JsonSerializer.Serialize(item.EmailLienHe ?? "")), @Html.Raw(System.Text.Json.JsonSerializer.Serialize(item.TrangThai ?? "Hoạt động")))'>
                                            <span class="material-symbols-outlined text-[18px]">edit</span>
                                        </button>
                                        <button class="p-2 text-on-surface-variant hover:text-error hover:bg-surface-container rounded-lg transition-colors cursor-pointer" title="Xóa đơn vị" type="button" onclick='openDeleteModal(@item.MaDonViToChuc, @Html.Raw(System.Text.Json.JsonSerializer.Serialize(item.TenDonViToChuc)))'>
                                            <span class="material-symbols-outlined text-[18px]">delete</span>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-8 text-on-surface-variant">
                                <span class="material-symbols-outlined text-[32px] text-outline mb-2">inbox</span>
                                <p>Không tìm thấy đơn vị tổ chức nào phù hợp.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination & Table Footer -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-space-sm pt-space-sm border-t border-surface-container">
            <p class="font-body-sm text-body-sm text-on-surface-variant">
                Hiển thị <strong class="text-on-surface font-semibold">@totalCount</strong> đơn vị tổ chức
            </p>
        </div>
    </div>
</div>

<!-- Modal Thêm Mới Đơn Vị Tổ Chức -->
<div id="createModal" class="fixed inset-0 bg-black/50 z-50 hidden flex items-center justify-center p-4">
    <div class="bg-surface-container-lowest rounded-2xl max-w-lg w-full p-6 shadow-2xl space-y-4">
        <div class="flex items-center justify-between border-b border-surface-container pb-3">
            <h3 class="font-headline-sm text-headline-sm font-bold text-on-surface flex items-center gap-2">
                <span class="material-symbols-outlined text-primary">add_business</span>
                Thêm Đơn Vị Tổ Chức Mới
            </h3>
            <button onclick="closeCreateModal()" class="text-on-surface-variant hover:text-on-surface cursor-pointer"><span class="material-symbols-outlined">close</span></button>
        </div>
        <form method="post" asp-controller="Admin" asp-action="CreateDonViToChuc" class="space-y-4" onsubmit="return validateCreateForm()">
            @Html.AntiForgeryToken()
            <div>
                <label class="font-label-md text-label-md text-on-surface block mb-1">Tên Đơn Vị Tổ Chức <span class="text-error">*</span></label>
                <input id="create_ten" name="TenDonViToChuc" required class="w-full h-11 px-3.5 bg-surface-container-low text-on-surface rounded-xl border border-surface-container focus:outline-none focus:ring-2 focus:ring-primary/20 transition-colors" placeholder="VD: Đoàn Thanh Niên UNETI" oninput="validateCreateName()" onblur="checkDuplicateCreateName()" />
                <p id="create_ten_error" class="hidden mt-1.5 text-error text-xs font-medium flex items-center gap-1">
                    <span class="material-symbols-outlined text-[14px]">error</span>
                    <span id="create_ten_error_text"></span>
                </p>
            </div>
            <div>
                <label class="font-label-md text-label-md text-on-surface block mb-1">Email Liên Hệ</label>
                <input id="create_email" name="EmailLienHe" type="email" class="w-full h-11 px-3.5 bg-surface-container-low text-on-surface rounded-xl border border-surface-container focus:outline-none focus:ring-2 focus:ring-primary/20 transition-colors" placeholder="VD: doanthanhnien@uneti.edu.vn" oninput="validateCreateEmail()" onblur="validateCreateEmail()" />
                <p id="create_email_error" class="hidden mt-1.5 text-error text-xs font-medium flex items-center gap-1">
                    <span class="material-symbols-outlined text-[14px]">error</span>
                    <span id="create_email_error_text"></span>
                </p>
            </div>
            <div>
                <label class="font-label-md text-label-md text-on-surface block mb-1">Trạng Thái</label>
                <select name="TrangThai" class="w-full h-11 px-3.5 bg-surface-container-low text-on-surface rounded-xl border border-surface-container focus:outline-none focus:ring-2 focus:ring-primary/20">
                    <option value="Hoạt động">Hoạt động</option>
                    <option value="Tạm dừng">Tạm dừng</option>
                </select>
            </div>
            <div>
                <label class="font-label-md text-label-md text-on-surface block mb-1">Mô Tả / Địa Chỉ</label>
                <textarea name="MoTa" rows="3" class="w-full p-3 bg-surface-container-low text-on-surface rounded-xl border border-surface-container focus:outline-none focus:ring-2 focus:ring-primary/20" placeholder="Thông tin chi tiết về đơn vị, địa chỉ tổ chức..."></textarea>
            </div>
            <div class="flex items-center justify-end gap-3 pt-3 border-t border-surface-container">
                <button type="button" onclick="closeCreateModal()" class="px-4 py-2.5 rounded-xl bg-surface-container text-on-surface font-label-md text-label-md hover:bg-surface-container-high transition-all cursor-pointer">Hủy</button>
                <button id="create_submit_btn" type="submit" class="px-5 py-2.5 rounded-xl bg-primary text-on-primary font-label-md text-label-md font-bold hover:bg-primary-container transition-all cursor-pointer">Lưu Đơn Vị</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal Chỉnh Sửa Đơn Vị Tổ Chức -->
<div id="editModal" class="fixed inset-0 bg-black/50 z-50 hidden flex items-center justify-center p-4">
    <div class="bg-surface-container-lowest rounded-2xl max-w-lg w-full p-6 shadow-2xl space-y-4">
        <div class="flex items-center justify-between border-b border-surface-container pb-3">
            <h3 class="font-headline-sm text-headline-sm font-bold text-on-surface flex items-center gap-2">
                <span class="material-symbols-outlined text-primary">edit_note</span>
                Chỉnh Sửa Đơn Vị Tổ Chức
            </h3>
            <button onclick="closeEditModal()" class="text-on-surface-variant hover:text-on-surface cursor-pointer"><span class="material-symbols-outlined">close</span></button>
        </div>
        <form method="post" asp-controller="Admin" asp-action="EditDonViToChuc" class="space-y-4" onsubmit="return validateEditForm()">
            @Html.AntiForgeryToken()
            <input type="hidden" id="edit_id" name="MaDonViToChuc" />
            <input type="hidden" id="edit_id_param" name="id" />
            <div>
                <label class="font-label-md text-label-md text-on-surface block mb-1">Tên Đơn Vị Tổ Chức <span class="text-error">*</span></label>
                <input id="edit_ten" name="TenDonViToChuc" required class="w-full h-11 px-3.5 bg-surface-container-low text-on-surface rounded-xl border border-surface-container focus:outline-none focus:ring-2 focus:ring-primary/20 transition-colors" oninput="validateEditName()" onblur="checkDuplicateEditName()" />
                <p id="edit_ten_error" class="hidden mt-1.5 text-error text-xs font-medium flex items-center gap-1">
                    <span class="material-symbols-outlined text-[14px]">error</span>
                    <span id="edit_ten_error_text"></span>
                </p>
            </div>
            <div>
                <label class="font-label-md text-label-md text-on-surface block mb-1">Email Liên Hệ</label>
                <input id="edit_email" name="EmailLienHe" type="email" class="w-full h-11 px-3.5 bg-surface-container-low text-on-surface rounded-xl border border-surface-container focus:outline-none focus:ring-2 focus:ring-primary/20 transition-colors" oninput="validateEditEmail()" onblur="validateEditEmail()" />
                <p id="edit_email_error" class="hidden mt-1.5 text-error text-xs font-medium flex items-center gap-1">
                    <span class="material-symbols-outlined text-[14px]">error</span>
                    <span id="edit_email_error_text"></span>
                </p>
            </div>
            <div>
                <label class="font-label-md text-label-md text-on-surface block mb-1">Trạng Thái</label>
                <select id="edit_trangthai" name="TrangThai" class="w-full h-11 px-3.5 bg-surface-container-low text-on-surface rounded-xl border border-surface-container focus:outline-none focus:ring-2 focus:ring-primary/20">
                    <option value="Hoạt động">Hoạt động</option>
                    <option value="Tạm dừng">Tạm dừng</option>
                </select>
            </div>
            <div>
                <label class="font-label-md text-label-md text-on-surface block mb-1">Mô Tả / Địa Chỉ</label>
                <textarea id="edit_mota" name="MoTa" rows="3" class="w-full p-3 bg-surface-container-low text-on-surface rounded-xl border border-surface-container focus:outline-none focus:ring-2 focus:ring-primary/20"></textarea>
            </div>
            <div class="flex items-center justify-end gap-3 pt-3 border-t border-surface-container">
                <button type="button" onclick="closeEditModal()" class="px-4 py-2.5 rounded-xl bg-surface-container text-on-surface font-label-md text-label-md hover:bg-surface-container-high transition-all cursor-pointer">Hủy</button>
                <button id="edit_submit_btn" type="submit" class="px-5 py-2.5 rounded-xl bg-primary text-on-primary font-label-md text-label-md font-bold hover:bg-primary-container transition-all cursor-pointer">Cập Nhật</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal Xóa Đơn Vị Tổ Chức -->
<div id="deleteModal" class="fixed inset-0 bg-black/50 z-50 hidden flex items-center justify-center p-4">
    <div class="bg-surface-container-lowest rounded-2xl max-w-md w-full p-6 shadow-2xl space-y-4">
        <div class="flex items-center gap-3 text-error">
            <span class="material-symbols-outlined text-[32px]">warning</span>
            <h3 class="font-headline-sm text-headline-sm font-bold text-on-surface">Xác Nhận Xóa Đơn Vị</h3>
        </div>
        <p class="font-body-md text-body-md text-on-surface-variant">
            Bạn có chắc chắn muốn xóa đơn vị <strong id="delete_name" class="text-on-surface font-semibold"></strong> khỏi hệ thống?
        </p>
        <p class="font-body-sm text-[12px] text-error">Lưu ý: Không thể xóa đơn vị nếu đang có đợt hiến máu liên kết.</p>
        <form method="post" asp-controller="Admin" asp-action="DeleteDonViToChuc" class="flex items-center justify-end gap-3 pt-3 border-t border-surface-container">
            @Html.AntiForgeryToken()
            <input type="hidden" id="delete_id" name="id" />
            <button type="button" onclick="closeDeleteModal()" class="px-4 py-2.5 rounded-xl bg-surface-container text-on-surface font-label-md text-label-md hover:bg-surface-container-high transition-all">Hủy</button>
            <button type="submit" class="px-5 py-2.5 rounded-xl bg-error text-on-error font-label-md text-label-md font-bold hover:bg-red-700 transition-all">Xóa Đơn Vị</button>
        </form>
    </div>
</div>

<script>
    // ========== Trạng thái validation ==========
    let createNameValid = false;
    let createNameDuplicate = false;
    let createEmailValid = true;
    let editNameValid = true;
    let editNameDuplicate = false;
    let editEmailValid = true;

    const emailRegex = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;
    const errorBorderClass = '!border-error !ring-error/20';
    const successBorderClass = '!border-emerald-500 !ring-emerald-500/20';

    // ========== Helper: show/hide error ==========
    function showFieldError(inputId, errorId, errorTextId, message) {
        const input = document.getElementById(inputId);
        const errorEl = document.getElementById(errorId);
        const errorTextEl = document.getElementById(errorTextId);
        if (input) { input.classList.add(...errorBorderClass.split(' ')); input.classList.remove(...successBorderClass.split(' ')); }
        if (errorEl) { errorEl.classList.remove('hidden'); }
        if (errorTextEl) { errorTextEl.textContent = message; }
    }

    function hideFieldError(inputId, errorId, showSuccess) {
        const input = document.getElementById(inputId);
        const errorEl = document.getElementById(errorId);
        if (input) {
            input.classList.remove(...errorBorderClass.split(' '));
            if (showSuccess && input.value.trim()) {
                input.classList.add(...successBorderClass.split(' '));
            } else {
                input.classList.remove(...successBorderClass.split(' '));
            }
        }
        if (errorEl) { errorEl.classList.add('hidden'); }
    }

    // ========== VALIDATE CREATE FORM ==========
    function validateCreateName() {
        const val = document.getElementById('create_ten').value.trim();
        if (!val) {
            showFieldError('create_ten', 'create_ten_error', 'create_ten_error_text', 'Tên đơn vị tổ chức không được để trống.');
            createNameValid = false;
            createNameDuplicate = false;
        } else {
            hideFieldError('create_ten', 'create_ten_error', !createNameDuplicate);
            createNameValid = true;
        }
    }

    let createNameTimer = null;
    function checkDuplicateCreateName() {
        const val = document.getElementById('create_ten').value.trim();
        if (!val) { createNameDuplicate = false; return; }
        clearTimeout(createNameTimer);
        createNameTimer = setTimeout(() => {
            fetch('/Admin/CheckDuplicateDonViToChuc?ten=' + encodeURIComponent(val))
                .then(r => r.json())
                .then(data => {
                    createNameDuplicate = data.isDuplicate;
                    if (data.isDuplicate) {
                        showFieldError('create_ten', 'create_ten_error', 'create_ten_error_text', 'Tên đơn vị "' + val + '" đã tồn tại.');
                    } else if (val) {
                        hideFieldError('create_ten', 'create_ten_error', true);
                    }
                })
                .catch(() => { createNameDuplicate = false; });
        }, 300);
    }

    function validateCreateEmail() {
        const val = document.getElementById('create_email').value.trim();
        if (!val) {
            hideFieldError('create_email', 'create_email_error', false);
            createEmailValid = true;
            return;
        }
        if (!emailRegex.test(val)) {
            showFieldError('create_email', 'create_email_error', 'create_email_error_text', 'Địa chỉ email không đúng định dạng. VD: example@domain.com');
            createEmailValid = false;
        } else {
            hideFieldError('create_email', 'create_email_error', true);
            createEmailValid = true;
        }
    }

    function validateCreateForm() {
        validateCreateName();
        validateCreateEmail();

        const nameVal = document.getElementById('create_ten').value.trim();
        if (!nameVal) {
            showFieldError('create_ten', 'create_ten_error', 'create_ten_error_text', 'Tên đơn vị tổ chức không được để trống.');
            document.getElementById('create_ten').focus();
            return false;
        }
        if (createNameDuplicate) {
            showFieldError('create_ten', 'create_ten_error', 'create_ten_error_text', 'Tên đơn vị "' + nameVal + '" đã tồn tại.');
            document.getElementById('create_ten').focus();
            return false;
        }
        if (!createEmailValid) {
            document.getElementById('create_email').focus();
            return false;
        }
        return true;
    }

    // ========== VALIDATE EDIT FORM ==========
    function validateEditName() {
        const val = document.getElementById('edit_ten').value.trim();
        if (!val) {
            showFieldError('edit_ten', 'edit_ten_error', 'edit_ten_error_text', 'Tên đơn vị tổ chức không được để trống.');
            editNameValid = false;
            editNameDuplicate = false;
        } else {
            hideFieldError('edit_ten', 'edit_ten_error', !editNameDuplicate);
            editNameValid = true;
        }
    }

    let editNameTimer = null;
    function checkDuplicateEditName() {
        const val = document.getElementById('edit_ten').value.trim();
        const excludeId = document.getElementById('edit_id').value;
        if (!val) { editNameDuplicate = false; return; }
        clearTimeout(editNameTimer);
        editNameTimer = setTimeout(() => {
            fetch('/Admin/CheckDuplicateDonViToChuc?ten=' + encodeURIComponent(val) + '&excludeId=' + excludeId)
                .then(r => r.json())
                .then(data => {
                    editNameDuplicate = data.isDuplicate;
                    if (data.isDuplicate) {
                        showFieldError('edit_ten', 'edit_ten_error', 'edit_ten_error_text', 'Tên đơn vị "' + val + '" đã tồn tại.');
                    } else if (val) {
                        hideFieldError('edit_ten', 'edit_ten_error', true);
                    }
                })
                .catch(() => { editNameDuplicate = false; });
        }, 300);
    }

    function validateEditEmail() {
        const val = document.getElementById('edit_email').value.trim();
        if (!val) {
            hideFieldError('edit_email', 'edit_email_error', false);
            editEmailValid = true;
            return;
        }
        if (!emailRegex.test(val)) {
            showFieldError('edit_email', 'edit_email_error', 'edit_email_error_text', 'Địa chỉ email không đúng định dạng. VD: example@domain.com');
            editEmailValid = false;
        } else {
            hideFieldError('edit_email', 'edit_email_error', true);
            editEmailValid = true;
        }
    }

    function validateEditForm() {
        validateEditName();
        validateEditEmail();

        const nameVal = document.getElementById('edit_ten').value.trim();
        if (!nameVal) {
            showFieldError('edit_ten', 'edit_ten_error', 'edit_ten_error_text', 'Tên đơn vị tổ chức không được để trống.');
            document.getElementById('edit_ten').focus();
            return false;
        }
        if (editNameDuplicate) {
            showFieldError('edit_ten', 'edit_ten_error', 'edit_ten_error_text', 'Tên đơn vị "' + nameVal + '" đã tồn tại.');
            document.getElementById('edit_ten').focus();
            return false;
        }
        if (!editEmailValid) {
            document.getElementById('edit_email').focus();
            return false;
        }
        return true;
    }

    // ========== MODAL FUNCTIONS ==========
    function openCreateModal() {
        // Reset form và trạng thái validation
        const form = document.querySelector('#createModal form');
        if (form) form.reset();
        createNameValid = false;
        createNameDuplicate = false;
        createEmailValid = true;
        hideFieldError('create_ten', 'create_ten_error', false);
        hideFieldError('create_email', 'create_email_error', false);
        document.getElementById('createModal').classList.remove('hidden');
    }
    function closeCreateModal() {
        document.getElementById('createModal').classList.add('hidden');
    }

    function openEditModal(id, ten, mota, email, trangthai) {
        document.getElementById('edit_id').value = id;
        document.getElementById('edit_id_param').value = id;
        document.getElementById('edit_ten').value = ten || '';
        document.getElementById('edit_mota').value = mota || '';
        document.getElementById('edit_email').value = email || '';
        document.getElementById('edit_trangthai').value = trangthai || 'Hoạt động';
        // Reset trạng thái validation
        editNameValid = true;
        editNameDuplicate = false;
        editEmailValid = true;
        hideFieldError('edit_ten', 'edit_ten_error', false);
        hideFieldError('edit_email', 'edit_email_error', false);
        document.getElementById('editModal').classList.remove('hidden');
    }
    function closeEditModal() {
        document.getElementById('editModal').classList.add('hidden');
    }

    function openDeleteModal(id, ten) {
        document.getElementById('delete_id').value = id;
        document.getElementById('delete_name').textContent = ten;
        document.getElementById('deleteModal').classList.remove('hidden');
    }
    function closeDeleteModal() {
        document.getElementById('deleteModal').classList.add('hidden');
    }
</script>
