@{
    ViewData["Title"] = "Quản lý đơn vị tổ chức & Điểm hiến máu lưu động";
    Layout = "_AdminLayout";
}

<div class="p-space-lg space-y-space-lg max-w-[1600px] mx-auto w-full">
    <!-- 1. Page Header & Medical Breadcrumb & Actions -->
    <div class="flex flex-col xl:flex-row xl:items-center justify-between gap-space-md">
        <div class="space-y-1">
            <nav class="flex items-center gap-2 font-label-sm text-label-sm text-on-surface-variant">
                <a asp-controller="Admin" asp-action="Dashboard" class="hover:text-primary transition-colors">Hệ thống Quản trị Y tế</a>
                <span class="material-symbols-outlined text-[14px]">chevron_right</span>
                <span class="text-on-surface-variant">Đối tác &amp; Dữ liệu</span>
                <span class="material-symbols-outlined text-[14px]">chevron_right</span>
                <span class="text-primary font-semibold">Đơn vị tổ chức &amp; Điểm lưu động</span>
            </nav>
            <div class="flex items-center gap-3">
                <h1 class="font-headline-lg text-headline-lg text-on-surface tracking-tight">Quản Lý Đơn Vị Tổ Chức &amp; Điểm Hiến Máu Lưu Động</h1>
                <span class="px-2.5 py-1 rounded-full bg-primary-fixed text-primary font-label-sm text-label-sm font-bold flex items-center gap-1">
                    <span class="w-2 h-2 rounded-full bg-primary animate-ping"></span>
                    Khu Vực Phía Bắc
                </span>
            </div>
            <p class="font-body-md text-body-md text-on-surface-variant max-w-4xl">
                Điều phối 48 đơn vị đối tác liên kết, 14 điểm lấy máu cố định/ngoại viện và đội xe hiến máu chuyên dụng đạt chuẩn bảo quản lạnh ISBT 128.
            </p>
        </div>
        <div class="flex flex-wrap items-center gap-3">
            <button class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-surface-container-lowest text-on-surface shadow-sm hover:bg-surface-container-low transition-all font-label-md text-label-md" type="button" onclick="alert('Đang trích xuất báo cáo đối tác & điểm lưu động (Excel)...')">
                <span class="material-symbols-outlined text-[18px] text-on-surface-variant">file_download</span>
                <span>Xuất Báo Cáo (Excel)</span>
            </button>
            <button class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-surface-container text-primary font-label-md text-label-md hover:bg-primary-fixed transition-all" type="button" onclick="alert('Mở mô-đun lập kế hoạch điểm hiến máu lưu động.')">
                <span class="material-symbols-outlined text-[18px]">calendar_month</span>
                <span>Lập Kế Hoạch Đợt Lưu Động</span>
            </button>
            <button class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-primary text-on-primary font-label-md text-label-md shadow-md shadow-primary/20 hover:bg-primary-container transition-all" type="button" onclick="alert('Mở biểu mẫu tạo đơn vị đối tác liên kết mới.')">
                <span class="material-symbols-outlined text-[18px]">add_business</span>
                <span>+ Thêm Đơn Vị Đối Tác Mới</span>
            </button>
        </div>
    </div>

    <!-- 2. Top Metric Cards (4 Cards) -->
    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-space-md">
        <!-- Metric 1 -->
        <div class="bg-surface-container-lowest p-space-md rounded-2xl shadow-sm flex flex-col justify-between relative overflow-hidden group">
            <div class="absolute right-0 top-0 w-24 h-24 bg-gradient-to-bl from-primary/10 via-transparent to-transparent rounded-bl-full pointer-events-none"></div>
            <div class="flex items-start justify-between">
                <div>
                    <p class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider">Tổng đối tác liên kết</p>
                    <h3 class="font-display-hero text-display-hero text-on-surface mt-1 leading-none font-bold">48 <span class="font-title-md text-title-md font-medium text-on-surface-variant">Đơn vị</span></h3>
                </div>
                <div class="w-12 h-12 rounded-xl bg-primary/10 text-primary flex items-center justify-center">
                    <span class="material-symbols-outlined text-[24px]">corporate_fare</span>
                </div>
            </div>
            <div class="pt-4 flex items-center justify-between text-on-surface-variant">
                <div class="flex items-center gap-1.5 font-label-sm text-label-sm text-primary font-semibold">
                    <span class="material-symbols-outlined text-[16px]">trending_up</span>
                    <span>+4 đối tác quý này</span>
                </div>
                <span class="font-label-sm text-label-sm">22 ĐH • 16 KCN • 10 CQ</span>
            </div>
        </div>

        <!-- Metric 2 -->
        <div class="bg-surface-container-lowest p-space-md rounded-2xl shadow-sm flex flex-col justify-between relative overflow-hidden group">
            <div class="absolute right-0 top-0 w-24 h-24 bg-gradient-to-bl from-emerald-500/10 via-transparent to-transparent rounded-bl-full pointer-events-none"></div>
            <div class="flex items-start justify-between">
                <div>
                    <p class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider">Điểm hiến máu hoạt động</p>
                    <h3 class="font-display-hero text-display-hero text-on-surface mt-1 leading-none font-bold">08 <span class="font-title-md text-title-md font-medium text-on-surface-variant">Điểm trực tiếp</span></h3>
                </div>
                <div class="w-12 h-12 rounded-xl bg-emerald-100 text-emerald-700 flex items-center justify-center">
                    <span class="material-symbols-outlined text-[24px]">pin_drop</span>
                </div>
            </div>
            <div class="pt-4 flex items-center justify-between">
                <div class="flex items-center gap-1.5 px-2 py-0.5 rounded-full bg-emerald-50 text-emerald-700 font-label-sm text-label-sm font-semibold">
                    <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                    <span>Live Realtime</span>
                </div>
                <span class="font-label-sm text-label-sm text-on-surface-variant">03 Cố định • 05 Ngoại viện</span>
            </div>
        </div>

        <!-- Metric 3 -->
        <div class="bg-surface-container-lowest p-space-md rounded-2xl shadow-sm flex flex-col justify-between relative overflow-hidden group">
            <div class="absolute right-0 top-0 w-24 h-24 bg-gradient-to-bl from-blue-500/10 via-transparent to-transparent rounded-bl-full pointer-events-none"></div>
            <div class="flex items-start justify-between">
                <div>
                    <p class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider">Xe lấy máu chuyên dụng</p>
                    <h3 class="font-display-hero text-display-hero text-on-surface mt-1 leading-none font-bold">6 <span class="font-title-md text-title-md font-medium text-on-surface-variant">/ 8 Xe xuất kích</span></h3>
                </div>
                <div class="w-12 h-12 rounded-xl bg-blue-100 text-blue-700 flex items-center justify-center">
                    <span class="material-symbols-outlined text-[24px]">directions_bus</span>
                </div>
            </div>
            <div class="pt-4 flex items-center justify-between">
                <span class="font-label-sm text-label-sm text-on-surface-variant">2 xe bảo dưỡng kỹ thuật</span>
                <span class="px-2 py-0.5 rounded bg-surface-container text-on-surface font-label-sm text-label-sm font-medium">ISBT 128 Lạnh 2-6°C</span>
            </div>
        </div>

        <!-- Metric 4 -->
        <div class="bg-surface-container-lowest p-space-md rounded-2xl shadow-sm flex flex-col justify-between relative overflow-hidden group">
            <div class="absolute right-0 top-0 w-24 h-24 bg-gradient-to-bl from-primary/10 via-transparent to-transparent rounded-bl-full pointer-events-none"></div>
            <div class="flex items-start justify-between">
                <div>
                    <p class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider">Hiệu suất đạt chỉ tiêu ngày</p>
                    <h3 class="font-display-hero text-display-hero text-primary mt-1 leading-none font-bold">106.4%</h3>
                </div>
                <div class="w-12 h-12 rounded-xl bg-primary-fixed text-primary flex items-center justify-center">
                    <span class="material-symbols-outlined text-[24px]">bloodtype</span>
                </div>
            </div>
            <div class="pt-4 flex items-center justify-between">
                <div class="w-full bg-surface-container rounded-full h-2 mr-3 overflow-hidden">
                    <div class="bg-primary h-2 rounded-full" style="width: 86%;"></div>
                </div>
                <span class="font-label-sm text-label-sm font-bold text-on-surface shrink-0">1,942 / 1,825 ĐV</span>
            </div>
        </div>
    </div>

    <!-- 3. Split Layout: Interactive Tactical Map & Live Mobile Fleet -->
    <div class="grid grid-cols-1 xl:grid-cols-12 gap-space-lg">
        <!-- Map & Geolocation Radar (8 cols / ~66%) -->
        <div class="xl:col-span-8 bg-surface-container-lowest rounded-2xl p-space-lg shadow-sm flex flex-col">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-space-sm mb-space-md">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-primary text-on-primary flex items-center justify-center shadow-sm">
                        <span class="material-symbols-outlined text-[20px]">map</span>
                    </div>
                    <div>
                        <h2 class="font-headline-sm text-headline-sm text-on-surface">Bản Đồ Phân Bố &amp; Trạng Thái Điểm Hiến Máu Thời Gian Thực</h2>
                        <p class="font-body-sm text-body-sm text-on-surface-variant">Giám sát tải tiếp nhận máu, vị trí GPS đội xe cơ động và chỉ tiêu thực địa</p>
                    </div>
                </div>
                <!-- Quick Filters -->
                <div class="flex items-center gap-1.5 p-1 bg-surface-container rounded-xl overflow-x-auto text-nowrap">
                    <button class="px-3 py-1.5 rounded-lg bg-surface-container-lowest text-primary font-label-sm text-label-sm font-bold shadow-sm" type="button">Tất cả (14)</button>
                    <button class="px-3 py-1.5 rounded-lg text-on-surface-variant hover:text-on-surface font-label-sm text-label-sm" type="button">Đang lấy máu (5)</button>
                    <button class="px-3 py-1.5 rounded-lg text-on-surface-variant hover:text-on-surface font-label-sm text-label-sm" type="button">Chuẩn bị (3)</button>
                    <button class="px-3 py-1.5 rounded-lg text-on-surface-variant hover:text-on-surface font-label-sm text-label-sm" type="button">Cố định (3)</button>
                </div>
            </div>

            <!-- Custom Styled Tactical Geolocation Canvas -->
            <div class="relative w-full h-[460px] bg-slate-900 rounded-xl overflow-hidden shadow-inner flex items-center justify-center">
                <!-- Stylized Medical Grid / Vector map overlay -->
                <svg class="absolute inset-0 w-full h-full opacity-25" xmlns="http://www.w3.org/2000/svg">
                    <defs>
                        <pattern height="40" id="grid-pattern" patternUnits="userSpaceOnUse" width="40">
                            <path d="M 40 0 L 0 0 0 40" fill="none" stroke="#60a5fa" stroke-dasharray="2 4" stroke-width="0.5"></path>
                        </pattern>
                    </defs>
                    <rect fill="url(#grid-pattern)" height="100%" width="100%"></rect>
                    <!-- Simulated River / Arteries -->
                    <path d="M -50,150 Q 200,90 450,220 T 950,280 T 1400,200" fill="none" opacity="0.35" stroke="#38bdf8" stroke-width="6"></path>
                    <path d="M 120,460 Q 300,320 600,380 T 1200,420" fill="none" opacity="0.25" stroke="#38bdf8" stroke-width="3"></path>
                </svg>
                <!-- Real Map Location Reference Provider (Static API ready) -->
                <div class="absolute inset-0 opacity-20 pointer-events-none bg-cover bg-center" data-alt="Dark tinted satellite aerial medical navigation map of Hanoi showing roads and transit lines" data-location="Hanoi, Vietnam" style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuDRC8N552Um7TaOXpnB7DY-ZqxEV69SPFMlgYYNU007HocOCSkn2B4aeM1qlPO98hademav_Za7y0GWQnberP670zP74zSn3pdZfA2khCwKxslVyG4SYa-oSgZLmNI7tdZp1GWKgYA1rzfiMciZwM8ZEyadhqhBAGjfL3wPXAq-uh3j5VQxRJl5NULEcpEZVWu-1eTFXf3T7Kty8m1VH09IUdC3rYGHwSFtVqDP6MooHkMB_16T_ikNGg')"></div>
                <!-- Radar Pulsing Circle & HUD overlay -->
                <div class="absolute top-4 left-4 flex items-center gap-2 bg-inverse-surface/80 backdrop-blur-md px-3 py-1.5 rounded-lg text-inverse-on-surface font-label-sm text-label-sm border border-slate-700">
                    <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse"></span>
                    <span>Hệ Thống Viễn Thông Y Tế Tele-Blood: <strong class="text-white">Trực Tuyến</strong></span>
                </div>
                <div class="absolute top-4 right-4 flex items-center gap-2 bg-inverse-surface/80 backdrop-blur-md px-3 py-1.5 rounded-lg text-slate-300 font-label-sm text-label-sm border border-slate-700">
                    <span class="material-symbols-outlined text-[16px] text-amber-400">thermostat</span>
                    <span>Nhiệt độ bảo quản tb: <strong class="text-emerald-300">3.4°C</strong></span>
                </div>

                <!-- PIN 1: ĐH Bách Khoa Hà Nội (Active pulsing red) -->
                <div class="absolute top-[38%] left-[44%] -translate-x-1/2 -translate-y-1/2 group cursor-pointer z-20">
                    <div class="relative flex items-center justify-center">
                        <span class="animate-ping absolute inline-flex h-9 w-9 rounded-full bg-primary opacity-75"></span>
                        <div class="relative w-8 h-8 rounded-full bg-primary text-on-primary flex items-center justify-center shadow-lg border-2 border-white">
                            <span class="material-symbols-outlined text-[16px]">bloodtype</span>
                        </div>
                    </div>
                    <!-- Tooltip Card -->
                    <div class="absolute left-1/2 -translate-x-1/2 bottom-10 w-64 bg-inverse-surface text-inverse-on-surface p-3 rounded-xl shadow-xl text-left pointer-events-none group-hover:pointer-events-auto transition-all duration-200 opacity-95">
                        <div class="flex items-center justify-between mb-1">
                            <span class="font-label-sm text-label-sm text-primary-fixed uppercase font-bold">Điểm Ngoại Viện • Đang Lấy</span>
                            <span class="px-1.5 py-0.2 bg-emerald-500/20 text-emerald-300 rounded font-label-sm text-[10px]">Xe 02 &amp; 05</span>
                        </div>
                        <p class="font-label-md text-label-md font-bold text-white">ĐH Bách Khoa Hà Nội (Hội trường C2)</p>
                        <div class="mt-2 text-slate-300 font-body-sm text-body-sm space-y-1">
                            <div class="flex justify-between">
                                <span>Tiến độ thu:</span>
                                <span class="text-emerald-400 font-bold">342 / 450 ĐV (76%)</span>
                            </div>
                            <div class="w-full bg-slate-700 h-1.5 rounded-full overflow-hidden">
                                <div class="bg-emerald-400 h-1.5 rounded-full" style="width: 76%"></div>
                            </div>
                            <p class="font-label-sm text-[11px] text-slate-400 pt-1">Bác sĩ phụ trách: BS. Đỗ Thùy Trang</p>
                        </div>
                    </div>
                </div>

                <!-- PIN 2: KCN Thăng Long (Canon) -->
                <div class="absolute top-[22%] left-[68%] -translate-x-1/2 -translate-y-1/2 group cursor-pointer z-20">
                    <div class="relative flex items-center justify-center">
                        <span class="animate-ping absolute inline-flex h-9 w-9 rounded-full bg-primary opacity-75"></span>
                        <div class="relative w-8 h-8 rounded-full bg-primary text-on-primary flex items-center justify-center shadow-lg border-2 border-white">
                            <span class="material-symbols-outlined text-[16px]">factory</span>
                        </div>
                    </div>
                    <!-- Tooltip Card -->
                    <div class="absolute left-1/2 -translate-x-1/2 bottom-10 w-64 bg-inverse-surface text-inverse-on-surface p-3 rounded-xl shadow-xl text-left pointer-events-none group-hover:pointer-events-auto transition-all duration-200 opacity-95">
                        <div class="flex items-center justify-between mb-1">
                            <span class="font-label-sm text-label-sm text-primary-fixed uppercase font-bold">KCN Trọng Điểm</span>
                            <span class="px-1.5 py-0.2 bg-emerald-500/20 text-emerald-300 rounded font-label-sm text-[10px]">Xe 01 &amp; 03</span>
                        </div>
                        <p class="font-label-md text-label-md font-bold text-white">Canon Việt Nam (KCN Thăng Long)</p>
                        <div class="mt-2 text-slate-300 font-body-sm text-body-sm space-y-1">
                            <div class="flex justify-between">
                                <span>Tiến độ thu:</span>
                                <span class="text-emerald-400 font-bold">410 / 600 ĐV (68%)</span>
                            </div>
                            <div class="w-full bg-slate-700 h-1.5 rounded-full overflow-hidden">
                                <div class="bg-primary h-1.5 rounded-full" style="width: 68%"></div>
                            </div>
                            <p class="font-label-sm text-[11px] text-slate-400 pt-1">Bác sĩ phụ trách: BS. Lê Quốc Tuấn</p>
                        </div>
                    </div>
                </div>

                <!-- PIN 3: Điểm cố định Viện Huyết học TW (Green Anchor) -->
                <div class="absolute top-[52%] left-[32%] -translate-x-1/2 -translate-y-1/2 group cursor-pointer z-20">
                    <div class="relative flex items-center justify-center">
                        <div class="relative w-9 h-9 rounded-full bg-emerald-600 text-white flex items-center justify-center shadow-lg border-2 border-white">
                            <span class="material-symbols-outlined text-[18px]">local_hospital</span>
                        </div>
                    </div>
                    <div class="absolute left-1/2 -translate-x-1/2 bottom-11 w-60 bg-inverse-surface text-inverse-on-surface p-3 rounded-xl shadow-xl text-left pointer-events-none group-hover:pointer-events-auto transition-all duration-200 opacity-95">
                        <span class="font-label-sm text-label-sm text-emerald-400 uppercase font-bold">Điểm Cố Định • Phòng 102</span>
                        <p class="font-label-md text-label-md font-bold text-white">Viện Huyết Học - Truyền Máu TW</p>
                        <p class="font-body-sm text-body-sm text-slate-300 mt-1">Đã tiếp nhận trong ngày: <strong class="text-emerald-400">185 ĐV</strong></p>
                        <span class="font-label-sm text-[11px] text-slate-400">Tiếp nhận đến 20:00 hàng ngày</span>
                    </div>
                </div>

                <!-- PIN 4: ĐH Quốc Gia Hòa Lạc (Amber setup) -->
                <div class="absolute top-[68%] left-[20%] -translate-x-1/2 -translate-y-1/2 group cursor-pointer z-10">
                    <div class="relative flex items-center justify-center">
                        <div class="relative w-7 h-7 rounded-full bg-amber-500 text-white flex items-center justify-center shadow border-2 border-white">
                            <span class="material-symbols-outlined text-[14px]">engineering</span>
                        </div>
                    </div>
                    <div class="absolute left-1/2 -translate-x-1/2 bottom-9 w-56 bg-inverse-surface text-inverse-on-surface p-2.5 rounded-xl shadow-xl text-left pointer-events-none group-hover:pointer-events-auto transition-all duration-200">
                        <span class="font-label-sm text-label-sm text-amber-300 font-bold">Đang Chuẩn Bị (Ca Chiều)</span>
                        <p class="font-label-md text-label-md text-white font-semibold">ĐHQGHN (Hòa Lạc Campus)</p>
                        <p class="font-label-sm text-[11px] text-slate-300">Dự kiến tiếp nhận lúc 13:30</p>
                    </div>
                </div>

                <!-- PIN 5: Bưu điện VN VNPost (Blue Done) -->
                <div class="absolute top-[48%] left-[58%] -translate-x-1/2 -translate-y-1/2 group cursor-pointer z-10">
                    <div class="relative flex items-center justify-center">
                        <div class="relative w-7 h-7 rounded-full bg-blue-600 text-white flex items-center justify-center shadow border-2 border-white">
                            <span class="material-symbols-outlined text-[14px]">check</span>
                        </div>
                    </div>
                    <div class="absolute left-1/2 -translate-x-1/2 bottom-9 w-52 bg-inverse-surface text-inverse-on-surface p-2.5 rounded-xl shadow-xl text-left pointer-events-none group-hover:pointer-events-auto transition-all duration-200">
                        <span class="font-label-sm text-label-sm text-blue-300 font-bold">Hoàn Thành Ca Sáng</span>
                        <p class="font-label-md text-label-md text-white font-semibold">VNPost Hà Nội</p>
                        <p class="font-label-sm text-[11px] text-slate-300">Tổng thu: 215 ĐV (Đạt 107%)</p>
                    </div>
                </div>

                <!-- Floating Hotspot Card bottom-left -->
                <div class="absolute bottom-4 left-4 bg-inverse-surface/90 backdrop-blur-md border border-slate-700 text-inverse-on-surface p-3.5 rounded-xl shadow-lg max-w-sm flex items-center gap-3">
                    <div class="w-10 h-10 rounded-lg bg-primary/20 text-primary-fixed flex items-center justify-center shrink-0">
                        <span class="material-symbols-outlined text-[20px]">local_fire_department</span>
                    </div>
                    <div>
                        <p class="font-label-sm text-label-sm text-primary-fixed font-bold uppercase">Điểm tiếp nhận đông nhất hôm nay</p>
                        <h4 class="font-label-md text-label-md font-bold text-white">Canon Việt Nam (KCN Thăng Long)</h4>
                        <p class="font-body-sm text-body-sm text-slate-300 text-xs">Dự báo chạm 690 đơn vị (+115% kế hoạch ban đầu)</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Column: Mobile Fleet Status (4 cols / ~34%) -->
        <div class="xl:col-span-4 bg-surface-container-lowest rounded-2xl p-space-lg shadow-sm flex flex-col justify-between">
            <div class="space-y-space-md">
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-2.5">
                        <div class="w-10 h-10 rounded-xl bg-blue-50 text-blue-700 flex items-center justify-center">
                            <span class="material-symbols-outlined text-[22px]">airport_shuttle</span>
                        </div>
                        <div>
                            <h3 class="font-headline-sm text-headline-sm text-on-surface">Đội Xe Chuyên Dụng</h3>
                            <p class="font-body-sm text-body-sm text-on-surface-variant">Giám sát xe hiến máu lưu động</p>
                        </div>
                    </div>
                    <span class="px-2.5 py-1 rounded-full bg-emerald-50 text-emerald-700 font-label-sm text-label-sm font-bold">6 Sẵn Sàng</span>
                </div>

                <!-- Bus List -->
                <div class="space-y-3">
                    <!-- Bus 1 -->
                    <div class="p-3 rounded-xl bg-surface-container-low hover:bg-surface-container transition-all">
                        <div class="flex items-center justify-between mb-2">
