@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Hồ Sơ Bệnh Sử & Tiền Sử Người Hiến Máu";
}

<div class="flex flex-col w-full">
    <!-- Interactive Feedback Toast (Hidden by default, triggered via JS) -->
    <div class="fixed bottom-6 right-6 z-50 transform translate-y-24 opacity-0 transition-all duration-300 pointer-events-none flex items-center gap-space-sm bg-inverse-surface text-inverse-on-surface px-space-lg py-space-md rounded-xl shadow-xl" id="approvalToast">
        <span class="material-symbols-outlined text-emerald-400 text-[24px]">verified</span>
        <div class="flex flex-col">
            <span class="font-label-lg text-label-lg font-bold text-white">Xác thực Chữ ký số SmartCA Thành công!</span>
            <span class="font-body-sm text-body-sm text-surface-variant">Hồ sơ đã chuyển tự động sang Trạm lấy máu #03 • Viện Huyết học TW</span>
        </div>
    </div>

    <div class="p-space-lg max-w-[1520px] mx-auto w-full space-y-space-lg">
        <!-- 1. BREADCRUMB & HEADER ACTIONS -->
        <section class="flex flex-col xl:flex-row items-start xl:items-center justify-between gap-space-md">
            <div class="space-y-1">
                <div class="flex items-center flex-wrap gap-2 font-label-sm text-label-sm text-secondary">
                    <a asp-controller="Admin" asp-action="Dashboard" class="hover:text-primary transition-colors flex items-center gap-1">
                        <span class="material-symbols-outlined text-[15px]">medical_services</span>
                        <span>Hệ thống Quản trị Y tế</span>
                    </a>
                    <span class="text-surface-variant">/</span>
                    <span>Đối tác &amp; Dữ liệu</span>
                    <span class="text-surface-variant">/</span>
                    <a asp-controller="NguoiHienMau" asp-action="HoSoCaNhan" class="hover:text-primary transition-colors">Người hiến máu (Donors)</a>
                    <span class="text-surface-variant">/</span>
                    <span class="text-primary font-bold bg-primary-fixed/40 px-2 py-0.5 rounded">Hồ sơ #DONOR-2019-01204</span>
                </div>
                <div class="flex items-center gap-3 pt-1">
                    <a asp-controller="Admin" asp-action="LichKhamSangLoc" class="inline-flex items-center gap-1 font-label-md text-label-md text-secondary hover:text-primary transition-colors group">
                        <span class="material-symbols-outlined text-[18px] group-hover:-translate-x-0.5 transition-transform">arrow_back</span>
                        <span>Quay lại Lịch khám sàng lọc</span>
                    </a>
                    <span class="text-surface-variant text-xs">•</span>
                    <span class="font-label-sm text-label-sm text-emerald-700 bg-emerald-50 px-2.5 py-1 rounded-full flex items-center gap-1.5 font-semibold">
                        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                        LIMS Cobas 6800: Đồng bộ tức thì (10 phút trước)
                    </span>
                </div>
            </div>
            <!-- Quick Action Buttons -->
            <div class="flex flex-wrap items-center gap-space-sm w-full xl:w-auto justify-start xl:justify-end">
                <button class="inline-flex items-center gap-2 h-11 px-4 rounded-xl bg-surface-container-lowest text-on-surface hover:bg-surface-container text-label-md font-label-md shadow-sm transition-all duration-150" type="button" onclick="alert('Đang trích xuất toàn bộ hồ sơ bệnh sử định dạng PDF...')">
                    <span class="material-symbols-outlined text-[19px] text-secondary">picture_as_pdf</span>
                    <span>In Trích Lục (PDF)</span>
                </button>
                <a asp-controller="Admin" asp-action="KetQuaXetNghiem" class="inline-flex items-center gap-2 h-11 px-4 rounded-xl bg-surface-container-lowest text-on-surface hover:bg-surface-container text-label-md font-label-md shadow-sm transition-all duration-150">
                    <span class="material-symbols-outlined text-[19px] text-secondary">biotech</span>
                    <span>Tra cứu LIMS</span>
                </a>
                <button class="inline-flex items-center gap-2 h-11 px-4 rounded-xl bg-secondary-fixed text-on-secondary-fixed hover:bg-secondary-fixed-dim text-label-md font-label-md transition-all duration-150" onclick="handleDeferralModal()" type="button">
                    <span class="material-symbols-outlined text-[19px]">schedule</span>
                    <span>Tạm Hoãn Y Khoa</span>
                </button>
                <button class="inline-flex items-center gap-2 h-11 px-5 rounded-xl bg-primary text-on-primary hover:bg-primary-container text-label-md font-label-md shadow-md transition-all duration-150" onclick="triggerApprovalSignature()" type="button">
                    <span class="material-symbols-outlined text-[20px]" style="font-variation-settings: 'FILL' 1;">verified_user</span>
                    <span>Duyệt Đủ Điều Kiện (SmartCA)</span>
                </button>
            </div>
        </section>

        <!-- 2. DONOR IDENTITY BANNER & CLINICAL PROFILE HERO -->
        <section class="bg-surface-container-lowest rounded-2xl p-space-lg shadow-sm">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-space-lg items-center">
                <!-- Avatar + Basic Info (Col 5) -->
                <div class="lg:col-span-5 flex items-start gap-space-md">
                    <div class="relative shrink-0">
                        <img class="w-24 h-24 sm:w-28 sm:h-28 rounded-2xl object-cover shadow-md" alt="Ảnh chân dung người hiến máu" src="https://lh3.googleusercontent.com/aida-public/AB6AXuAxbYBN8X9VOvMb-cUr0DO87XZKXLsXA3zTB13aoFjD8HRRM8DOMvwMPZFdABsOoDbW7QRdrvX-PHZ5zs8ZbGENhCg16Wpzrx5lJ1cMG2-pzxuRiRCEe_if_A5lfw_QUym9qqTeuXkfERypPtEb4V8ylQyKqTPKJ_0fokSVfkxPUkdJj2B4sr2B4hJcwYFq6wV9LzyCS4a3gJt1UDe8N4P1cGeWBR9s_z2ontsMypG98Bpk8qq5-mlDmg">
                        <span class="absolute -bottom-2 -right-2 bg-emerald-600 text-white rounded-full p-1 shadow-md flex items-center justify-center" title="Đã xác thực định danh VNeID Mức 2">
                            <span class="material-symbols-outlined text-[18px]">verified</span>
                        </span>
                    </div>
                    <div class="space-y-1.5 min-w-0">
                        <div class="flex items-center flex-wrap gap-2">
                            <h1 class="font-headline-md text-headline-md text-on-surface font-bold tracking-tight">Lê Minh Tuấn</h1>
                            <span class="px-2.5 py-0.5 rounded-full bg-emerald-50 text-emerald-700 font-label-sm text-label-sm font-bold inline-flex items-center gap-1">
                                <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span>
                                VNeID Mức 2
                            </span>
                        </div>
                        <p class="font-body-sm text-body-sm text-secondary">
                            Nam • 41 tuổi (Sinh: 14/08/1984) • CCCD: <strong class="text-on-surface font-semibold font-mono">0340****1928</strong>
                        </p>
                        <div class="flex items-center gap-2 pt-1 font-mono text-xs text-secondary">
                            <span class="bg-surface-container px-2 py-0.5 rounded font-semibold text-on-surface">ISBT 128: =A01204899120</span>
                            <span class="material-symbols-outlined text-[16px] text-secondary">qr_code_2</span>
                        </div>
                        <!-- Diamond Donor Badge -->
                        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-xl bg-gradient-to-r from-amber-50 to-rose-50 text-amber-900 font-label-sm text-label-sm font-bold shadow-sm">
                            <span class="material-symbols-outlined text-amber-600 text-[18px]" style="font-variation-settings: 'FILL' 1;">military_tech</span>
                            <span>Hạng Kim Cương Danh Dự (25 lần hiến • 8,750 mL)</span>
                        </div>
                    </div>
                </div>
                <!-- Rare Blood Group Special Highlight (Col 4) -->
                <div class="lg:col-span-4 bg-primary/5 rounded-2xl p-space-md flex flex-col justify-between">
                    <div class="flex items-start justify-between">
                        <div>
                            <span class="font-label-sm text-label-sm uppercase tracking-wider text-primary font-bold">Phân Loại Nhóm Máu Hiếm</span>
                            <div class="flex items-baseline gap-2 mt-1">
                                <span class="font-display-hero text-display-hero font-extrabold text-primary leading-none">B Rh(-)</span>
                                <span class="px-2 py-1 rounded-md bg-primary text-on-primary font-label-sm text-label-sm font-bold uppercase tracking-wide">
                                    Tỷ lệ 0.04%
                                </span>
                            </div>
                        </div>
                        <div class="w-10 h-10 rounded-xl bg-primary/10 flex items-center justify-center text-primary">
                            <span class="material-symbols-outlined text-[24px]">bloodtype</span>
                        </div>
                    </div>
                    <div class="mt-3 pt-3 bg-surface-container-lowest/80 rounded-xl p-2.5 space-y-1 text-xs text-on-surface">
                        <div class="flex justify-between">
                            <span class="text-secondary font-medium">Kháng thể bất thường:</span>
                            <span class="font-semibold text-emerald-700">ÂM TÍNH (Screening Negative)</span>
                        </div>
                        <div class="flex justify-between font-mono text-[11px] text-secondary">
                            <span>Hệ phụ: Kell(-), Duffy(a+b+), Kidd(a+b+)</span>
                            <span class="text-primary font-semibold">Tương thích rộng</span>
                        </div>
                    </div>
                </div>
                <!-- Donation Status & Emergency Notes (Col 3) -->
                <div class="lg:col-span-3 flex flex-col justify-between gap-space-sm bg-surface-container-low rounded-2xl p-space-md">
                    <div class="space-y-1">
                        <span class="font-label-sm text-label-sm uppercase tracking-wider text-secondary font-bold">Trạng Thái Chu Kỳ</span>
                        <div class="flex items-center gap-2">
                            <span class="w-3 h-3 rounded-full bg-emerald-500 animate-ping"></span>
                            <span class="font-title-md text-title-md text-emerald-800 font-bold">ĐỦ ĐIỀU KIỆN HIẾN NGAY</span>
                        </div>
                        <p class="font-body-sm text-body-sm text-secondary">
                            Đã qua <strong class="text-on-surface font-semibold">120 ngày</strong> kể từ lần hiến gần nhất (Quy định: &ge; 84 ngày).
                        </p>
                    </div>
                    <div class="pt-2">
                        <span class="inline-flex items-center gap-1 text-[11px] font-label-sm font-bold text-primary bg-primary-fixed px-2.5 py-1 rounded-lg">
                            <span class="material-symbols-outlined text-[14px]">bolt</span>
                            CODE RED: Sẵn sàng viện trợ trong 25 phút
                        </span>
                    </div>
                </div>
            </div>
            <!-- Emergency Contact and Logistics Bar -->
            <div class="mt-space-md pt-space-md bg-surface-container-low/50 rounded-xl p-space-md grid grid-cols-1 md:grid-cols-3 gap-space-md text-body-sm">
                <div class="flex items-center gap-2.5">
                    <span class="material-symbols-outlined text-secondary text-[20px]">call</span>
                    <div class="truncate">
                        <span class="text-secondary text-xs block">Điện thoại chính &amp; Khẩn cấp:</span>
                        <span class="font-semibold text-on-surface font-mono">0903.882.*** (Đã xác thực VNeID)</span>
                    </div>
                </div>
                <div class="flex items-center gap-2.5">
                    <span class="material-symbols-outlined text-secondary text-[20px]">location_on</span>
                    <div class="truncate">
                        <span class="text-secondary text-xs block">Địa chỉ thường trú:</span>
                        <span class="font-semibold text-on-surface truncate">P.702 Chung cư D2 Giảng Võ, Ba Đình, Hà Nội</span>
                    </div>
                </div>
                <div class="flex items-center gap-2.5">
                    <span class="material-symbols-outlined text-secondary text-[20px]">contact_emergency</span>
                    <div class="truncate">
                        <span class="text-secondary text-xs block">Người liên hệ khẩn cấp:</span>
                        <span class="font-semibold text-on-surface">Vợ - Lê Thị Mai Lan (0912.445.***)</span>
                    </div>
                </div>
            </div>
        </section>

        <!-- 3. VITALS & HEMOGLOBIN FOUR-CARD METRICS ROW -->
        <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-space-md">
            <!-- Card 1: Huyết Áp -->
            <div class="bg-surface-container-lowest rounded-2xl p-space-lg shadow-sm flex flex-col justify-between">
                <div class="flex items-start justify-between">
                    <span class="font-label-sm text-label-sm uppercase font-bold text-secondary tracking-wider">Huyết Áp Khảo Sát</span>
                    <span class="p-2 rounded-xl bg-surface-container text-primary">
                        <span class="material-symbols-outlined text-[20px]">speed</span>
                    </span>
                </div>
                <div class="my-3">
                    <div class="flex items-baseline gap-2">
                        <span class="font-headline-lg text-headline-lg font-bold text-on-surface font-mono">125 / 82</span>
                        <span class="font-body-sm text-body-sm text-secondary">mmHg</span>
                    </div>
                    <p class="font-label-sm text-label-sm text-emerald-700 font-semibold mt-1 flex items-center gap-1">
                        <span class="material-symbols-outlined text-[16px]">check_circle</span>
                        Lý tưởng (Chuẩn: 100/60 - 140/90)
                    </p>
                </div>
                <div class="w-full bg-surface-container rounded-full h-1.5 overflow-hidden">
                    <div class="bg-emerald-600 h-full rounded-full" style="width: 72%"></div>
                </div>
            </div>
            <!-- Card 2: Nồng Độ Hemoglobin (Hb) -->
            <div class="bg-surface-container-lowest rounded-2xl p-space-lg shadow-sm flex flex-col justify-between">
                <div class="flex items-start justify-between">
                    <span class="font-label-sm text-label-sm uppercase font-bold text-secondary tracking-wider">Nồng Độ Hemoglobin (Hb)</span>
                    <span class="p-2 rounded-xl bg-rose-50 text-rose-700">
                        <span class="material-symbols-outlined text-[20px]">water_drop</span>
                    </span>
                </div>
                <div class="my-3">
                    <div class="flex items-baseline gap-2">
                        <span class="font-headline-lg text-headline-lg font-bold text-primary font-mono">14.6</span>
                        <span class="font-body-sm text-body-sm text-secondary">g/dL (146 g/L)</span>
                    </div>
                    <p class="font-label-sm text-label-sm text-emerald-700 font-semibold mt-1 flex items-center gap-1">
                        <span class="material-symbols-outlined text-[16px]">check_circle</span>
                        Đủ tiêu chuẩn hiến gói 450 mL (&ge; 12.5)
                    </p>
                </div>
                <div class="w-full bg-surface-container rounded-full h-1.5 overflow-hidden">
                    <div class="bg-primary h-full rounded-full" style="width: 85%"></div>
                </div>
            </div>
            <!-- Card 3: Mạch & Thân Nhiệt -->
            <div class="bg-surface-container-lowest rounded-2xl p-space-lg shadow-sm flex flex-col justify-between">
                <div class="flex items-start justify-between">
                    <span class="font-label-sm text-label-sm uppercase font-bold text-secondary tracking-wider">Mạch &amp; Thân Nhiệt</span>
                    <span class="p-2 rounded-xl bg-surface-container text-emerald-700">
                        <span class="material-symbols-outlined text-[20px]">favorite</span>
                    </span>
                </div>
                <div class="my-3">
                    <div class="flex items-baseline gap-2">
                        <span class="font-headline-lg text-headline-lg font-bold text-on-surface font-mono">74 <span class="text-sm font-normal text-secondary">bpm</span></span>
                        <span class="text-surface-variant">•</span>
                        <span class="font-headline-lg text-headline-lg font-bold text-on-surface font-mono">36.6<span class="text-sm font-normal text-secondary">°C</span></span>
                    </div>
                    <p class="font-label-sm text-label-sm text-emerald-700 font-semibold mt-1 flex items-center gap-1">
                        <span class="material-symbols-outlined text-[16px]">check_circle</span>
                        Nhịp xoang đều, thân nhiệt bình thường
                    </p>
                </div>
                <div class="w-full bg-surface-container rounded-full h-1.5 overflow-hidden">
                    <div class="bg-emerald-600 h-full rounded-full" style="width: 65%"></div>
                </div>
            </div>
            <!-- Card 4: Thể Trọng & BMI -->
            <div class="bg-surface-container-lowest rounded-2xl p-space-lg shadow-sm flex flex-col justify-between">
                <div class="flex items-start justify-between">
                    <span class="font-label-sm text-label-sm uppercase font-bold text-secondary tracking-wider">Thể Trọng &amp; Thể Tích Máu</span>
                    <span class="p-2 rounded-xl bg-surface-container text-secondary">
                        <span class="material-symbols-outlined text-[20px]">scale</span>
                    </span>
                </div>
                <div class="my-3">
                    <div class="flex items-baseline gap-2">
                        <span class="font-headline-lg text-headline-lg font-bold text-on-surface font-mono">68.5</span>
                        <span class="font-body-sm text-body-sm text-secondary">kg (Cao 1m73)</span>
                    </div>
                    <p class="font-label-sm text-label-sm text-on-surface-variant font-semibold mt-1 flex items-center gap-1">
                        <span>BMI: <strong class="text-on-surface font-mono">22.9</strong> (Cân đối)</span>
                        <span class="text-surface-variant">•</span>
                        <span>Ước tính: ~5,100 mL máu</span>
                    </p>
                </div>
                <div class="w-full bg-surface-container rounded-full h-1.5 overflow-hidden">
                    <div class="bg-sky-600 h-full rounded-full" style="width: 78%"></div>
                </div>
            </div>
        </section>

        <!-- 4. TWO-COLUMN HIGH-DENSITY CLINICAL RECORD CONTENT (65% / 35%) -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-space-lg items-start">
            <!-- LEFT COLUMN: Medical Questionnaire, LIMS Screening & Timeline (Col 8 / ~67%) -->
            <div class="lg:col-span-8 space-y-space-lg">
                <!-- Block A: Bảng Kiểm Tiền Sử & Sàng Lọc Sức Khỏe -->
                <section class="bg-surface-container-lowest rounded-2xl p-space-lg shadow-sm space-y-space-md">
                    <div class="flex items-center justify-between pb-space-sm bg-surface-container-low/30 rounded-xl p-3">
                        <div class="flex items-center gap-2.5">
                            <span class="p-2 rounded-xl bg-primary text-on-primary">
                                <span class="material-symbols-outlined text-[20px]">fact_check</span>
                            </span>
                            <div>
                                <h2 class="font-title-md text-title-md text-on-surface font-bold">Bảng Kiểm Sàng Lọc Lâm Sàng &amp; Tiền Sử Dịch Tễ</h2>
                                <p class="font-body-sm text-body-sm text-secondary">Chuẩn hóa theo Thông tư 26/2013/TT-BYT hướng dẫn truyền máu</p>
                            </div>
                        </div>
                        <span class="px-3 py-1 rounded-full bg-emerald-100 text-emerald-800 font-label-sm text-label-sm font-bold">
                            0 Bất Thường
                        </span>
                    </div>
                    <!-- Screening Checklist Grid -->
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-space-sm">
                        <div class="p-3 rounded-xl bg-surface-container-low flex items-start gap-3">
                            <span class="material-symbols-outlined text-emerald-600 text-[22px] shrink-0 mt-0.5">check_circle</span>
                            <div class="space-y-0.5">
                                <span class="font-label-md text-label-md text-on-surface font-semibold block">Tiền sử bệnh lý mạn tính</span>
                                <p class="font-body-sm text-body-sm text-secondary">Không có bệnh tim mạch bẩm sinh, cao huyết áp vô căn, đái tháo đường hay co giật động kinh.</p>
                            </div>
                        </div>
                        <div class="p-3 rounded-xl bg-surface-container-low flex items-start gap-3">
                            <span class="material-symbols-outlined text-emerald-600 text-[22px] shrink-0 mt-0.5">check_circle</span>
                            <div class="space-y-0.5">
                                <span class="font-label-md text-label-md text-on-surface font-semibold block">Kháng sinh &amp; Thuốc điều trị</span>
                                <p class="font-body-sm text-body-sm text-secondary">Không sử dụng kháng sinh, Aspirin, thuốc chống đông hoặc ức chế miễn dịch trong 14 ngày qua.</p>
                            </div>
                        </div>
                        <div class="p-3 rounded-xl bg-surface-container-low flex items-start gap-3">
                            <span class="material-symbols-outlined text-emerald-600 text-[22px] shrink-0 mt-0.5">check_circle</span>
                            <div class="space-y-0.5">
                                <span class="font-label-md text-label-md text-on-surface font-semibold block">Tiêm chủng &amp; Vaccine</span>
                                <p class="font-body-sm text-body-sm text-secondary">Đã tiêm ngừa Cúm mùa (3 tháng trước). Không tiêm vaccine sống giảm độc lực trong 4 tuần qua.</p>
                            </div>
                        </div>
                        <div class="p-3 rounded-xl bg-surface-container-low flex items-start gap-3">
                            <span class="material-symbols-outlined text-emerald-600 text-[22px] shrink-0 mt-0.5">check_circle</span>
                            <div class="space-y-0.5">
                                <span class="font-label-md text-label-md text-on-surface font-semibold block">Can thiệp &amp; Xâm lấn da</span>
                                <p class="font-body-sm text-body-sm text-secondary">Không xăm hình, xỏ khuyên, nội soi can thiệp, phẫu thuật hay châm cứu trong 6 tháng gần nhất.</p>
                            </div>
                        </div>
                    </div>
                    <!-- Lịch sử phản ứng phụ -->
                    <div class="p-4 rounded-xl bg-surface-container-low flex items-center justify-between flex-wrap gap-3">
                        <div class="flex items-center gap-3">
                            <span class="material-symbols-outlined text-secondary text-[24px]">find_replace</span>
                            <div>
                                <span class="font-label-md text-label-md text-on-surface font-semibold">Lịch sử phản ứng bất lợi sau hiến (Adverse Reactions):</span>
                                <p class="font-body-sm text-body-sm text-secondary">25 lần hiến ghi nhận: <strong>Mức độ 0 (Hoàn toàn bình thường)</strong>, không chóng mặt, không Vasovagal syncope.</p>
                            </div>
                        </div>
                        <span class="px-2.5 py-1 rounded bg-surface-container-lowest text-emerald-700 font-label-sm text-label-sm font-bold shadow-sm">
                            Độ an toàn: Tuyệt đối (100%)
                        </span>
                    </div>
                </section>

                <!-- Block B: Kết Quả Xét Nghiệm Tự Động LIMS (Cobas 6800 Blood Screening) -->
                <section class="bg-surface-container-lowest rounded-2xl p-space-lg shadow-sm space-y-space-md">
                    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-space-sm pb-space-sm bg-surface-container-low/30 rounded-xl p-3">
