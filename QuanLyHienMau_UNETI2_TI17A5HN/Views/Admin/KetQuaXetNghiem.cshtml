@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Thẩm Định & Quản Lý Kết Quả Xét Nghiệm Máu";
}

<div class="flex flex-col w-full">
    <!-- Top Ambient Glow Line -->
    <div class="h-1.5 w-full bg-gradient-to-r from-primary via-primary-container to-surface-tint shrink-0"></div>

    <!-- Main Container -->
    <div class="p-space-lg lg:p-margin flex flex-col gap-space-lg max-w-[1720px] mx-auto w-full">
        <!-- Header & Action Ribbon -->
        <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-space-md">
            <div class="flex flex-col gap-1">
                <nav class="flex items-center gap-2 font-label-sm text-label-sm text-on-surface-variant">
                    <a asp-controller="Admin" asp-action="Dashboard" class="hover:text-primary cursor-pointer transition-colors">Hệ thống Y tế Vitalis</a>
                    <span class="material-symbols-outlined text-[14px]">chevron_right</span>
                    <span class="hover:text-primary cursor-pointer transition-colors">Quản lý Y tế</span>
                    <span class="material-symbols-outlined text-[14px]">chevron_right</span>
                    <span class="text-primary font-bold">Thẩm định &amp; Kết quả xét nghiệm</span>
                </nav>
                <div class="flex items-center gap-3 mt-1">
                    <h1 class="font-headline-lg text-headline-lg text-on-surface tracking-tight">Thẩm Định &amp; Nhập Kết Quả Xét Nghiệm Máu</h1>
                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-surface-container font-label-sm text-label-sm text-secondary font-bold">
                        <span class="h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
                        Phòng LAB 04 • Chuẩn ISO 15189
                    </span>
                </div>
                <p class="font-body-sm text-body-sm text-on-surface-variant max-w-3xl">
                    Quy trình kiểm soát an toàn truyền máu 2 lớp: Sàng lọc 5 tác nhân lây nhiễm (NAT/ELISA), định nhóm ABO/RhD, đánh giá thể tích cơ học và phê duyệt cấp mã ISBT 128 nhập kho bảo quản 2–6°C.
                </p>
            </div>
            <!-- Action Buttons -->
            <div class="flex items-center flex-wrap gap-space-sm shrink-0">
                <button class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-surface-container-low hover:bg-surface-container text-on-surface font-label-md text-label-md transition-all duration-150 shadow-sm" type="button" onclick="alert('Đã kích hoạt đồng bộ tự động 2 chiều HL7 / LIS với Roche Cobas 6800.')">
                    <span class="material-symbols-outlined text-[18px] text-primary">sync_saved_locally</span>
                    <span>HL7 / LIS Auto-Sync</span>
                    <span class="px-1.5 py-0.5 rounded-md bg-emerald-100 text-emerald-800 text-[10px] font-bold">Live</span>
                </button>
                <button class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-surface-container-low hover:bg-surface-container text-on-surface font-label-md text-label-md transition-all duration-150 shadow-sm" type="button" onclick="alert('Đang trích xuất biên bản kiểm định xét nghiệm (PDF)...')">
                    <span class="material-symbols-outlined text-[18px]">print</span>
                    <span>Xuất biên bản (PDF)</span>
                </button>
                <button class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-primary hover:bg-primary-container text-on-primary font-label-md text-label-md shadow-md hover:shadow-lg transition-all duration-150" type="button" onclick="openManualEntryModal()">
                    <span class="material-symbols-outlined text-[20px]">barcode_scanner</span>
                    <span>+ Nhập thủ công / Quét Barcode</span>
                </button>
            </div>
        </div>

        <!-- KPI Metric Cards Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-space-md">
            <!-- Card 1: Tổng tiếp nhận -->
            <div class="p-space-lg rounded-2xl bg-surface-container-lowest shadow-sm flex flex-col justify-between relative overflow-hidden">
                <div class="absolute -right-6 -bottom-6 w-28 h-28 bg-surface-container-low rounded-full opacity-60 pointer-events-none"></div>
                <div class="flex items-start justify-between">
                    <div class="flex flex-col">
                        <span class="font-label-sm text-label-sm uppercase tracking-wider text-on-surface-variant font-bold">Mẫu tiếp nhận ca hôm nay</span>
                        <div class="flex items-baseline gap-2 mt-2">
                            <span class="font-headline-lg text-headline-lg font-bold text-on-surface">86</span>
                            <span class="font-body-sm text-body-sm text-on-surface-variant font-medium">túi máu</span>
                        </div>
                    </div>
                    <div class="w-12 h-12 rounded-xl bg-surface-container-high flex items-center justify-center text-primary shrink-0">
                        <span class="material-symbols-outlined text-[26px]">water_drop</span>
                    </div>
                </div>
                <div class="mt-4 pt-3 flex items-center justify-between text-on-surface-variant">
                    <span class="inline-flex items-center gap-1 font-label-sm text-label-sm text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-md font-bold">
                        <span class="material-symbols-outlined text-[14px]">add_circle</span> +14 túi vừa nhận
                    </span>
                    <span class="font-body-sm text-body-sm">Từ 3 bàn chọc ven</span>
                </div>
            </div>
            <!-- Card 2: Đạt chuẩn an toàn -->
            <div class="p-space-lg rounded-2xl bg-surface-container-lowest shadow-sm flex flex-col justify-between relative overflow-hidden">
                <div class="absolute -right-6 -bottom-6 w-28 h-28 bg-emerald-50 rounded-full opacity-70 pointer-events-none"></div>
                <div class="flex items-start justify-between">
                    <div class="flex flex-col">
                        <span class="font-label-sm text-label-sm uppercase tracking-wider text-emerald-800 font-bold">Đạt chuẩn an toàn sinh học</span>
                        <div class="flex items-baseline gap-2 mt-2">
                            <span class="font-headline-lg text-headline-lg font-bold text-emerald-700">78</span>
                            <span class="font-body-sm text-body-sm text-emerald-800 font-semibold">(90.7%)</span>
                        </div>
                    </div>
                    <div class="w-12 h-12 rounded-xl bg-emerald-50 flex items-center justify-center text-emerald-700 shrink-0">
                        <span class="material-symbols-outlined text-[26px]">verified_user</span>
                    </div>
                </div>
                <div class="mt-4 pt-3 flex items-center justify-between text-on-surface-variant">
                    <span class="inline-flex items-center gap-1 font-label-sm text-label-sm text-on-surface">
                        <span class="material-symbols-outlined text-[16px] text-emerald-600">ac_unit</span> Kho lạnh 2°C – 6°C
                    </span>
                    <span class="font-label-sm text-label-sm font-semibold text-emerald-800">Đã dán ISBT 128</span>
                </div>
            </div>
            <!-- Card 3: Cảnh báo / Nghi ngờ -->
            <div class="p-space-lg rounded-2xl bg-surface-container-lowest shadow-sm flex flex-col justify-between relative overflow-hidden">
                <div class="absolute -right-6 -bottom-6 w-28 h-28 bg-amber-50 rounded-full opacity-70 pointer-events-none"></div>
                <div class="flex items-start justify-between">
                    <div class="flex flex-col">
                        <span class="font-label-sm text-label-sm uppercase tracking-wider text-amber-800 font-bold">Cảnh báo / Nghi ngờ ELISA</span>
                        <div class="flex items-baseline gap-2 mt-2">
                            <span class="font-headline-lg text-headline-lg font-bold text-amber-600">03</span>
                            <span class="font-body-sm text-body-sm text-amber-800 font-medium">mẫu chờ NAT</span>
                        </div>
                    </div>
                    <div class="w-12 h-12 rounded-xl bg-amber-50 flex items-center justify-center text-amber-600 shrink-0">
                        <span class="material-symbols-outlined text-[26px]">biotech</span>
                    </div>
                </div>
                <div class="mt-4 pt-3 flex items-center justify-between text-on-surface-variant">
                    <span class="inline-flex items-center gap-1 font-label-sm text-label-sm text-amber-700 bg-amber-50 px-2 py-0.5 rounded-md font-bold">
                        <span class="material-symbols-outlined text-[14px]">hourglass_top</span> Chờ khẳng định lần 2
                    </span>
                    <span class="font-body-sm text-body-sm">Cô lập tại tủ kiểm định</span>
                </div>
            </div>
            <!-- Card 4: Không đạt chuẩn / Huỷ -->
            <div class="p-space-lg rounded-2xl bg-surface-container-lowest shadow-sm flex flex-col justify-between relative overflow-hidden">
                <div class="absolute -right-6 -bottom-6 w-28 h-28 bg-rose-50 rounded-full opacity-70 pointer-events-none"></div>
                <div class="flex items-start justify-between">
                    <div class="flex flex-col">
                        <span class="font-label-sm text-label-sm uppercase tracking-wider text-error font-bold">Không đạt chuẩn / Chờ hủy</span>
                        <div class="flex items-baseline gap-2 mt-2">
                            <span class="font-headline-lg text-headline-lg font-bold text-error">05</span>
                            <span class="font-body-sm text-body-sm text-error/80 font-medium">túi máu</span>
                        </div>
                    </div>
                    <div class="w-12 h-12 rounded-xl bg-error-container/40 flex items-center justify-center text-error shrink-0">
                        <span class="material-symbols-outlined text-[26px]">dangerous</span>
                    </div>
                </div>
                <div class="mt-4 pt-3 flex items-center justify-between text-on-surface-variant">
                    <span class="inline-flex items-center gap-1 font-label-sm text-label-sm text-error font-bold">
                        2 vỡ hồng cầu • 3 nhiễm khuẩn
                    </span>
                    <span class="font-body-sm text-body-sm">Quy chuẩn BYT 26</span>
                </div>
            </div>
        </div>

        <!-- Search, Barcode Scanner & Filters Bar -->
        <div class="p-space-md lg:p-space-lg rounded-2xl bg-surface-container-lowest shadow-sm flex flex-col lg:flex-row items-stretch lg:items-center justify-between gap-space-md">
            <!-- Search & Barcode Input -->
            <div class="relative flex-1 min-w-[280px]">
                <span class="material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-primary text-[22px]">barcode_scanner</span>
                <input class="w-full h-12 pl-12 pr-10 rounded-xl bg-surface-container-low font-body-md text-body-md text-on-surface focus:outline-none focus:bg-surface-container-lowest transition-all" placeholder="Quét Barcode túi máu (ISBT 128) hoặc tìm CCCD, Họ tên người hiến..." type="text" value="#BAG-2025-08991" id="barcodeSearchInput">
                <button aria-label="Xóa tìm kiếm" class="absolute right-3 top-1/2 -translate-y-1/2 text-on-surface-variant hover:text-on-surface" type="button" onclick="document.getElementById('barcodeSearchInput').value=''">
                    <span class="material-symbols-outlined text-[18px]">close</span>
                </button>
            </div>
            <!-- Quick Campaign Selector -->
            <div class="flex items-center gap-2 min-w-[260px]">
                <div class="flex items-center gap-2 h-12 px-4 rounded-xl bg-surface-container-low w-full text-on-surface">
                    <span class="material-symbols-outlined text-on-surface-variant text-[20px]">calendar_month</span>
                    <div class="flex flex-col flex-1 leading-tight">
                        <span class="font-label-sm text-[10px] text-on-surface-variant uppercase font-bold">Chiến dịch hiến máu</span>
                        <span class="font-label-md text-label-md font-semibold truncate">Giọt Hồng Thanh Niên - 15/11</span>
                    </div>
                    <span class="material-symbols-outlined text-on-surface-variant text-[18px]">arrow_drop_down</span>
                </div>
            </div>
            <!-- Blood Group Chips Filter -->
            <div class="flex items-center gap-1.5 overflow-x-auto py-1">
                <button class="px-3 py-2 rounded-xl bg-primary text-on-primary font-label-sm text-label-sm font-bold shadow-sm whitespace-nowrap" type="button">Tất cả</button>
                <button class="px-3 py-2 rounded-xl bg-surface-container-low hover:bg-surface-container text-on-surface font-label-sm text-label-sm font-semibold whitespace-nowrap" type="button">O+</button>
                <button class="px-3 py-2 rounded-xl bg-surface-container-low hover:bg-surface-container text-on-surface font-label-sm text-label-sm font-semibold whitespace-nowrap" type="button">A+</button>
                <button class="px-3 py-2 rounded-xl bg-surface-container-low hover:bg-surface-container text-on-surface font-label-sm text-label-sm font-semibold whitespace-nowrap" type="button">B+</button>
                <button class="px-3 py-2 rounded-xl bg-surface-container-low hover:bg-surface-container text-on-surface font-label-sm text-label-sm font-semibold whitespace-nowrap" type="button">AB+</button>
                <button class="px-3 py-2 rounded-xl bg-rose-100 text-rose-800 font-label-sm text-label-sm font-bold whitespace-nowrap flex items-center gap-1" type="button">
                    <span class="material-symbols-outlined text-[14px]">warning</span> Rh(-) Hiếm
                </button>
            </div>
            <!-- Status Filter Tabs -->
            <div class="flex items-center gap-1 bg-surface-container-low p-1 rounded-xl shrink-0">
                <button class="px-3 py-1.5 rounded-lg bg-surface-container-lowest text-on-surface font-label-sm text-label-sm font-bold shadow-sm" type="button">
                    Đạt chuẩn (78)
                </button>
                <button class="px-3 py-1.5 rounded-lg text-on-surface-variant hover:text-on-surface font-label-sm text-label-sm font-semibold" type="button">
                    Chờ duyệt (5)
                </button>
                <button class="px-3 py-1.5 rounded-lg text-error hover:bg-error-container/20 font-label-sm text-label-sm font-semibold" type="button">
                    Hủy / Lỗi (5)
                </button>
            </div>
        </div>

        <!-- Main Workspace Split: Left (7 cols / 58%) & Right (5 cols / 42%) -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-space-lg items-start">
            <!-- LEFT COLUMN: Specimen Audit Table (7 Cols) -->
            <div class="lg:col-span-7 flex flex-col gap-space-md">
                <!-- Table Card Container -->
                <div class="bg-surface-container-lowest rounded-2xl shadow-sm overflow-hidden flex flex-col">
                    <!-- Table Sub-Header -->
                    <div class="p-space-md lg:p-space-lg flex items-center justify-between bg-surface-container-lowest">
                        <div class="flex items-center gap-3">
                            <div class="w-9 h-9 rounded-xl bg-primary/10 flex items-center justify-center text-primary font-bold">
                                <span class="material-symbols-outlined text-[20px]">assignment</span>
                            </div>
                            <div class="flex flex-col">
                                <h2 class="font-headline-sm text-headline-sm font-bold text-on-surface">Danh Sách Mẫu Máu Ca Trực</h2>
                                <span class="font-body-sm text-body-sm text-on-surface-variant">Hiển thị 5 / 86 túi máu cần đối soát an toàn</span>
                            </div>
                        </div>
                        <div class="flex items-center gap-2">
                            <button class="p-2 rounded-xl text-on-surface-variant hover:bg-surface-container-low hover:text-on-surface transition-colors" title="Làm mới" type="button" onclick="alert('Đã cập nhật danh sách mẫu máu mới nhất!')">
                                <span class="material-symbols-outlined text-[20px]">refresh</span>
                            </button>
                            <button class="p-2 rounded-xl text-on-surface-variant hover:bg-surface-container-low hover:text-on-surface transition-colors" title="Cấu hình cột" type="button">
                                <span class="material-symbols-outlined text-[20px]">view_column</span>
                            </button>
                        </div>
                    </div>
                    <!-- Responsive Table Body -->
                    <div class="overflow-x-auto w-full">
                        <table class="w-full text-left border-collapse">
                            <thead>
                                <tr class="bg-surface-container-low text-on-surface-variant font-label-sm text-label-sm uppercase tracking-wider">
                                    <th class="py-3.5 px-4 font-bold">Mã Túi Máu / Barcode</th>
                                    <th class="py-3.5 px-4 font-bold">Người Hiến (CCCD)</th>
                                    <th class="py-3.5 px-3 font-bold text-center">Nhóm Máu</th>
                                    <th class="py-3.5 px-3 font-bold text-center">Thể Tích &amp; Hb</th>
                                    <th class="py-3.5 px-4 font-bold">Sàng Lọc 5 Bệnh</th>
                                    <th class="py-3.5 px-4 font-bold">Trạng Thái</th>
                                    <th class="py-3.5 px-4 font-bold text-right">Thao Tác</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y-0 font-body-sm text-body-sm">
                                <!-- Row 1: Selected Row (#BAG-2025-08991) -->
                                <tr class="bg-primary/5 hover:bg-primary/10 transition-colors cursor-pointer relative" onclick="selectBag('BAG-2025-08991', 'Nguyễn Hoàng Nam', '001099028891', 'Nhóm O', 'Rh (D) (+)', '350 mL', '13.8 g/dL')">
                                    <td class="py-3.5 px-4">
                                        <div class="flex items-center gap-2.5">
                                            <span class="w-2 h-8 rounded-full bg-primary shrink-0"></span>
                                            <div class="flex flex-col">
                                                <span class="font-label-md text-label-md font-bold text-primary">#BAG-2025-08991</span>
                                                <div class="flex items-center gap-1 text-[11px] font-mono text-on-surface-variant">
                                                    <span class="material-symbols-outlined text-[13px]">schedule</span> 09:20 • ISBT-128
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="py-3.5 px-4">
                                        <div class="flex flex-col">
                                            <span class="font-label-md text-label-md font-bold text-on-surface">Nguyễn Hoàng Nam</span>
                                            <span class="text-on-surface-variant text-[12px] font-mono">001099••••891</span>
                                        </div>
                                    </td>
                                    <td class="py-3.5 px-3 text-center">
                                        <span class="inline-flex items-center justify-center px-2.5 py-1 rounded-lg bg-rose-100 text-primary font-label-md text-label-md font-bold">
                                            O Rh(+)
                                        </span>
                                    </td>
                                    <td class="py-3.5 px-3 text-center">
                                        <div class="flex flex-col items-center">
                                            <span class="font-bold text-on-surface">350 mL</span>
                                            <span class="text-[11px] text-emerald-700 font-medium">Hb: 13.8 g/dL</span>
                                        </div>
                                    </td>
                                    <td class="py-3.5 px-4">
                                        <div class="flex items-center gap-1.5">
                                            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-emerald-50 text-emerald-800 font-label-sm text-label-sm font-bold">
                                                <span class="material-symbols-outlined text-[14px] text-emerald-600">check_circle</span> 5/5 Âm tính
                                            </span>
                                        </div>
                                    </td>
                                    <td class="py-3.5 px-4">
                                        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-emerald-100 text-emerald-800 font-label-sm text-label-sm font-bold">
                                            <span class="h-1.5 w-1.5 rounded-full bg-emerald-600"></span> Đạt chuẩn
                                        </span>
                                    </td>
                                    <td class="py-3.5 px-4 text-right">
                                        <div class="flex items-center justify-end gap-1">
                                            <button class="p-1.5 rounded-lg text-primary hover:bg-primary/10 transition-colors" title="Đang mở thẩm định" type="button">
                                                <span class="material-symbols-outlined text-[18px]">visibility</span>
                                            </button>
                                            <button class="p-1.5 rounded-lg text-on-surface-variant hover:bg-surface-container-low transition-colors" title="In nhãn" type="button" onclick="alert('Đang in tem ISBT 128 cho túi máu #BAG-2025-08991...')">
                                                <span class="material-symbols-outlined text-[18px]">print</span>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                                <!-- Row 2: Lê Thị Hương (A+) -->
                                <tr class="hover:bg-surface-container-low/60 transition-colors cursor-pointer bg-surface-container-lowest" onclick="selectBag('BAG-2025-08992', 'Lê Thị Mai Hương', '038198001442', 'Nhóm A', 'Rh (D) (+)', '250 mL', '12.6 g/dL')">
                                    <td class="py-3.5 px-4">
                                        <div class="flex items-center gap-2.5">
                                            <span class="w-2 h-8 rounded-full bg-surface-container-highest shrink-0"></span>
                                            <div class="flex flex-col">
                                                <span class="font-label-md text-label-md font-bold text-on-surface">#BAG-2025-08992</span>
                                                <div class="flex items-center gap-1 text-[11px] font-mono text-on-surface-variant">
                                                    <span class="material-symbols-outlined text-[13px]">schedule</span> 09:28 • ISBT-128
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="py-3.5 px-4">
                                        <div class="flex flex-col">
                                            <span class="font-label-md text-label-md font-bold text-on-surface">Lê Thị Mai Hương</span>
                                            <span class="text-on-surface-variant text-[12px] font-mono">038198••••442</span>
                                        </div>
                                    </td>
                                    <td class="py-3.5 px-3 text-center">
                                        <span class="inline-flex items-center justify-center px-2.5 py-1 rounded-lg bg-surface-container-high text-on-surface font-label-md text-label-md font-bold">
                                            A Rh(+)
                                        </span>
                                    </td>
                                    <td class="py-3.5 px-3 text-center">
                                        <div class="flex flex-col items-center">
                                            <span class="font-bold text-on-surface">250 mL</span>
                                            <span class="text-[11px] text-emerald-700 font-medium">Hb: 12.6 g/dL</span>
                                        </div>
                                    </td>
                                    <td class="py-3.5 px-4">
                                        <div class="flex items-center gap-1.5">
                                            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-emerald-50 text-emerald-800 font-label-sm text-label-sm font-bold">
                                                <span class="material-symbols-outlined text-[14px] text-emerald-600">check_circle</span> 5/5 Âm tính
                                            </span>
                                        </div>
                                    </td>
                                    <td class="py-3.5 px-4">
                                        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-emerald-100 text-emerald-800 font-label-sm text-label-sm font-bold">
                                            <span class="h-1.5 w-1.5 rounded-full bg-emerald-600"></span> Đạt chuẩn
                                        </span>
                                    </td>
                                    <td class="py-3.5 px-4 text-right">
                                        <div class="flex items-center justify-end gap-1">
                                            <button class="p-1.5 rounded-lg text-on-surface-variant hover:bg-surface-container-low transition-colors" title="Xem" type="button">
                                                <span class="material-symbols-outlined text-[18px]">edit_note</span>
                                            </button>
                                            <button class="p-1.5 rounded-lg text-on-surface-variant hover:bg-surface-container-low transition-colors" title="In nhãn" type="button">
                                                <span class="material-symbols-outlined text-[18px]">print</span>
                                            </button>
                                        </div>
                                    </td>
