@* Họ và tên: ĐIỀN HỌ TÊN CỦA BẠN | Mã sinh viên: ĐIỀN MSSV CỦA BẠN | Nội dung: Module 5. *@
@using QuanLyHienMau_UNETI2_TI17A5HN.ViewModels
@model List<PhieuDangKyHienMau>
@{Layout="_AdminLayout";ViewData["Title"]="Kết quả hiến máu";}

<link rel="stylesheet" href="~/css/module5-integration.css" asp-append-version="true"/><div class="m5-ui p-space-lg max-w-[1600px] mx-auto w-full"><partial name="_Module5Messages"/>
<div class="page-head">
<div>

<h1>Kết quả hiến máu</h1>

</div>
<a class="button quiet" href="/Admin/LichKhamSangLoc">Xem lịch khám</a>
</div>
<section class="card">
<div class="table-wrap">
<table>
<thead>
<tr>
<th>Phiếu</th>
<th>Người hiến / Đợt</th>
<th>Trạng thái / Kết quả</th>
<th>Điểm / Ngày cập nhật</th>
<th>Nhận xét</th>
<th>Thao tác</th>
</tr>
</thead>
<tbody>@foreach(var p in Model){<tr>
<td>#@p.MaPhieu</td>
<td>
<b>@p.NguoiHien.HoTen</b>
<small>@p.Dot.TenDot</small>
</td>
<td>
<span class="badge">@p.TrangThai</span>
</td>
<td>@(p.KetQuaHienMau?.DiemDanhGia?.ToString()??"—")<small>@p.KetQuaHienMau?.NgayCapNhat.ToString("dd/MM/yyyy HH:mm")</small>
</td>
<td>@(p.KetQuaHienMau?.NhanXet??"Chờ nhân viên y tế ghi nhận kết quả.")</td>
<td>@if(p.TrangThai==TrangThaiPhieu.DaKham && p.KetQuaHienMau==null){<a class="button small" asp-controller="KetQuaHienMau" asp-action="Create" asp-route-id="@p.MaPhieu">Nhập kết quả</a>}else{<span class="muted">Đã công bố</span>}</td>
</tr>}@if(Model.Count==0){<tr>
<td colspan="6" class="empty">Chưa có phiếu đã khám hoặc kết quả hiến máu.</td>
</tr>}</tbody>
</table>
</div>
</section>

</div>
