                                    <span class="font-label-md text-label-md font-bold text-emerald-700 bg-emerald-50 px-3 py-1 rounded-lg">ÂM TÍNH</span>
                                </div>
                                <!-- Test 5: Sốt rét -->
                                <div class="p-3 rounded-xl bg-surface-container-low flex items-center justify-between">
                                    <div class="flex items-center gap-3">
                                        <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
                                        <div class="flex flex-col">
                                            <span class="font-label-md text-label-md font-bold text-on-surface">Ký sinh trùng sốt rét (Malaria Ag / Giemsa)</span>
                                            <span class="text-[11px] text-on-surface-variant">Soi kính hiển vi huỳnh quang &amp; Kháng nguyên</span>
                                        </div>
                                    </div>
                                    <span class="font-label-md text-label-md font-bold text-emerald-700 bg-emerald-50 px-3 py-1 rounded-lg">ÂM TÍNH</span>
                                </div>
                            </div>
                        </div>
                        <!-- Section 3: Physical Bag Integrity & Clinical Indices -->
                        <div class="flex flex-col gap-space-sm">
                            <span class="font-label-md text-label-md font-bold text-on-surface uppercase tracking-wide">3. Đánh Giá Cảm Quan &amp; Chỉ Số Hóa Sinh Túi Máu</span>
                            <div class="grid grid-cols-2 gap-3">
                                <div class="p-3 rounded-xl bg-surface-container-low flex flex-col gap-1">
                                    <span class="text-[11px] text-on-surface-variant font-medium">Thể tích túi lấy thực nhận</span>
                                    <div class="flex items-baseline gap-1">
                                        <span class="font-headline-sm text-headline-sm font-bold text-on-surface" id="activeVolume">350</span>
                                        <span class="font-body-sm text-body-sm font-semibold">mL (Đạt ±10%)</span>
                                    </div>
                                    <span class="text-[11px] text-emerald-700 font-semibold flex items-center gap-1">
                                        <span class="material-symbols-outlined text-[13px]">check</span> Chống đông CPD-A1 chuẩn
                                    </span>
                                </div>
                                <div class="p-3 rounded-xl bg-surface-container-low flex flex-col gap-1">
                                    <span class="text-[11px] text-on-surface-variant font-medium">Huyết sắc tố (Hemoglobin Hb)</span>
                                    <div class="flex items-baseline gap-1">
                                        <span class="font-headline-sm text-headline-sm font-bold text-on-surface" id="activeHb">13.8</span>
                                        <span class="font-body-sm text-body-sm font-semibold">g/dL (Chuẩn &gt;12.5)</span>
                                    </div>
                                    <span class="text-[11px] text-emerald-700 font-semibold flex items-center gap-1">
                                        <span class="material-symbols-outlined text-[13px]">check</span> Hct: 41.5% • Tiểu cầu tốt
                                    </span>
                                </div>
                            </div>
                            <!-- Physical Quality Checklist -->
                            <div class="p-3 rounded-xl bg-surface-container-low flex flex-col gap-2">
                                <div class="flex items-center justify-between text-body-sm">
                                    <div class="flex items-center gap-2">
                                        <span class="material-symbols-outlined text-emerald-600 text-[18px]">verified</span>
                                        <span class="font-medium text-on-surface">Độ trong huyết tương: Non-lipemic (Không mỡ máu)</span>
                                    </div>
                                    <span class="text-[11px] font-bold text-emerald-700">Đạt</span>
                                </div>
                                <div class="flex items-center justify-between text-body-sm">
                                    <div class="flex items-center gap-2">
                                        <span class="material-symbols-outlined text-emerald-600 text-[18px]">verified</span>
                                        <span class="font-medium text-on-surface">Tình trạng hồng cầu: Non-hemolyzed (Không tan máu)</span>
                                    </div>
                                    <span class="text-[11px] font-bold text-emerald-700">Đạt</span>
                                </div>
                                <div class="flex items-center justify-between text-body-sm">
                                    <div class="flex items-center gap-2">
                                        <span class="material-symbols-outlined text-emerald-600 text-[18px]">verified</span>
                                        <span class="font-medium text-on-surface">Dây dẫn, van niêm phong túi: Kín tuyệt đối 100%</span>
                                    </div>
                                    <span class="text-[11px] font-bold text-emerald-700">Đạt</span>
                                </div>
                            </div>
                        </div>
                        <!-- Section 4: Post-Approval Automation Options -->
                        <div class="p-3.5 rounded-xl bg-surface-container-low flex flex-col gap-2.5">
                            <span class="font-label-sm text-[11px] uppercase tracking-wider text-on-surface-variant font-bold">Quy trình tự động hóa tích hợp</span>
                            <label class="flex items-start gap-2.5 cursor-pointer">
                                <input checked="" class="mt-0.5 w-4 h-4 rounded text-primary focus:ring-primary/20 accent-primary" type="checkbox">
                                <span class="font-body-sm text-body-sm text-on-surface leading-snug">
                                    Tự động gửi thông báo kết quả &amp; cấp <strong>Giấy chứng nhận hiến máu điện tử</strong> qua VNeID / SMS cho người hiến.
                                </span>
                            </label>
                            <label class="flex items-start gap-2.5 cursor-pointer">
                                <input checked="" class="mt-0.5 w-4 h-4 rounded text-primary focus:ring-primary/20 accent-primary" type="checkbox">
                                <span class="font-body-sm text-body-sm text-on-surface leading-snug">
                                    Đồng bộ tức thời thông tin túi máu vào <strong>Ngân Hàng Máu Quốc Gia (National Blood Bank)</strong>.
                                </span>
                            </label>
                        </div>
                        <!-- Section 5: Primary Action Buttons / Decision Flow -->
                        <div class="flex flex-col gap-2.5 pt-2">
                            <button class="w-full py-3.5 px-4 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-label-lg text-label-lg font-bold shadow-md hover:shadow-lg transition-all flex items-center justify-center gap-2" type="button" onclick="approveAndStore()">
                                <span class="material-symbols-outlined text-[22px]">verified</span>
                                <span>PHÊ DUYỆT ĐẠT CHUẨN &amp; NHẬP KHO LẠNH</span>
                            </button>
                            <div class="grid grid-cols-2 gap-2.5">
                                <button class="py-2.5 px-3 rounded-xl bg-surface-container-low hover:bg-surface-container text-on-surface font-label-md text-label-md font-semibold transition-colors flex items-center justify-center gap-1.5" type="button" onclick="alert('Đã gửi lệnh yêu cầu chạy lại xét nghiệm (Re-test) cho phòng LAB.')">
                                    <span class="material-symbols-outlined text-[18px]">replay</span>
                                    <span>Yêu cầu chạy lại (Re-test)</span>
                                </button>
                                <button class="py-2.5 px-3 rounded-xl bg-error-container/40 hover:bg-error-container text-error font-label-md text-label-md font-semibold transition-colors flex items-center justify-center gap-1.5" type="button" onclick="openRejectModal()">
                                    <span class="material-symbols-outlined text-[18px]">delete_forever</span>
                                    <span>Từ chối &amp; Lập biên bản hủy</span>
                                </button>
                            </div>
                            <!-- Physician Digital Signature Notice -->
                            <div class="flex items-center justify-center gap-2 text-on-surface-variant font-label-sm text-label-sm text-center pt-1">
                                <span class="material-symbols-outlined text-[15px] text-emerald-600">lock</span>
                                <span>Ký số định danh tự động: <strong>BS. CKI Trần Mai Linh</strong> (Trưởng kíp Lab)</span>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- Quick Help & Clinical Protocol Tips -->
                <div class="p-space-md rounded-2xl bg-surface-container-lowest shadow-sm flex items-start gap-3">
                    <span class="material-symbols-outlined text-primary text-[24px] shrink-0 mt-0.5">info</span>
                    <div class="flex flex-col gap-1">
                        <span class="font-label-md text-label-md font-bold text-on-surface">Lưu ý an toàn sinh học cấp Bộ Y Tế</span>
                        <p class="font-body-sm text-body-sm text-on-surface-variant">
                            Tất cả mẫu có phản ứng nghi ngờ (S/CO &ge; 0.9) bắt buộc chạy lại kỹ thuật NAT trong vòng 4 giờ. Tuyệt đối không giải phóng túi máu vào kho lưu trữ khi chưa có chữ ký số xác thực của Trưởng kíp xét nghiệm.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function selectBag(code, name, cccd, abo, rh, volume, hb) {
            document.getElementById('activeBagCode').innerText = '#' + code;
            document.getElementById('activeDonorName').innerText = name;
            document.getElementById('activeDonorCccd').innerText = 'CCCD: ' + cccd + ' (VNeID Đã định danh)';
            document.getElementById('activeAbo').innerText = abo;
            document.getElementById('activeRh').innerText = rh;
            document.getElementById('activeVolume').innerText = volume.replace(' mL', '');
            document.getElementById('activeHb').innerText = hb.replace(' g/dL', '');
        }

        function approveAndStore() {
            alert('Đã phê duyệt đạt chuẩn an toàn sinh học và xuất kho lạnh lưu trữ 2-6°C cho túi máu! Giấy chứng nhận hiến máu điện tử đã được tự động cấp qua VNeID.');
        }

        function openManualEntryModal() {
            const barcode = prompt("Nhập mã Barcode túi máu hoặc quét ISBT 128:", "=W0123 25 08996 00 00");
            if (barcode) {
                alert("Đã kết nối dữ liệu máy xét nghiệm cho túi máu: " + barcode);
            }
        }

        function openRejectModal() {
            const reason = prompt("Nhập lý do chuyên môn hủy túi máu:", "Phát hiện chỉ số men gan bất thường / Lỗi tan máu cơ học");
            if (reason) {
                alert("Đã lập biên bản hủy túi máu theo quy chuẩn an toàn sinh học. Lý do: " + reason);
            }
        }
    </script>
}
