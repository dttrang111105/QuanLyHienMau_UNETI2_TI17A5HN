@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản lý kho lưu trữ máu & điều phối khẩn cấp";
}

<div class="flex flex-col w-full">
    <!-- Top Ambient Glow Line -->
    <div class="h-1.5 w-full bg-gradient-to-r from-primary via-tertiary-container to-primary-container"></div>

    <!-- Top Hero & Breadcrumbs Section -->
    <div class="w-full px-space-lg py-space-md">
        <!-- Breadcrumb & System State Indicator -->
        <div class="flex flex-wrap items-center justify-between gap-space-sm mb-space-sm">
            <div class="flex items-center gap-2 font-label-sm text-label-sm text-on-surface-variant">
                <span>Hệ thống Quản trị Y tế</span>
                <span class="material-symbols-outlined text-[14px]">chevron_right</span>
                <span>Đối tác &amp; Dữ liệu</span>
                <span class="material-symbols-outlined text-[14px]">chevron_right</span>
                <span class="text-primary font-semibold">Kho lưu trữ máu &amp; Điều phối khẩn cấp</span>
            </div>
            <div class="flex items-center gap-3">
                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-surface-container-high text-on-surface font-label-sm text-label-sm">
                    <span class="w-2 h-2 rounded-full bg-primary animate-ping"></span>
                    <span>Hệ thống ISBT 128: <strong class="text-primary">Đồng bộ Thời Gian Thực (Active)</strong></span>
                </div>
                <span class="text-on-surface-variant font-label-sm text-label-sm">Cập nhật: <span class="font-mono font-semibold text-on-surface" id="clock-ticker">14:42:19 - 18/11/2025</span></span>
            </div>
        </div>

        <!-- Title & Primary Command Controls -->
        <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-space-md pb-space-md">
            <div class="space-y-1">
                <h1 class="font-headline-lg text-headline-lg text-on-surface flex items-center gap-space-sm">
                    <span class="material-symbols-outlined text-[34px] text-primary" style="font-variation-settings: 'FILL' 1;">bloodtype</span>
                    Quản Lý Kho Lưu Trữ Máu &amp; Điều Phối Túi Máu Khẩn Cấp
                </h1>
                <p class="font-body-md text-body-md text-on-surface-variant max-w-4xl">
                    Giám sát chuỗi lạnh tiêu chuẩn ISBT 128, kiểm soát tồn trữ theo hạn dùng sinh học của từng chế phẩm máu và điều hành mạng lưới cấp cứu liên viện 24/7 (Code Red Hotline).
                </p>
            </div>
            <!-- Quick Action Buttons -->
            <div class="flex flex-wrap items-center gap-space-sm shrink-0">
                <button class="inline-flex items-center gap-2 h-11 px-4 rounded-xl bg-surface-container-lowest text-on-surface font-label-md text-label-md shadow-sm hover:bg-surface-container-low transition-all" type="button" onclick="alert('Đang trích xuất báo cáo kiểm kê kho lưu trữ máu theo định dạng chuẩn Bộ Y Tế...')">
                    <span class="material-symbols-outlined text-[18px] text-on-surface-variant">file_download</span>
                    Xuất kiểm kê (PDF/XLSX)
                </button>
                <button class="inline-flex items-center gap-2 h-11 px-4 rounded-xl bg-surface-container-low text-primary font-label-md text-label-md shadow-sm hover:bg-surface-container transition-all" type="button" onclick="alert('Đang kết nối luồng cảm biến vi khí hậu IoT LoRaWAN...')">
                    <span class="material-symbols-outlined text-[18px]" style="font-variation-settings: 'FILL' 1;">sensors</span>
                    Nhật ký Cảm biến IoT
                </button>
                <button class="inline-flex items-center gap-2 h-11 px-5 rounded-xl bg-primary-container text-on-primary font-label-lg text-label-lg shadow-md hover:bg-primary transition-all font-bold" type="button" onclick="alert('Mở bảng điều lệnh kích hoạt cấp cứu Code Red liên viện!')">
                    <span class="material-symbols-outlined text-[20px] animate-pulse">crisis_alert</span>
                    + Lệnh Điều Phối Khẩn Cấp (Code Red)
                </button>
            </div>
        </div>

        <!-- 4 Dynamic Metric KPI Cards -->
        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-space-md mt-2">
            <!-- KPI 1 -->
            <div class="relative overflow-hidden rounded-xl bg-surface-container-lowest p-space-lg shadow-sm">
                <div class="flex items-start justify-between">
                    <div>
                        <p class="font-label-sm text-label-sm uppercase tracking-wider text-on-surface-variant font-semibold">Tổng Dung Lượng Tồn Kho</p>
                        <h3 class="font-headline-lg text-headline-lg text-on-surface mt-1">2,480 <span class="font-title-md text-title-md font-normal text-on-surface-variant">Đơn Vị</span></h3>
                    </div>
                    <div class="w-12 h-12 rounded-xl bg-primary-fixed flex items-center justify-center text-primary shrink-0">
                        <span class="material-symbols-outlined text-[26px]">inventory_2</span>
                    </div>
                </div>
                <div class="mt-4 flex items-center justify-between text-on-surface-variant font-body-sm text-body-sm">
                    <span class="inline-flex items-center text-primary font-semibold gap-1">
                        <span class="material-symbols-outlined text-[16px]">arrow_upward</span> +120 ĐV nhập hôm nay
                    </span>
                    <span class="font-mono text-on-surface font-semibold">Tỷ lệ lấp đầy: 78%</span>
                </div>
                <div class="w-full bg-surface-container-high h-2 rounded-full mt-2 overflow-hidden">
                    <div class="bg-primary h-full rounded-full" style="width: 78%;"></div>
                </div>
            </div>

            <!-- KPI 2 -->
            <div class="relative overflow-hidden rounded-xl bg-surface-container-lowest p-space-lg shadow-sm">
                <div class="flex items-start justify-between">
                    <div>
                        <p class="font-label-sm text-label-sm uppercase tracking-wider text-error font-semibold">Cảnh Báo Hết Hạn</p>
                        <h3 class="font-headline-lg text-headline-lg text-error mt-1">14 <span class="font-title-md text-title-md font-normal text-on-surface-variant">Túi Chế Phẩm</span></h3>
                    </div>
                    <div class="w-12 h-12 rounded-xl bg-error-container flex items-center justify-center text-error shrink-0">
                        <span class="material-symbols-outlined text-[26px]" style="font-variation-settings: 'FILL' 1;">warning</span>
                    </div>
                </div>
                <div class="mt-4 flex items-center justify-between text-on-surface-variant font-body-sm text-body-sm">
                    <span class="text-error font-semibold inline-flex items-center gap-1">
                        <span class="material-symbols-outlined text-[16px]">timer</span> Tiểu cầu &lt; 48h
                    </span>
                    <span class="px-2 py-0.5 rounded-full bg-error-container text-on-error-container font-label-sm text-label-sm font-bold">Ưu tiên luân chuyển</span>
                </div>
                <div class="w-full bg-surface-container-high h-2 rounded-full mt-2 overflow-hidden">
                    <div class="bg-error h-full rounded-full" style="width: 45%;"></div>
                </div>
            </div>

            <!-- KPI 3 -->
            <div class="relative overflow-hidden rounded-xl bg-surface-container-lowest p-space-lg shadow-sm">
                <div class="flex items-start justify-between">
                    <div>
                        <p class="font-label-sm text-label-sm uppercase tracking-wider text-on-surface-variant font-semibold">Giám Sát Chuỗi Lạnh IoT</p>
                        <h3 class="font-headline-lg text-headline-lg text-on-surface mt-1">2.8°C <span class="text-on-surface-variant font-light text-headline-sm">/ -26.5°C</span></h3>
                    </div>
                    <div class="w-12 h-12 rounded-xl bg-surface-container flex items-center justify-center text-on-surface shrink-0">
                        <span class="material-symbols-outlined text-[26px]">ac_unit</span>
                    </div>
                </div>
                <div class="mt-4 flex items-center justify-between font-body-sm text-body-sm">
                    <span class="inline-flex items-center gap-1 text-on-surface">
                        <span class="w-2 h-2 rounded-full bg-emerald-500"></span> 10 Tủ bảo quản ổn định
                    </span>
                    <span class="font-mono text-on-surface-variant text-label-sm">ISO 15189:2022</span>
                </div>
                <div class="w-full bg-surface-container-high h-2 rounded-full mt-2 overflow-hidden">
                    <div class="bg-emerald-600 h-full rounded-full" style="width: 100%;"></div>
                </div>
            </div>

            <!-- KPI 4 -->
            <div class="relative overflow-hidden rounded-xl bg-surface-container-lowest p-space-lg shadow-sm">
                <div class="flex items-start justify-between">
                    <div>
                        <p class="font-label-sm text-label-sm uppercase tracking-wider text-primary font-semibold">Cấp Cứu Cần Điều Phối</p>
                        <h3 class="font-headline-lg text-headline-lg text-primary mt-1">03 <span class="font-title-md text-title-md font-normal text-on-surface-variant">Lệnh Khẩn SOS</span></h3>
                    </div>
                    <div class="w-12 h-12 rounded-xl bg-secondary-fixed flex items-center justify-center text-primary shrink-0 animate-bounce">
                        <span class="material-symbols-outlined text-[26px]">e911_emergency</span>
                    </div>
                </div>
                <div class="mt-4 flex items-center justify-between text-on-surface font-body-sm text-body-sm">
                    <span class="text-primary font-semibold">Việt Đức • Bạch Mai • Nhi TW</span>
                    <span class="px-2 py-0.5 rounded-full bg-primary text-on-primary font-label-sm text-label-sm font-bold">Code Red</span>
                </div>
                <div class="w-full bg-surface-container-high h-2 rounded-full mt-2 overflow-hidden">
                    <div class="bg-primary h-full rounded-full" style="width: 85%;"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Workstation Layout: 2 Columns (7:5 Split) -->
    <div class="w-full px-space-lg pb-space-xl grid grid-cols-1 xl:grid-cols-12 gap-space-lg">
        <!-- LEFT PANEL (Col 1-7): Matrix & Cold Chain Monitors -->
        <div class="xl:col-span-7 flex flex-col gap-space-lg">
            <!-- SECTION 2: BẢNG MA TRẬN TỒN KHO THEO NHÓM MÁU VÀ CHẾ PHẨM MÁU -->
            <div class="rounded-xl bg-surface-container-lowest p-space-lg shadow-sm flex flex-col">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-space-sm mb-space-md">
                    <div>
                        <div class="flex items-center gap-2">
                            <span class="w-3 h-3 rounded-full bg-primary"></span>
                            <h2 class="font-headline-sm text-headline-sm text-on-surface">Ma Trận Dự Trữ Chế Phẩm &amp; Phân Loại Nhóm Máu</h2>
                        </div>
                        <p class="font-body-sm text-body-sm text-on-surface-variant mt-0.5">Phân loại chi tiết hệ ABO / Rh(+/-) gắn định mức dự trữ an toàn quốc gia</p>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="inline-flex items-center gap-1 font-label-sm text-label-sm px-2.5 py-1 rounded bg-surface-container text-on-surface-variant">
                            <span class="w-2 h-2 rounded-full bg-emerald-500"></span> An toàn
                        </span>
                        <span class="inline-flex items-center gap-1 font-label-sm text-label-sm px-2.5 py-1 rounded bg-secondary-fixed text-primary font-semibold">
                            <span class="w-2 h-2 rounded-full bg-amber-500"></span> Cần tiếp ứng
                        </span>
                        <span class="inline-flex items-center gap-1 font-label-sm text-label-sm px-2.5 py-1 rounded bg-error-container text-error font-bold">
                            <span class="w-2 h-2 rounded-full bg-error"></span> Báo động đỏ
                        </span>
                    </div>
                </div>

                <!-- Inventory Table Grid -->
                <div class="overflow-x-auto">
                    <table class="w-full text-left font-body-sm text-body-sm border-collapse">
                        <thead>
                            <tr class="bg-surface-container-low text-on-surface-variant font-label-md text-label-md">
                                <th class="py-3 px-3 rounded-l-xl">Hệ Máu (ABO/Rh)</th>
                                <th class="py-3 px-3">
                                    <div class="flex flex-col">
                                        <span>Hồng cầu lắng (RBC)</span>
                                        <span class="font-label-sm text-label-sm font-normal text-on-surface-variant">2-6°C • 42 ngày</span>
                                    </div>
                                </th>
                                <th class="py-3 px-3">
                                    <div class="flex flex-col">
                                        <span>Huyết tương đông (FFP)</span>
                                        <span class="font-label-sm text-label-sm font-normal text-on-surface-variant">≤ -25°C • 12 tháng</span>
                                    </div>
                                </th>
                                <th class="py-3 px-3">
                                    <div class="flex flex-col">
                                        <span>Khối tiểu cầu (PC)</span>
                                        <span class="font-label-sm text-label-sm font-normal text-on-surface-variant">20-24°C • 5 ngày</span>
                                    </div>
                                </th>
                                <th class="py-3 px-3">
                                    <div class="flex flex-col">
                                        <span>Tủa lạnh (CRYO)</span>
                                        <span class="font-label-sm text-label-sm font-normal text-on-surface-variant">≤ -20°C • 12 tháng</span>
                                    </div>
                                </th>
                                <th class="py-3 px-3 rounded-r-xl text-right">Tổng &amp; Chỉ số dự trữ</th>
                            </tr>
                        </thead>
                        <tbody class="text-on-surface">
                            <!-- ROW 1: O Rh- (CRITICAL EMERGENCY) -->
                            <tr class="bg-error-container/30 transition-colors">
                                <td class="py-3.5 px-3">
                                    <div class="flex items-center gap-2">
                                        <span class="px-2.5 py-1 rounded-lg bg-primary text-on-primary font-headline-sm text-headline-sm font-bold leading-none">O-</span>
                                        <div>
                                            <span class="font-label-md text-label-md font-bold text-error flex items-center gap-1">
                                                O Rh âm <span class="material-symbols-outlined text-[16px]">priority_high</span>
                                            </span>
                                            <span class="font-label-sm text-label-sm text-error">Nhóm máu hiếm tối cấp</span>
                                        </div>
                                    </div>
                                </td>
                                <td class="py-3.5 px-3">
                                    <div class="font-mono font-bold text-error">03 ĐV</div>
                                    <span class="font-label-sm text-label-sm text-error font-semibold">15% định mức</span>
                                </td>
                                <td class="py-3.5 px-3 font-mono">08 ĐV</td>
                                <td class="py-3.5 px-3">
                                    <span class="font-mono font-bold text-error">01 ĐV</span>
                                    <div class="font-label-sm text-label-sm text-error">Gần cạn kiệt</div>
                                </td>
                                <td class="py-3.5 px-3 font-mono">04 ĐV</td>
                                <td class="py-3.5 px-3 text-right">
                                    <span class="font-mono font-bold text-error text-title-md">16 ĐV</span>
                                    <div class="font-label-sm text-label-sm font-bold text-error">BÁO ĐỘNG ĐỎ</div>
                                </td>
                            </tr>
                            <!-- ROW 2: O Rh+ (DEFICIT) -->
                            <tr class="hover:bg-surface-container-low transition-colors">
                                <td class="py-3 px-3">
                                    <div class="flex items-center gap-2">
                                        <span class="px-2.5 py-1 rounded-lg bg-surface-container-high text-primary font-headline-sm text-headline-sm font-bold leading-none">O+</span>
                                        <div>
                                            <span class="font-label-md text-label-md font-semibold text-on-surface">O Rh dương</span>
                                            <span class="font-label-sm text-label-sm text-on-surface-variant block">Nhu cầu dùng cao</span>
                                        </div>
                                    </div>
                                </td>
                                <td class="py-3 px-3">
                                    <div class="font-mono font-semibold text-on-surface">342 ĐV</div>
                                    <span class="font-label-sm text-label-sm text-secondary font-semibold">45% định mức (Thiếu hụt)</span>
                                </td>
                                <td class="py-3 px-3 font-mono">410 ĐV</td>
                                <td class="py-3 px-3 font-mono">24 ĐV</td>
                                <td class="py-3 px-3 font-mono">82 ĐV</td>
                                <td class="py-3 px-3 text-right">
                                    <span class="font-mono font-bold text-on-surface text-title-md">858 ĐV</span>
                                    <div class="font-label-sm text-label-sm text-secondary font-semibold">Cần tiếp viện</div>
                                </td>
                            </tr>
                            <!-- ROW 3: A Rh+ (SAFE) -->
                            <tr class="hover:bg-surface-container-low transition-colors">
                                <td class="py-3 px-3">
                                    <div class="flex items-center gap-2">
                                        <span class="px-2.5 py-1 rounded-lg bg-surface-container text-on-surface font-headline-sm text-headline-sm font-bold leading-none">A+</span>
                                        <div>
                                            <span class="font-label-md text-label-md font-semibold text-on-surface">A Rh dương</span>
                                            <span class="font-label-sm text-label-sm text-emerald-700 block">Ổn định</span>
                                        </div>
                                    </div>
                                </td>
                                <td class="py-3 px-3 font-mono">285 ĐV</td>
                                <td class="py-3 px-3 font-mono">312 ĐV</td>
                                <td class="py-3 px-3 font-mono">19 ĐV</td>
                                <td class="py-3 px-3 font-mono">44 ĐV</td>
                                <td class="py-3 px-3 text-right">
                                    <span class="font-mono font-bold text-on-surface text-title-md">660 ĐV</span>
                                    <div class="font-label-sm text-label-sm text-emerald-700 font-semibold">88% định mức (Đạt)</div>
                                </td>
                            </tr>
                            <!-- ROW 4: B Rh+ (SAFE) -->
                            <tr class="hover:bg-surface-container-low transition-colors">
                                <td class="py-3 px-3">
                                    <div class="flex items-center gap-2">
                                        <span class="px-2.5 py-1 rounded-lg bg-surface-container text-on-surface font-headline-sm text-headline-sm font-bold leading-none">B+</span>
                                        <div>
                                            <span class="font-label-md text-label-md font-semibold text-on-surface">B Rh dương</span>
                                            <span class="font-label-sm text-label-sm text-emerald-700 block">Dồi dào</span>
                                        </div>
                                    </div>
                                </td>
                                <td class="py-3 px-3 font-mono">298 ĐV</td>
                                <td class="py-3 px-3 font-mono">280 ĐV</td>
                                <td class="py-3 px-3 font-mono">16 ĐV</td>
                                <td class="py-3 px-3 font-mono">51 ĐV</td>
                                <td class="py-3 px-3 text-right">
                                    <span class="font-mono font-bold text-on-surface text-title-md">645 ĐV</span>
                                    <div class="font-label-sm text-label-sm text-emerald-700 font-semibold">92% định mức (Đạt)</div>
                                </td>
                            </tr>
                            <!-- ROW 5: AB Rh+ & Hiếm Rh- khác -->
                            <tr class="hover:bg-surface-container-low transition-colors">
                                <td class="py-3 px-3">
                                    <div class="flex items-center gap-2">
                                        <span class="px-2.5 py-1 rounded-lg bg-surface-container text-on-surface font-headline-sm text-headline-sm font-bold leading-none">AB</span>
                                        <div>
                                            <span class="font-label-md text-label-md font-semibold text-on-surface">AB (+/-) &amp; Nhóm phụ</span>
                                            <span class="font-label-sm text-label-sm text-on-surface-variant block">Lưu trữ mục tiêu</span>
                                        </div>
                                    </div>
                                </td>
                                <td class="py-3 px-3 font-mono">124 ĐV</td>
                                <td class="py-3 px-3 font-mono">146 ĐV</td>
                                <td class="py-3 px-3 font-mono">08 ĐV</td>
                                <td class="py-3 px-3 font-mono">23 ĐV</td>
                                <td class="py-3 px-3 text-right">
                                    <span class="font-mono font-bold text-on-surface text-title-md">301 ĐV</span>
                                    <div class="font-label-sm text-label-sm text-on-surface-variant font-semibold">75% định mức</div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <!-- Inventory Urgency Banner -->
                <div class="mt-space-md p-space-sm rounded-xl bg-primary/10 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-space-sm">
                    <div class="flex items-center gap-2 text-primary font-body-sm text-body-sm font-medium">
                        <span class="material-symbols-outlined text-[20px]" style="font-variation-settings: 'FILL' 1;">campaign</span>
                        <span>Khuyến nghị tiếp nhận: Đang thiếu hụt nghiêm trọng <strong>O Rh(-)</strong> và <strong>O Rh(+)</strong>. Kích hoạt thông báo mời gọi người hiến máu tình nguyện hệ thống.</span>
                    </div>
                    <button class="shrink-0 px-3 py-1.5 rounded-lg bg-primary text-on-primary font-label-sm text-label-sm font-semibold hover:bg-primary-container transition-colors" type="button" onclick="alert('Đã gửi thông báo đẩy và SMS kêu gọi tới 1,250 tình nguyện viên nhóm máu O!')">
                        Gửi SMS Khẩn Cấp
                    </button>
                </div>
            </div>

            <!-- SECTION 3: GIÁM SÁT 4 PHÂN KHU TỦ BẢO QUẢN IOT THỜI GIAN THỰC -->
            <div class="rounded-xl bg-surface-container-lowest p-space-lg shadow-sm flex flex-col">
                <div class="flex items-center justify-between mb-space-md">
                    <div>
                        <div class="flex items-center gap-2">
                            <span class="material-symbols-outlined text-[22px] text-primary">device_thermostat</span>
                            <h2 class="font-headline-sm text-headline-sm text-on-surface">Giám Sát Chuỗi Lạnh 4 Phân Khu Tủ Bảo Quản (Cold Chain IoT)</h2>
                        </div>
                        <p class="font-body-sm text-body-sm text-on-surface-variant mt-0.5">Truyền dữ liệu không dây Modbus/LoRaWAN • Cảm biến kép sai số ±0.1°C</p>
                    </div>
                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-surface-container text-on-surface font-label-sm text-label-sm">
                        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span> IoT Gateway Online
                    </span>
                </div>

                <!-- 4 Refrigerator Pods Grid -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-space-md">
