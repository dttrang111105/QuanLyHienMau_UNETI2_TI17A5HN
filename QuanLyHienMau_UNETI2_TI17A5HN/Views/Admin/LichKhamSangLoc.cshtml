@model IEnumerable<QuanLyHienMau_UNETI2_TI17A5HN.Models.LichKhamSangLoc>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản Lý & Điều Phối Lịch Khám Sàng Lọc";

    var dotHienMaus = ViewBag.DotHienMaus as List<QuanLyHienMau_UNETI2_TI17A5HN.Models.DotHienMau> ?? new List<QuanLyHienMau_UNETI2_TI17A5HN.Models.DotHienMau>();
    var phieuSanSang = ViewBag.PhieuSanSangTaoLich as List<QuanLyHienMau_UNETI2_TI17A5HN.Models.PhieuDangKyHienMau> ?? new List<QuanLyHienMau_UNETI2_TI17A5HN.Models.PhieuDangKyHienMau>();
    var currentSearch = ViewBag.CurrentSearch as string;
    var currentTrangThai = ViewBag.CurrentTrangThai as string;
    var currentNgay = ViewBag.CurrentNgay as string;
    var currentMaDot = ViewBag.CurrentMaDot as int?;
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalItems = ViewBag.TotalItems ?? 0;
}

<div class="flex flex-col w-full">
    <!-- Top Hero & Breadcrumbs Section -->
    <div class="px-space-lg py-space-md bg-surface-container-lowest shadow-sm flex flex-col gap-space-md">
        <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-space-md">
            <!-- Breadcrumb and Title Group -->
            <div class="space-y-1">
                <nav class="flex items-center gap-1.5 text-on-surface-variant font-label-sm text-label-sm">
                    <a asp-controller="Admin" asp-action="Dashboard" class="hover:text-primary">Hệ thống Y tế</a>
                    <span class="material-symbols-outlined text-[14px]">chevron_right</span>
                    <span>Quản lý Y tế</span>
                    <span class="material-symbols-outlined text-[14px]">chevron_right</span>
                    <span class="text-primary font-bold">Lịch khám sàng lọc</span>
                </nav>
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-primary-fixed flex items-center justify-center text-primary shrink-0 shadow-sm">
                        <span class="material-symbols-outlined text-[24px]">medical_services</span>
                    </div>
                    <div>
                        <h1 class="font-headline-md text-headline-md text-on-surface font-bold tracking-tight">
                            Quản Lý &amp; Điều Phối Lịch Khám Sàng Lọc
                        </h1>
                        <p class="font-body-sm text-body-sm text-on-surface-variant">
                            Điều phối ca khám thực địa, ghi nhận kết quả khám lâm sàng ban đầu và phân bổ kíp trực y bác sĩ theo thời gian thực.
                        </p>
                    </div>
                </div>
            </div>

            <!-- Action Cluster -->
            <div class="flex flex-wrap items-center gap-space-sm shrink-0">
                <a asp-controller="Admin" asp-action="PhieuDangKyHienMau" class="flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-surface-container-low text-on-surface hover:bg-surface-container font-label-md text-label-md transition-all shadow-sm">
                    <span class="material-symbols-outlined text-[18px]">assignment_turned_in</span>
                    <span>Phiếu Đăng Ký</span>
                </a>
                <button type="button" class="flex items-center gap-2 px-4 py-2 rounded-xl bg-primary text-on-primary hover:bg-primary-container font-label-md text-label-md shadow-md transition-all" onclick="toggleNewSlotModal(true)">
                    <span class="material-symbols-outlined text-[18px]">add_circle</span>
                    <span>+ Thiết Lập Ca Mới</span>
                </button>
            </div>
        </div>

        <!-- Filter Bar -->
        <form method="get" asp-controller="Admin" asp-action="LichKhamSangLoc" class="grid grid-cols-1 md:grid-cols-12 gap-space-sm pt-space-xs">
            <!-- Search -->
            <div class="md:col-span-3 relative">
                <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant text-[20px]">search</span>
                <input type="search" name="search" value="@currentSearch" placeholder="Tìm tên TNV, SĐT, Bác sĩ..." class="w-full h-11 pl-10 pr-3 bg-surface-container-low rounded-xl font-body-sm text-body-sm text-on-surface focus:outline-none focus:ring-2 focus:ring-primary/20 shadow-sm placeholder:text-on-surface-variant/70" />
            </div>

            <!-- Status -->
            <div class="md:col-span-3 relative">
                <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant text-[20px]">filter_alt</span>
                <select name="trangThai" class="w-full h-11 pl-10 pr-8 bg-surface-container-low rounded-xl font-body-sm text-body-sm text-on-surface appearance-none focus:outline-none focus:ring-2 focus:ring-primary/20 shadow-sm cursor-pointer">
                    <option value="all" selected="@(string.IsNullOrEmpty(currentTrangThai) || currentTrangThai == "all")">Tất cả trạng thái</option>
                    <option value="Đã lên lịch" selected="@(currentTrangThai == "Đã lên lịch")">Đã lên lịch</option>
                    <option value="Đã hoàn thành" selected="@(currentTrangThai == "Đã hoàn thành")">Đã hoàn thành</option>
                    <option value="Đã hủy" selected="@(currentTrangThai == "Đã hủy")">Đã hủy</option>
                </select>
                <span class="material-symbols-outlined absolute right-2.5 top-1/2 -translate-y-1/2 text-on-surface-variant pointer-events-none text-[18px]">arrow_drop_down</span>
            </div>

            <!-- Date -->
            <div class="md:col-span-3 relative">
                <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant text-[20px]">calendar_today</span>
                <input type="date" name="ngay" value="@currentNgay" class="w-full h-11 pl-10 pr-3 bg-surface-container-low rounded-xl font-body-sm text-body-sm text-on-surface focus:outline-none focus:ring-2 focus:ring-primary/20 shadow-sm" />
            </div>

            <!-- Campaign -->
            <div class="md:col-span-2 relative">
                <select name="maDot" class="w-full h-11 px-3 bg-surface-container-low rounded-xl font-body-sm text-body-sm text-on-surface appearance-none focus:outline-none focus:ring-2 focus:ring-primary/20 shadow-sm cursor-pointer truncate">
                    <option value="" selected="@(!currentMaDot.HasValue)">Tất cả đợt</option>
                    @foreach (var d in dotHienMaus)
                    {
                        <option value="@d.MaDot" selected="@(currentMaDot == d.MaDot)">@d.TenDot</option>
                    }
                </select>
            </div>

            <!-- Filter Buttons -->
            <div class="md:col-span-1 flex items-center gap-1">
                <button type="submit" class="flex-1 h-11 rounded-xl bg-primary text-on-primary hover:bg-primary-container font-label-md text-label-md font-bold transition-all flex items-center justify-center shadow-sm" title="Lọc dữ liệu">
                    <span class="material-symbols-outlined text-[18px]">filter_list</span>
                </button>
                <a asp-controller="Admin" asp-action="LichKhamSangLoc" class="h-11 px-2.5 rounded-xl bg-surface-container text-on-surface hover:bg-surface-container-high transition-colors flex items-center justify-center" title="Bỏ lọc">
                    <span class="material-symbols-outlined text-[18px]">restart_alt</span>
                </a>
            </div>
        </form>
    </div>

    <!-- MAIN BODY -->
    <div class="p-space-lg space-y-space-md">
        <!-- Toast Alerts -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="p-space-md rounded-2xl bg-emerald-50 border border-emerald-200 text-emerald-900 flex items-center gap-3 shadow-sm">
                <span class="material-symbols-outlined text-emerald-600 text-[24px]">check_circle</span>
                <div class="flex-1 font-body-md text-body-md font-medium">@TempData["SuccessMessage"]</div>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="p-space-md rounded-2xl bg-error-container/60 border border-error text-on-error-container flex items-center gap-3 shadow-sm">
                <span class="material-symbols-outlined text-error text-[24px]">error</span>
                <div class="flex-1 font-body-md text-body-md font-medium">@TempData["ErrorMessage"]</div>
            </div>
        }

        <!-- KPI Metrics Ribbon -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-space-md">
            <!-- Total -->
            <div class="bg-surface-container-lowest rounded-2xl p-space-md shadow-sm flex flex-col justify-between">
                <div class="flex items-center justify-between">
                    <span class="font-label-md text-label-md text-on-surface-variant font-medium">Tổng số lịch khám</span>
                    <span class="w-8 h-8 rounded-lg bg-surface-container flex items-center justify-center text-primary">
                        <span class="material-symbols-outlined text-[18px]">event_note</span>
                    </span>
                </div>
                <div class="mt-2 flex items-baseline gap-2">
                    <span class="font-headline-lg text-headline-lg font-bold text-on-surface leading-none">@ViewBag.TotalLich</span>
                    <span class="font-label-sm text-label-sm text-on-surface-variant">Toàn hệ thống</span>
                </div>
            </div>

            <!-- Da Len Lich -->
            <div class="bg-surface-container-lowest rounded-2xl p-space-md shadow-sm flex flex-col justify-between border-l-4 border-sky-500">
                <div class="flex items-center justify-between">
                    <span class="font-label-md text-label-md text-sky-800 font-bold">Đã lên lịch</span>
                    <span class="w-8 h-8 rounded-lg bg-sky-50 flex items-center justify-center text-sky-600">
                        <span class="material-symbols-outlined text-[18px]">schedule</span>
                    </span>
                </div>
                <div class="mt-2 flex items-baseline gap-2">
                    <span class="font-headline-lg text-headline-lg font-bold text-sky-900 leading-none">@ViewBag.DaLenLichCount</span>
                    <span class="font-label-sm text-label-sm text-sky-700">Sẵn sàng tiếp nhận</span>
                </div>
            </div>

            <!-- Da Hoan Thanh -->
            <div class="bg-surface-container-lowest rounded-2xl p-space-md shadow-sm flex flex-col justify-between border-l-4 border-emerald-500">
                <div class="flex items-center justify-between">
                    <span class="font-label-md text-label-md text-emerald-800 font-bold">Đã hoàn thành khám</span>
                    <span class="w-8 h-8 rounded-lg bg-emerald-50 flex items-center justify-center text-emerald-600">
                        <span class="material-symbols-outlined text-[18px]">done_all</span>
                    </span>
                </div>
                <div class="mt-2 flex items-baseline gap-2">
                    <span class="font-headline-lg text-headline-lg font-bold text-emerald-900 leading-none">@ViewBag.DaHoanThanhCount</span>
                    <span class="font-label-sm text-label-sm text-emerald-700">Đã kiểm tra lâm sàng</span>
                </div>
            </div>

            <!-- Da Huy -->
            <div class="bg-surface-container-lowest rounded-2xl p-space-md shadow-sm flex flex-col justify-between border-l-4 border-surface-container-highest">
                <div class="flex items-center justify-between">
                    <span class="font-label-md text-label-md text-on-surface-variant font-medium">Đã hủy ca</span>
                    <span class="w-8 h-8 rounded-lg bg-surface-container flex items-center justify-center text-on-surface-variant">
                        <span class="material-symbols-outlined text-[18px]">event_busy</span>
                    </span>
                </div>
                <div class="mt-2 flex items-baseline gap-2">
                    <span class="font-headline-lg text-headline-lg font-bold text-on-surface-variant leading-none">@ViewBag.DaHuyCount</span>
                    <span class="font-label-sm text-label-sm text-on-surface-variant">Hủy hoặc chuyển ca</span>
                </div>
            </div>
        </div>

        <!-- MAIN TABLE VIEW CONTAINER -->
        <div class="bg-surface-container-lowest rounded-2xl shadow-sm overflow-hidden flex flex-col">
            <!-- Table Header -->
            <div class="p-space-md bg-surface-container-low flex flex-col sm:flex-row sm:items-center justify-between gap-space-sm">
                <div class="flex items-center gap-2">
                    <span class="material-symbols-outlined text-primary text-[20px]">calendar_month</span>
                    <h2 class="font-title-md text-title-md font-bold text-on-surface">Danh Sách Lịch Khám Sàng Lọc</h2>
                    <span class="px-2.5 py-0.5 rounded-full bg-surface-container text-on-surface-variant font-label-sm text-label-sm font-semibold">
                        @totalItems lượt khám
                    </span>
                </div>
                <div class="text-on-surface-variant font-label-sm text-label-sm">
                    Trang @currentPage / @totalPages
                </div>
            </div>

            <!-- Table -->
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-surface-container font-label-md text-label-md text-on-surface-variant">
                            <th class="p-3 w-36">Giờ Hẹn / Mã</th>
                            <th class="p-3 min-w-[220px]">Người Hiến Máu</th>
                            <th class="p-3 min-w-[200px]">Bác Sĩ &amp; Điểm Khám</th>
                            <th class="p-3 min-w-[200px]">Đợt Hiến Máu</th>
                            <th class="p-3 min-w-[140px]">Trạng Thái Lịch</th>
                            <th class="p-3 w-44 text-center">Thao Tác</th>
                        </tr>
                    </thead>
                    <tbody class="font-body-sm text-body-sm divide-y divide-surface-container">
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="6" class="p-12 text-center text-on-surface-variant">
                                    <div class="flex flex-col items-center justify-center gap-2">
                                        <span class="material-symbols-outlined text-[48px] text-on-surface-variant/40">event_busy</span>
                                        <p class="font-title-md text-title-md font-semibold">Không tìm thấy lịch khám nào</p>
                                        <p class="text-body-sm text-on-surface-variant/70">Thử thay đổi bộ lọc ngày, trạng thái hoặc từ khóa tìm kiếm.</p>
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                var donor = item.PhieuDangKyHienMau?.NguoiHienMau;
                                var dot = item.PhieuDangKyHienMau?.DotHienMau;

                                <tr class="hover:bg-surface-container-low transition-colors">
                                    <!-- Thoi gian & Ma Lich -->
                                    <td class="p-3 align-top">
                                        <span class="font-label-md text-label-md font-bold text-on-surface block">
                                            @item.ThoiGianBatDau.ToString("HH:mm") - @item.ThoiGianKetThuc.ToString("HH:mm")
                                        </span>
                                        <span class="font-label-sm text-label-sm text-primary font-bold block">
                                            #LKS-@item.MaLichKhamSangLoc.ToString("D4")
                                        </span>
                                        <span class="text-[11px] text-on-surface-variant">@item.ThoiGianBatDau.ToString("dd/MM/yyyy")</span>
                                    </td>

                                    <!-- Nguoi Hien Mau -->
                                    <td class="p-3 align-top">
                                        <div class="flex items-center gap-2.5">
                                            <div class="w-9 h-9 rounded-full bg-primary/10 text-primary flex items-center justify-center font-bold text-xs shrink-0">
                                                @(donor?.HoTen?.Length > 0 ? donor.HoTen[0].ToString().ToUpper() : "N")
                                            </div>
                                            <div class="min-w-0">
                                                <a asp-controller="Admin" asp-action="ChiTietPhieuDangKy" asp-route-id="@item.MaPhieu" class="font-label-md text-label-md font-bold text-on-surface hover:text-primary transition-colors truncate block">
                                                    @(donor?.HoTen ?? "Chưa rõ họ tên")
                                                </a>
                                                <div class="flex flex-wrap items-center gap-1.5 text-[12px] text-on-surface-variant">
                                                    @if (!string.IsNullOrEmpty(donor?.SoDienThoai))
                                                    {
                                                        <span>@donor.SoDienThoai</span>
                                                    }
                                                    @if (!string.IsNullOrEmpty(donor?.NhomMau))
                                                    {
                                                        <span class="px-1.5 py-0.2 rounded bg-primary-fixed text-primary font-bold text-[10px]">@donor.NhomMau</span>
                                                    }
                                                    @if (donor?.CanNang.HasValue == true)
                                                    {
                                                        <span>• @donor.CanNang kg</span>
                                                    }
                                                </div>
                                                <span class="text-[11px] text-on-surface-variant">Phiếu: #DKHM-@item.MaPhieu.ToString("D5")</span>
                                            </div>
                                        </div>
                                    </td>

                                    <!-- Bac Si & Dia Diem -->
                                    <td class="p-3 align-top">
                                        <p class="font-label-md text-label-md font-semibold text-on-surface">
                                            @(item.BacSiSangLoc ?? "BS. CKI Trần Mai Linh")
                                        </p>
                                        <p class="text-[12px] text-on-surface-variant truncate">
                                            @(item.DiaDiemHoacLienKet ?? "Điểm hiến máu")
                                        </p>
                                        <p class="text-[11px] text-on-surface-variant">
                                            Hình thức: @(item.HinhThucTiepNhan ?? "Trực tiếp")
                                        </p>
                                    </td>

                                    <!-- Dot Hien Mau -->
                                    <td class="p-3 align-top">
                                        <p class="font-label-md text-label-md font-semibold text-on-surface line-clamp-1" title="@dot?.TenDot">
                                            @(dot?.TenDot ?? "Chưa chỉ định")
                                        </p>
                                        @if (dot?.DonViToChuc != null)
                                        {
                                            <p class="text-[11px] text-on-surface-variant truncate">@dot.DonViToChuc.TenDonViToChuc</p>
                                        }
                                        <p class="text-[11px] text-on-surface-variant">
                                            Phiếu: <strong class="text-on-surface">@(item.PhieuDangKyHienMau?.TrangThai ?? "N/A")</strong>
                                        </p>
                                    </td>

                                    <!-- Trang Thai -->
                                    <td class="p-3 align-top">
                                        @if (item.TrangThai == "Đã lên lịch")
                                        {
                                            <span class="px-2.5 py-1 rounded-full bg-sky-100 text-sky-900 font-label-sm text-label-sm font-bold inline-flex items-center gap-1">
                                                <span class="w-1.5 h-1.5 rounded-full bg-sky-500 animate-pulse"></span>
                                                Đã lên lịch
                                            </span>
                                        }
                                        else if (item.TrangThai == "Đã hoàn thành")
                                        {
                                            <span class="px-2.5 py-1 rounded-full bg-emerald-100 text-emerald-900 font-label-sm text-label-sm font-bold inline-flex items-center gap-1">
                                                <span class="material-symbols-outlined text-[14px]">check_circle</span>
                                                Đã hoàn thành
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="px-2.5 py-1 rounded-full bg-surface-container text-on-surface-variant font-label-sm text-label-sm font-bold inline-flex items-center gap-1">
                                                <span class="material-symbols-outlined text-[14px]">cancel</span>
                                                @item.TrangThai
                                            </span>
                                        }

                                        @if (!string.IsNullOrEmpty(item.GhiChu))
                                        {
                                            <p class="text-[11px] text-on-surface-variant mt-1 line-clamp-1" title="@item.GhiChu">
                                                @item.GhiChu
                                            </p>
                                        }
                                    </td>

                                    <!-- Thao Tac -->
                                    <td class="p-3 align-top text-center">
                                        <div class="flex items-center justify-center gap-1">
                                            @if (item.TrangThai == "Đã lên lịch")
                                            {
                                                <!-- Hoan thanh kham button -->
                                                <form method="post" asp-controller="Admin" asp-action="HoanThanhKham" class="inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="maLich" value="@item.MaLichKhamSangLoc" />
                                                    <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                                    <button type="submit" class="p-2 rounded-xl bg-emerald-600 text-on-primary hover:bg-emerald-700 transition-colors shadow-sm" title="Xác nhận hoàn thành khám">
                                                        <span class="material-symbols-outlined text-[18px]">done_all</span>
                                                    </button>
                                                </form>

                                                <!-- Sua lich -->
                                                <button type="button" onclick="openEditModal(@item.MaLichKhamSangLoc, '@item.ThoiGianBatDau.ToString("yyyy-MM-ddTHH:mm")', '@item.ThoiGianKetThuc.ToString("yyyy-MM-ddTHH:mm")', '@(item.HinhThucTiepNhan ?? "")', '@(item.DiaDiemHoacLienKet ?? "")', '@(item.BacSiSangLoc ?? "")', '@(item.GhiChu ?? "")')" class="p-2 rounded-xl bg-surface-container text-on-surface hover:bg-surface-container-high transition-colors" title="Chỉnh sửa ca">
                                                    <span class="material-symbols-outlined text-[18px]">edit</span>
                                                </button>

                                                <!-- Huy lich -->
                                                <form method="post" asp-controller="Admin" asp-action="HuyLichKham" class="inline" onsubmit="return confirm('Bạn có chắc chắn muốn hủy lịch khám này?');">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="maLich" value="@item.MaLichKhamSangLoc" />
                                                    <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                                    <button type="submit" class="p-2 rounded-xl bg-error-container text-on-error-container hover:bg-error-container/80 transition-colors" title="Hủy ca">
                                                        <span class="material-symbols-outlined text-[18px]">delete</span>
                                                    </button>
                                                </form>
                                            }

                                            <!-- Chi tiet phieu -->
                                            <a asp-controller="Admin" asp-action="ChiTietPhieuDangKy" asp-route-id="@item.MaPhieu" class="p-2 rounded-xl bg-surface-container text-on-surface hover:bg-surface-container-high transition-colors" title="Xem hồ sơ phiếu đăng ký">
                                                <span class="material-symbols-outlined text-[18px]">visibility</span>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination Bar -->
            @if (totalPages > 1)
            {
                <div class="p-space-md bg-surface-container-low flex flex-col sm:flex-row items-center justify-between gap-space-sm">
                    <span class="font-body-sm text-body-sm text-on-surface-variant">
                        Hiển thị <strong>@Model.Count()</strong> trên tổng số <strong>@totalItems</strong> lượt khám
                    </span>
                    <div class="flex items-center gap-1 font-label-md text-label-md">
                        <a asp-controller="Admin" asp-action="LichKhamSangLoc"
                           asp-route-page="@(currentPage - 1)"
                           asp-route-search="@currentSearch"
                           asp-route-trangThai="@currentTrangThai"
                           asp-route-ngay="@currentNgay"
                           asp-route-maDot="@currentMaDot"
                           class="px-3 py-1.5 rounded-lg border border-outline-variant text-on-surface hover:bg-surface-container @(currentPage <= 1 ? "opacity-40 pointer-events-none" : "")">
                            « Trước
                        </a>

                        @for (int i = 1; i <= totalPages; i++)
                        {
                            if (i == 1 || i == totalPages || (i >= currentPage - 2 && i <= currentPage + 2))
                            {
                                <a asp-controller="Admin" asp-action="LichKhamSangLoc"
                                   asp-route-page="@i"
                                   asp-route-search="@currentSearch"
                                   asp-route-trangThai="@currentTrangThai"
                                   asp-route-ngay="@currentNgay"
                                   asp-route-maDot="@currentMaDot"
                                   class="px-3 py-1.5 rounded-lg font-bold @(i == currentPage ? "bg-primary text-on-primary shadow-sm" : "border border-outline-variant text-on-surface hover:bg-surface-container")">
                                    @i
                                </a>
                            }
                            else if (i == currentPage - 3 || i == currentPage + 3)
                            {
                                <span class="px-2 py-1 text-on-surface-variant">...</span>
                            }
                        }

                        <a asp-controller="Admin" asp-action="LichKhamSangLoc"
                           asp-route-page="@(currentPage + 1)"
                           asp-route-search="@currentSearch"
                           asp-route-trangThai="@currentTrangThai"
                           asp-route-ngay="@currentNgay"
                           asp-route-maDot="@currentMaDot"
                           class="px-3 py-1.5 rounded-lg border border-outline-variant text-on-surface hover:bg-surface-container @(currentPage >= totalPages ? "opacity-40 pointer-events-none" : "")">
                            Sau »
                        </a>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- MODAL: ADD / CONFIGURE NEW SCREENING SLOT -->
<div class="fixed inset-0 z-50 bg-inverse-surface/40 backdrop-blur-sm hidden flex items-center justify-center p-4" id="newSlotModal">
    <div class="bg-surface-container-lowest rounded-2xl max-w-xl w-full shadow-2xl overflow-hidden flex flex-col">
        <div class="p-space-md bg-surface-container flex items-center justify-between">
            <div class="flex items-center gap-2">
                <span class="material-symbols-outlined text-primary text-[22px]">add_circle</span>
                <h3 class="font-title-md text-title-md font-bold text-on-surface">Thiết Lập Ca Khám Sàng Lọc Mới</h3>
            </div>
            <button class="w-8 h-8 rounded-lg bg-surface-container-low text-on-surface hover:bg-surface-container-highest flex items-center justify-center" onclick="toggleNewSlotModal(false)">
                <span class="material-symbols-outlined text-[18px]">close</span>
            </button>
        </div>
        <form method="post" asp-controller="Admin" asp-action="TaoLichKham" class="p-space-lg space-y-space-md">
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />

            <div>
                <label class="block font-label-md text-label-md font-bold text-on-surface mb-1">Chọn Phiếu Đăng Ký Cần Khám <span class="text-primary">*</span></label>
                @if (!phieuSanSang.Any())
                {
                    <div class="p-3 bg-amber-50 text-amber-900 rounded-xl text-body-sm">
                        Hiện không có phiếu đăng ký nào ở trạng thái "Đã xác nhận" hoặc "Chờ khám sàng lọc" cần tạo lịch. Vui lòng duyệt phiếu đăng ký trước.
                    </div>
                }
                else
                {
                    <select name="maPhieu" required class="w-full h-11 px-3 bg-surface-container-low rounded-xl font-body-sm text-body-sm text-on-surface focus:outline-none focus:ring-2 focus:ring-primary/20 cursor-pointer">
                        @foreach (var p in phieuSanSang)
                        {
                            <option value="@p.MaPhieu">#DKHM-@p.MaPhieu.ToString("D5") – @(p.NguoiHienMau?.HoTen ?? "TNV") (@(p.DotHienMau?.TenDot ?? "Đợt hiến")) – [@p.TrangThai]</option>
                        }
                    </select>
                }
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-space-sm">
                <div>
                    <label class="block font-label-md text-label-md font-bold text-on-surface mb-1">Bác sĩ phụ trách <span class="text-primary">*</span></label>
                    <select name="bacSi" class="w-full h-11 px-3 bg-surface-container-low rounded-xl font-body-sm text-body-sm text-on-surface focus:outline-none focus:ring-2 focus:ring-primary/20">
                        <option value="BS. CKI Trần Mai Linh">BS. CKI Trần Mai Linh (Trưởng kíp)</option>
                        <option value="ThS. BS Lê Quốc Tuấn">ThS. BS Lê Quốc Tuấn (Huyết học)</option>
                        <option value="BS. Đỗ Phương Nga">BS. Đỗ Phương Nga (Nội khoa)</option>
                        <option value="BS. Vũ Hải Yến">BS. Vũ Hải Yến (Dịch tễ)</option>
                        <option value="BS. Hoàng Tuấn Anh">BS. Hoàng Tuấn Anh (Hồi sức)</option>
                    </select>
                </div>
                <div>
                    <label class="block font-label-md text-label-md font-bold text-on-surface mb-1">Hình thức tiếp nhận</label>
                    <select name="hinhThucTiepNhan" class="w-full h-11 px-3 bg-surface-container-low rounded-xl font-body-sm text-body-sm text-on-surface focus:outline-none focus:ring-2 focus:ring-primary/20">
                        <option value="Trực tiếp tại điểm hiến">Trực tiếp tại điểm hiến</option>
                        <option value="Xe hiến máu lưu động">Xe hiến máu lưu động</option>
                        <option value="Điểm cố định quận/huyện">Điểm cố định quận/huyện</option>
                    </select>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-space-sm">
                <div>
                    <label class="block font-label-md text-label-md font-bold text-on-surface mb-1">Thời gian bắt đầu <span class="text-primary">*</span></label>
                    <input type="datetime-local" name="thoiGianBatDau" required value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" class="w-full h-11 px-3 bg-surface-container-low rounded-xl font-body-sm text-body-sm text-on-surface focus:outline-none focus:ring-2 focus:ring-primary/20">
                </div>
                <div>
                    <label class="block font-label-md text-label-md font-bold text-on-surface mb-1">Thời gian kết thúc <span class="text-primary">*</span></label>
                    <input type="datetime-local" name="thoiGianKetThuc" required value="@DateTime.Now.AddHours(2).ToString("yyyy-MM-ddTHH:mm")" class="w-full h-11 px-3 bg-surface-container-low rounded-xl font-body-sm text-body-sm text-on-surface focus:outline-none focus:ring-2 focus:ring-primary/20">
                </div>
            </div>

            <div>
                <label class="block font-label-md text-label-md font-bold text-on-surface mb-1">Địa điểm / Bàn khám</label>
                <input type="text" name="diaDiem" value="Bàn 01 - Điểm hiến máu UNETI" class="w-full h-11 px-3 bg-surface-container-low rounded-xl font-body-sm text-body-sm text-on-surface focus:outline-none focus:ring-2 focus:ring-primary/20" />
            </div>

            <div>
                <label class="block font-label-md text-label-md font-bold text-on-surface mb-1">Ghi chú lâm sàng ban đầu</label>
                <input type="text" name="ghiChu" placeholder="Ví dụ: Đo huyết áp trước, kiểm tra chỉ số Hb..." class="w-full h-11 px-3 bg-surface-container-low rounded-xl font-body-sm text-body-sm text-on-surface focus:outline-none focus:ring-2 focus:ring-primary/20" />
            </div>

            <div class="p-space-md bg-surface-container-low flex items-center justify-end gap-space-sm">
                <button type="button" class="px-4 py-2 rounded-xl bg-surface-container text-on-surface hover:bg-surface-container-high font-label-md text-label-md font-semibold transition-colors" onclick="toggleNewSlotModal(false)">
                    Hủy bỏ
                </button>
                <button type="submit" class="px-5 py-2 rounded-xl bg-primary text-on-primary hover:bg-primary-container font-label-md text-label-md font-bold shadow-md transition-all" @(!phieuSanSang.Any() ? "disabled" : "")>
                    Lưu &amp; Kích Hoạt Ca Trực
                </button>
            </div>
        </form>
    </div>
</div>

<!-- MODAL: EDIT SCREENING SLOT -->
<div class="fixed inset-0 z-50 bg-inverse-surface/40 backdrop-blur-sm hidden flex items-center justify-center p-4" id="editSlotModal">
    <div class="bg-surface-container-lowest rounded-2xl max-w-xl w-full shadow-2xl overflow-hidden flex flex-col">
        <div class="p-space-md bg-surface-container flex items-center justify-between">
            <div class="flex items-center gap-2">
                <span class="material-symbols-outlined text-primary text-[22px]">edit</span>
                <h3 class="font-title-md text-title-md font-bold text-on-surface">Chỉnh Sửa Ca Khám Sàng Lọc</h3>
            </div>
            <button class="w-8 h-8 rounded-lg bg-surface-container-low text-on-surface hover:bg-surface-container-highest flex items-center justify-center" onclick="closeEditModal()">
                <span class="material-symbols-outlined text-[18px]">close</span>
            </button>
        </div>
        <form method="post" asp-controller="Admin" asp-action="SuaLichKham" class="p-space-lg space-y-space-md">
            @Html.AntiForgeryToken()
            <input type="hidden" id="editMaLich" name="maLich" value="" />
            <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />

            <div class="grid grid-cols-1 md:grid-cols-2 gap-space-sm">
                <div>
                    <label class="block font-label-md text-label-md font-bold text-on-surface mb-1">Bác sĩ phụ trách <span class="text-primary">*</span></label>
                    <input type="text" id="editBacSi" name="bacSi" class="w-full h-11 px-3 bg-surface-container-low rounded-xl font-body-sm text-body-sm text-on-surface focus:outline-none focus:ring-2 focus:ring-primary/20" />
                </div>
                <div>
                    <label class="block font-label-md text-label-md font-bold text-on-surface mb-1">Hình thức tiếp nhận</label>
                    <input type="text" id="editHinhThuc" name="hinhThucTiepNhan" class="w-full h-11 px-3 bg-surface-container-low rounded-xl font-body-sm text-body-sm text-on-surface focus:outline-none focus:ring-2 focus:ring-primary/20" />
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-space-sm">
                <div>
                    <label class="block font-label-md text-label-md font-bold text-on-surface mb-1">Thời gian bắt đầu <span class="text-primary">*</span></label>
                    <input type="datetime-local" id="editThoiGianBatDau" name="thoiGianBatDau" required class="w-full h-11 px-3 bg-surface-container-low rounded-xl font-body-sm text-body-sm text-on-surface focus:outline-none focus:ring-2 focus:ring-primary/20">
                </div>
                <div>
                    <label class="block font-label-md text-label-md font-bold text-on-surface mb-1">Thời gian kết thúc <span class="text-primary">*</span></label>
                    <input type="datetime-local" id="editThoiGianKetThuc" name="thoiGianKetThuc" required class="w-full h-11 px-3 bg-surface-container-low rounded-xl font-body-sm text-body-sm text-on-surface focus:outline-none focus:ring-2 focus:ring-primary/20">
                </div>
            </div>

            <div>
                <label class="block font-label-md text-label-md font-bold text-on-surface mb-1">Địa điểm / Bàn khám</label>
                <input type="text" id="editDiaDiem" name="diaDiem" class="w-full h-11 px-3 bg-surface-container-low rounded-xl font-body-sm text-body-sm text-on-surface focus:outline-none focus:ring-2 focus:ring-primary/20" />
            </div>

            <div>
                <label class="block font-label-md text-label-md font-bold text-on-surface mb-1">Ghi chú</label>
                <input type="text" id="editGhiChu" name="ghiChu" class="w-full h-11 px-3 bg-surface-container-low rounded-xl font-body-sm text-body-sm text-on-surface focus:outline-none focus:ring-2 focus:ring-primary/20" />
            </div>

            <div class="p-space-md bg-surface-container-low flex items-center justify-end gap-space-sm">
                <button type="button" class="px-4 py-2 rounded-xl bg-surface-container text-on-surface hover:bg-surface-container-high font-label-md text-label-md font-semibold transition-colors" onclick="closeEditModal()">
                    Hủy bỏ
                </button>
                <button type="submit" class="px-5 py-2 rounded-xl bg-primary text-on-primary hover:bg-primary-container font-label-md text-label-md font-bold shadow-md transition-all">
                    Lưu Cập Nhật
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function toggleNewSlotModal(show) {
            const modal = document.getElementById('newSlotModal');
            if (show) {
                modal.classList.remove('hidden');
            } else {
                modal.classList.add('hidden');
            }
        }

        function openEditModal(id, start, end, hinhThuc, diaDiem, bacSi, ghiChu) {
            document.getElementById('editMaLich').value = id;
            document.getElementById('editThoiGianBatDau').value = start;
            document.getElementById('editThoiGianKetThuc').value = end;
            document.getElementById('editHinhThuc').value = hinhThuc;
            document.getElementById('editDiaDiem').value = diaDiem;
            document.getElementById('editBacSi').value = bacSi;
            document.getElementById('editGhiChu').value = ghiChu;
            document.getElementById('editSlotModal').classList.remove('hidden');
        }

        function closeEditModal() {
            document.getElementById('editSlotModal').classList.add('hidden');
        }
    </script>
}
