@model IEnumerable<QuanLyHienMau_UNETI2_TI17A5HN.Models.NguoiHienMau>
@{
    // Module 3: Quản lý người hiến máu & phân loại nhóm máu hiếm
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản lý người hiến máu & phân loại nhóm máu hiếm";
    
    var tongNguoiHien = (int)(ViewBag.TongNguoiHien ?? 0);
    var tongMauHiem = (int)(ViewBag.TongMauHiem ?? 0);
    var oAm = (int)(ViewBag.OAm ?? 0);
    var aAm = (int)(ViewBag.AAm ?? 0);
    var bAm = (int)(ViewBag.BAm ?? 0);
    var abAm = (int)(ViewBag.ABAm ?? 0);
    var duDieuKienCount = (int)(ViewBag.DuDieuKienCount ?? 0);
    var hienTichCucCount = (int)(ViewBag.HienTichCucCount ?? 0);

    var totalItems = (int)(ViewBag.TotalItems ?? 0);
    var currentPage = (int)(ViewBag.CurrentPage ?? 1);
    var totalPages = (int)(ViewBag.TotalPages ?? 1);
    var pageSize = (int)(ViewBag.PageSize ?? 10);

    var currentSearch = (string?)ViewBag.CurrentSearch ?? "";
    var currentNhomMau = (string?)ViewBag.CurrentNhomMau ?? "";
    var currentRhGroup = (string?)ViewBag.CurrentRhGroup ?? "";
    var currentStatus = (string?)ViewBag.CurrentStatus ?? "";
    var currentTier = (string?)ViewBag.CurrentTier ?? "";
}

<div class="flex flex-col w-full">
    <!-- Top Ambient Glow Line -->
    <div class="h-1.5 w-full bg-gradient-to-r from-primary via-tertiary-container to-secondary"></div>

    <!-- Main Content Space -->
    <div class="px-space-lg py-space-md max-w-7xl mx-auto w-full space-y-space-lg">
        <!-- 1. Header & Breadcrumb & Action Suite -->
        <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-space-md">
            <div class="space-y-space-xs">
                <nav aria-label="Breadcrumb" class="flex items-center gap-2">
                    <span class="font-label-sm text-label-sm text-secondary">Hệ thống Quản trị Y tế</span>
                    <span class="text-surface-variant font-label-sm text-label-sm">/</span>
                    <span class="font-label-sm text-label-sm text-secondary">Đối tác &amp; Dữ liệu</span>
                    <span class="text-surface-variant font-label-sm text-label-sm">/</span>
                    <span class="font-label-sm text-label-sm font-semibold text-primary">Người hiến máu (Donors)</span>
                </nav>
                <h1 class="font-headline-lg text-headline-lg text-on-surface tracking-tight flex items-center gap-3 flex-wrap">
                    Danh Sách Người Hiến Máu &amp; Phân Loại Nhóm Máu Hiếm
                    <span class="px-2.5 py-0.5 rounded-full bg-primary/10 text-primary font-label-sm text-label-sm tracking-wide uppercase font-bold">ISBT 128 / VNeID v2</span>
                </h1>
                <p class="font-body-md text-body-md text-secondary max-w-4xl">
                    Quản lý hồ sơ định danh tình nguyện viên toàn hệ thống, phân loại nhóm máu hiếm Rh(-), Bombay, Kell, theo dõi chu kỳ an toàn 84 ngày và kích hoạt điều phối khẩn cấp 24/7.
                </p>
            </div>
            <!-- Action Buttons -->
            <div class="flex items-center flex-wrap gap-space-sm shrink-0">
                <button class="h-10 px-4 rounded-xl bg-surface-container-lowest text-on-surface shadow-sm hover:bg-surface-container transition-all flex items-center gap-2 font-label-md text-label-md" type="button" onclick="alert('Đang trích xuất danh sách người hiến máu (CSV / Excel)...')">
                    <span class="material-symbols-outlined text-[18px]">download</span>
                    <span>Xuất Danh Sách</span>
                </button>
                <button class="h-10 px-4 rounded-xl bg-tertiary text-on-tertiary shadow-sm hover:opacity-95 transition-all flex items-center gap-2 font-label-md text-label-md font-bold" onclick="openEmergencyModal()" type="button">
                    <span class="material-symbols-outlined text-[18px] animate-pulse">crisis_alert</span>
                    <span>Kêu Gọi Khẩn Cấp</span>
                </button>
                <a asp-controller="DangKy" asp-action="Create" class="h-10 px-5 rounded-xl bg-primary text-on-primary shadow-md hover:bg-primary-container transition-all flex items-center gap-2 font-label-md text-label-md font-bold">
                    <span class="material-symbols-outlined text-[18px]">person_add</span>
                    <span>Thêm Hồ Sơ Mới</span>
                </a>
            </div>
        </div>

        <!-- 2. 4 Metric Cards (KPI Band) -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-space-md">
            <!-- Card 1 -->
            <div class="bg-surface-container-lowest p-space-lg rounded-2xl shadow-sm flex flex-col justify-between space-y-space-md relative overflow-hidden group">
                <div class="absolute right-0 top-0 w-24 h-24 bg-primary/5 rounded-bl-full pointer-events-none transition-transform group-hover:scale-110"></div>
                <div class="flex items-center justify-between">
                    <span class="font-label-sm text-label-sm uppercase tracking-wider text-secondary font-semibold">Tổng Người Hiến Toàn Hệ Thống</span>
                    <div class="w-9 h-9 rounded-xl bg-primary-fixed flex items-center justify-center text-primary">
                        <span class="material-symbols-outlined text-[20px]">groups</span>
                    </div>
                </div>
                <div class="space-y-1">
                    <div class="flex items-baseline gap-2">
                        <span class="font-headline-lg text-headline-lg font-bold text-on-surface">@tongNguoiHien.ToString("N0")</span>
                        <span class="font-label-sm text-label-sm text-emerald-600 font-semibold flex items-center gap-0.5">
                            <span class="material-symbols-outlined text-[14px]">verified</span> Đã xác thực
                        </span>
                    </div>
                    <p class="font-body-sm text-body-sm text-secondary flex items-center gap-1.5">
                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                        Đã liên thông cơ sở dữ liệu quốc gia
                    </p>
                </div>
                <div class="w-full bg-surface-container rounded-full h-1.5 overflow-hidden">
                    <div class="bg-primary h-full rounded-full" style="width: 100%;"></div>
                </div>
            </div>

            <!-- Card 2: Rare Blood Club -->
            <div class="bg-surface-container-lowest p-space-lg rounded-2xl shadow-sm flex flex-col justify-between space-y-space-md relative overflow-hidden group">
                <div class="absolute right-0 top-0 w-24 h-24 bg-tertiary/10 rounded-bl-full pointer-events-none transition-transform group-hover:scale-110"></div>
                <div class="flex items-center justify-between">
                    <span class="font-label-sm text-label-sm uppercase tracking-wider text-tertiary font-bold flex items-center gap-1">
                        <span class="material-symbols-outlined text-[16px] text-tertiary">diamond</span>
                        CLB Nhóm Máu Hiếm
                    </span>
                    <div class="w-9 h-9 rounded-xl bg-tertiary-fixed flex items-center justify-center text-tertiary">
                        <span class="material-symbols-outlined text-[20px]">bloodtype</span>
                    </div>
                </div>
                <div class="space-y-1">
                    <div class="flex items-baseline gap-2">
                        <span class="font-headline-lg text-headline-lg font-bold text-tertiary">@tongMauHiem.ToString("N0")</span>
                        <span class="font-label-sm text-label-sm text-secondary">Tình nguyện viên</span>
                    </div>
                    <div class="flex flex-wrap gap-1.5 pt-1">
                        <span class="px-1.5 py-0.5 rounded bg-surface-container font-label-sm text-label-sm text-on-surface font-mono">O-: @oAm</span>
                        <span class="px-1.5 py-0.5 rounded bg-surface-container font-label-sm text-label-sm text-on-surface font-mono">A-: @aAm</span>
                        <span class="px-1.5 py-0.5 rounded bg-surface-container font-label-sm text-label-sm text-on-surface font-mono">B-: @bAm</span>
                        <span class="px-1.5 py-0.5 rounded bg-surface-container font-label-sm text-label-sm text-on-surface font-mono">AB-: @abAm</span>
                    </div>
                </div>
                <p class="font-body-sm text-body-sm text-emerald-700 bg-emerald-50 px-2 py-1 rounded-lg flex items-center gap-1 font-medium">
                    <span class="material-symbols-outlined text-[15px]">timer</span>
                    <strong>@oAm người O Rh(-)</strong> sẵn sàng điều phối
                </p>
            </div>

            <!-- Card 3 -->
            <div class="bg-surface-container-lowest p-space-lg rounded-2xl shadow-sm flex flex-col justify-between space-y-space-md relative overflow-hidden group">
                <div class="absolute right-0 top-0 w-24 h-24 bg-emerald-500/10 rounded-bl-full pointer-events-none transition-transform group-hover:scale-110"></div>
                <div class="flex items-center justify-between">
                    <span class="font-label-sm text-label-sm uppercase tracking-wider text-secondary font-semibold">Đủ Điều Kiện Hiến Ngay</span>
                    <div class="w-9 h-9 rounded-xl bg-emerald-100 flex items-center justify-center text-emerald-800">
                        <span class="material-symbols-outlined text-[20px]">event_available</span>
                    </div>
                </div>
                <div class="space-y-1">
                    <div class="flex items-baseline gap-2">
                        <span class="font-headline-lg text-headline-lg font-bold text-on-surface">@duDieuKienCount.ToString("N0")</span>
                        <span class="font-label-sm text-label-sm text-emerald-600 font-semibold">@(tongNguoiHien > 0 ? (duDieuKienCount * 100.0 / tongNguoiHien).ToString("0.0") : "0")%</span>
                    </div>
                    <p class="font-body-sm text-body-sm text-secondary">
                        Đã qua chu kỳ an toàn <strong class="text-on-surface">&ge; 84 ngày</strong>
                    </p>
                </div>
                <div class="flex items-center justify-between text-secondary font-label-sm text-label-sm pt-2 bg-surface-container-low px-2.5 py-1.5 rounded-lg">
                    <span>Chiến dịch tuần này:</span>
                    <span class="font-semibold text-primary">Sẵn sàng tiếp nhận</span>
                </div>
            </div>

            <!-- Card 4 -->
            <div class="bg-surface-container-lowest p-space-lg rounded-2xl shadow-sm flex flex-col justify-between space-y-space-md relative overflow-hidden group">
                <div class="absolute right-0 top-0 w-24 h-24 bg-amber-500/10 rounded-bl-full pointer-events-none transition-transform group-hover:scale-110"></div>
                <div class="flex items-center justify-between">
                    <span class="font-label-sm text-label-sm uppercase tracking-wider text-secondary font-semibold">Người Hiến Máu Tích Cực</span>
                    <div class="w-9 h-9 rounded-xl bg-amber-100 flex items-center justify-center text-amber-800">
                        <span class="material-symbols-outlined text-[20px]">military_tech</span>
                    </div>
                </div>
                <div class="space-y-1">
                    <div class="flex items-baseline gap-2">
                        <span class="font-headline-lg text-headline-lg font-bold text-on-surface">@hienTichCucCount.ToString("N0")</span>
                        <span class="font-label-sm text-label-sm text-amber-700 font-semibold bg-amber-50 px-2 py-0.5 rounded-md">Bạc &bull; Vàng &bull; Kim Cương</span>
                    </div>
                    <p class="font-body-sm text-body-sm text-secondary">
                        Đã hiến &ge; 5 lần; tỷ lệ cống hiến cao
                    </p>
                </div>
                <div class="w-full bg-surface-container rounded-full h-1.5 overflow-hidden">
                    <div class="bg-amber-500 h-full rounded-full" style="width: @(tongNguoiHien > 0 ? (hienTichCucCount * 100.0 / tongNguoiHien).ToString("0.0") : "0")%;"></div>
                </div>
            </div>
        </div>

        <!-- 3. Emergency Callout & Rare Blood Hotspot Banner -->
        <div class="bg-gradient-to-r from-tertiary-container via-primary-container to-primary text-on-primary rounded-3xl p-space-lg shadow-md relative overflow-hidden">
            <!-- Ambient light effect -->
            <div class="absolute -right-12 -top-12 w-64 h-64 rounded-full bg-white/10 blur-2xl pointer-events-none"></div>
            <div class="relative z-10 flex flex-col lg:flex-row lg:items-center justify-between gap-space-lg">
                <div class="space-y-2 max-w-2xl">
                    <div class="flex items-center gap-2">
                        <span class="px-2.5 py-1 rounded-full bg-white/20 backdrop-blur text-white font-label-sm text-label-sm font-bold flex items-center gap-1.5 animate-pulse">
                            <span class="w-2 h-2 rounded-full bg-amber-300"></span> BÁO ĐỘNG ĐỎ TRUNG TÂM MÁU QUỐC GIA
                        </span>
                        <span class="font-label-sm text-label-sm text-white/80">Khu vực: BV Hữu nghị Việt Đức &amp; Viện Huyết học TW</span>
                    </div>
                    <h2 class="font-headline-md text-headline-md font-bold text-white tracking-tight">
                        CẢNH BÁO THIẾU HỤT TỒN KHO NHÓM MÁU HIẾM O Rh(-) VÀ B Rh(-)
                    </h2>
                    <p class="font-body-md text-body-md text-white/90">
                        Yêu cầu khẩn: Cần <strong>15 đơn vị O Rh(-)</strong> phục vụ 2 ca phẫu thuật đa chấn thương sọ não. Hệ thống ghi nhận <strong>@oAm tình nguyện viên O Rh(-)</strong> trong cơ sở dữ liệu toàn quốc.
                    </p>
                    <div class="flex items-center gap-4 pt-1 font-label-md text-label-md">
                        <span class="flex items-center gap-1 text-white">
                            <span class="material-symbols-outlined text-[18px] text-emerald-300">check_circle</span>
                            <strong>@duDieuKienCount người</strong> đủ điều kiện hiến ngay
                        </span>
                        <span class="flex items-center gap-1 text-white">
                            <span class="material-symbols-outlined text-[18px] text-amber-300">hourglass_top</span>
                            <strong>@tongMauHiem người</strong> thuộc CLB Máu hiếm
                        </span>
                    </div>
                </div>
                <!-- Quick Emergency Engine Controls -->
                <div class="bg-black/20 backdrop-blur-md p-space-md rounded-2xl flex flex-col sm:flex-row lg:flex-col gap-space-sm shrink-0 w-full lg:w-80">
                    <div class="space-y-1">
                        <span class="font-label-sm text-label-sm text-white/70 uppercase font-semibold">Mục tiêu phát lệnh điều phối:</span>
                        <div class="flex items-center justify-between bg-white/10 px-3 py-2 rounded-xl text-white">
                            <div class="flex items-center gap-2">
                                <span class="px-2 py-0.5 rounded bg-tertiary font-bold font-mono text-sm">O Rh(-)</span>
                                <span class="text-body-sm font-medium">Bán kính toàn quốc</span>
                            </div>
                            <span class="font-label-sm text-label-sm font-semibold text-amber-300">@oAm sẵn sàng</span>
                        </div>
                    </div>
                    <button class="w-full py-2.5 px-4 rounded-xl bg-white text-primary font-label-md text-label-md font-bold shadow-md hover:bg-surface-bright transition-all flex items-center justify-center gap-2" type="button" onclick="openEmergencyModal()">
                        <span class="material-symbols-outlined text-[18px]">send</span>
                        <span>Phát Lệnh SMS &amp; VNeID (@oAm)</span>
                    </button>
                    <button class="w-full py-2 px-3 rounded-xl bg-white/15 text-white hover:bg-white/20 transition-all font-label-sm text-label-sm flex items-center justify-center gap-1.5 font-semibold" type="button" onclick="alert('Kíp trực khẩn cấp: BS. Trần Mai Linh, ĐD. Nguyễn Bích Ngọc, KTV. Lê Thảo Trang.')">
                        <span class="material-symbols-outlined text-[16px]">support_agent</span>
                        <span>Xem Danh Sách Kíp Trực Khẩn Cấp</span>
                    </button>
                </div>
            </div>
        </div>

        <!-- 4. Advanced Multi-dimensional Filter Bar -->
        <form method="get" asp-controller="Admin" asp-action="NguoiHienMau" class="bg-surface-container-lowest rounded-2xl p-space-lg shadow-sm space-y-space-md">
            <input type="hidden" name="nhomMau" value="@currentNhomMau" />
            <input type="hidden" name="rhGroup" value="@currentRhGroup" />
            <input type="hidden" name="status" value="@currentStatus" />

            <!-- Search Input & Quick Actions -->
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-space-md">
                <div class="lg:col-span-6 relative">
                    <span class="material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-secondary text-[20px]">search</span>
                    <input class="w-full h-12 pl-11 pr-4 rounded-xl bg-surface-container-low font-body-md text-body-md text-on-surface placeholder:text-secondary/70 focus:outline-none focus:ring-2 focus:ring-primary/20 focus:bg-surface-container-lowest transition-all" 
                           id="donorSearchInput" 
                           name="search" 
                           value="@currentSearch"
                           placeholder="Tìm theo Họ tên, CCCD/Tài khoản, Số điện thoại, Địa chỉ, Mã ID..." 
                           type="text">
                </div>
                <div class="lg:col-span-3">
                    <div class="relative">
                        <select class="w-full h-12 px-4 rounded-xl bg-surface-container-low font-body-md text-body-md text-on-surface appearance-none focus:outline-none focus:ring-2 focus:ring-primary/20" 
                                name="statusSelect" 
                                onchange="location.href='@Url.Action("NguoiHienMau", "Admin", new { search = currentSearch, nhomMau = currentNhomMau, rhGroup = currentRhGroup, tier = currentTier })&status=' + this.value;">
                            <option value="" selected="@(string.IsNullOrEmpty(currentStatus))">Tất cả trạng thái hồ sơ</option>
                            <option value="hoatdong" selected="@(currentStatus == "hoatdong")">Đang hoạt động</option>
                            <option value="dudieukien" selected="@(currentStatus == "dudieukien")">Đủ điều kiện hiến ngay (≥ 84 ngày)</option>
                            <option value="tamhoan" selected="@(currentStatus == "tamhoan")">Tạm hoãn y khoa</option>
                        </select>
                        <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-secondary pointer-events-none text-[20px]">expand_more</span>
                    </div>
                </div>
                <div class="lg:col-span-3 flex items-center gap-space-sm">
                    <div class="relative flex-1">
                        <select class="w-full h-12 px-4 rounded-xl bg-surface-container-low font-body-md text-body-md text-on-surface appearance-none focus:outline-none focus:ring-2 focus:ring-primary/20" 
                                name="tier" 
                                onchange="this.form.submit()">
                            <option value="" selected="@(string.IsNullOrEmpty(currentTier))">Tất cả phân hạng cống hiến</option>
                            <option value="diamond" selected="@(currentTier == "diamond")">Kim Cương (≥ 20 lần)</option>
                            <option value="gold" selected="@(currentTier == "gold")">Vàng (10 - 19 lần)</option>
                            <option value="silver" selected="@(currentTier == "silver")">Bạc (5 - 9 lần)</option>
                            <option value="bronze" selected="@(currentTier == "bronze")">Đồng (1 - 4 lần)</option>
                        </select>
                        <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-secondary pointer-events-none text-[20px]">expand_more</span>
                    </div>
                    <button class="h-12 px-4 rounded-xl bg-primary text-on-primary font-label-md text-label-md font-bold shadow-xs hover:bg-primary-container transition-all flex items-center gap-1.5" type="submit">
                        <span class="material-symbols-outlined text-[18px]">filter_list</span>
                        <span>Lọc</span>
                    </button>
                    <a asp-controller="Admin" asp-action="NguoiHienMau" class="h-12 w-12 rounded-xl bg-surface-container-low text-secondary hover:text-primary hover:bg-surface-container flex items-center justify-center shrink-0 transition-colors" title="Làm mới bộ lọc">
                        <span class="material-symbols-outlined text-[20px]">refresh</span>
                    </a>
                </div>
            </div>

            <!-- Segmented Tag Filters (Blood Type & Status) -->
            <div class="pt-2 flex flex-col md:flex-row items-start md:items-center justify-between gap-space-md border-t border-surface-container">
                <!-- ABO Groups -->
                <div class="flex items-center gap-2 flex-wrap">
                    <span class="font-label-sm text-label-sm text-secondary uppercase tracking-wider font-semibold mr-1">Nhóm máu ABO:</span>
                    <a asp-action="NguoiHienMau" asp-route-search="@currentSearch" asp-route-nhomMau="" asp-route-rhGroup="@currentRhGroup" asp-route-status="@currentStatus" asp-route-tier="@currentTier"
                       class="px-3 py-1.5 rounded-lg @(string.IsNullOrEmpty(currentNhomMau) ? "bg-primary text-on-primary font-bold shadow-xs" : "bg-surface-container-low hover:bg-surface-container text-on-surface") font-label-sm text-label-sm font-semibold transition-colors">
                        Tất cả
                    </a>
                    <a asp-action="NguoiHienMau" asp-route-search="@currentSearch" asp-route-nhomMau="O" asp-route-rhGroup="@currentRhGroup" asp-route-status="@currentStatus" asp-route-tier="@currentTier"
                       class="px-3 py-1.5 rounded-lg @(currentNhomMau == "O" ? "bg-primary text-on-primary font-bold shadow-xs" : "bg-surface-container-low hover:bg-surface-container text-on-surface") font-label-sm text-label-sm font-semibold transition-colors">
                        Nhóm O
                    </a>
                    <a asp-action="NguoiHienMau" asp-route-search="@currentSearch" asp-route-nhomMau="A" asp-route-rhGroup="@currentRhGroup" asp-route-status="@currentStatus" asp-route-tier="@currentTier"
                       class="px-3 py-1.5 rounded-lg @(currentNhomMau == "A" ? "bg-primary text-on-primary font-bold shadow-xs" : "bg-surface-container-low hover:bg-surface-container text-on-surface") font-label-sm text-label-sm font-semibold transition-colors">
                        Nhóm A
                    </a>
                    <a asp-action="NguoiHienMau" asp-route-search="@currentSearch" asp-route-nhomMau="B" asp-route-rhGroup="@currentRhGroup" asp-route-status="@currentStatus" asp-route-tier="@currentTier"
                       class="px-3 py-1.5 rounded-lg @(currentNhomMau == "B" ? "bg-primary text-on-primary font-bold shadow-xs" : "bg-surface-container-low hover:bg-surface-container text-on-surface") font-label-sm text-label-sm font-semibold transition-colors">
                        Nhóm B
                    </a>
                    <a asp-action="NguoiHienMau" asp-route-search="@currentSearch" asp-route-nhomMau="AB" asp-route-rhGroup="@currentRhGroup" asp-route-status="@currentStatus" asp-route-tier="@currentTier"
                       class="px-3 py-1.5 rounded-lg @(currentNhomMau == "AB" ? "bg-primary text-on-primary font-bold shadow-xs" : "bg-surface-container-low hover:bg-surface-container text-on-surface") font-label-sm text-label-sm font-semibold transition-colors">
                        Nhóm AB
                    </a>
                </div>
                <!-- Rh and Rare Status -->
                <div class="flex items-center gap-2 flex-wrap">
                    <span class="font-label-sm text-label-sm text-secondary uppercase tracking-wider font-semibold mr-1">Yếu tố Rh &amp; CLB:</span>
                    <a asp-action="NguoiHienMau" asp-route-search="@currentSearch" asp-route-nhomMau="@currentNhomMau" asp-route-rhGroup="@(currentRhGroup == "rh_am" ? "" : "rh_am")" asp-route-status="@currentStatus" asp-route-tier="@currentTier"
                       class="px-3 py-1.5 rounded-lg @(currentRhGroup == "rh_am" ? "bg-tertiary text-on-tertiary font-bold ring-2 ring-tertiary/40" : "bg-tertiary-fixed text-tertiary") font-label-sm text-label-sm font-bold flex items-center gap-1 shadow-xs transition-all">
                        <span class="material-symbols-outlined text-[16px]">emergency</span>
                        Rh(-) Âm tính (Máu Hiếm)
                    </a>
                    <a asp-action="NguoiHienMau" asp-route-search="@currentSearch" asp-route-nhomMau="@currentNhomMau" asp-route-rhGroup="@(currentRhGroup == "rh_duong" ? "" : "rh_duong")" asp-route-status="@currentStatus" asp-route-tier="@currentTier"
                       class="px-3 py-1.5 rounded-lg @(currentRhGroup == "rh_duong" ? "bg-primary text-on-primary font-bold" : "bg-surface-container-low hover:bg-surface-container text-on-surface") font-label-sm text-label-sm font-semibold transition-colors">
                        Rh(+) Dương tính
                    </a>
                    <a asp-action="NguoiHienMau" asp-route-search="@currentSearch" asp-route-nhomMau="@currentNhomMau" asp-route-rhGroup="@currentRhGroup" asp-route-status="@(currentStatus == "dudieukien" ? "" : "dudieukien")" asp-route-tier="@currentTier"
                       class="px-3 py-1.5 rounded-lg @(currentStatus == "dudieukien" ? "bg-emerald-600 text-white font-bold" : "bg-emerald-50 text-emerald-800 hover:bg-emerald-100") font-label-sm text-label-sm font-semibold transition-colors flex items-center gap-1">
                        <span class="w-2 h-2 rounded-full @(currentStatus == "dudieukien" ? "bg-white" : "bg-emerald-600")"></span>
                        Đủ điều kiện hiến ngay (≥ 84 ngày)
                    </a>
                    <a asp-action="NguoiHienMau" asp-route-search="@currentSearch" asp-route-nhomMau="@currentNhomMau" asp-route-rhGroup="@currentRhGroup" asp-route-status="@(currentStatus == "tamhoan" ? "" : "tamhoan")" asp-route-tier="@currentTier"
                       class="px-3 py-1.5 rounded-lg @(currentStatus == "tamhoan" ? "bg-error text-on-error font-bold" : "bg-surface-container-low hover:bg-surface-container text-on-surface") font-label-sm text-label-sm font-semibold transition-colors">
                        Tạm hoãn y khoa
                    </a>
                </div>
            </div>
        </form>

        <!-- 5. Detailed Donors Data Table (ISBT 128 / VNeID Standard) -->
        <div class="bg-surface-container-lowest rounded-2xl shadow-sm overflow-hidden">
            <!-- Table Top Meta -->
            <div class="px-space-lg py-space-md bg-surface-container-low/50 flex flex-col sm:flex-row sm:items-center justify-between gap-space-sm">
                <div class="flex items-center gap-2">
                    <span class="font-label-md text-label-md font-semibold text-on-surface">Danh sách hồ sơ lâm sàng &amp; lịch sử hiến</span>
                    <span class="px-2 py-0.5 rounded-full bg-surface-container-highest text-secondary font-label-sm text-label-sm font-semibold">@totalItems bản ghi</span>
                </div>
                <div class="flex items-center gap-space-md text-secondary font-body-sm text-body-sm">
                    <span class="flex items-center gap-1">
                        <span class="material-symbols-outlined text-[16px] text-emerald-600">verified</span>
                        Cơ sở dữ liệu Y tế số
                    </span>
                    <span class="flex items-center gap-1">
                        <span class="material-symbols-outlined text-[16px] text-primary">bloodtype</span>
                        Quy chuẩn an toàn truyền máu 84 ngày
                    </span>
                </div>
            </div>

            <!-- Table Body -->
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-surface-container text-on-surface font-label-sm text-label-sm uppercase tracking-wider">
                            <th class="py-3.5 px-4 font-bold" scope="col">Mã Định Danh &amp; Họ Tên</th>
                            <th class="py-3.5 px-4 font-bold" scope="col">Nhóm Máu (ISBT 128)</th>
                            <th class="py-3.5 px-4 font-bold" scope="col">Tần Suất &amp; Phân Hạng</th>
                            <th class="py-3.5 px-4 font-bold" scope="col">Lần Hiến Cuối &amp; Chu Kỳ 84 Ngày</th>
                            <th class="py-3.5 px-4 font-bold" scope="col">Chỉ Số Lâm Sàng</th>
                            <th class="py-3.5 px-4 font-bold" scope="col">Khu Vực &amp; Liên Lạc Khẩn Cấp</th>
                            <th class="py-3.5 px-4 font-bold text-center" scope="col">Thao Tác</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-surface-container/50 text-on-surface font-body-md text-body-md">
                        @if (Model == null || !Model.Any())
                        {
                            <tr>
                                <td colspan="7" class="py-12 px-4 text-center">
                                    <div class="flex flex-col items-center justify-center space-y-3">
                                        <div class="w-16 h-16 rounded-full bg-surface-container flex items-center justify-center text-secondary">
                                            <span class="material-symbols-outlined text-[36px]">search_off</span>
                                        </div>
                                        <h4 class="font-headline-sm text-headline-sm font-bold text-on-surface">Không tìm thấy người hiến máu phù hợp</h4>
                                        <p class="font-body-sm text-body-sm text-secondary max-w-md">
                                            Không có hồ sơ nào khớp với từ khóa tìm kiếm hoặc bộ lọc hiện tại. Vui lòng thử từ khóa khác hoặc làm mới bộ lọc.
                                        </p>
                                        <a asp-controller="Admin" asp-action="NguoiHienMau" class="px-4 py-2 rounded-xl bg-primary text-on-primary font-label-md text-label-md font-semibold">
                                            Xem tất cả người hiến
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var donor in Model)
                            {
                                var isRare = donor.NhomMau != null && (donor.NhomMau.Contains("-") || donor.NhomMau.Contains("Rh(-)") || donor.NhomMau.Contains("Rh-"));
                                var soLanHien = donor.PhieuDangKyHienMaus.Count(p => p.TrangThai == "Hiến máu thành công" || p.KetQuaHienMau != null);
                                var tongLuongMau = soLanHien * 350;

                                string tierName = "Chưa hiến";
                                string tierBadgeClass = "bg-surface-container text-secondary";
                                if (soLanHien >= 20) { tierName = "Kim Cương"; tierBadgeClass = "bg-purple-100 text-purple-900 font-bold"; }
                                else if (soLanHien >= 10) { tierName = "Hạng Vàng"; tierBadgeClass = "bg-amber-100 text-amber-800 font-bold"; }
                                else if (soLanHien >= 5) { tierName = "Hạng Bạc"; tierBadgeClass = "bg-slate-100 text-slate-700 font-semibold"; }
                                else if (soLanHien >= 1) { tierName = "Hạng Đồng"; tierBadgeClass = "bg-amber-50 text-amber-900 font-semibold"; }

                                var lastPhieu = donor.PhieuDangKyHienMaus
                                    .Where(p => p.TrangThai == "Hiến máu thành công" || p.KetQuaHienMau != null)
                                    .OrderByDescending(p => p.NgayXuLy ?? p.NgayNop)
                                    .FirstOrDefault();

                                var initials = string.Join("", (donor.HoTen ?? "N H").Split(' ', StringSplitOptions.RemoveEmptyEntries).TakeLast(2).Select(s => s[0]));
                                int age = 0;
                                if (donor.NgaySinh.HasValue)
                                {
                                    age = DateTime.Today.Year - donor.NgaySinh.Value.Year;
                                    if (donor.NgaySinh.Value.Date > DateTime.Today.AddYears(-age)) age--;
                                }

                                <tr class="@(isRare ? "bg-tertiary-fixed/15 hover:bg-tertiary-fixed/25" : "hover:bg-surface-container-low/70") transition-colors">
                                    <!-- Cột 1: Mã định danh & Họ tên -->
                                    <td class="py-4 px-4">
                                        <div class="flex items-center gap-3">
                                            <div class="w-10 h-10 rounded-full @(isRare ? "bg-tertiary text-on-tertiary" : "bg-primary/10 text-primary") flex items-center justify-center font-bold text-sm shrink-0">
                                                @initials.ToUpper()
                                            </div>
                                            <div class="flex flex-col min-w-0">
                                                <div class="flex items-center gap-1.5 flex-wrap">
                                                    <span class="font-label-md text-label-md font-bold @(isRare ? "text-tertiary" : "text-on-surface") truncate">@donor.HoTen</span>
                                                    <span class="material-symbols-outlined text-[16px] text-emerald-600" title="Hồ sơ đã định danh">verified</span>
                                                    @if (isRare)
                                                    {
                                                        <span class="px-1.5 py-0.5 rounded bg-tertiary text-on-tertiary font-label-sm text-[10px] uppercase font-bold tracking-wider">CLB MÁU HIẾM</span>
                                                    }
                                                </div>
                                                <span class="font-body-sm text-body-sm text-secondary">
                                                    @(donor.GioiTinh ?? "Chưa rõ") • @(age > 0 ? $"{age} tuổi" : "Chưa rõ tuổi") • CCCD: <span class="font-mono">@(donor.TaiKhoan != null ? donor.TaiKhoan.TenDangNhap : $"00{donor.MaNguoiHien:D4}****")</span>
                                                </span>
                                                <span class="font-mono text-label-sm text-label-sm @(isRare ? "text-tertiary font-semibold" : "text-secondary/70")">ID: DONOR-@donor.MaNguoiHien.ToString("D5")</span>
                                            </div>
                                        </div>
                                    </td>

                                    <!-- Cột 2: Nhóm máu -->
                                    <td class="py-4 px-4">
                                        <div class="flex flex-col items-start gap-1">
                                            <span class="px-2.5 py-1 rounded-lg @(isRare ? "bg-tertiary text-on-tertiary font-bold" : "bg-surface-container-high text-on-surface font-bold") font-mono text-sm tracking-wide flex items-center gap-1">
                                                @if (isRare)
                                                {
                                                    <span class="material-symbols-outlined text-[14px] text-amber-300">emergency</span>
                                                }
                                                @(string.IsNullOrEmpty(donor.NhomMau) ? "Chưa rõ" : donor.NhomMau)
                                            </span>
                                            <span class="font-label-sm text-label-sm @(isRare ? "text-tertiary font-bold" : "text-secondary")">
                                                @(isRare ? "Máu hiếm quốc gia" : "Nhóm máu phổ thông")
                                            </span>
                                        </div>
                                    </td>

                                    <!-- Cột 3: Tần suất & Phân hạng -->
                                    <td class="py-4 px-4">
                                        <div class="flex flex-col gap-1">
                                            <div class="flex items-center gap-1.5">
                                                <span class="px-2 py-0.5 rounded bg-surface-container text-secondary font-label-sm text-label-sm font-semibold">
                                                    @soLanHien lần
                                                </span>
                                                <span class="px-2 py-0.5 rounded @tierBadgeClass font-label-sm text-label-sm">
                                                    @tierName
                                                </span>
                                            </div>
                                            <span class="font-body-sm text-body-sm text-secondary">Tổng hiến: <strong class="text-on-surface">@tongLuongMau.ToString("N0") mL</strong></span>
                                        </div>
                                    </td>

                                    <!-- Cột 4: Lần hiến cuối & Chu kỳ 84 ngày -->
                                    <td class="py-4 px-4">
                                        <div class="flex flex-col gap-1 max-w-xs">
                                            @if (donor.TrangThai != "Hoạt động" && !string.IsNullOrEmpty(donor.TrangThai))
                                            {
                                                <span class="px-2.5 py-0.5 rounded-full bg-error-container text-on-error-container font-label-sm text-label-sm font-bold flex items-center gap-1 w-fit">
                                                    <span class="material-symbols-outlined text-[14px]">block</span> TẠM HOÃN Y KHOA
                                                </span>
                                                <span class="font-body-sm text-body-sm text-secondary">Trạng thái: @donor.TrangThai</span>
                                            }
                                            else if (lastPhieu != null)
                                            {
                                                var ngayHien = lastPhieu.NgayXuLy ?? lastPhieu.NgayNop;
                                                var daysPassed = (int)(DateTime.Now - ngayHien).TotalDays;
                                                if (daysPassed >= 84)
                                                {
                                                    <span class="px-2.5 py-1 rounded-full bg-emerald-100 text-emerald-800 font-label-sm text-label-sm font-bold flex items-center gap-1 w-fit">
                                                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-600 animate-pulse"></span>
                                                        ĐỦ ĐIỀU KIỆN HIẾN NGAY
                                                    </span>
                                                    <span class="font-body-sm text-body-sm text-secondary">Lần cuối: @ngayHien.ToString("dd/MM/yyyy") (@daysPassed ngày)</span>
                                                }
                                                else
                                                {
                                                    var remaining = 84 - daysPassed;
                                                    var pct = Math.Min(100, Math.Max(5, (daysPassed * 100) / 84));
                                                    <div class="flex items-center justify-between text-body-sm">
                                                        <span class="text-secondary">Lần cuối: <strong>@ngayHien.ToString("dd/MM/yyyy")</strong></span>
                                                        <span class="font-label-sm text-label-sm text-amber-700 font-semibold">Còn @remaining ngày</span>
                                                    </div>
                                                    <div class="w-36 bg-surface-container rounded-full h-1.5 overflow-hidden">
                                                        <div class="bg-amber-500 h-full rounded-full" style="width: @pct%;"></div>
                                                    </div>
                                                    <span class="font-body-sm text-body-sm text-secondary">Dự kiến: @ngayHien.AddDays(84).ToString("dd/MM/yyyy")</span>
                                                }
                                            }
                                            else
                                            {
                                                <span class="px-2.5 py-1 rounded-full bg-emerald-100 text-emerald-800 font-label-sm text-label-sm font-bold flex items-center gap-1 w-fit">
                                                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span>
                                                    SẴN SÀNG HIẾN LẦN ĐẦU
                                                </span>
                                                <span class="font-body-sm text-body-sm text-secondary">Chưa có lịch sử hiến</span>
                                            }
                                        </div>
                                    </td>

                                    <!-- Cột 5: Chỉ số lâm sàng -->
                                    <td class="py-4 px-4">
                                        <div class="flex flex-col gap-0.5 font-body-sm text-body-sm">
                                            <span>Cân nặng: <strong class="text-on-surface">@(donor.CanNang.HasValue ? $"{donor.CanNang.Value:0.#} kg" : "-- kg")</strong></span>
                                            <span>Nghề nghiệp: <span class="text-secondary">@(donor.NgheNghiep ?? "Tự do")</span></span>
                                            <span class="text-emerald-700 font-medium flex items-center gap-0.5 truncate max-w-[180px]" title="@(donor.GhiChuSucKhoe ?? "Sức khỏe tốt")">
                                                <span class="material-symbols-outlined text-[14px]">check</span> @(donor.GhiChuSucKhoe ?? "Sức khỏe tốt")
                                            </span>
                                        </div>
                                    </td>

                                    <!-- Cột 6: Khu vực & Liên lạc -->
                                    <td class="py-4 px-4">
                                        <div class="flex flex-col gap-0.5 font-body-sm text-body-sm">
                                            <span class="font-medium text-on-surface flex items-center gap-1">
                                                <span class="material-symbols-outlined text-[14px] text-secondary">phone</span> @(donor.SoDienThoai ?? "--")
                                            </span>
                                            <span class="text-secondary truncate max-w-[200px]" title="@donor.DiaChi">@(donor.DiaChi ?? "Chưa cập nhật địa chỉ")</span>
                                            <span class="font-label-sm text-label-sm text-secondary truncate max-w-[200px]">@(donor.Email ?? donor.TaiKhoan?.Email ?? "--")</span>
                                        </div>
                                    </td>

                                    <!-- Cột 7: Thao tác -->
                                    <td class="py-4 px-4 text-center">
                                        <div class="flex items-center justify-center gap-1">
                                            @if (isRare)
                                            {
                                                <button class="p-1.5 rounded-lg bg-tertiary text-on-tertiary hover:opacity-90 transition-opacity" title="Gọi khẩn cấp tình nguyện viên máu hiếm" type="button" onclick="alert('Đang kết nối liên lạc khẩn cấp tới @donor.HoTen (@donor.SoDienThoai)...')">
                                                    <span class="material-symbols-outlined text-[20px]">phone_in_talk</span>
                                                </button>
                                            }
                                            <a asp-controller="Admin" asp-action="PhieuDangKy" asp-route-search="@donor.HoTen" class="p-1.5 rounded-lg text-secondary hover:text-primary hover:bg-surface-container transition-colors" title="Xem các phiếu đăng ký của người này">
                                                <span class="material-symbols-outlined text-[20px]">assignment_ind</span>
                                            </a>
                                            <button class="p-1.5 rounded-lg text-secondary hover:text-primary hover:bg-surface-container transition-colors" title="Gửi SMS thông báo" type="button" onclick="alert('Mở cổng gửi tin nhắn điều phối tới: @donor.HoTen (@donor.SoDienThoai)')">
                                                <span class="material-symbols-outlined text-[20px]">sms</span>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <!-- 7. Professional Dynamic Pagination Footer -->
            <div class="px-space-lg py-space-md bg-surface-container-low/50 flex flex-col md:flex-row items-center justify-between gap-space-md border-t border-surface-container">
                <div class="flex items-center gap-space-md text-secondary font-body-sm text-body-sm">
                    @if (totalItems > 0)
                    {
                        var fromRecord = ((currentPage - 1) * pageSize) + 1;
                        var toRecord = Math.Min(currentPage * pageSize, totalItems);
                        <span>Hiển thị <strong>@fromRecord - @toRecord</strong> trong tổng số <strong>@totalItems</strong> người hiến máu</span>
                    }
                    else
                    {
                        <span>Không có dữ liệu</span>
                    }
                    <div class="flex items-center gap-2">
                        <span>Bản ghi / trang:</span>
                        <select class="h-8 px-2 rounded-lg bg-surface-container-lowest font-body-sm text-body-sm text-on-surface focus:outline-none focus:ring-1 focus:ring-primary/20"
                                onchange="location.href='@Url.Action("NguoiHienMau", "Admin", new { search = currentSearch, nhomMau = currentNhomMau, rhGroup = currentRhGroup, status = currentStatus, tier = currentTier, page = 1 })&pageSize=' + this.value;">
                            <option value="6" selected="@(pageSize == 6)">6</option>
                            <option value="10" selected="@(pageSize == 10)">10</option>
                            <option value="20" selected="@(pageSize == 20)">20</option>
                            <option value="50" selected="@(pageSize == 50)">50</option>
                        </select>
                    </div>
                </div>

                @if (totalPages > 1)
                {
                    <div class="flex items-center gap-1">
                        <!-- First Page -->
                        @if (currentPage > 1)
                        {
                            <a asp-action="NguoiHienMau" asp-route-page="1" asp-route-pageSize="@pageSize" asp-route-search="@currentSearch" asp-route-nhomMau="@currentNhomMau" asp-route-rhGroup="@currentRhGroup" asp-route-status="@currentStatus" asp-route-tier="@currentTier"
                               class="h-9 w-9 rounded-lg bg-surface-container-lowest hover:bg-surface-container text-on-surface flex items-center justify-center transition-colors">
                                <span class="material-symbols-outlined text-[18px]">first_page</span>
                            </a>
                            <a asp-action="NguoiHienMau" asp-route-page="@(currentPage - 1)" asp-route-pageSize="@pageSize" asp-route-search="@currentSearch" asp-route-nhomMau="@currentNhomMau" asp-route-rhGroup="@currentRhGroup" asp-route-status="@currentStatus" asp-route-tier="@currentTier"
                               class="h-9 w-9 rounded-lg bg-surface-container-lowest hover:bg-surface-container text-on-surface flex items-center justify-center transition-colors">
                                <span class="material-symbols-outlined text-[18px]">chevron_left</span>
                            </a>
                        }
                        else
                        {
                            <button class="h-9 w-9 rounded-lg bg-surface-container-lowest text-secondary opacity-40 flex items-center justify-center cursor-not-allowed" disabled type="button">
                                <span class="material-symbols-outlined text-[18px]">first_page</span>
                            </button>
                            <button class="h-9 w-9 rounded-lg bg-surface-container-lowest text-secondary opacity-40 flex items-center justify-center cursor-not-allowed" disabled type="button">
                                <span class="material-symbols-outlined text-[18px]">chevron_left</span>
                            </button>
                        }

                        <!-- Page Numbers -->
                        @for (int p = Math.Max(1, currentPage - 2); p <= Math.Min(totalPages, currentPage + 2); p++)
                        {
                            if (p == currentPage)
                            {
                                <span class="h-9 w-9 rounded-lg bg-primary text-on-primary font-label-md text-label-md font-bold shadow-xs flex items-center justify-center">@p</span>
                            }
                            else
                            {
                                <a asp-action="NguoiHienMau" asp-route-page="@p" asp-route-pageSize="@pageSize" asp-route-search="@currentSearch" asp-route-nhomMau="@currentNhomMau" asp-route-rhGroup="@currentRhGroup" asp-route-status="@currentStatus" asp-route-tier="@currentTier"
                                   class="h-9 w-9 rounded-lg bg-surface-container-lowest hover:bg-surface-container text-on-surface font-label-md text-label-md flex items-center justify-center transition-colors">
                                    @p
                                </a>
                            }
                        }

                        <!-- Next & Last Page -->
                        @if (currentPage < totalPages)
                        {
                            <a asp-action="NguoiHienMau" asp-route-page="@(currentPage + 1)" asp-route-pageSize="@pageSize" asp-route-search="@currentSearch" asp-route-nhomMau="@currentNhomMau" asp-route-rhGroup="@currentRhGroup" asp-route-status="@currentStatus" asp-route-tier="@currentTier"
                               class="h-9 w-9 rounded-lg bg-surface-container-lowest hover:bg-surface-container text-on-surface flex items-center justify-center transition-colors">
                                <span class="material-symbols-outlined text-[18px]">chevron_right</span>
                            </a>
                            <a asp-action="NguoiHienMau" asp-route-page="@totalPages" asp-route-pageSize="@pageSize" asp-route-search="@currentSearch" asp-route-nhomMau="@currentNhomMau" asp-route-rhGroup="@currentRhGroup" asp-route-status="@currentStatus" asp-route-tier="@currentTier"
                               class="h-9 w-9 rounded-lg bg-surface-container-lowest hover:bg-surface-container text-on-surface flex items-center justify-center transition-colors">
                                <span class="material-symbols-outlined text-[18px]">last_page</span>
                            </a>
                        }
                        else
                        {
                            <button class="h-9 w-9 rounded-lg bg-surface-container-lowest text-secondary opacity-40 flex items-center justify-center cursor-not-allowed" disabled type="button">
                                <span class="material-symbols-outlined text-[18px]">chevron_right</span>
                            </button>
                            <button class="h-9 w-9 rounded-lg bg-surface-container-lowest text-secondary opacity-40 flex items-center justify-center cursor-not-allowed" disabled type="button">
                                <span class="material-symbols-outlined text-[18px]">last_page</span>
                            </button>
