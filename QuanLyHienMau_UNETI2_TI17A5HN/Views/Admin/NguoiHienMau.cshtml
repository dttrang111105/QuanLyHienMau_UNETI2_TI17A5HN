@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản lý người hiến máu & phân loại nhóm máu hiếm";
}

<div class="flex flex-col w-full">
    <!-- Top Ambient Glow Line -->
    <div class="h-1.5 w-full bg-gradient-to-r from-primary via-tertiary-container to-secondary"></div>

    <!-- Main Content Space -->
    <div class="px-space-lg py-space-md max-w-7xl mx-auto w-full space-y-space-lg">
        <!-- 1. Header & Breadcrumb & Action Suite -->
        <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-space-md">
            <div class="space-y-space-xs">
                <nav aria-label="Breadcrumb" class="flex items-center gap-2">
                    <span class="font-label-sm text-label-sm text-secondary">Hệ thống Quản trị Y tế</span>
                    <span class="text-surface-variant font-label-sm text-label-sm">/</span>
                    <span class="font-label-sm text-label-sm text-secondary">Đối tác &amp; Dữ liệu</span>
                    <span class="text-surface-variant font-label-sm text-label-sm">/</span>
                    <span class="font-label-sm text-label-sm font-semibold text-primary">Người hiến máu (Donors)</span>
                </nav>
                <h1 class="font-headline-lg text-headline-lg text-on-surface tracking-tight flex items-center gap-3 flex-wrap">
                    Danh Sách Người Hiến Máu &amp; Phân Loại Nhóm Máu Hiếm
                    <span class="px-2.5 py-0.5 rounded-full bg-primary/10 text-primary font-label-sm text-label-sm tracking-wide uppercase font-bold">ISBT 128 / VNeID v2</span>
                </h1>
                <p class="font-body-md text-body-md text-secondary max-w-4xl">
                    Quản lý hồ sơ định danh 380,450 tình nguyện viên toàn quốc, phân loại nhóm máu hiếm Rh(-), Bombay, Kell, theo dõi chu kỳ an toàn 84 ngày và kích hoạt điều phối khẩn cấp 24/7.
                </p>
            </div>
            <!-- Action Buttons -->
            <div class="flex items-center flex-wrap gap-space-sm shrink-0">
                <button class="h-10 px-4 rounded-xl bg-surface-container-lowest text-on-surface shadow-sm hover:bg-surface-container transition-all flex items-center gap-2 font-label-md text-label-md" type="button" onclick="alert('Đang trích xuất danh sách người hiến máu (CSV / Excel)...')">
                    <span class="material-symbols-outlined text-[18px]">download</span>
                    <span>Xuất Danh Sách</span>
                </button>
                <button class="h-10 px-4 rounded-xl bg-tertiary text-on-tertiary shadow-sm hover:opacity-95 transition-all flex items-center gap-2 font-label-md text-label-md font-bold" onclick="openEmergencyModal()" type="button">
                    <span class="material-symbols-outlined text-[18px] animate-pulse">crisis_alert</span>
                    <span>Kêu Gọi Khẩn Cấp</span>
                </button>
                <button class="h-10 px-5 rounded-xl bg-primary text-on-primary shadow-md hover:bg-primary-container transition-all flex items-center gap-2 font-label-md text-label-md font-bold" type="button" onclick="alert('Mở form tiếp nhận đăng ký hồ sơ người hiến máu mới!')">
                    <span class="material-symbols-outlined text-[18px]">person_add</span>
                    <span>Thêm Hồ Sơ Mới</span>
                </button>
            </div>
        </div>

        <!-- 2. 4 Metric Cards (KPI Band) -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-space-md">
            <!-- Card 1 -->
            <div class="bg-surface-container-lowest p-space-lg rounded-2xl shadow-sm flex flex-col justify-between space-y-space-md relative overflow-hidden group">
                <div class="absolute right-0 top-0 w-24 h-24 bg-primary/5 rounded-bl-full pointer-events-none transition-transform group-hover:scale-110"></div>
                <div class="flex items-center justify-between">
                    <span class="font-label-sm text-label-sm uppercase tracking-wider text-secondary font-semibold">Tổng Người Hiến Toàn Hệ Thống</span>
                    <div class="w-9 h-9 rounded-xl bg-primary-fixed flex items-center justify-center text-primary">
                        <span class="material-symbols-outlined text-[20px]">groups</span>
                    </div>
                </div>
                <div class="space-y-1">
                    <div class="flex items-baseline gap-2">
                        <span class="font-headline-lg text-headline-lg font-bold text-on-surface">380,450</span>
                        <span class="font-label-sm text-label-sm text-emerald-600 font-semibold flex items-center gap-0.5">
                            <span class="material-symbols-outlined text-[14px]">arrow_upward</span> +1,240
                        </span>
                    </div>
                    <p class="font-body-sm text-body-sm text-secondary flex items-center gap-1.5">
                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                        VNeID Mức 2 đạt <strong class="text-on-surface font-semibold">94.6%</strong>
                    </p>
                </div>
                <div class="w-full bg-surface-container rounded-full h-1.5 overflow-hidden">
                    <div class="bg-primary h-full rounded-full" style="width: 94.6%;"></div>
                </div>
            </div>

            <!-- Card 2: Rare Blood Club -->
            <div class="bg-surface-container-lowest p-space-lg rounded-2xl shadow-sm flex flex-col justify-between space-y-space-md relative overflow-hidden group">
                <div class="absolute right-0 top-0 w-24 h-24 bg-tertiary/10 rounded-bl-full pointer-events-none transition-transform group-hover:scale-110"></div>
                <div class="flex items-center justify-between">
                    <span class="font-label-sm text-label-sm uppercase tracking-wider text-tertiary font-bold flex items-center gap-1">
                        <span class="material-symbols-outlined text-[16px] text-tertiary">diamond</span>
                        CLB Nhóm Máu Hiếm
                    </span>
                    <div class="w-9 h-9 rounded-xl bg-tertiary-fixed flex items-center justify-center text-tertiary">
                        <span class="material-symbols-outlined text-[20px]">bloodtype</span>
                    </div>
                </div>
                <div class="space-y-1">
                    <div class="flex items-baseline gap-2">
                        <span class="font-headline-lg text-headline-lg font-bold text-tertiary">1,485</span>
                        <span class="font-label-sm text-label-sm text-secondary">Tình nguyện viên</span>
                    </div>
                    <div class="flex flex-wrap gap-1.5 pt-1">
                        <span class="px-1.5 py-0.5 rounded bg-surface-container font-label-sm text-label-sm text-on-surface font-mono">O-: 742</span>
                        <span class="px-1.5 py-0.5 rounded bg-surface-container font-label-sm text-label-sm text-on-surface font-mono">A-: 388</span>
                        <span class="px-1.5 py-0.5 rounded bg-surface-container font-label-sm text-label-sm text-on-surface font-mono">B-: 265</span>
                        <span class="px-1.5 py-0.5 rounded bg-surface-container font-label-sm text-label-sm text-on-surface font-mono">AB-: 90</span>
                    </div>
                </div>
                <p class="font-body-sm text-body-sm text-emerald-700 bg-emerald-50 px-2 py-1 rounded-lg flex items-center gap-1 font-medium">
                    <span class="material-symbols-outlined text-[15px]">timer</span>
                    <strong>320 người</strong> sẵn sàng gọi khẩn trong 30p
                </p>
            </div>

            <!-- Card 3 -->
            <div class="bg-surface-container-lowest p-space-lg rounded-2xl shadow-sm flex flex-col justify-between space-y-space-md relative overflow-hidden group">
                <div class="absolute right-0 top-0 w-24 h-24 bg-emerald-500/10 rounded-bl-full pointer-events-none transition-transform group-hover:scale-110"></div>
                <div class="flex items-center justify-between">
                    <span class="font-label-sm text-label-sm uppercase tracking-wider text-secondary font-semibold">Đủ Điều Kiện Hiến Ngay</span>
                    <div class="w-9 h-9 rounded-xl bg-emerald-100 flex items-center justify-center text-emerald-800">
                        <span class="material-symbols-outlined text-[20px]">event_available</span>
                    </div>
                </div>
                <div class="space-y-1">
                    <div class="flex items-baseline gap-2">
                        <span class="font-headline-lg text-headline-lg font-bold text-on-surface">142,680</span>
                        <span class="font-label-sm text-label-sm text-emerald-600 font-semibold">37.5%</span>
                    </div>
                    <p class="font-body-sm text-body-sm text-secondary">
                        Đã qua chu kỳ hồi phục <strong class="text-on-surface">&ge; 84 ngày</strong>
                    </p>
                </div>
                <div class="flex items-center justify-between text-secondary font-label-sm text-label-sm pt-2 bg-surface-container-low px-2.5 py-1.5 rounded-lg">
                    <span>Chiến dịch tuần này:</span>
                    <span class="font-semibold text-primary">Sẵn sàng điều phối</span>
                </div>
            </div>

            <!-- Card 4 -->
            <div class="bg-surface-container-lowest p-space-lg rounded-2xl shadow-sm flex flex-col justify-between space-y-space-md relative overflow-hidden group">
                <div class="absolute right-0 top-0 w-24 h-24 bg-amber-500/10 rounded-bl-full pointer-events-none transition-transform group-hover:scale-110"></div>
                <div class="flex items-center justify-between">
                    <span class="font-label-sm text-label-sm uppercase tracking-wider text-secondary font-semibold">Người Hiến Máu Tích Cực</span>
                    <div class="w-9 h-9 rounded-xl bg-amber-100 flex items-center justify-center text-amber-800">
                        <span class="material-symbols-outlined text-[20px]">military_tech</span>
                    </div>
                </div>
                <div class="space-y-1">
                    <div class="flex items-baseline gap-2">
                        <span class="font-headline-lg text-headline-lg font-bold text-on-surface">18,920</span>
                        <span class="font-label-sm text-label-sm text-amber-700 font-semibold bg-amber-50 px-2 py-0.5 rounded-md">Vàng &amp; Kim Cương</span>
                    </div>
                    <p class="font-body-sm text-body-sm text-secondary">
                        Đã hiến &ge; 5 lần; tỷ lệ hiến nhắc lại <strong class="text-on-surface font-semibold">68.4%</strong>
                    </p>
                </div>
                <div class="w-full bg-surface-container rounded-full h-1.5 overflow-hidden">
                    <div class="bg-amber-500 h-full rounded-full" style="width: 68.4%;"></div>
                </div>
            </div>
        </div>

        <!-- 3. Emergency Callout & Rare Blood Hotspot Banner -->
        <div class="bg-gradient-to-r from-tertiary-container via-primary-container to-primary text-on-primary rounded-3xl p-space-lg shadow-md relative overflow-hidden">
            <!-- Ambient light effect -->
            <div class="absolute -right-12 -top-12 w-64 h-64 rounded-full bg-white/10 blur-2xl pointer-events-none"></div>
            <div class="relative z-10 flex flex-col lg:flex-row lg:items-center justify-between gap-space-lg">
                <div class="space-y-2 max-w-2xl">
                    <div class="flex items-center gap-2">
                        <span class="px-2.5 py-1 rounded-full bg-white/20 backdrop-blur text-white font-label-sm text-label-sm font-bold flex items-center gap-1.5 animate-pulse">
                            <span class="w-2 h-2 rounded-full bg-amber-300"></span> BÁO ĐỘNG ĐỎ TRUNG TÂM MÁU QUỐC GIA
                        </span>
                        <span class="font-label-sm text-label-sm text-white/80">Khu vực: BV Hữu nghị Việt Đức &amp; Viện Huyết học TW</span>
                    </div>
                    <h2 class="font-headline-md text-headline-md font-bold text-white tracking-tight">
                        CẢNH BÁO THIẾU HỤT TỒN KHO NHÓM MÁU HIẾM O Rh(-) VÀ B Rh(-)
                    </h2>
                    <p class="font-body-md text-body-md text-white/90">
                        Yêu cầu khẩn: Cần <strong>15 đơn vị O Rh(-)</strong> phục vụ 2 ca phẫu thuật đa chấn thương sọ não. Bán kính quét tìm kiếm đã định vị <strong>48 người hiến O Rh(-) đủ điều kiện trong vòng 15km quanh Hà Nội</strong>.
                    </p>
                    <div class="flex items-center gap-4 pt-1 font-label-md text-label-md">
                        <span class="flex items-center gap-1 text-white">
                            <span class="material-symbols-outlined text-[18px] text-emerald-300">check_circle</span>
                            <strong>12 người</strong> đang di chuyển đến viện
                        </span>
                        <span class="flex items-center gap-1 text-white">
                            <span class="material-symbols-outlined text-[18px] text-amber-300">hourglass_top</span>
                            <strong>6 người</strong> đang trong phòng lấy máu
                        </span>
                    </div>
                </div>
                <!-- Quick Emergency Engine Controls -->
                <div class="bg-black/20 backdrop-blur-md p-space-md rounded-2xl flex flex-col sm:flex-row lg:flex-col gap-space-sm shrink-0 w-full lg:w-80">
                    <div class="space-y-1">
                        <span class="font-label-sm text-label-sm text-white/70 uppercase font-semibold">Mục tiêu phát lệnh điều phối:</span>
                        <div class="flex items-center justify-between bg-white/10 px-3 py-2 rounded-xl text-white">
                            <div class="flex items-center gap-2">
                                <span class="px-2 py-0.5 rounded bg-tertiary font-bold font-mono text-sm">O Rh(-)</span>
                                <span class="text-body-sm font-medium">Bán kính &le; 15 km</span>
                            </div>
                            <span class="font-label-sm text-label-sm font-semibold text-amber-300">48 sẵn sàng</span>
                        </div>
                    </div>
                    <button class="w-full py-2.5 px-4 rounded-xl bg-white text-primary font-label-md text-label-md font-bold shadow-md hover:bg-surface-bright transition-all flex items-center justify-center gap-2" type="button" onclick="openEmergencyModal()">
                        <span class="material-symbols-outlined text-[18px]">send</span>
                        <span>Phát Lệnh SMS &amp; VNeID (48)</span>
                    </button>
                    <button class="w-full py-2 px-3 rounded-xl bg-white/15 text-white hover:bg-white/20 transition-all font-label-sm text-label-sm flex items-center justify-center gap-1.5 font-semibold" type="button" onclick="alert('Kíp trực khẩn cấp: BS. Trần Mai Linh, ĐD. Nguyễn Bích Ngọc, KTV. Lê Thảo Trang.')">
                        <span class="material-symbols-outlined text-[16px]">support_agent</span>
                        <span>Xem Danh Sách Kíp Trực Khẩn Cấp</span>
                    </button>
                </div>
            </div>
        </div>

        <!-- 4. Advanced Multi-dimensional Filter Bar -->
        <div class="bg-surface-container-lowest rounded-2xl p-space-lg shadow-sm space-y-space-md">
            <!-- Search Input & Quick Actions -->
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-space-md">
                <div class="lg:col-span-6 relative">
                    <span class="material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-secondary text-[20px]">search</span>
                    <input class="w-full h-12 pl-11 pr-4 rounded-xl bg-surface-container-low font-body-md text-body-md text-on-surface placeholder:text-secondary/70 focus:outline-none focus:ring-2 focus:ring-primary/20 focus:bg-surface-container-lowest transition-all" id="donorSearchInput" placeholder="Tìm theo Họ tên, CCCD/VNeID (12 số), Số điện thoại, Mã định danh (VD: DONOR-09821)..." type="text">
                </div>
                <div class="lg:col-span-3">
                    <div class="relative">
                        <select class="w-full h-12 px-4 rounded-xl bg-surface-container-low font-body-md text-body-md text-on-surface appearance-none focus:outline-none focus:ring-2 focus:ring-primary/20" id="filterLocation">
                            <option value="">Toàn quốc / Tất cả Tỉnh Thành</option>
                            <option selected="" value="HN">Hà Nội (Trung tâm &amp; Bệnh viện TW)</option>
                            <option value="HCM">TP. Hồ Chí Minh</option>
                            <option value="DN">Đà Nẵng</option>
                            <option value="HP">Hải Phòng</option>
                            <option value="TN">Thái Nguyên</option>
                            <option value="CT">Cần Thơ</option>
                        </select>
                        <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-secondary pointer-events-none text-[20px]">expand_more</span>
                    </div>
                </div>
                <div class="lg:col-span-3 flex items-center gap-space-sm">
                    <div class="relative flex-1">
                        <select class="w-full h-12 px-4 rounded-xl bg-surface-container-low font-body-md text-body-md text-on-surface appearance-none focus:outline-none focus:ring-2 focus:ring-primary/20" id="filterTier">
                            <option value="">Tất cả phân hạng cống hiến</option>
                            <option value="diamond">Kim Cương (&ge; 20 lần)</option>
                            <option value="gold">Vàng (10 - 19 lần)</option>
                            <option value="silver">Bạc (5 - 9 lần)</option>
                            <option value="bronze">Đồng (1 - 4 lần)</option>
                        </select>
                        <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-secondary pointer-events-none text-[20px]">expand_more</span>
                    </div>
                    <button class="h-12 w-12 rounded-xl bg-surface-container-low text-secondary hover:text-primary hover:bg-surface-container flex items-center justify-center shrink-0 transition-colors" title="Làm mới bộ lọc" type="button" onclick="document.getElementById('donorSearchInput').value=''; document.querySelectorAll('tbody tr').forEach(r => r.style.display='');">
                        <span class="material-symbols-outlined text-[20px]">refresh</span>
                    </button>
                </div>
            </div>

            <!-- Segmented Tag Filters (Blood Type & Status) -->
            <div class="pt-2 flex flex-col md:flex-row items-start md:items-center justify-between gap-space-md border-t border-surface-container">
                <!-- ABO Groups -->
                <div class="flex items-center gap-2 flex-wrap">
                    <span class="font-label-sm text-label-sm text-secondary uppercase tracking-wider font-semibold mr-1">Nhóm máu ABO:</span>
                    <button class="px-3 py-1.5 rounded-lg bg-primary text-on-primary font-label-sm text-label-sm font-semibold shadow-xs" type="button">Tất cả</button>
                    <button class="px-3 py-1.5 rounded-lg bg-surface-container-low hover:bg-surface-container text-on-surface font-label-sm text-label-sm font-semibold transition-colors" type="button">Nhóm O</button>
                    <button class="px-3 py-1.5 rounded-lg bg-surface-container-low hover:bg-surface-container text-on-surface font-label-sm text-label-sm font-semibold transition-colors" type="button">Nhóm A</button>
                    <button class="px-3 py-1.5 rounded-lg bg-surface-container-low hover:bg-surface-container text-on-surface font-label-sm text-label-sm font-semibold transition-colors" type="button">Nhóm B</button>
                    <button class="px-3 py-1.5 rounded-lg bg-surface-container-low hover:bg-surface-container text-on-surface font-label-sm text-label-sm font-semibold transition-colors" type="button">Nhóm AB</button>
                </div>
                <!-- Rh and Rare Status -->
                <div class="flex items-center gap-2 flex-wrap">
                    <span class="font-label-sm text-label-sm text-secondary uppercase tracking-wider font-semibold mr-1">Yếu tố Rh &amp; CLB:</span>
                    <button class="px-3 py-1.5 rounded-lg bg-tertiary-fixed text-tertiary font-label-sm text-label-sm font-bold flex items-center gap-1 shadow-xs hover:bg-tertiary hover:text-on-tertiary transition-all" type="button">
                        <span class="material-symbols-outlined text-[16px]">emergency</span>
                        Rh(-) Âm tính (Máu Hiếm)
                    </button>
                    <button class="px-3 py-1.5 rounded-lg bg-surface-container-low hover:bg-surface-container text-on-surface font-label-sm text-label-sm font-semibold transition-colors" type="button">Rh(+) Dương tính</button>
                    <button class="px-3 py-1.5 rounded-lg bg-emerald-50 text-emerald-800 font-label-sm text-label-sm font-semibold hover:bg-emerald-100 transition-colors flex items-center gap-1" type="button">
                        <span class="w-2 h-2 rounded-full bg-emerald-600"></span>
                        Đủ điều kiện hiến ngay (&ge; 84 ngày)
                    </button>
                    <button class="px-3 py-1.5 rounded-lg bg-surface-container-low hover:bg-surface-container text-on-surface font-label-sm text-label-sm font-semibold transition-colors" type="button">
                        Tạm hoãn y khoa
                    </button>
                </div>
            </div>
        </div>

        <!-- 5. Detailed Donors Data Table (ISBT 128 / VNeID Standard) -->
        <div class="bg-surface-container-lowest rounded-2xl shadow-sm overflow-hidden">
            <!-- Table Top Meta -->
            <div class="px-space-lg py-space-md bg-surface-container-low/50 flex flex-col sm:flex-row sm:items-center justify-between gap-space-sm">
                <div class="flex items-center gap-2">
                    <span class="font-label-md text-label-md font-semibold text-on-surface">Danh sách hồ sơ lâm sàng &amp; lịch sử hiến</span>
                    <span class="px-2 py-0.5 rounded-full bg-surface-container-highest text-secondary font-label-sm text-label-sm font-semibold">380,450 bản ghi</span>
                </div>
                <div class="flex items-center gap-space-md text-secondary font-body-sm text-body-sm">
                    <span class="flex items-center gap-1">
                        <span class="material-symbols-outlined text-[16px] text-emerald-600">verified</span>
                        VNeID Mức 2 (Đã liên thông BCA)
                    </span>
                    <span class="flex items-center gap-1">
                        <span class="material-symbols-outlined text-[16px] text-primary">bloodtype</span>
                        Quy chuẩn an toàn truyền máu 84 ngày
                    </span>
                </div>
            </div>

            <!-- Table Body -->
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-surface-container text-on-surface font-label-sm text-label-sm uppercase tracking-wider">
                            <th class="py-3.5 px-4 font-bold" scope="col">Mã Định Danh &amp; Họ Tên</th>
                            <th class="py-3.5 px-4 font-bold" scope="col">Nhóm Máu (ISBT 128)</th>
                            <th class="py-3.5 px-4 font-bold" scope="col">Tần Suất &amp; Phân Hạng</th>
                            <th class="py-3.5 px-4 font-bold" scope="col">Lần Hiến Cuối &amp; Chu Kỳ 84 Ngày</th>
                            <th class="py-3.5 px-4 font-bold" scope="col">Chỉ Số Lâm Sàng</th>
                            <th class="py-3.5 px-4 font-bold" scope="col">Khu Vực &amp; Liên Lạc Khẩn Cấp</th>
                            <th class="py-3.5 px-4 font-bold text-center" scope="col">Thao Tác</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y-0 text-on-surface font-body-md text-body-md">
                        <!-- Row 1: Nguyễn Hoàng Nam -->
                        <tr class="hover:bg-surface-container-low/70 transition-colors">
                            <td class="py-4 px-4">
                                <div class="flex items-center gap-3">
                                    <div class="w-10 h-10 rounded-full bg-primary/10 text-primary flex items-center justify-center font-bold text-sm shrink-0">
                                        NH
                                    </div>
                                    <div class="flex flex-col min-w-0">
