<!-- Modal Thêm Tài Khoản Mới -->
<div id="modalCreateAccount" class="fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-xs @(TempData["OpenCreateModal"] != null ? "" : "hidden")">
    <div class="bg-surface-container-lowest rounded-3xl p-6 sm:p-8 max-w-lg w-full mx-4 shadow-2xl border border-surface-container relative animate-in fade-in zoom-in duration-150">
        <div class="flex items-center justify-between mb-4 pb-3 border-b border-surface-container">
            <div class="flex items-center gap-2.5">
                <div class="w-10 h-10 rounded-xl bg-primary-fixed flex items-center justify-center text-primary">
                    <span class="material-symbols-outlined text-[22px]">person_add</span>
                </div>
                <div>
                    <h3 class="font-title-lg font-bold text-on-surface">Tạo Tài Khoản Người Dùng Mới</h3>
                    <p class="text-xs text-on-surface-variant">Thiết lập tài khoản và phân quyền cán bộ y tế / quản trị viên</p>
                </div>
            </div>
            <button onclick="document.getElementById('modalCreateAccount').classList.add('hidden')" class="p-1 rounded-lg text-on-surface-variant hover:bg-surface-container cursor-pointer" type="button">
                <span class="material-symbols-outlined text-[20px]">close</span>
            </button>
        </div>

        @if (TempData["CreateAccountError"] != null)
        {
            <div class="mb-4 p-3.5 rounded-xl bg-red-50 border border-red-200 text-red-700 flex items-center gap-2.5 text-xs font-semibold">
                <span class="material-symbols-outlined text-[20px] text-red-600 shrink-0">error</span>
                <span>@TempData["CreateAccountError"]</span>
            </div>
        }

        <form method="post" asp-controller="Admin" asp-action="TaoTaiKhoan" class="space-y-4">
            @Html.AntiForgeryToken()

            <div>
                <label class="block text-xs font-bold text-on-surface mb-1">Tên Đăng Nhập <span class="text-primary">*</span></label>
                <input name="TenDangNhap" value="@(TempData["CreateTenDangNhap"] ?? "")" required minlength="3" maxlength="50" pattern="^[a-zA-Z0-9_.-]+$" title="Tên đăng nhập từ 3 đến 50 ký tự, không chứa dấu cách" placeholder="ví dụ: bstranlinh" class="w-full h-11 px-3.5 rounded-xl border border-outline-variant focus:border-primary focus:ring-2 focus:ring-primary/20 text-sm bg-surface-container-low" />
                <span class="text-[11px] text-on-surface-variant mt-0.5 block">Tối thiểu 3 ký tự, không chứa dấu cách, không trùng với tài khoản đã có.</span>
            </div>

            <div>
                <label class="block text-xs font-bold text-on-surface mb-1">Họ Và Tên Cán Bộ / Người Dùng <span class="text-primary">*</span></label>
                <input name="HoTen" value="@(TempData["CreateHoTen"] ?? "")" required maxlength="100" placeholder="ví dụ: BS. Trần Mai Linh" class="w-full h-11 px-3.5 rounded-xl border border-outline-variant focus:border-primary focus:ring-2 focus:ring-primary/20 text-sm bg-surface-container-low" />
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div>
                    <label class="block text-xs font-bold text-on-surface mb-1">Địa Chỉ Email</label>
                    <input name="Email" type="email" value="@(TempData["CreateEmail"] ?? "")" placeholder="linh.tm@hospital.vn" class="w-full h-11 px-3.5 rounded-xl border border-outline-variant focus:border-primary focus:ring-2 focus:ring-primary/20 text-sm bg-surface-container-low" />
                </div>
                <div>
                    <label class="block text-xs font-bold text-on-surface mb-1">Mật Khẩu Khởi Tạo <span class="text-primary">*</span></label>
                    <input name="MatKhau" type="password" required minlength="6" placeholder="Tối thiểu 6 ký tự" class="w-full h-11 px-3.5 rounded-xl border border-outline-variant focus:border-primary focus:ring-2 focus:ring-primary/20 text-sm bg-surface-container-low" />
                </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div>
                    <label class="block text-xs font-bold text-on-surface mb-1">Phân Cấp Vai Trò <span class="text-primary">*</span></label>
                    <select name="VaiTro" class="w-full h-11 px-3.5 rounded-xl border border-outline-variant focus:border-primary focus:ring-2 focus:ring-primary/20 text-sm bg-surface-container-low">
                        <option value="Medical Staff" selected="@(TempData["CreateVaiTro"]?.ToString() == "Medical Staff" ? "selected" : null)">Nhân Viên Y Tế / Bác Sĩ</option>
                        <option value="Admin" selected="@(TempData["CreateVaiTro"]?.ToString() == "Admin" ? "selected" : null)">Admin Quản Trị Hệ Thống</option>
                        <option value="Donor" selected="@(TempData["CreateVaiTro"]?.ToString() == "Donor" ? "selected" : null)">Người Hiến Máu (Donor)</option>
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-bold text-on-surface mb-1">Trạng Thái Ban Đầu</label>
                    <select name="TrangThai" class="w-full h-11 px-3.5 rounded-xl border border-outline-variant focus:border-primary focus:ring-2 focus:ring-primary/20 text-sm bg-surface-container-low">
                        <option value="Hoạt động" selected="@(TempData["CreateTrangThai"]?.ToString() == "Hoạt động" ? "selected" : null)">Hoạt động (Active)</option>
                        <option value="Bị khóa" selected="@(TempData["CreateTrangThai"]?.ToString() == "Bị khóa" ? "selected" : null)">Bị khóa (Locked)</option>
                    </select>
                </div>
            </div>

            <div class="flex items-center justify-end gap-3 pt-3 border-t border-surface-container">
                <button onclick="document.getElementById('modalCreateAccount').classList.add('hidden')" type="button" class="px-4 py-2.5 rounded-xl bg-surface-container hover:bg-surface-container-high text-on-surface text-sm font-semibold cursor-pointer">
                    Hủy bỏ
                </button>
                <button type="submit" class="px-5 py-2.5 rounded-xl bg-primary text-on-primary text-sm font-bold shadow-md hover:bg-primary-container cursor-pointer flex items-center gap-1.5">
                    <span class="material-symbols-outlined text-[18px]">check</span>
                    <span>Tạo Tài Khoản</span>
                </button>
            </div>
        </form>
    </div>
</div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const searchInput = document.getElementById('staffSearchInput');
        const roleSelect = document.getElementById('staffRoleSelect');
        const unitSelect = document.getElementById('staffUnitSelect');
        const tokenSelect = document.getElementById('staffTokenSelect');
        const btnReset = document.getElementById('btnResetFilter');
        const tableBody = document.getElementById('staffTableBody');

        function filterTable() {
            if (!tableBody) return;
            const searchVal = searchInput ? searchInput.value.toLowerCase().trim() : '';
            const roleVal = roleSelect ? roleSelect.value.toLowerCase().trim() : '';
            const unitVal = unitSelect ? unitSelect.value.toLowerCase().trim() : '';
            const tokenVal = tokenSelect ? tokenSelect.value.toLowerCase().trim() : '';

            const rows = tableBody.querySelectorAll('tr');
            rows.forEach(row => {
                const text = row.innerText.toLowerCase();
                const matchSearch = !searchVal || text.includes(searchVal);
                const matchRole = !roleVal || text.includes(roleVal);
                const matchUnit = !unitVal || text.includes(unitVal);
                const matchToken = !tokenVal || text.includes(tokenVal);

                if (matchSearch && matchRole && matchUnit && matchToken) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
        }

        if (searchInput) searchInput.addEventListener('input', filterTable);
        if (roleSelect) roleSelect.addEventListener('change', filterTable);
        if (unitSelect) unitSelect.addEventListener('change', filterTable);
        if (tokenSelect) tokenSelect.addEventListener('change', filterTable);

        if (btnReset) {
            btnReset.addEventListener('click', function () {
                if (searchInput) searchInput.value = '';
                if (roleSelect) roleSelect.value = '';
                if (unitSelect) unitSelect.value = '';
                if (tokenSelect) tokenSelect.value = '';
                filterTable();
            });
        }
    });
</script>
