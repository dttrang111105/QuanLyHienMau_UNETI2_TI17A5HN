@model IEnumerable<QuanLyHienMau_UNETI2_TI17A5HN.Models.TaiKhoan>
@{
    ViewData["Title"] = "Quản lý tài khoản & Phân quyền hệ thống";
    Layout = "_AdminLayout";
    var filteredCount = Model?.Count() ?? 0;
    var totalAccounts = (int?)ViewBag.TotalAccounts ?? filteredCount;
    var adminCount = (int?)ViewBag.AdminCount ?? 0;
    var medicalStaffCount = (int?)ViewBag.MedicalStaffCount ?? 0;
    var donorCount = (int?)ViewBag.DonorCount ?? 0;
    var lockedCount = (int?)ViewBag.LockedCount ?? (Model?.Count(a => a.TrangThai == "Bị khóa") ?? 0);
    var activeCount = (int?)ViewBag.ActiveCount ?? (totalAccounts - lockedCount);
    var currentUserIdStr = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    int.TryParse(currentUserIdStr, out int currentUserId);
}

<!-- Subtle Ambient Glow -->
<div class="relative w-full overflow-hidden px-space-lg py-space-lg flex flex-col gap-space-lg">
    <div class="absolute -top-40 right-1/4 w-96 h-96 bg-primary/5 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute top-1/2 -left-20 w-80 h-80 bg-primary-container/5 rounded-full blur-3xl pointer-events-none"></div>

    <!-- 1. Header Section -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="p-4 rounded-2xl bg-emerald-50 border border-emerald-200 text-emerald-800 flex items-center justify-between shadow-xs">
            <div class="flex items-center gap-2.5">
                <span class="material-symbols-outlined text-emerald-600 text-[22px]">check_circle</span>
                <span class="font-body-sm font-semibold">@TempData["SuccessMessage"]</span>
            </div>
            <button onclick="this.parentElement.remove()" class="text-emerald-600 hover:text-emerald-900 cursor-pointer"><span class="material-symbols-outlined text-[18px]">close</span></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="p-4 rounded-2xl bg-red-50 border border-red-200 text-red-800 flex items-center justify-between shadow-xs">
            <div class="flex items-center gap-2.5">
                <span class="material-symbols-outlined text-red-600 text-[22px]">error</span>
                <span class="font-body-sm font-semibold">@TempData["ErrorMessage"]</span>
            </div>
            <button onclick="this.parentElement.remove()" class="text-red-600 hover:text-red-900 cursor-pointer"><span class="material-symbols-outlined text-[18px]">close</span></button>
        </div>
    }

    <header class="flex flex-col gap-space-sm relative z-10">
        <!-- Breadcrumb -->
        <nav class="flex items-center gap-2 font-label-sm text-label-sm text-on-surface-variant">
            <a asp-controller="Admin" asp-action="Dashboard" class="hover:text-primary transition-colors">Hệ thống Quản trị Y tế</a>
            <span class="material-symbols-outlined text-[14px]">chevron_right</span>
            <span class="text-on-surface-variant">Hệ thống</span>
            <span class="material-symbols-outlined text-[14px]">chevron_right</span>
            <span class="text-primary font-semibold">Quản lý tài khoản &amp; Phân quyền</span>
        </nav>

        <!-- Main Title & Actions Bar -->
        <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-space-md mt-1">
            <div class="flex flex-col gap-1 max-w-4xl">
                <div class="flex flex-wrap items-center gap-3">
                    <h1 class="font-headline-lg text-headline-lg text-on-surface tracking-tight">
                        Quản Lý Tài Khoản &amp; Phân Quyền Nhân Sự
                    </h1>
                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-secondary-container text-on-secondary-container font-label-sm text-label-sm">
                        <span class="w-1.5 h-1.5 rounded-full bg-primary animate-pulse"></span>
                        Phân quyền theo vai trò công tác
                    </span>
                </div>
                <p class="font-body-md text-body-md text-on-surface-variant leading-relaxed">
                    Quản lý danh sách tài khoản người dùng trên hệ thống, phân quyền theo chức trách công tác (Quản trị viên, Nhân viên y tế, Người hiến máu), hỗ trợ cấp mới, khóa hoặc mở khóa tài khoản và đặt lại mật khẩu.
                </p>
            </div>
            <!-- Action Buttons -->
            <div class="flex items-center gap-space-sm shrink-0">
                <button class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-surface-container-lowest shadow-sm hover:shadow-md hover:bg-surface-container-low text-on-surface transition-all duration-180 font-label-md text-label-md cursor-pointer" type="button" onclick="document.getElementById('auditTrailSection').scrollIntoView({behavior: 'smooth'})">
                    <span class="material-symbols-outlined text-[18px] text-on-surface-variant">history</span>
                    <span>Lịch Sử Hoạt Động</span>
                </button>
                <a asp-controller="Admin" asp-action="RBAC" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-surface-container-lowest shadow-sm hover:shadow-md hover:bg-surface-container-low text-on-surface transition-all duration-180 font-label-md text-label-md">
                    <span class="material-symbols-outlined text-[18px] text-on-surface-variant">tune</span>
                    <span>Cấu Hình Phân Quyền</span>
                </a>
                <button class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-primary text-on-primary shadow-md hover:bg-primary-container active:scale-[0.98] transition-all duration-180 font-label-md text-label-md cursor-pointer" type="button" onclick="document.getElementById('modalCreateAccount').classList.remove('hidden')">
                    <span class="material-symbols-outlined text-[20px]">person_add</span>
                    <span>+ Thêm Tài Khoản Mới</span>
                </button>
            </div>
        </div>
    </header>

    <!-- 2. KPI Summary Cards (4 Cards) -->
    <section class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-space-md">
        <!-- KPI 1: Tổng số tài khoản -->
        <div class="relative overflow-hidden rounded-xl bg-surface-container-lowest p-space-lg shadow-sm hover:shadow-md transition-shadow">
            <div class="flex items-center justify-between mb-3">
                <span class="font-label-md text-label-md text-on-surface-variant">Tổng Số Tài Khoản</span>
                <div class="w-10 h-10 rounded-xl bg-secondary-container flex items-center justify-center text-primary">
                    <span class="material-symbols-outlined text-[22px]">group</span>
                </div>
            </div>
            <div class="flex items-baseline gap-2 mb-2">
                <span class="font-display-hero text-display-hero text-on-surface leading-none">@totalAccounts</span>
                <span class="font-label-sm text-label-sm font-semibold text-emerald-600 bg-emerald-50 px-2 py-0.5 rounded-full">Toàn hệ thống</span>
            </div>
            <div class="flex items-center justify-between text-body-sm text-on-surface-variant pt-2 border-t border-surface-container-low">
                <span>Trạng thái hoạt động</span>
                <span class="font-label-sm text-label-sm font-bold text-on-surface">@activeCount đang hoạt động</span>
            </div>
            <div class="w-full bg-surface-container-low h-1.5 rounded-full mt-2 overflow-hidden">
                <div class="bg-primary h-full rounded-full" style="width: 100%"></div>
            </div>
        </div>

        <!-- KPI 2: Quản trị viên -->
        <div class="relative overflow-hidden rounded-xl bg-surface-container-lowest p-space-lg shadow-sm hover:shadow-md transition-shadow">
            <div class="flex items-center justify-between mb-3">
                <span class="font-label-md text-label-md text-on-surface-variant">Quản Trị Viên</span>
                <div class="w-10 h-10 rounded-xl bg-primary-fixed flex items-center justify-center text-primary">
                    <span class="material-symbols-outlined text-[22px]">admin_panel_settings</span>
                </div>
            </div>
            <div class="flex items-baseline gap-2 mb-2">
                <span class="font-display-hero text-display-hero text-on-surface leading-none">@adminCount</span>
                <span class="font-label-sm text-label-sm text-on-surface-variant">Quản trị hệ thống</span>
            </div>
            <div class="flex items-center justify-between text-body-sm text-on-surface-variant pt-2 border-t border-surface-container-low">
                <span>Phạm vi phụ trách</span>
                <span class="font-label-sm text-label-sm font-bold text-emerald-700">Điều hành toàn diện</span>
            </div>
            <div class="w-full bg-surface-container-low h-1.5 rounded-full mt-2 overflow-hidden">
                <div class="bg-emerald-600 h-full rounded-full" style="width: 100%"></div>
            </div>
        </div>

        <!-- KPI 3: Nhân viên y tế -->
        <div class="relative overflow-hidden rounded-xl bg-surface-container-lowest p-space-lg shadow-sm hover:shadow-md transition-shadow">
            <div class="flex items-center justify-between mb-3">
                <span class="font-label-md text-label-md text-on-surface-variant">Nhân Viên Y Tế</span>
                <div class="w-10 h-10 rounded-xl bg-surface-container-high flex items-center justify-center text-on-surface">
                    <span class="material-symbols-outlined text-[22px]">stethoscope</span>
                </div>
            </div>
            <div class="flex items-baseline gap-2 mb-2">
                <span class="font-display-hero text-display-hero text-on-surface leading-none">@medicalStaffCount</span>
                <span class="font-label-sm text-label-sm text-on-surface-variant">Cán bộ chuyên môn</span>
            </div>
            <div class="flex items-center justify-between text-body-sm text-on-surface-variant pt-2 border-t border-surface-container-low">
                <span>Nhiệm vụ chuyên môn</span>
                <span class="font-label-sm text-label-sm font-bold text-on-surface">Khám &amp; Tiếp nhận máu</span>
            </div>
            <div class="w-full bg-surface-container-low h-1.5 rounded-full mt-2 overflow-hidden">
                <div class="bg-primary-container h-full rounded-full" style="width: 100%"></div>
            </div>
        </div>

        <!-- KPI 4: Người hiến máu -->
        <div class="relative overflow-hidden rounded-xl bg-surface-container-lowest p-space-lg shadow-sm hover:shadow-md transition-shadow">
            <div class="flex items-center justify-between mb-3">
                <span class="font-label-md text-label-md text-on-surface-variant">Người Hiến Máu</span>
                <div class="w-10 h-10 rounded-xl bg-primary/10 flex items-center justify-center text-primary">
                    <span class="material-symbols-outlined text-[22px]">volunteer_activism</span>
                </div>
            </div>
            <div class="flex items-baseline gap-2 mb-2">
                <span class="font-display-hero text-display-hero text-primary leading-none">@donorCount</span>
                <span class="font-label-sm text-label-sm font-bold text-primary bg-primary-fixed px-2 py-0.5 rounded-full">Tình nguyện viên</span>
            </div>
            <div class="flex items-center justify-between text-body-sm text-on-surface-variant pt-2 border-t border-surface-container-low">
                <span>Tài khoản bị khóa</span>
                <span class="font-label-sm text-label-sm font-semibold @(lockedCount > 0 ? "text-error" : "text-on-surface")">@lockedCount tài khoản</span>
            </div>
            <div class="w-full bg-surface-container-low h-1.5 rounded-full mt-2 overflow-hidden">
                <div class="bg-primary h-full rounded-full" style="width: 100%"></div>
            </div>
        </div>
    </section>

    <!-- 3. Block 1: Role Permission Matrix (5 Cards Grid) -->
    <section class="flex flex-col gap-space-sm">
        <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
                <span class="w-2.5 h-6 bg-primary rounded-full inline-block"></span>
                <h2 class="font-headline-sm text-headline-sm text-on-surface">
                    Nhóm Vai Trò &amp; Chức Năng Nghiệp Vụ
                </h2>
                <span class="font-label-sm text-label-sm px-2.5 py-0.5 rounded-full bg-surface-container-high text-on-surface-variant">Phân công nhiệm vụ</span>
            </div>
            <a asp-controller="Admin" asp-action="RBAC" class="font-label-md text-label-md text-primary hover:text-primary-container font-semibold inline-flex items-center gap-1 transition-colors">
                <span>Xem bảng phân quyền chi tiết</span>
                <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
            </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5 gap-space-md">
            <!-- Role 1: Quản Trị Viên -->
            <div class="flex flex-col justify-between rounded-xl bg-surface-container-lowest p-space-md shadow-sm hover:shadow-md transition-all duration-200">
                <div>
                    <div class="flex items-center justify-between mb-3">
                        <span class="px-2.5 py-1 rounded-lg bg-primary-fixed text-primary font-label-sm text-label-sm font-bold uppercase tracking-wider">
                            Quản trị hệ thống
                        </span>
                        <span class="w-8 h-8 rounded-full bg-primary/10 flex items-center justify-center text-primary">
                            <span class="material-symbols-outlined text-[18px]">verified_user</span>
                        </span>
                    </div>
                    <h3 class="font-title-md text-title-md text-on-surface font-bold leading-snug">
                        Quản Trị Viên Hệ Thống
                    </h3>
                    <p class="font-label-sm text-label-sm text-on-surface-variant mt-1 mb-3">
                        Điều hành chung toàn hệ thống
                    </p>
                    <div class="space-y-1.5 pt-2 border-t border-surface-container-low font-body-sm text-body-sm text-on-surface-variant">
                        <div class="flex items-start gap-1.5">
                            <span class="material-symbols-outlined text-primary text-[16px] shrink-0 mt-0.5">check_circle</span>
                            <span>Quản lý tài khoản &amp; phân quyền</span>
                        </div>
                        <div class="flex items-start gap-1.5">
                            <span class="material-symbols-outlined text-primary text-[16px] shrink-0 mt-0.5">check_circle</span>
                            <span>Quản lý đơn vị tổ chức hiến máu</span>
                        </div>
                        <div class="flex items-start gap-1.5">
                            <span class="material-symbols-outlined text-primary text-[16px] shrink-0 mt-0.5">check_circle</span>
                            <span>Quản lý đợt hiến máu nhân đạo</span>
                        </div>
                        <div class="flex items-start gap-1.5">
                            <span class="material-symbols-outlined text-primary text-[16px] shrink-0 mt-0.5">check_circle</span>
                            <span>Theo dõi báo cáo tổng hợp</span>
                        </div>
                    </div>
                </div>
                <a asp-controller="Admin" asp-action="RBAC" class="mt-4 w-full py-2 px-3 rounded-lg bg-surface-container-low hover:bg-surface-container text-on-surface font-label-sm text-label-sm font-semibold transition-colors flex items-center justify-center gap-1">
                    <span class="material-symbols-outlined text-[16px]">edit</span>
                    <span>Xem quyền hạn vai trò</span>
                </a>
            </div>

            <!-- Role 2: Bác Sĩ Sàng Lọc -->
            <div class="flex flex-col justify-between rounded-xl bg-surface-container-lowest p-space-md shadow-sm hover:shadow-md transition-all duration-200">
                <div>
                    <div class="flex items-center justify-between mb-3">
                        <span class="px-2.5 py-1 rounded-lg bg-surface-container-high text-on-surface font-label-sm text-label-sm font-bold uppercase tracking-wider">
                            Khám sàng lọc
                        </span>
                        <span class="w-8 h-8 rounded-full bg-surface-container flex items-center justify-center text-on-surface">
                            <span class="material-symbols-outlined text-[18px]">clinical_notes</span>
                        </span>
                    </div>
                    <h3 class="font-title-md text-title-md text-on-surface font-bold leading-snug">
                        Bác Sĩ Khám Sàng Lọc
                    </h3>
                    <p class="font-label-sm text-label-sm text-on-surface-variant mt-1 mb-3">
                        Chuyên môn khám trước hiến máu
                    </p>
                    <div class="space-y-1.5 pt-2 border-t border-surface-container-low font-body-sm text-body-sm text-on-surface-variant">
                        <div class="flex items-start gap-1.5">
                            <span class="material-symbols-outlined text-primary text-[16px] shrink-0 mt-0.5">check_circle</span>
                            <span>Khám thể lực &amp; tiền sử sức khỏe</span>
                        </div>
                        <div class="flex items-start gap-1.5">
                            <span class="material-symbols-outlined text-primary text-[16px] shrink-0 mt-0.5">check_circle</span>
                            <span>Đánh giá điều kiện tham gia hiến</span>
                        </div>
                        <div class="flex items-start gap-1.5">
                            <span class="material-symbols-outlined text-primary text-[16px] shrink-0 mt-0.5">check_circle</span>
                            <span>Chỉ định lượng máu tiếp nhận</span>
                        </div>
                        <div class="flex items-start gap-1.5 text-on-surface-variant/50">
                            <span class="material-symbols-outlined text-[16px] shrink-0 mt-0.5">block</span>
                            <span>Không quản lý tài khoản hệ thống</span>
                        </div>
                    </div>
                </div>
                <a asp-controller="Admin" asp-action="RBAC" class="mt-4 w-full py-2 px-3 rounded-lg bg-surface-container-low hover:bg-surface-container text-on-surface font-label-sm text-label-sm font-semibold transition-colors flex items-center justify-center gap-1">
                    <span class="material-symbols-outlined text-[16px]">edit</span>
                    <span>Xem quyền hạn vai trò</span>
                </a>
            </div>

            <!-- Role 3: Nhân Viên Xét Nghiệm -->
            <div class="flex flex-col justify-between rounded-xl bg-surface-container-lowest p-space-md shadow-sm hover:shadow-md transition-all duration-200">
                <div>
                    <div class="flex items-center justify-between mb-3">
                        <span class="px-2.5 py-1 rounded-lg bg-emerald-100 text-emerald-800 font-label-sm text-label-sm font-bold uppercase tracking-wider">
                            Xét nghiệm máu
                        </span>
                        <span class="w-8 h-8 rounded-full bg-emerald-50 flex items-center justify-center text-emerald-700">
                            <span class="material-symbols-outlined text-[18px]">biotech</span>
                        </span>
                    </div>
                    <h3 class="font-title-md text-title-md text-on-surface font-bold leading-snug">
                        Kỹ Thuật Viên Xét Nghiệm
                    </h3>
                    <p class="font-label-sm text-label-sm text-on-surface-variant mt-1 mb-3">
                        Ghi nhận kết quả hiến máu
                    </p>
                    <div class="space-y-1.5 pt-2 border-t border-surface-container-low font-body-sm text-body-sm text-on-surface-variant">
                        <div class="flex items-start gap-1.5">
                            <span class="material-symbols-outlined text-emerald-700 text-[16px] shrink-0 mt-0.5">check_circle</span>
                            <span>Ghi nhận kết quả sàng lọc máu</span>
                        </div>
                        <div class="flex items-start gap-1.5">
                            <span class="material-symbols-outlined text-emerald-700 text-[16px] shrink-0 mt-0.5">check_circle</span>
                            <span>Xác định nhóm máu người hiến</span>
                        </div>
                        <div class="flex items-start gap-1.5">
                            <span class="material-symbols-outlined text-emerald-700 text-[16px] shrink-0 mt-0.5">check_circle</span>
                            <span>Cập nhật nhận xét sau hiến máu</span>
                        </div>
                        <div class="flex items-start gap-1.5 text-on-surface-variant/50">
                            <span class="material-symbols-outlined text-[16px] shrink-0 mt-0.5">block</span>
                            <span>Không sửa thông tin cá nhân</span>
                        </div>
                    </div>
                </div>
                <a asp-controller="Admin" asp-action="RBAC" class="mt-4 w-full py-2 px-3 rounded-lg bg-surface-container-low hover:bg-surface-container text-on-surface font-label-sm text-label-sm font-semibold transition-colors flex items-center justify-center gap-1">
                    <span class="material-symbols-outlined text-[16px]">edit</span>
                    <span>Xem quyền hạn vai trò</span>
                </a>
            </div>

            <!-- Role 4: Cán Bộ Quản Lý Kho Máu -->
            <div class="flex flex-col justify-between rounded-xl bg-surface-container-lowest p-space-md shadow-sm hover:shadow-md transition-all duration-200">
                <div>
                    <div class="flex items-center justify-between mb-3">
                        <span class="px-2.5 py-1 rounded-lg bg-sky-100 text-sky-800 font-label-sm text-label-sm font-bold uppercase tracking-wider">
                            Lưu trữ &amp; Bảo quản
                        </span>
                        <span class="w-8 h-8 rounded-full bg-sky-50 flex items-center justify-center text-sky-700">
                            <span class="material-symbols-outlined text-[18px]">ac_unit</span>
                        </span>
                    </div>
                    <h3 class="font-title-md text-title-md text-on-surface font-bold leading-snug">
                        Cán Bộ Quản Lý Kho Máu
                    </h3>
                    <p class="font-label-sm text-label-sm text-on-surface-variant mt-1 mb-3">
                        Theo dõi tiếp nhận &amp; bảo quản
                    </p>
                    <div class="space-y-1.5 pt-2 border-t border-surface-container-low font-body-sm text-body-sm text-on-surface-variant">
                        <div class="flex items-start gap-1.5">
                            <span class="material-symbols-outlined text-sky-700 text-[16px] shrink-0 mt-0.5">check_circle</span>
                            <span>Tiếp nhận đơn vị máu đạt chuẩn</span>
                        </div>
                        <div class="flex items-start gap-1.5">
                            <span class="material-symbols-outlined text-sky-700 text-[16px] shrink-0 mt-0.5">check_circle</span>
                            <span>Theo dõi điều kiện bảo quản máu</span>
                        </div>
                        <div class="flex items-start gap-1.5">
                            <span class="material-symbols-outlined text-sky-700 text-[16px] shrink-0 mt-0.5">check_circle</span>
                            <span>Điều phối cung cấp cho bệnh viện</span>
                        </div>
                        <div class="flex items-start gap-1.5 text-on-surface-variant/50">
                            <span class="material-symbols-outlined text-[16px] shrink-0 mt-0.5">block</span>
                            <span>Không sửa kết quả xét nghiệm</span>
                        </div>
                    </div>
                </div>
                <a asp-controller="Admin" asp-action="RBAC" class="mt-4 w-full py-2 px-3 rounded-lg bg-surface-container-low hover:bg-surface-container text-on-surface font-label-sm text-label-sm font-semibold transition-colors flex items-center justify-center gap-1">
                    <span class="material-symbols-outlined text-[16px]">edit</span>
                    <span>Xem quyền hạn vai trò</span>
                </a>
            </div>

            <!-- Role 5: Người Hiến Máu -->
            <div class="flex flex-col justify-between rounded-xl bg-surface-container-lowest p-space-md shadow-sm hover:shadow-md transition-all duration-200">
                <div>
                    <div class="flex items-center justify-between mb-3">
                        <span class="px-2.5 py-1 rounded-lg bg-secondary-container text-on-secondary-container font-label-sm text-label-sm font-bold uppercase tracking-wider">
                            Tình nguyện viên
                        </span>
                        <span class="w-8 h-8 rounded-full bg-secondary-container/60 flex items-center justify-center text-on-secondary-container">
                            <span class="material-symbols-outlined text-[18px]">groups</span>
                        </span>
                    </div>
                    <h3 class="font-title-md text-title-md text-on-surface font-bold leading-snug">
                        Người Hiến Máu Tình Nguyện
                    </h3>
                    <p class="font-label-sm text-label-sm text-on-surface-variant mt-1 mb-3">
                        Tham gia các đợt hiến máu
                    </p>
                    <div class="space-y-1.5 pt-2 border-t border-surface-container-low font-body-sm text-body-sm text-on-surface-variant">
                        <div class="flex items-start gap-1.5">
                            <span class="material-symbols-outlined text-primary text-[16px] shrink-0 mt-0.5">check_circle</span>
                            <span>Đăng ký tham gia đợt hiến máu</span>
                        </div>
                        <div class="flex items-start gap-1.5">
                            <span class="material-symbols-outlined text-primary text-[16px] shrink-0 mt-0.5">check_circle</span>
                            <span>Theo dõi lịch hẹn khám sàng lọc</span>
                        </div>
                        <div class="flex items-start gap-1.5">
                            <span class="material-symbols-outlined text-primary text-[16px] shrink-0 mt-0.5">check_circle</span>
                            <span>Tra cứu lịch sử &amp; kết quả hiến máu</span>
                        </div>
                        <div class="flex items-start gap-1.5 text-on-surface-variant/50">
                            <span class="material-symbols-outlined text-[16px] shrink-0 mt-0.5">block</span>
                            <span>Không truy cập trang quản trị</span>
                        </div>
                    </div>
                </div>
                <a asp-controller="Admin" asp-action="RBAC" class="mt-4 w-full py-2 px-3 rounded-lg bg-surface-container-low hover:bg-surface-container text-on-surface font-label-sm text-label-sm font-semibold transition-colors flex items-center justify-center gap-1">
                    <span class="material-symbols-outlined text-[16px]">edit</span>
                    <span>Xem quyền hạn vai trò</span>
                </a>
            </div>
        </div>
    </section>

    <!-- 4. Block 2: Account Directory & Status Table -->
    <section class="flex flex-col gap-space-sm">
        <!-- Filter Bar -->
        <form method="get" asp-controller="Admin" asp-action="NhanSu" class="p-space-md bg-surface-container-lowest rounded-xl shadow-sm flex flex-col lg:flex-row gap-3 items-stretch lg:items-center justify-between">
            <div class="flex flex-1 flex-col sm:flex-row gap-3">
                <!-- Search input -->
                <div class="relative flex-1">
                    <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant text-[20px]">search</span>
                    <input name="search" value="@ViewBag.CurrentSearch" class="w-full h-11 pl-10 pr-4 bg-surface-container-low rounded-xl font-body-sm text-body-sm text-on-surface placeholder:text-on-surface-variant/60 focus:outline-none focus:bg-surface-container-lowest transition-all" placeholder="Tìm tên đăng nhập, họ và tên, địa chỉ email..." type="search">
                </div>
                <!-- Role Filter -->
                <div class="relative min-w-[200px]">
                    <select name="vaiTro" class="w-full h-11 px-3 bg-surface-container-low rounded-xl font-body-sm text-body-sm text-on-surface focus:outline-none cursor-pointer appearance-none">
                        <option value="all">Tất cả vai trò</option>
                        <option value="Admin" selected="@(ViewBag.CurrentVaiTro == "Admin" ? "selected" : null)">Quản trị viên</option>
                        <option value="Medical Staff" selected="@(ViewBag.CurrentVaiTro == "Medical Staff" ? "selected" : null)">Nhân viên y tế</option>
                        <option value="Donor" selected="@(ViewBag.CurrentVaiTro == "Donor" ? "selected" : null)">Người hiến máu</option>
                    </select>
                    <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-on-surface-variant pointer-events-none text-[18px]">expand_more</span>
                </div>
                <!-- Status Filter -->
                <div class="relative min-w-[190px]">
                    <select name="trangThai" class="w-full h-11 px-3 bg-surface-container-low rounded-xl font-body-sm text-body-sm text-on-surface focus:outline-none cursor-pointer appearance-none">
                        <option value="all">Tất cả trạng thái</option>
                        <option value="Hoạt động" selected="@(ViewBag.CurrentTrangThai == "Hoạt động" ? "selected" : null)">Hoạt động</option>
                        <option value="Bị khóa" selected="@(ViewBag.CurrentTrangThai == "Bị khóa" ? "selected" : null)">Bị khóa</option>
                    </select>
                    <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-on-surface-variant pointer-events-none text-[18px]">expand_more</span>
                </div>
            </div>
            <!-- Submit Button & Reset -->
            <div class="flex items-center gap-2 self-end lg:self-center shrink-0">
                <button type="submit" class="px-4 py-2.5 rounded-xl bg-primary text-on-primary font-label-md text-label-md font-semibold hover:bg-primary-container transition-all flex items-center gap-1.5 cursor-pointer">
                    <span class="material-symbols-outlined text-[18px]">search</span>
                    <span>Tìm Kiếm</span>
                </button>
                <a asp-controller="Admin" asp-action="NhanSu" class="p-2.5 rounded-xl bg-surface-container-low hover:bg-surface-container text-on-surface transition-colors" title="Làm mới danh sách">
                    <span class="material-symbols-outlined text-[20px]">refresh</span>
                </a>
            </div>
        </form>

        <!-- Table Wrapper -->
        <div class="overflow-x-auto rounded-xl bg-surface-container-lowest shadow-sm">
            <table class="w-full text-left border-collapse min-w-[1050px]">
                <thead>
                    <tr class="bg-surface-container-low font-label-md text-label-md text-on-surface-variant">
                        <th class="py-3.5 px-space-md">Họ Tên &amp; Tên Đăng Nhập</th>
                        <th class="py-3.5 px-space-md">Mã Tài Khoản &amp; Đơn Vị</th>
                        <th class="py-3.5 px-space-md">Vai Trò Hệ Thống</th>
                        <th class="py-3.5 px-space-md">Thông Tin Hồ Sơ</th>
                        <th class="py-3.5 px-space-md">Phạm Vi Hoạt Động</th>
                        <th class="py-3.5 px-space-md">Trạng Thái</th>
                        <th class="py-3.5 px-space-md text-right">Thao Tác</th>
                    </tr>
                </thead>
                <tbody id="staffTableBody" class="font-body-sm text-body-sm text-on-surface divide-y divide-surface-container-low">
                    @if (Model != null && Model.Any())
                    {
                        foreach (var acc in Model)
                        {
                            var words = (acc.HoTen ?? "TK").Split(' ', StringSplitOptions.RemoveEmptyEntries);
                            var initials = words.Length > 1 ? (words[0].Substring(0, 1) + words[words.Length - 1].Substring(0, 1)).ToUpper() : (words.Length == 1 && words[0].Length > 0 ? words[0].Substring(0, Math.Min(2, words[0].Length)).ToUpper() : "TK");
                            var isLocked = acc.TrangThai == "Bị khóa";

                            <tr class="hover:bg-surface-container-low/50 transition-colors @(isLocked ? "bg-red-50/40" : "")">
                                <td class="py-3.5 px-space-md">
                                    <div class="flex items-center gap-3">
                                        <div class="relative w-10 h-10 rounded-full @(acc.VaiTro == "Admin" ? "bg-purple-700 text-white" : (acc.VaiTro == "Medical Staff" ? "bg-primary text-on-primary" : "bg-secondary-container text-primary")) flex items-center justify-center font-bold text-label-md shrink-0">
                                            @initials
                                            @if (!isLocked)
                                            {
                                                <span class="absolute -bottom-0.5 -right-0.5 w-3.5 h-3.5 rounded-full bg-emerald-500 ring-2 ring-white"></span>
                                            }
                                            else
                                            {
                                                <span class="absolute -bottom-0.5 -right-0.5 w-3.5 h-3.5 rounded-full bg-red-500 ring-2 ring-white"></span>
                                            }
                                        </div>
                                        <div class="flex flex-col">
                                            <div class="flex items-center gap-1.5">
                                                <span class="font-title-md text-title-md font-bold text-on-surface">@acc.HoTen</span>
                                                <span class="text-xs text-on-surface-variant">(@acc.TenDangNhap)</span>
                                            </div>
                                            <div class="flex items-center gap-2 font-label-sm text-label-sm text-on-surface-variant">
                                                <span>Email: @(acc.Email ?? "Chưa cập nhật")</span>
                                                @if (acc.NguoiHienMau?.SoDienThoai != null)
                                                {
                                                    <span>• SĐT: @acc.NguoiHienMau.SoDienThoai</span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </td>
                                <td class="py-3.5 px-space-md">
                                    <div class="flex flex-col">
                                        <span class="font-semibold text-on-surface">Hệ Thống Hiến Máu UNETI</span>
                                        <span class="text-on-surface-variant font-label-sm text-label-sm">Mã TK: #@acc.MaTaiKhoan</span>
                                    </div>
                                </td>
                                <td class="py-3.5 px-space-md">
                                    @if (acc.VaiTro == "Admin")
                                    {
                                        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-purple-100 text-purple-800 font-label-sm text-label-sm font-bold">
                                            <span class="material-symbols-outlined text-[14px]">admin_panel_settings</span>
                                            Quản Trị Viên
                                        </span>
                                    }
                                    else if (acc.VaiTro == "Medical Staff")
                                    {
                                        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-primary-fixed text-primary font-label-sm text-label-sm font-bold">
                                            <span class="material-symbols-outlined text-[14px]">stethoscope</span>
                                            Nhân Viên Y Tế
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-secondary-container text-on-secondary-container font-label-sm text-label-sm font-semibold">
                                            <span class="material-symbols-outlined text-[14px]">person</span>
                                            Người Hiến Máu
                                        </span>
                                    }
                                </td>
                                <td class="py-3.5 px-space-md">
                                    <div class="flex flex-col gap-0.5">
                                        <div class="flex items-center gap-1.5">
                                            <span class="w-2 h-2 rounded-full @(!isLocked ? "bg-emerald-500" : "bg-red-500")"></span>
                                            <span class="font-semibold @(!isLocked ? "text-emerald-800" : "text-red-700") font-label-sm text-label-sm">Hồ sơ thành viên</span>
                                        </div>
                                        <span class="font-label-sm text-label-sm text-on-surface-variant">Thông tin hợp lệ</span>
                                    </div>
                                </td>
                                <td class="py-3.5 px-space-md">
                                    <span class="text-xs text-on-surface-variant">Cổng Hiến Máu UNETI</span>
                                </td>
                                <td class="py-3.5 px-space-md">
                                    @if (isLocked)
                                    {
                                        <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-red-100 text-red-700 font-label-sm text-label-sm font-bold">
                                            <span class="w-1.5 h-1.5 rounded-full bg-red-600"></span>
                                            Bị Khóa
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-emerald-50 text-emerald-700 font-label-sm text-label-sm font-semibold">
                                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span>
                                            Đang hoạt động
                                        </span>
                                    }
                                </td>
                                <td class="py-3.5 px-space-md text-right">
                                    <div class="inline-flex items-center gap-2">
                                        <button type="button" onclick='openResetPasswordModal(@acc.MaTaiKhoan, @Html.Raw(System.Text.Json.JsonSerializer.Serialize(acc.TenDangNhap)), @Html.Raw(System.Text.Json.JsonSerializer.Serialize(acc.HoTen)))' class="inline-flex items-center gap-1 px-3 py-1.5 rounded-xl text-xs font-bold transition-all shadow-xs cursor-pointer bg-surface-container hover:bg-surface-container-high text-on-surface" title="Đặt lại mật khẩu">
                                            <span class="material-symbols-outlined text-[16px]">lock_reset</span>
                                            <span>Đổi MK</span>
                                        </button>
                                        @if (acc.MaTaiKhoan == currentUserId && !isLocked)
                                        {
                                            <span class="inline-flex items-center gap-1 px-3 py-1.5 rounded-xl text-xs font-bold bg-surface-container-low text-on-surface-variant border border-surface-container" title="Tài khoản đang đăng nhập">
                                                <span class="material-symbols-outlined text-[16px] text-emerald-600">verified_user</span>
                                                <span>Tài khoản của bạn</span>
                                            </span>
                                        }
                                        else
                                        {
                                            var confirmText = $"Bạn có chắc chắn muốn {(isLocked ? "MỞ KHÓA" : "KHÓA")} tài khoản '{acc.TenDangNhap}' ({acc.HoTen}) không?";
                                            <form method="post" asp-controller="Admin" asp-action="KhoaMoKhoaTaiKhoan" class="inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@acc.MaTaiKhoan" />
                                                <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                                <button type="submit" class="inline-flex items-center gap-1 px-3 py-1.5 rounded-xl text-xs font-bold transition-all shadow-xs cursor-pointer @(isLocked ? "bg-emerald-600 hover:bg-emerald-700 text-white" : "bg-red-50 hover:bg-red-100 text-red-700 border border-red-200")" title="@(isLocked ? "Mở khóa tài khoản" : "Khóa tài khoản này")" onclick='return confirm(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(confirmText)));'>
                                                    <span class="material-symbols-outlined text-[16px]">@(isLocked ? "lock_open" : "lock")</span>
                                                    <span>@(isLocked ? "Mở Khóa" : "Khóa TK")</span>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="py-8 text-center text-on-surface-variant font-body-md">
                                Không tìm thấy tài khoản nào phù hợp với điều kiện tìm kiếm hiện tại.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <!-- Pagination Bar -->
            <div class="px-space-md py-3 bg-surface-container-low flex flex-col sm:flex-row items-center justify-between gap-3 text-body-sm text-on-surface-variant">
                <div class="flex items-center gap-2">
                    <span>Hiển thị</span>
                    <span class="font-semibold text-on-surface">@filteredCount</span>
                    <span>/</span>
                    <span class="font-semibold text-on-surface">@totalAccounts</span>
                    <span>tài khoản trên hệ thống</span>
                </div>
            </div>
        </div>
    </section>

    <!-- 5. Block 3: Activity History Log -->
    <section id="auditTrailSection" class="rounded-xl bg-surface-container-lowest p-space-lg shadow-sm flex flex-col gap-space-md">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-surface-container-low pb-space-sm">
            <div class="flex items-center gap-2.5">
                <div class="w-8 h-8 rounded-lg bg-inverse-surface text-inverse-on-surface flex items-center justify-center">
                    <span class="material-symbols-outlined text-[18px]">history</span>
                </div>
                <div>
                    <h3 class="font-headline-sm text-headline-sm text-on-surface leading-snug">
                        Lịch Sử Hoạt Động Quản Trị &amp; Nghiệp Vụ
                    </h3>
                    <p class="font-label-sm text-label-sm text-on-surface-variant">
                        Theo dõi các hoạt động cập nhật tài khoản, phân công nhân sự và phê duyệt chuyên môn
                    </p>
                </div>
            </div>
            <div class="flex items-center gap-2">
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-50 text-emerald-700 font-label-sm text-label-sm font-semibold">
                    <span class="w-2 h-2 rounded-full bg-emerald-600 animate-ping"></span>
                    Ghi nhận hoạt động: Bình thường
                </span>
            </div>
        </div>

        <!-- Activity Log Items -->
        <div class="space-y-3 font-body-sm text-body-sm">
            <!-- Log Item 1 -->
            <div class="flex items-start gap-3 p-3 rounded-xl bg-surface-container-low/70 hover:bg-surface-container-low transition-colors">
                <span class="px-2 py-0.5 rounded text-label-sm font-bold bg-primary text-on-primary shrink-0 mt-0.5">
                    08:42
                </span>
                <div class="flex-1 min-w-0">
                    <div class="flex flex-wrap items-center gap-2">
                        <span class="font-bold text-on-surface">BS. CKI Trần Mai Linh</span>
                        <span class="text-on-surface-variant">đã xác nhận phê duyệt</span>
                        <span class="px-2 py-0.5 rounded bg-surface-container-highest text-on-surface font-semibold text-label-sm">Phiếu điều phối máu cấp cứu</span>
                        <span class="text-on-surface-variant">với</span>
                        <strong class="text-primary font-semibold">04 đơn vị máu nhóm O Rh(-)</strong>
                        <span class="text-on-surface-variant">hỗ trợ Bệnh viện Hữu nghị Việt Đức.</span>
                    </div>
                    <div class="mt-1 flex items-center gap-2 text-[11px] text-on-surface-variant">
                        <span>Đơn vị: Viện Huyết học - Truyền máu TW</span>
                        <span>•</span>
                        <span class="text-emerald-700 font-semibold">Đã hoàn tất thủ tục bàn giao</span>
                    </div>
                </div>
                <span class="material-symbols-outlined text-emerald-600 text-[20px] shrink-0">verified</span>
            </div>

            <!-- Log Item 2 -->
            <div class="flex items-start gap-3 p-3 rounded-xl bg-surface-container-low/70 hover:bg-surface-container-low transition-colors">
                <span class="px-2 py-0.5 rounded text-label-sm font-bold bg-surface-container-highest text-on-surface shrink-0 mt-0.5">
                    08:30
                </span>
                <div class="flex-1 min-w-0">
                    <div class="flex flex-wrap items-center gap-2">
                        <span class="font-bold text-on-surface">KTV. Lê Thảo Trang</span>
                        <span class="text-on-surface-variant">đã hoàn thành cập nhật kết quả xét nghiệm sàng lọc cho phiếu hiến máu</span>
                        <span class="px-2 py-0.5 rounded bg-emerald-100 text-emerald-800 font-semibold text-label-sm">Đạt tiêu chuẩn tiếp nhận</span>.
                    </div>
                    <div class="mt-1 flex items-center gap-2 text-[11px] text-on-surface-variant">
                        <span>Bộ phận: Khoa Xét nghiệm sàng lọc máu</span>
                        <span>•</span>
                        <span>Đã cập nhật vào hồ sơ người hiến máu</span>
                    </div>
                </div>
                <span class="material-symbols-outlined text-emerald-600 text-[20px] shrink-0">check_circle</span>
            </div>

            <!-- Log Item 3 -->
            <div class="flex items-start gap-3 p-3 rounded-xl bg-surface-container-low/70 hover:bg-surface-container-low transition-colors">
                <span class="px-2 py-0.5 rounded text-label-sm font-bold bg-surface-container-highest text-on-surface shrink-0 mt-0.5">
                    07:15
                </span>
                <div class="flex-1 min-w-0">
                    <div class="flex flex-wrap items-center gap-2">
                        <span class="font-bold text-on-surface">Quản trị viên hệ thống</span>
                        <span class="text-on-surface-variant">đã phân công nhân sự phụ trách</span>
                        <span class="px-2 py-0.5 rounded bg-secondary-container text-on-secondary-container font-semibold text-label-sm">Điểm hiến máu lưu động</span>
                        <span class="text-on-surface-variant">phục vụ đợt tiếp nhận hiến máu tình nguyện tại</span>
                        <span class="font-semibold text-on-surface">Trường Đại học Kinh tế - Kỹ thuật Công nghiệp (UNETI)</span>.
                    </div>
                    <div class="mt-1 flex items-center gap-2 text-[11px] text-on-surface-variant">
                        <span>Kíp trực khám sàng lọc &amp; tiếp nhận máu</span>
                        <span>•</span>
                        <span>Đã thông báo lịch làm việc cho cán bộ y tế</span>
                    </div>
                </div>
                <span class="material-symbols-outlined text-on-surface-variant text-[20px] shrink-0">badge</span>
            </div>
        </div>
    </section>

    <!-- Modal Thêm Tài Khoản Mới -->
    <div id="modalCreateAccount" class="fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-xs @(TempData["OpenCreateModal"] != null ? "" : "hidden")">
        <div class="bg-surface-container-lowest rounded-3xl p-6 sm:p-8 max-w-lg w-full mx-4 shadow-2xl border border-surface-container relative">
            <div class="flex items-center justify-between mb-4 pb-3 border-b border-surface-container">
                <div class="flex items-center gap-2.5">
                    <div class="w-10 h-10 rounded-xl bg-primary-fixed flex items-center justify-center text-primary">
                        <span class="material-symbols-outlined text-[22px]">person_add</span>
                    </div>
                    <div>
                        <h3 class="font-title-lg font-bold text-on-surface">Tạo Tài Khoản Người Dùng Mới</h3>
                        <p class="text-xs text-on-surface-variant">Thiết lập thông tin tài khoản và phân quyền vai trò trên hệ thống</p>
                    </div>
                </div>
                <button onclick="document.getElementById('modalCreateAccount').classList.add('hidden')" class="p-1 rounded-lg text-on-surface-variant hover:bg-surface-container cursor-pointer" type="button">
                    <span class="material-symbols-outlined text-[20px]">close</span>
                </button>
            </div>

            @if (TempData["CreateAccountError"] != null)
            {
                <div class="mb-4 p-3.5 rounded-xl bg-red-50 border border-red-200 text-red-700 flex items-center gap-2.5 text-xs font-semibold">
                    <span class="material-symbols-outlined text-[20px] text-red-600 shrink-0">error</span>
                    <span>@TempData["CreateAccountError"]</span>
                </div>
            }

            <form method="post" asp-controller="Admin" asp-action="TaoTaiKhoan" class="space-y-4">
                @Html.AntiForgeryToken()

                <div>
                    <label class="block text-xs font-bold text-on-surface mb-1">Tên Đăng Nhập <span class="text-primary">*</span></label>
                    <input name="TenDangNhap" value="@(TempData["CreateTenDangNhap"] ?? "")" required minlength="3" maxlength="50" pattern="^[a-zA-Z0-9_.-]+$" title="Tên đăng nhập từ 3 đến 50 ký tự, không chứa dấu cách" placeholder="Ví dụ: bstranlinh" class="w-full h-11 px-3.5 rounded-xl border border-outline-variant focus:border-primary focus:ring-2 focus:ring-primary/20 text-sm bg-surface-container-low" />
                    <span class="text-[11px] text-on-surface-variant mt-0.5 block">Từ 3 đến 50 ký tự, viết liền không dấu cách, không trùng lặp.</span>
                </div>

                <div>
                    <label class="block text-xs font-bold text-on-surface mb-1">Họ Và Tên Đầy Đủ <span class="text-primary">*</span></label>
                    <input name="HoTen" value="@(TempData["CreateHoTen"] ?? "")" required maxlength="100" placeholder="Ví dụ: BS. Trần Mai Linh" class="w-full h-11 px-3.5 rounded-xl border border-outline-variant focus:border-primary focus:ring-2 focus:ring-primary/20 text-sm bg-surface-container-low" />
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-bold text-on-surface mb-1">Địa Chỉ Email</label>
                        <input name="Email" type="email" value="@(TempData["CreateEmail"] ?? "")" placeholder="linh.tm@uneti.edu.vn" class="w-full h-11 px-3.5 rounded-xl border border-outline-variant focus:border-primary focus:ring-2 focus:ring-primary/20 text-sm bg-surface-container-low" />
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-on-surface mb-1">Mật Khẩu Khởi Tạo <span class="text-primary">*</span></label>
                        <input name="MatKhau" type="password" required minlength="6" placeholder="Tối thiểu 6 ký tự" class="w-full h-11 px-3.5 rounded-xl border border-outline-variant focus:border-primary focus:ring-2 focus:ring-primary/20 text-sm bg-surface-container-low" />
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-bold text-on-surface mb-1">Vai Trò Hệ Thống <span class="text-primary">*</span></label>
                        <select name="VaiTro" class="w-full h-11 px-3.5 rounded-xl border border-outline-variant focus:border-primary focus:ring-2 focus:ring-primary/20 text-sm bg-surface-container-low">
                            <option value="Medical Staff" selected="@(TempData["CreateVaiTro"]?.ToString() == "Medical Staff" ? "selected" : null)">Nhân Viên Y Tế</option>
                            <option value="Admin" selected="@(TempData["CreateVaiTro"]?.ToString() == "Admin" ? "selected" : null)">Quản Trị Viên</option>
                            <option value="Donor" selected="@(TempData["CreateVaiTro"]?.ToString() == "Donor" ? "selected" : null)">Người Hiến Máu</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-on-surface mb-1">Trạng Thái Tài Khoản</label>
                        <select name="TrangThai" class="w-full h-11 px-3.5 rounded-xl border border-outline-variant focus:border-primary focus:ring-2 focus:ring-primary/20 text-sm bg-surface-container-low">
                            <option value="Hoạt động" selected="@(TempData["CreateTrangThai"]?.ToString() == "Hoạt động" ? "selected" : null)">Hoạt động</option>
                            <option value="Bị khóa" selected="@(TempData["CreateTrangThai"]?.ToString() == "Bị khóa" ? "selected" : null)">Bị khóa</option>
                        </select>
                    </div>
                </div>

                <div class="flex items-center justify-end gap-3 pt-3 border-t border-surface-container">
                    <button onclick="document.getElementById('modalCreateAccount').classList.add('hidden')" type="button" class="px-4 py-2.5 rounded-xl bg-surface-container hover:bg-surface-container-high text-on-surface text-sm font-semibold cursor-pointer">
                        Hủy bỏ
                    </button>
                    <button type="submit" class="px-5 py-2.5 rounded-xl bg-primary text-on-primary text-sm font-bold shadow-md hover:bg-primary-container cursor-pointer flex items-center gap-1.5">
                        <span class="material-symbols-outlined text-[18px]">check</span>
                        <span>Tạo Tài Khoản</span>
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Modal Đặt Lại Mật Khẩu -->
    <div id="modalResetPassword" class="fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-xs hidden">
        <div class="bg-surface-container-lowest rounded-3xl p-6 sm:p-8 max-w-md w-full mx-4 shadow-2xl border border-surface-container relative">
            <div class="flex items-center justify-between mb-4 pb-3 border-b border-surface-container">
                <div class="flex items-center gap-2.5">
                    <div class="w-10 h-10 rounded-xl bg-primary-fixed flex items-center justify-center text-primary">
                        <span class="material-symbols-outlined text-[22px]">lock_reset</span>
                    </div>
                    <div>
                        <h3 class="font-title-lg font-bold text-on-surface">Đặt Lại Mật Khẩu</h3>
                        <p class="text-xs text-on-surface-variant" id="resetPwdAccountLabel">Cấp lại mật khẩu mới cho tài khoản</p>
                    </div>
                </div>
                <button onclick="document.getElementById('modalResetPassword').classList.add('hidden')" class="p-1 rounded-lg text-on-surface-variant hover:bg-surface-container cursor-pointer" type="button">
                    <span class="material-symbols-outlined text-[20px]">close</span>
                </button>
            </div>

            <form method="post" asp-controller="Admin" asp-action="DoiMatKhau" class="space-y-4">
                @Html.AntiForgeryToken()
                <input type="hidden" id="resetPwdAccountId" name="id" />

                <div>
                    <label class="block text-xs font-bold text-on-surface mb-1">Mật Khẩu Mới <span class="text-primary">*</span></label>
                    <input name="matKhauMoi" type="password" required minlength="6" placeholder="Nhập mật khẩu mới (tối thiểu 6 ký tự)" class="w-full h-11 px-3.5 rounded-xl border border-outline-variant focus:border-primary focus:ring-2 focus:ring-primary/20 text-sm bg-surface-container-low" />
                </div>

                <div class="flex items-center justify-end gap-3 pt-3 border-t border-surface-container">
                    <button onclick="document.getElementById('modalResetPassword').classList.add('hidden')" type="button" class="px-4 py-2.5 rounded-xl bg-surface-container hover:bg-surface-container-high text-on-surface text-sm font-semibold cursor-pointer">
                        Hủy bỏ
                    </button>
                    <button type="submit" class="px-5 py-2.5 rounded-xl bg-primary text-on-primary text-sm font-bold shadow-md hover:bg-primary-container cursor-pointer flex items-center gap-1.5">
                        <span class="material-symbols-outlined text-[18px]">check</span>
                        <span>Lưu Mật Khẩu Mới</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function openResetPasswordModal(id, username, fullName) {
        document.getElementById('resetPwdAccountId').value = id;
        document.getElementById('resetPwdAccountLabel').textContent = 'Tài khoản: ' + fullName + ' (' + username + ')';
        document.getElementById('modalResetPassword').classList.remove('hidden');
    }
</script>
