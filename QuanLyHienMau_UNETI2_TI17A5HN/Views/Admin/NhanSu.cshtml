@{
    ViewData["Title"] = "Phân quyền nhân sự & Quản trị tài khoản y tế";
    Layout = "_AdminLayout";
}

<!-- Subtle Ambient Glow -->
<div class="relative w-full overflow-hidden px-space-lg py-space-lg flex flex-col gap-space-lg">
    <div class="absolute -top-40 right-1/4 w-96 h-96 bg-primary/5 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute top-1/2 -left-20 w-80 h-80 bg-primary-container/5 rounded-full blur-3xl pointer-events-none"></div>

    <!-- 1. Header Section -->
    <header class="flex flex-col gap-space-sm relative z-10">
        <!-- Breadcrumb -->
        <nav class="flex items-center gap-2 font-label-sm text-label-sm text-on-surface-variant">
            <a asp-controller="Admin" asp-action="Dashboard" class="hover:text-primary transition-colors">Hệ thống Quản trị Y tế</a>
            <span class="material-symbols-outlined text-[14px]">chevron_right</span>
            <span class="text-on-surface-variant">Hệ thống</span>
            <span class="material-symbols-outlined text-[14px]">chevron_right</span>
            <span class="text-primary font-semibold">Phân quyền nhân sự</span>
        </nav>

        <!-- Main Title & Actions Bar -->
        <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-space-md mt-1">
            <div class="flex flex-col gap-1 max-w-4xl">
                <div class="flex flex-wrap items-center gap-3">
                    <h1 class="font-headline-lg text-headline-lg text-on-surface tracking-tight">
                        Phân Quyền Nhân Sự &amp; Quản Trị Tài Khoản Y Tế
                    </h1>
                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-secondary-container text-on-secondary-container font-label-sm text-label-sm">
                        <span class="w-1.5 h-1.5 rounded-full bg-primary animate-pulse"></span>
                        RBAC Matrix • SmartCA PKI • Bộ Y Tế &amp; C06
                    </span>
                </div>
                <p class="font-body-md text-body-md text-on-surface-variant leading-relaxed">
                    Quản lý <span class="font-semibold text-on-surface">342 tài khoản y tế</span> thuộc 5 nhóm vai trò lâm sàng, phân cấp quyền hạn theo ma trận bảo mật bệnh viện, kiểm soát chứng thư số ký duyệt kết quả xét nghiệm và nhật ký truy cập audit log.
                </p>
            </div>
            <!-- Action Buttons -->
            <div class="flex items-center gap-space-sm shrink-0">
                <button class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-surface-container-lowest shadow-sm hover:shadow-md hover:bg-surface-container-low text-on-surface transition-all duration-180 font-label-md text-label-md" type="button" onclick="document.getElementById('auditTrailSection').scrollIntoView({behavior: 'smooth'})">
                    <span class="material-symbols-outlined text-[18px] text-on-surface-variant">shield_with_heart</span>
                    <span>Nhật Ký Audit Trail</span>
                </button>
                <a asp-controller="Admin" asp-action="RBAC" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-surface-container-lowest shadow-sm hover:shadow-md hover:bg-surface-container-low text-on-surface transition-all duration-180 font-label-md text-label-md">
                    <span class="material-symbols-outlined text-[18px] text-on-surface-variant">tune</span>
                    <span>Cấu Hình Ma Trận (RBAC)</span>
                </a>
                <button class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-primary text-on-primary shadow-md hover:bg-primary-container active:scale-[0.98] transition-all duration-180 font-label-md text-label-md" type="button" onclick="alert('Mở biểu mẫu tạo tài khoản cán bộ y tế mới.')">
                    <span class="material-symbols-outlined text-[20px]">person_add</span>
                    <span>+ Thêm Cán Bộ Y Tế Mới</span>
                </button>
            </div>
        </div>
    </header>

    <!-- 2. KPI Summary Cards (4 Cards) -->
    <section class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-space-md">
        <!-- KPI 1 -->
        <div class="relative overflow-hidden rounded-xl bg-surface-container-lowest p-space-lg shadow-sm hover:shadow-md transition-shadow">
            <div class="flex items-center justify-between mb-3">
                <span class="font-label-md text-label-md text-on-surface-variant">Tổng Cán Bộ Y Tế</span>
                <div class="w-10 h-10 rounded-xl bg-secondary-container flex items-center justify-center text-primary">
                    <span class="material-symbols-outlined text-[22px]">badge</span>
                </div>
            </div>
            <div class="flex items-baseline gap-2 mb-2">
                <span class="font-display-hero text-display-hero text-on-surface leading-none">342</span>
                <span class="font-label-sm text-label-sm font-semibold text-emerald-600 bg-emerald-50 px-2 py-0.5 rounded-full">+18 Quý này</span>
            </div>
            <div class="flex items-center justify-between text-body-sm text-on-surface-variant pt-2 border-t border-surface-container-low">
                <span>Tỷ lệ kích hoạt</span>
                <span class="font-label-sm text-label-sm font-bold text-on-surface">98.2% Active</span>
            </div>
            <div class="w-full bg-surface-container-low h-1.5 rounded-full mt-2 overflow-hidden">
                <div class="bg-primary h-full rounded-full" style="width: 98.2%"></div>
            </div>
        </div>

        <!-- KPI 2 -->
        <div class="relative overflow-hidden rounded-xl bg-surface-container-lowest p-space-lg shadow-sm hover:shadow-md transition-shadow">
            <div class="flex items-center justify-between mb-3">
                <span class="font-label-md text-label-md text-on-surface-variant">Bác Sĩ Khám &amp; Trưởng Kíp</span>
                <div class="w-10 h-10 rounded-xl bg-primary-fixed flex items-center justify-center text-primary">
                    <span class="material-symbols-outlined text-[22px]">stethoscope</span>
                </div>
            </div>
            <div class="flex items-baseline gap-2 mb-2">
                <span class="font-display-hero text-display-hero text-on-surface leading-none">64</span>
                <span class="font-label-sm text-label-sm text-on-surface-variant">Bác sĩ lâm sàng</span>
            </div>
            <div class="flex items-center justify-between text-body-sm text-on-surface-variant pt-2 border-t border-surface-container-low">
                <span>Ký số SmartCA</span>
                <span class="font-label-sm text-label-sm font-bold text-emerald-700">62 / 64 Hoạt động</span>
            </div>
            <div class="w-full bg-surface-container-low h-1.5 rounded-full mt-2 overflow-hidden">
                <div class="bg-emerald-600 h-full rounded-full" style="width: 96.8%"></div>
            </div>
        </div>

        <!-- KPI 3 -->
        <div class="relative overflow-hidden rounded-xl bg-surface-container-lowest p-space-lg shadow-sm hover:shadow-md transition-shadow">
            <div class="flex items-center justify-between mb-3">
                <span class="font-label-md text-label-md text-on-surface-variant">KTV Xét Nghiệm &amp; Kho Máu</span>
                <div class="w-10 h-10 rounded-xl bg-surface-container-high flex items-center justify-center text-on-surface">
                    <span class="material-symbols-outlined text-[22px]">science</span>
                </div>
            </div>
            <div class="flex items-baseline gap-2 mb-2">
                <span class="font-display-hero text-display-hero text-on-surface leading-none">118</span>
                <span class="font-label-sm text-label-sm text-on-surface-variant">Kỹ thuật viên</span>
            </div>
            <div class="flex items-center justify-between text-body-sm text-on-surface-variant pt-2 border-t border-surface-container-low">
                <span>Chuẩn mã hóa ISBT</span>
                <span class="font-label-sm text-label-sm font-bold text-on-surface">100% Khớp LIMS</span>
            </div>
            <div class="w-full bg-surface-container-low h-1.5 rounded-full mt-2 overflow-hidden">
                <div class="bg-primary-container h-full rounded-full" style="width: 100%"></div>
            </div>
        </div>

        <!-- KPI 4 (Alert Highlighted) -->
        <div class="relative overflow-hidden rounded-xl bg-gradient-to-br from-surface-container-lowest to-error-container/20 p-space-lg shadow-sm hover:shadow-md transition-shadow">
            <div class="flex items-center justify-between mb-3">
                <span class="font-label-md text-label-md text-error font-semibold">Cảnh Báo An Toàn &amp; Ký Số</span>
                <div class="w-10 h-10 rounded-xl bg-error/10 flex items-center justify-center text-error animate-bounce">
                    <span class="material-symbols-outlined text-[22px]">warning</span>
                </div>
            </div>
            <div class="flex items-baseline gap-2 mb-2">
                <span class="font-display-hero text-display-hero text-error leading-none">04</span>
                <span class="font-label-sm text-label-sm font-bold text-error bg-error-container px-2 py-0.5 rounded-full">Cần xử lý</span>
            </div>
            <div class="flex items-center justify-between text-body-sm text-on-surface-variant pt-2 border-t border-error-container/40">
                <span>Hết hạn SmartCA</span>
                <span class="font-label-sm text-label-sm font-semibold text-error">03 Token &lt; 15 ngày</span>
            </div>
            <div class="flex items-center justify-between text-body-sm text-on-surface-variant mt-1">
                <span>Zero-Trust Lock</span>
                <span class="font-label-sm text-label-sm font-semibold text-on-surface">01 Tài khoản</span>
            </div>
        </div>
    </section>

    <!-- 3. Block 1: Role Permission Matrix (5 Cards Grid) -->
    <section class="flex flex-col gap-space-sm">
        <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
                <span class="w-2.5 h-6 bg-primary rounded-full inline-block"></span>
                <h2 class="font-headline-sm text-headline-sm text-on-surface">
                    Ma Trận Phân Quyền Vai Trò Y Tế (Role Permission Matrix)
                </h2>
                <span class="font-label-sm text-label-sm px-2.5 py-0.5 rounded-full bg-surface-container-high text-on-surface-variant">5 Nhóm Vai Trò Cấp Lâm Sàng</span>
            </div>
            <a asp-controller="Admin" asp-action="RBAC" class="font-label-md text-label-md text-primary hover:text-primary-container font-semibold inline-flex items-center gap-1 transition-colors">
                <span>Xem cấu hình chi tiết RBAC &amp; ABAC Policy</span>
                <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
            </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5 gap-space-md">
            <!-- Role 1: Trưởng Kíp -->
            <div class="flex flex-col justify-between rounded-xl bg-surface-container-lowest p-space-md shadow-sm hover:shadow-md transition-all duration-200">
                <div>
                    <div class="flex items-center justify-between mb-3">
                        <span class="px-2.5 py-1 rounded-lg bg-primary-fixed text-primary font-label-sm text-label-sm font-bold uppercase tracking-wider">
                            Super Admin / Lead
                        </span>
                        <span class="w-8 h-8 rounded-full bg-primary/10 flex items-center justify-center text-primary">
                            <span class="material-symbols-outlined text-[18px]">verified_user</span>
                        </span>
                    </div>
                    <h3 class="font-title-md text-title-md text-on-surface font-bold leading-snug">
                        Trưởng Kíp / Trưởng Khoa
                    </h3>
                    <p class="font-label-sm text-label-sm text-on-surface-variant mt-1 mb-3">
                        12 Cán bộ phụ trách kíp tiếp nhận
                    </p>
                    <div class="space-y-1.5 pt-2 border-t border-surface-container-low font-body-sm text-body-sm text-on-surface-variant">
                        <div class="flex items-start gap-1.5">
                            <span class="material-symbols-outlined text-primary text-[16px] shrink-0 mt-0.5">check_circle</span>
                            <span>Phê duyệt túi máu khẩn cấp</span>
                        </div>
                        <div class="flex items-start gap-1.5">
                            <span class="material-symbols-outlined text-primary text-[16px] shrink-0 mt-0.5">check_circle</span>
                            <span>Ký số GCN Hiến máu điện tử</span>
                        </div>
                        <div class="flex items-start gap-1.5">
                            <span class="material-symbols-outlined text-primary text-[16px] shrink-0 mt-0.5">check_circle</span>
                            <span>Ghi đè lệnh xuất kho chuỗi lạnh</span>
                        </div>
                        <div class="flex items-start gap-1.5">
                            <span class="material-symbols-outlined text-primary text-[16px] shrink-0 mt-0.5">check_circle</span>
                            <span>Cấu hình ủy quyền nhân sự</span>
                        </div>
                    </div>
                </div>
                <a asp-controller="Admin" asp-action="RBAC" class="mt-4 w-full py-2 px-3 rounded-lg bg-surface-container-low hover:bg-surface-container text-on-surface font-label-sm text-label-sm font-semibold transition-colors flex items-center justify-center gap-1">
                    <span class="material-symbols-outlined text-[16px]">edit</span>
                    <span>Chỉnh sửa quyền vai trò</span>
                </a>
            </div>

            <!-- Role 2: Bác Sĩ Sàng Lọc -->
            <div class="flex flex-col justify-between rounded-xl bg-surface-container-lowest p-space-md shadow-sm hover:shadow-md transition-all duration-200">
                <div>
                    <div class="flex items-center justify-between mb-3">
                        <span class="px-2.5 py-1 rounded-lg bg-surface-container-high text-on-surface font-label-sm text-label-sm font-bold uppercase tracking-wider">
                            Clinical Screening
                        </span>
                        <span class="w-8 h-8 rounded-full bg-surface-container flex items-center justify-center text-on-surface">
                            <span class="material-symbols-outlined text-[18px]">clinical_notes</span>
                        </span>
                    </div>
                    <h3 class="font-title-md text-title-md text-on-surface font-bold leading-snug">
                        Bác Sĩ Sàng Lọc Lâm Sàng
                    </h3>
                    <p class="font-label-sm text-label-sm text-on-surface-variant mt-1 mb-3">
                        52 Bác sĩ khám lâm sàng
                    </p>
                    <div class="space-y-1.5 pt-2 border-t border-surface-container-low font-body-sm text-body-sm text-on-surface-variant">
                        <div class="flex items-start gap-1.5">
                            <span class="material-symbols-outlined text-primary text-[16px] shrink-0 mt-0.5">check_circle</span>
                            <span>Khám thể lực &amp; tiền sử y khoa</span>
                        </div>
                        <div class="flex items-start gap-1.5">
                            <span class="material-symbols-outlined text-primary text-[16px] shrink-0 mt-0.5">check_circle</span>
                            <span>Chỉ định hoãn hiến máu tạm thời</span>
                        </div>
                        <div class="flex items-start gap-1.5">
                            <span class="material-symbols-outlined text-primary text-[16px] shrink-0 mt-0.5">check_circle</span>
                            <span>Duyệt thể tích: 250 / 350 / 450mL</span>
                        </div>
                        <div class="flex items-start gap-1.5 text-on-surface-variant/50">
                            <span class="material-symbols-outlined text-[16px] shrink-0 mt-0.5">block</span>
                            <span>Không quyền xuất kho máu</span>
                        </div>
                    </div>
                </div>
                <a asp-controller="Admin" asp-action="RBAC" class="mt-4 w-full py-2 px-3 rounded-lg bg-surface-container-low hover:bg-surface-container text-on-surface font-label-sm text-label-sm font-semibold transition-colors flex items-center justify-center gap-1">
                    <span class="material-symbols-outlined text-[16px]">edit</span>
                    <span>Chỉnh sửa quyền vai trò</span>
                </a>
            </div>

            <!-- Role 3: KTV Xét Nghiệm -->
            <div class="flex flex-col justify-between rounded-xl bg-surface-container-lowest p-space-md shadow-sm hover:shadow-md transition-all duration-200">
                <div>
                    <div class="flex items-center justify-between mb-3">
                        <span class="px-2.5 py-1 rounded-lg bg-emerald-100 text-emerald-800 font-label-sm text-label-sm font-bold uppercase tracking-wider">
                            Lab Immuno / NAT
                        </span>
                        <span class="w-8 h-8 rounded-full bg-emerald-50 flex items-center justify-center text-emerald-700">
                            <span class="material-symbols-outlined text-[18px]">biotech</span>
                        </span>
                    </div>
                    <h3 class="font-title-md text-title-md text-on-surface font-bold leading-snug">
                        Kỹ Thuật Viên Xét Nghiệm
                    </h3>
                    <p class="font-label-sm text-label-sm text-on-surface-variant mt-1 mb-3">
                        76 Kỹ thuật viên LIMS
                    </p>
                    <div class="space-y-1.5 pt-2 border-t border-surface-container-low font-body-sm text-body-sm text-on-surface-variant">
                        <div class="flex items-start gap-1.5">
                            <span class="material-symbols-outlined text-emerald-700 text-[16px] shrink-0 mt-0.5">check_circle</span>
                            <span>Nhập chỉ số HIV, HBV, HCV, NAT</span>
                        </div>
                        <div class="flex items-start gap-1.5">
                            <span class="material-symbols-outlined text-emerald-700 text-[16px] shrink-0 mt-0.5">check_circle</span>
                            <span>Khẳng định nhóm máu ABO / Rh</span>
                        </div>
                        <div class="flex items-start gap-1.5">
                            <span class="material-symbols-outlined text-emerald-700 text-[16px] shrink-0 mt-0.5">check_circle</span>
                            <span>Ký số chứng nhận kết quả lab</span>
                        </div>
                        <div class="flex items-start gap-1.5 text-on-surface-variant/50">
                            <span class="material-symbols-outlined text-[16px] shrink-0 mt-0.5">block</span>
                            <span>Không đổi thông tin người hiến</span>
                        </div>
                    </div>
                </div>
                <a asp-controller="Admin" asp-action="RBAC" class="mt-4 w-full py-2 px-3 rounded-lg bg-surface-container-low hover:bg-surface-container text-on-surface font-label-sm text-label-sm font-semibold transition-colors flex items-center justify-center gap-1">
                    <span class="material-symbols-outlined text-[16px]">edit</span>
                    <span>Chỉnh sửa quyền vai trò</span>
                </a>
            </div>

            <!-- Role 4: Thủ Kho Lưu Trữ -->
            <div class="flex flex-col justify-between rounded-xl bg-surface-container-lowest p-space-md shadow-sm hover:shadow-md transition-all duration-200">
                <div>
                    <div class="flex items-center justify-between mb-3">
                        <span class="px-2.5 py-1 rounded-lg bg-sky-100 text-sky-800 font-label-sm text-label-sm font-bold uppercase tracking-wider">
                            Cold Chain / ISBT
                        </span>
                        <span class="w-8 h-8 rounded-full bg-sky-50 flex items-center justify-center text-sky-700">
                            <span class="material-symbols-outlined text-[18px]">ac_unit</span>
                        </span>
                    </div>
                    <h3 class="font-title-md text-title-md text-on-surface font-bold leading-snug">
                        Thủ Kho Lưu Trữ &amp; Chuỗi Lạnh
                    </h3>
                    <p class="font-label-sm text-label-sm text-on-surface-variant mt-1 mb-3">
                        42 Cán bộ bảo quản
                    </p>
                    <div class="space-y-1.5 pt-2 border-t border-surface-container-low font-body-sm text-body-sm text-on-surface-variant">
                        <div class="flex items-start gap-1.5">
                            <span class="material-symbols-outlined text-sky-700 text-[16px] shrink-0 mt-0.5">check_circle</span>
                            <span>Nhập kho mã hóa ISBT 128</span>
                        </div>
                        <div class="flex items-start gap-1.5">
                            <span class="material-symbols-outlined text-sky-700 text-[16px] shrink-0 mt-0.5">check_circle</span>
                            <span>Giám sát cảm biến IoT nhiệt độ</span>
                        </div>
                        <div class="flex items-start gap-1.5">
                            <span class="material-symbols-outlined text-sky-700 text-[16px] shrink-0 mt-0.5">check_circle</span>
                            <span>Quét Barcode xuất xe cấp cứu</span>
                        </div>
                        <div class="flex items-start gap-1.5 text-on-surface-variant/50">
                            <span class="material-symbols-outlined text-[16px] shrink-0 mt-0.5">block</span>
                            <span>Không sửa kết quả xét nghiệm</span>
                        </div>
                    </div>
                </div>
                <a asp-controller="Admin" asp-action="RBAC" class="mt-4 w-full py-2 px-3 rounded-lg bg-surface-container-low hover:bg-surface-container text-on-surface font-label-sm text-label-sm font-semibold transition-colors flex items-center justify-center gap-1">
                    <span class="material-symbols-outlined text-[16px]">edit</span>
                    <span>Chỉnh sửa quyền vai trò</span>
                </a>
            </div>

            <!-- Role 5: Điều Phối Viên -->
            <div class="flex flex-col justify-between rounded-xl bg-surface-container-lowest p-space-md shadow-sm hover:shadow-md transition-all duration-200">
                <div>
                    <div class="flex items-center justify-between mb-3">
                        <span class="px-2.5 py-1 rounded-lg bg-secondary-container text-on-secondary-container font-label-sm text-label-sm font-bold uppercase tracking-wider">
                            Field Coordinator
                        </span>
                        <span class="w-8 h-8 rounded-full bg-secondary-container/60 flex items-center justify-center text-on-secondary-container">
                            <span class="material-symbols-outlined text-[18px]">groups</span>
                        </span>
                    </div>
                    <h3 class="font-title-md text-title-md text-on-surface font-bold leading-snug">
                        Điều Phối Viên &amp; Ngoại Viện
                    </h3>
                    <p class="font-label-sm text-label-sm text-on-surface-variant mt-1 mb-3">
                        160 Tình nguyện viên &amp; cán bộ
                    </p>
                    <div class="space-y-1.5 pt-2 border-t border-surface-container-low font-body-sm text-body-sm text-on-surface-variant">
                        <div class="flex items-start gap-1.5">
                            <span class="material-symbols-outlined text-primary text-[16px] shrink-0 mt-0.5">check_circle</span>
                            <span>Check-in VNeID tại xe lưu động</span>
                        </div>
                        <div class="flex items-start gap-1.5">
                            <span class="material-symbols-outlined text-primary text-[16px] shrink-0 mt-0.5">check_circle</span>
                            <span>Hỗ trợ suất ăn &amp; quà tặng hiện vật</span>
                        </div>
                        <div class="flex items-start gap-1.5">
                            <span class="material-symbols-outlined text-primary text-[16px] shrink-0 mt-0.5">check_circle</span>
                            <span>Theo dõi phản ứng sau hiến máu</span>
                        </div>
                        <div class="flex items-start gap-1.5 text-on-surface-variant/50">
                            <span class="material-symbols-outlined text-[16px] shrink-0 mt-0.5">block</span>
                            <span>Không can thiệp hồ sơ bệnh án</span>
                        </div>
                    </div>
                </div>
                <a asp-controller="Admin" asp-action="RBAC" class="mt-4 w-full py-2 px-3 rounded-lg bg-surface-container-low hover:bg-surface-container text-on-surface font-label-sm text-label-sm font-semibold transition-colors flex items-center justify-center gap-1">
                    <span class="material-symbols-outlined text-[16px]">edit</span>
                    <span>Chỉnh sửa quyền vai trò</span>
