                                    </div>
                                </td>
                                <td class="py-3.5 px-space-md">
                                    @if (acc.VaiTro == "Admin")
                                    {
                                        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-purple-100 text-purple-800 font-label-sm text-label-sm font-bold">
                                            <span class="material-symbols-outlined text-[14px]">admin_panel_settings</span>
                                            Admin Quản Trị
                                        </span>
                                    }
                                    else if (acc.VaiTro == "Medical Staff")
                                    {
                                        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-primary-fixed text-primary font-label-sm text-label-sm font-bold">
                                            <span class="material-symbols-outlined text-[14px]">stethoscope</span>
                                            Nhân Viên Y Tế
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-secondary-container text-on-secondary-container font-label-sm text-label-sm font-semibold">
                                            <span class="material-symbols-outlined text-[14px]">person</span>
