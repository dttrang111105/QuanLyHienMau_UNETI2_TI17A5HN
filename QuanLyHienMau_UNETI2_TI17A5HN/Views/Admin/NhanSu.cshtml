<script>
    document.addEventListener('DOMContentLoaded', function () {
        const searchInput = document.getElementById('staffSearchInput');
        const roleSelect = document.getElementById('staffRoleSelect');
        const unitSelect = document.getElementById('staffUnitSelect');
        const tokenSelect = document.getElementById('staffTokenSelect');
        const btnReset = document.getElementById('btnResetFilter');
        const tableBody = document.getElementById('staffTableBody');

        function filterTable() {
            if (!tableBody) return;
            const searchVal = searchInput ? searchInput.value.toLowerCase().trim() : '';
            const roleVal = roleSelect ? roleSelect.value.toLowerCase().trim() : '';
            const unitVal = unitSelect ? unitSelect.value.toLowerCase().trim() : '';
            const tokenVal = tokenSelect ? tokenSelect.value.toLowerCase().trim() : '';

            const rows = tableBody.querySelectorAll('tr');
            rows.forEach(row => {
                const text = row.innerText.toLowerCase();
                const matchSearch = !searchVal || text.includes(searchVal);
                const matchRole = !roleVal || text.includes(roleVal);
                const matchUnit = !unitVal || text.includes(unitVal);
                const matchToken = !tokenVal || text.includes(tokenVal);

                if (matchSearch && matchRole && matchUnit && matchToken) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
        }

        if (searchInput) searchInput.addEventListener('input', filterTable);
        if (roleSelect) roleSelect.addEventListener('change', filterTable);
        if (unitSelect) unitSelect.addEventListener('change', filterTable);
        if (tokenSelect) tokenSelect.addEventListener('change', filterTable);

        if (btnReset) {
            btnReset.addEventListener('click', function () {
                if (searchInput) searchInput.value = '';
                if (roleSelect) roleSelect.value = '';
                if (unitSelect) unitSelect.value = '';
                if (tokenSelect) tokenSelect.value = '';
                filterTable();
            });
        }
    });
</script>
