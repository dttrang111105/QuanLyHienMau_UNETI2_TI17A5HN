                                            <button type="submit" class="inline-flex items-center gap-1 px-3 py-1.5 rounded-xl text-xs font-bold transition-all shadow-xs cursor-pointer @(isLocked ? "bg-emerald-600 hover:bg-emerald-700 text-white" : "bg-red-50 hover:bg-red-100 text-red-700 border border-red-200")" title="@(isLocked ? "Mở khóa tài khoản" : "Khóa tài khoản này")" onclick="return confirm('Bạn có chắc chắn muốn @(isLocked ? "MỞ KHÓA" : "KHÓA") tài khoản \'@acc.TenDangNhap\' (@acc.HoTen) không?');">
                                                <span class="material-symbols-outlined text-[16px]">@(isLocked ? "lock_open" : "lock")</span>
                                                <span>@(isLocked ? "Mở Khóa" : "Khóa TK")</span>
