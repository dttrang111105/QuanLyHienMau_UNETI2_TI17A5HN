@{
    ViewData["Title"] = "Cấu hình phân quyền chi tiết (RBAC / ABAC Policy Editor)";
    Layout = "_AdminLayout";
}

<div class="p-space-lg max-w-[1500px] mx-auto w-full space-y-space-lg">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 font-label-sm text-label-sm text-on-surface-variant">
        <a asp-controller="Admin" asp-action="Dashboard" class="hover:text-primary transition-colors">Hệ thống Quản trị Y tế</a>
        <span class="material-symbols-outlined text-[14px]">chevron_right</span>
        <a asp-controller="Admin" asp-action="NhanSu" class="hover:text-primary transition-colors">Phân quyền nhân sự</a>
        <span class="material-symbols-outlined text-[14px]">chevron_right</span>
        <span class="text-primary font-semibold">Cấu hình ma trận RBAC &amp; ABAC</span>
    </nav>

    <!-- CENTRAL POLICY EDITOR CONTAINER -->
    <div class="relative w-full bg-surface-container-lowest rounded-2xl shadow-xl overflow-hidden flex flex-col border border-surface-container" id="matrixContainer">
        <!-- HEADER -->
        <div class="px-space-lg py-space-md bg-surface-container-low shrink-0 space-y-space-sm border-b border-surface-container">
            <div class="flex items-start justify-between gap-space-md">
                <div class="flex items-start gap-space-md">
                    <div class="w-12 h-12 rounded-xl bg-primary text-on-primary flex items-center justify-center shadow-md shrink-0">
                        <span class="material-symbols-outlined text-[28px]">security</span>
                    </div>
                    <div class="space-y-0.5">
                        <div class="flex items-center gap-space-sm flex-wrap">
                            <h1 class="font-headline-sm text-headline-sm text-on-surface font-bold tracking-tight">
                                Cấu Hình Phân Quyền Chi Tiết &amp; Chính Sách Truy Cập (RBAC / ABAC Matrix)
                            </h1>
                            <span class="px-2.5 py-0.5 rounded-full bg-primary/10 text-primary font-label-sm text-label-sm font-bold">
                                Bản cập nhật v4.2
                            </span>
                        </div>
                        <p class="font-body-sm text-body-sm text-on-surface-variant">
                            Quản lý bộ quyền hạn chức năng theo vai trò chuyên môn y tế, áp dụng kiểm soát truy cập dựa trên thuộc tính (ABAC - Attribute-Based Access Control) và ủy quyền chữ ký số SmartCA.
                        </p>
                    </div>
                </div>
                <!-- Close / Return button -->
                <a asp-controller="Admin" asp-action="NhanSu" class="w-9 h-9 rounded-xl bg-surface-container flex items-center justify-center text-on-surface-variant hover:bg-error-container hover:text-error transition-colors shrink-0" title="Quay lại danh sách cán bộ">
                    <span class="material-symbols-outlined text-[20px]">close</span>
                </a>
            </div>

            <!-- Compliance & Encryption Badges -->
            <div class="flex items-center gap-space-md pt-1 flex-wrap font-label-sm text-label-sm text-on-surface-variant">
                <div class="flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-surface-container-lowest shadow-sm">
                    <span class="material-symbols-outlined text-primary text-[16px]">verified</span>
                    <span>Tiêu chuẩn bảo mật: <strong class="text-on-surface font-semibold">HL7/FHIR &amp; Thông tư 26/BYT</strong></span>
                </div>
                <div class="flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-surface-container-lowest shadow-sm">
                    <span class="material-symbols-outlined text-primary text-[16px]">lock</span>
                    <span>Mã hóa chính sách: <strong class="text-on-surface font-semibold">AES-256 GCM</strong></span>
                </div>
                <div class="flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-surface-container-lowest shadow-sm">
                    <span class="material-symbols-outlined text-emerald-600 text-[16px]">fingerprint</span>
                    <span>Cấp phép: <strong class="text-on-surface font-semibold">FIPS 140-3 Cryptographic Core</strong></span>
                </div>
            </div>
        </div>

        <!-- ROLE SELECTOR TABS & QUICK CONTROLS -->
        <div class="px-space-lg py-space-sm bg-surface-container-lowest shadow-sm flex items-center justify-between gap-space-md shrink-0 flex-wrap border-b border-surface-container">
            <!-- Segmented Role Tabs -->
            <div id="roleTabsGroup" class="flex items-center gap-1.5 p-1 bg-surface-container rounded-xl overflow-x-auto max-w-full">
                <!-- Tab 1 -->
                <button data-role-name="Trưởng Kíp / Trưởng Khoa (Super Medical Admin)" data-role-scope="Phạm vi ủy quyền: Toàn diện hệ thống, phê duyệt cấp cứu Code Red, ký số trả máu và xác nhận hủy mẫu bệnh phẩm." data-role-level="Level 4 - Toàn viện" class="role-tab-btn flex items-center gap-2 px-3 py-1.5 rounded-lg bg-primary text-on-primary font-label-md text-label-md font-semibold shadow-sm shrink-0" type="button">
                    <span>Trưởng Kíp / Trưởng Khoa</span>
                    <span class="px-1.5 py-0.2 rounded-full bg-white/20 text-white font-label-sm text-[10px]">12</span>
                </button>
                <!-- Tab 2 -->
                <button data-role-name="Bác Sĩ Sàng Lọc Lâm Sàng" data-role-scope="Phạm vi ủy quyền: Đánh giá thể lực, tiền sử bệnh án, phân loại nhóm máu hiếm và chỉ định hoãn hiến máu tạm thời." data-role-level="Level 2 - Lâm sàng" class="role-tab-btn flex items-center gap-2 px-3 py-1.5 rounded-lg text-on-surface hover:bg-surface-container-highest transition-colors font-label-md text-label-md shrink-0" type="button">
                    <span>BS. Khám Lâm Sàng</span>
                    <span class="px-1.5 py-0.2 rounded-full bg-surface-container-highest text-on-surface-variant font-label-sm text-[10px]">52</span>
                </button>
                <!-- Tab 3 -->
                <button data-role-name="Kỹ Thuật Viên Xét Nghiệm Lab" data-role-scope="Phạm vi ủy quyền: Thực hiện xét nghiệm miễn dịch ELISA, NAT sàng lọc virus và ký số biên bản kỹ thuật lab." data-role-level="Level 2 - Cận lâm sàng" class="role-tab-btn flex items-center gap-2 px-3 py-1.5 rounded-lg text-on-surface hover:bg-surface-container-highest transition-colors font-label-md text-label-md shrink-0" type="button">
                    <span>KTV Xét Nghiệm Lab</span>
                    <span class="px-1.5 py-0.2 rounded-full bg-surface-container-highest text-on-surface-variant font-label-sm text-[10px]">76</span>
                </button>
                <!-- Tab 4 -->
                <button data-role-name="Thủ Kho Lưu Trữ &amp; Chuỗi Lạnh" data-role-scope="Phạm vi ủy quyền: Giám sát kho lạnh bảo quản ISBT 128, kiểm soát cảm biến IoT và quét Barcode xuất xe cấp cứu." data-role-level="Level 2 - Quản lý kho" class="role-tab-btn flex items-center gap-2 px-3 py-1.5 rounded-lg text-on-surface hover:bg-surface-container-highest transition-colors font-label-md text-label-md shrink-0" type="button">
                    <span>Thủ Kho Chuỗi Lạnh</span>
                    <span class="px-1.5 py-0.2 rounded-full bg-surface-container-highest text-on-surface-variant font-label-sm text-[10px]">42</span>
                </button>
                <!-- Tab 5 -->
                <button data-role-name="Điều Phối Ngoại Viện &amp; Tình Nguyện Viên" data-role-scope="Phạm vi ủy quyền: Quét QR VNeID mức 2 tiếp đón công dân, phát quà bồi dưỡng và hỗ trợ kíp xe lưu động." data-role-level="Level 1 - Hiện trường" class="role-tab-btn flex items-center gap-2 px-3 py-1.5 rounded-lg text-on-surface hover:bg-surface-container-highest transition-colors font-label-md text-label-md shrink-0" type="button">
                    <span>Điều Phối Ngoại Viện</span>
                    <span class="px-1.5 py-0.2 rounded-full bg-surface-container-highest text-on-surface-variant font-label-sm text-[10px]">160</span>
                </button>
            </div>
            <!-- Quick Matrix Controls -->
            <div class="flex items-center gap-space-xs shrink-0">
                <button class="px-3 py-1.5 rounded-xl bg-surface-container text-on-surface hover:bg-surface-container-high transition-colors font-label-sm text-label-sm font-semibold flex items-center gap-1.5" type="button" onclick="alert('Sao chép cấu hình quyền từ vai trò hiện tại...')">
                    <span class="material-symbols-outlined text-[16px]">content_copy</span>
                    <span>Nhân bản quyền (Clone)</span>
                </button>
                <button class="px-3 py-1.5 rounded-xl bg-surface-container text-on-surface hover:bg-surface-container-high transition-colors font-label-sm text-label-sm font-semibold flex items-center gap-1.5" type="button" onclick="alert('Đã khôi phục ma trận về cấu hình chuẩn Thông tư 26/BYT.')">
                    <span class="material-symbols-outlined text-[16px]">restart_alt</span>
                    <span>Khôi phục mặc định BYT</span>
                </button>
            </div>
        </div>

        <!-- SCROLLABLE CONTENT BODY -->
        <div class="p-space-lg space-y-space-lg">
            <!-- Role Overview Banner -->
            <div class="p-space-md rounded-xl bg-secondary-container/40 flex items-center justify-between gap-space-md border border-secondary-container">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-primary-container text-on-primary flex items-center justify-center font-bold shrink-0">
                        <span class="material-symbols-outlined text-[22px]">verified</span>
                    </div>
                    <div>
                        <div id="bannerRoleTitle" class="font-title-md text-title-md font-bold text-on-surface">Vai trò: Trưởng Kíp / Trưởng Khoa (Super Medical Admin)</div>
                        <div id="bannerRoleScope" class="font-body-sm text-body-sm text-on-surface-variant">Phạm vi ủy quyền: Toàn diện hệ thống, phê duyệt cấp cứu Code Red, ký số trả máu và xác nhận hủy mẫu bệnh phẩm.</div>
                    </div>
                </div>
                <div class="text-right shrink-0">
                    <span id="bannerRoleLevel" class="px-3 py-1 rounded-full bg-emerald-100 text-emerald-800 font-label-sm text-label-sm font-bold">
                        Level 4 - Toàn viện
                    </span>
                </div>
            </div>

            <!-- INTERACTIVE PERMISSION MATRIX GRID (CRUD + SmartCA Medical Permissions) -->
            <div class="space-y-space-md">
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <span class="material-symbols-outlined text-primary text-[20px]">grid_view</span>
                        <h2 class="font-headline-sm text-headline-sm text-on-surface font-bold">Ma Trận Quyền Hạn Nghiệp Vụ Y Tế</h2>
                    </div>
                    <div class="flex items-center gap-4 font-label-sm text-label-sm text-on-surface-variant">
                        <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded bg-primary"></span> Có quyền</span>
                        <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded bg-surface-container-high"></span> Không có quyền</span>
                        <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded bg-amber-500"></span> SmartCA 2FA</span>
                    </div>
                </div>

                <!-- MATRIX TABLE -->
                <div class="overflow-x-auto rounded-xl shadow-sm bg-surface-container-lowest border border-surface-container">
                    <table class="w-full text-left border-collapse min-w-[800px]">
                        <thead>
                            <tr class="bg-surface-container font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider">
                                <th class="py-3 px-4 w-2/5">Danh mục chức năng y tế</th>
                                <th class="py-3 px-2 text-center">Xem (Read)</th>
                                <th class="py-3 px-2 text-center">Tạo mới (Create)</th>
                                <th class="py-3 px-2 text-center">Chỉnh sửa (Update)</th>
                                <th class="py-3 px-2 text-center">Duyệt/Ký PKI</th>
                                <th class="py-3 px-2 text-center">Xuất DL (Export)</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-surface-container font-body-sm text-body-sm text-on-surface">
                            <!-- NHÓM 1: Quản Trị Đợt & Tiếp Nhận Hiến Máu -->
                            <tr class="bg-surface-container-low font-title-md text-title-md font-bold text-primary">
                                <td class="py-2.5 px-4 flex items-center gap-2" colspan="6">
                                    <span class="material-symbols-outlined text-[18px]">volunteer_activism</span>
                                    <span>Nhóm 1: Quản Trị Đợt &amp; Tiếp Nhận Hiến Máu (Donor &amp; Campaigns Management)</span>
                                </td>
                            </tr>
                            <tr class="hover:bg-surface-container-low/60 transition-colors">
                                <td class="py-3 px-4">
                                    <div class="font-semibold text-on-surface">Hồ sơ công dân &amp; Tra cứu VNeID Mức 2</div>
                                    <div class="font-body-sm text-xs text-on-surface-variant">Tra cứu lịch sử 84 ngày, căn cước công dân gắn chip</div>
                                </td>
                                <td class="text-center py-3 px-2"><input checked class="w-4 h-4 rounded text-primary accent-primary cursor-pointer" type="checkbox"></td>
                                <td class="text-center py-3 px-2"><input checked class="w-4 h-4 rounded text-primary accent-primary cursor-pointer" type="checkbox"></td>
                                <td class="text-center py-3 px-2"><input checked class="w-4 h-4 rounded text-primary accent-primary cursor-pointer" type="checkbox"></td>
                                <td class="text-center py-3 px-2"><span class="inline-flex items-center px-1.5 py-0.5 rounded bg-amber-100 text-amber-900 font-label-sm text-[10px] font-bold">2FA SmartCA</span></td>
                                <td class="text-center py-3 px-2"><input checked class="w-4 h-4 rounded text-primary accent-primary cursor-pointer" type="checkbox"></td>
                            </tr>
                            <tr class="hover:bg-surface-container-low/60 transition-colors">
                                <td class="py-3 px-4">
                                    <div class="font-semibold text-on-surface">Tiếp nhận &amp; Đăng ký hiến máu tại bàn ngoại viện</div>
                                    <div class="font-body-sm text-xs text-on-surface-variant">Cấp số thứ tự, in vòng đeo tay mã vạch định danh</div>
                                </td>
                                <td class="text-center py-3 px-2"><input checked class="w-4 h-4 accent-primary cursor-pointer" type="checkbox"></td>
                                <td class="text-center py-3 px-2"><input checked class="w-4 h-4 accent-primary cursor-pointer" type="checkbox"></td>
                                <td class="text-center py-3 px-2"><input checked class="w-4 h-4 accent-primary cursor-pointer" type="checkbox"></td>
                                <td class="text-center py-3 px-2"><span class="text-on-surface-variant text-xs">-</span></td>
                                <td class="text-center py-3 px-2"><input checked class="w-4 h-4 accent-primary cursor-pointer" type="checkbox"></td>
                            </tr>
                            <tr class="hover:bg-surface-container-low/60 transition-colors">
                                <td class="py-3 px-4">
                                    <div class="font-semibold text-on-surface">Đánh giá thể lực &amp; Khám sàng lọc lâm sàng</div>
                                    <div class="font-body-sm text-xs text-on-surface-variant">Huyết áp, nhịp tim, test huyết sắc tố, phân loại đủ ĐK hoặc hoãn hiến</div>
                                </td>
                                <td class="text-center py-3 px-2"><input checked class="w-4 h-4 accent-primary cursor-pointer" type="checkbox"></td>
                                <td class="text-center py-3 px-2"><input checked class="w-4 h-4 accent-primary cursor-pointer" type="checkbox"></td>
                                <td class="text-center py-3 px-2"><input checked class="w-4 h-4 accent-primary cursor-pointer" type="checkbox"></td>
                                <td class="text-center py-3 px-2"><span class="inline-flex items-center px-1.5 py-0.5 rounded bg-primary text-on-primary font-label-sm text-[10px] font-bold">Ký Bác Sĩ</span></td>
                                <td class="text-center py-3 px-2"><input checked class="w-4 h-4 accent-primary cursor-pointer" type="checkbox"></td>
                            </tr>
                            <tr class="hover:bg-surface-container-low/60 transition-colors">
                                <td class="py-3 px-4">
                                    <div class="font-semibold text-on-surface">Phê duyệt thể tích lấy máu (250 / 350 / 450 mL)</div>
                                    <div class="font-body-sm text-xs text-on-surface-variant">Chỉ định túi lấy máu, gạn tách tiểu cầu tự động apheresis</div>
                                </td>
                                <td class="text-center py-3 px-2"><input checked class="w-4 h-4 accent-primary cursor-pointer" type="checkbox"></td>
                                <td class="text-center py-3 px-2"><input checked class="w-4 h-4 accent-primary cursor-pointer" type="checkbox"></td>
                                <td class="text-center py-3 px-2"><input checked class="w-4 h-4 accent-primary cursor-pointer" type="checkbox"></td>
                                <td class="text-center py-3 px-2"><span class="inline-flex items-center px-1.5 py-0.5 rounded bg-primary text-on-primary font-label-sm text-[10px] font-bold">Ký SmartCA</span></td>
                                <td class="text-center py-3 px-2"><input checked class="w-4 h-4 accent-primary cursor-pointer" type="checkbox"></td>
                            </tr>

                            <!-- NHÓM 2: Xét Nghiệm Lâm Sàng & Phân Loại Máu -->
                            <tr class="bg-surface-container-low font-title-md text-title-md font-bold text-primary">
                                <td class="py-2.5 px-4 flex items-center gap-2" colspan="6">
                                    <span class="material-symbols-outlined text-[18px]">biotech</span>
                                    <span>Nhóm 2: Xét Nghiệm Lâm Sàng &amp; Phân Loại Máu (Lab Immuno &amp; NAT Screening)</span>
                                </td>
                            </tr>
                            <tr class="hover:bg-surface-container-low/60 transition-colors">
                                <td class="py-3 px-4">
                                    <div class="font-semibold text-on-surface">Nhập chỉ số test nhanh &amp; Sàng lọc HBV, HCV, HIV, Giang mai</div>
                                    <div class="font-body-sm text-xs text-on-surface-variant">Kỹ thuật ELISA thế hệ 4 &amp; Khuếch đại gen NAT tự động</div>
                                </td>
                                <td class="text-center py-3 px-2"><input checked class="w-4 h-4 accent-primary cursor-pointer" type="checkbox"></td>
                                <td class="text-center py-3 px-2"><input checked class="w-4 h-4 accent-primary cursor-pointer" type="checkbox"></td>
                                <td class="text-center py-3 px-2"><input checked class="w-4 h-4 accent-primary cursor-pointer" type="checkbox"></td>
                                <td class="text-center py-3 px-2"><span class="inline-flex items-center px-1.5 py-0.5 rounded bg-amber-100 text-amber-900 font-label-sm text-[10px] font-bold">Ký Lab Head</span></td>
                                <td class="text-center py-3 px-2"><input checked class="w-4 h-4 accent-primary cursor-pointer" type="checkbox"></td>
                            </tr>
                            <tr class="hover:bg-surface-container-low/60 transition-colors">
                                <td class="py-3 px-4">
                                    <div class="font-semibold text-on-surface">Xác nhận nhóm máu ABO và hệ thống Rh / Kell</div>
                                    <div class="font-body-sm text-xs text-on-surface-variant">Phân nhóm hồng cầu bằng kỹ thuật gelcard bán tự động</div>
                                </td>
                                <td class="text-center py-3 px-2"><input checked class="w-4 h-4 accent-primary cursor-pointer" type="checkbox"></td>
                                <td class="text-center py-3 px-2"><input checked class="w-4 h-4 accent-primary cursor-pointer" type="checkbox"></td>
                                <td class="text-center py-3 px-2"><input checked class="w-4 h-4 accent-primary cursor-pointer" type="checkbox"></td>
                                <td class="text-center py-3 px-2"><span class="inline-flex items-center px-1.5 py-0.5 rounded bg-primary text-on-primary font-label-sm text-[10px] font-bold">SmartCA FIPS</span></td>
                                <td class="text-center py-3 px-2"><input checked class="w-4 h-4 accent-primary cursor-pointer" type="checkbox"></td>
                            </tr>
                            <tr class="hover:bg-surface-container-low/60 transition-colors">
                                <td class="py-3 px-4">
                                    <div class="font-semibold text-on-surface">Phê duyệt hủy túi máu nhiễm tác nhân sinh học</div>
                                    <div class="font-body-sm text-xs text-on-surface-variant">Lập biên bản tiêu hủy chất thải lây nhiễm, khóa mã ISBT 128 vĩnh viễn</div>
                                </td>
                                <td class="text-center py-3 px-2"><input checked class="w-4 h-4 accent-primary cursor-pointer" type="checkbox"></td>
                                <td class="text-center py-3 px-2"><input checked class="w-4 h-4 accent-primary cursor-pointer" type="checkbox"></td>
                                <td class="text-center py-3 px-2"><input checked class="w-4 h-4 accent-primary cursor-pointer" type="checkbox"></td>
                                <td class="text-center py-3 px-2"><span class="inline-flex items-center px-2 py-0.5 rounded bg-error text-on-error font-label-sm text-[10px] font-bold">2FA Tối Cao</span></td>
                                <td class="text-center py-3 px-2"><input checked class="w-4 h-4 accent-primary cursor-pointer" type="checkbox"></td>
                            </tr>

                            <!-- NHÓM 3: Kho Lưu Trữ Chuỗi Lạnh & Điều Phối Túi Máu -->
                            <tr class="bg-surface-container-low font-title-md text-title-md font-bold text-primary">
                                <td class="py-2.5 px-4 flex items-center gap-2" colspan="6">
                                    <span class="material-symbols-outlined text-[18px]">ac_unit</span>
                                    <span>Nhóm 3: Kho Lưu Trữ Chuỗi Lạnh &amp; Điều Phối Túi Máu (Cold Chain &amp; Emergency Dispatch)</span>
                                </td>
                            </tr>
                            <tr class="hover:bg-surface-container-low/60 transition-colors">
                                <td class="py-3 px-4">
                                    <div class="font-semibold text-on-surface">Quét mã vạch ISBT 128 &amp; Giám sát nhiệt độ IoT (-80°C / 4°C)</div>
                                    <div class="font-body-sm text-xs text-on-surface-variant">Phân vùng khay bảo quản hồng cầu khối, huyết tương đông lạnh</div>
                                </td>
                                <td class="text-center py-3 px-2"><input checked class="w-4 h-4 accent-primary cursor-pointer" type="checkbox"></td>
                                <td class="text-center py-3 px-2"><input checked class="w-4 h-4 accent-primary cursor-pointer" type="checkbox"></td>
                                <td class="text-center py-3 px-2"><input checked class="w-4 h-4 accent-primary cursor-pointer" type="checkbox"></td>
                                <td class="text-center py-3 px-2"><span class="text-on-surface-variant text-xs">-</span></td>
                                <td class="text-center py-3 px-2"><input checked class="w-4 h-4 accent-primary cursor-pointer" type="checkbox"></td>
