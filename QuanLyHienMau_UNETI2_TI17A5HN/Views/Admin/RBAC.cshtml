@{
    ViewData["Title"] = "Cấu hình phân quyền hệ thống";
    Layout = "_AdminLayout";
}

<div class="p-space-lg max-w-[1500px] mx-auto w-full space-y-space-lg">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 font-label-sm text-label-sm text-on-surface-variant">
        <a asp-controller="Admin" asp-action="Dashboard" class="hover:text-primary transition-colors">Hệ thống Quản trị Y tế</a>
        <span class="material-symbols-outlined text-[14px]">chevron_right</span>
        <a asp-controller="Admin" asp-action="NhanSu" class="hover:text-primary transition-colors">Quản lý tài khoản &amp; Phân quyền</a>
        <span class="material-symbols-outlined text-[14px]">chevron_right</span>
        <span class="text-primary font-semibold">Cấu hình phân quyền chi tiết</span>
    </nav>

    <!-- CENTRAL POLICY EDITOR CONTAINER -->
    <div class="relative w-full bg-surface-container-lowest rounded-2xl shadow-xl overflow-hidden flex flex-col border border-surface-container" id="matrixContainer">
        <!-- HEADER -->
        <div class="px-space-lg py-space-md bg-surface-container-low shrink-0 space-y-space-sm border-b border-surface-container">
            <div class="flex items-start justify-between gap-space-md">
                <div class="flex items-start gap-space-md">
                    <div class="w-12 h-12 rounded-xl bg-primary text-on-primary flex items-center justify-center shadow-md shrink-0">
                        <span class="material-symbols-outlined text-[28px]">security</span>
                    </div>
                    <div class="space-y-0.5">
                        <div class="flex items-center gap-space-sm flex-wrap">
                            <h1 class="font-headline-sm text-headline-sm text-on-surface font-bold tracking-tight">
                                Cấu Hình Phân Quyền Vai Trò &amp; Chức Năng Hệ Thống
                            </h1>
                            <span class="px-2.5 py-0.5 rounded-full bg-primary/10 text-primary font-label-sm text-label-sm font-bold">
                                Quy định phân quyền
                            </span>
                        </div>
                        <p class="font-body-sm text-body-sm text-on-surface-variant">
                            Thiết lập và quản lý quyền hạn thực hiện các chức năng nghiệp vụ theo từng nhóm vai trò người dùng trong hệ thống quản lý hiến máu tình nguyện.
                        </p>
                    </div>
                </div>
                <!-- Close / Return button -->
                <a asp-controller="Admin" asp-action="NhanSu" class="w-9 h-9 rounded-xl bg-surface-container flex items-center justify-center text-on-surface-variant hover:bg-error-container hover:text-error transition-colors shrink-0" title="Quay lại danh sách tài khoản">
                    <span class="material-symbols-outlined text-[20px]">close</span>
                </a>
            </div>

            <!-- Compliance Badges -->
            <div class="flex items-center gap-space-md pt-1 flex-wrap font-label-sm text-label-sm text-on-surface-variant">
                <div class="flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-surface-container-lowest shadow-sm">
                    <span class="material-symbols-outlined text-primary text-[16px]">verified</span>
                    <span>Tuân thủ quy định: <strong class="text-on-surface font-semibold">Thông tư 26/2013/TT-BYT của Bộ Y Tế</strong></span>
                </div>
                <div class="flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-surface-container-lowest shadow-sm">
                    <span class="material-symbols-outlined text-primary text-[16px]">lock</span>
                    <span>Bảo mật thông tin: <strong class="text-on-surface font-semibold">An toàn hồ sơ người hiến máu</strong></span>
                </div>
                <div class="flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-surface-container-lowest shadow-sm">
                    <span class="material-symbols-outlined text-emerald-600 text-[16px]">badge</span>
                    <span>Phân công nhiệm vụ: <strong class="text-on-surface font-semibold">Đúng chức trách chuyên môn</strong></span>
                </div>
            </div>
        </div>

        <!-- ROLE SELECTOR TABS & QUICK CONTROLS -->
        <div class="px-space-lg py-space-sm bg-surface-container-lowest shadow-sm flex items-center justify-between gap-space-md shrink-0 flex-wrap border-b border-surface-container">
            <!-- Segmented Role Tabs -->
            <div id="roleTabsGroup" class="flex items-center gap-1.5 p-1 bg-surface-container rounded-xl overflow-x-auto max-w-full">
                <!-- Tab 1 -->
                <button data-role-name="Quản Trị Viên Hệ Thống" data-role-scope="Phạm vi phụ trách: Điều hành toàn diện hệ thống, quản lý tài khoản người dùng, đơn vị tổ chức, đợt hiến máu và báo cáo tổng hợp." data-role-level="Cấp Quản Trị Hệ Thống" class="role-tab-btn flex items-center gap-2 px-3 py-1.5 rounded-lg bg-primary text-on-primary font-label-md text-label-md font-semibold shadow-sm shrink-0 cursor-pointer" type="button">
                    <span>Quản Trị Viên</span>
                </button>
                <!-- Tab 2 -->
                <button data-role-name="Bác Sĩ Khám Sàng Lọc" data-role-scope="Phạm vi phụ trách: Đánh giá thể lực, kiểm tra tiền sử sức khỏe, duyệt phiếu đăng ký và kết luận điều kiện tham gia hiến máu." data-role-level="Cấp Chuyên Môn Lâm Sàng" class="role-tab-btn flex items-center gap-2 px-3 py-1.5 rounded-lg text-on-surface hover:bg-surface-container-highest transition-colors font-label-md text-label-md shrink-0 cursor-pointer" type="button">
                    <span>BS. Khám Sàng Lọc</span>
                </button>
                <!-- Tab 3 -->
                <button data-role-name="Kỹ Thuật Viên Xét Nghiệm" data-role-scope="Phạm vi phụ trách: Thực hiện xét nghiệm sàng lọc máu, xác định nhóm máu và cập nhật kết quả hiến máu vào hệ thống." data-role-level="Cấp Chuyên Môn Xét Nghiệm" class="role-tab-btn flex items-center gap-2 px-3 py-1.5 rounded-lg text-on-surface hover:bg-surface-container-highest transition-colors font-label-md text-label-md shrink-0 cursor-pointer" type="button">
                    <span>KTV Xét Nghiệm</span>
                </button>
                <!-- Tab 4 -->
                <button data-role-name="Cán Bộ Quản Lý Kho Máu" data-role-scope="Phạm vi phụ trách: Tiếp nhận các đơn vị máu đạt chuẩn, theo dõi điều kiện bảo quản và điều phối cung cấp máu cho các bệnh viện." data-role-level="Cấp Quản Lý Lưu Trữ" class="role-tab-btn flex items-center gap-2 px-3 py-1.5 rounded-lg text-on-surface hover:bg-surface-container-highest transition-colors font-label-md text-label-md shrink-0 cursor-pointer" type="button">
                    <span>Cán Bộ Kho Máu</span>
                </button>
                <!-- Tab 5 -->
                <button data-role-name="Người Hiến Máu Tình Nguyện" data-role-scope="Phạm vi phụ trách: Đăng ký tham gia các đợt hiến máu, theo dõi lịch khám sàng lọc và tra cứu lịch sử, kết quả hiến máu cá nhân." data-role-level="Thành Viên Cộng Đồng" class="role-tab-btn flex items-center gap-2 px-3 py-1.5 rounded-lg text-on-surface hover:bg-surface-container-highest transition-colors font-label-md text-label-md shrink-0 cursor-pointer" type="button">
                    <span>Người Hiến Máu</span>
                </button>
            </div>
            <!-- Quick Matrix Controls -->
            <div class="flex items-center gap-space-xs shrink-0">
                <button class="px-3 py-1.5 rounded-xl bg-surface-container text-on-surface hover:bg-surface-container-high transition-colors font-label-sm text-label-sm font-semibold flex items-center gap-1.5 cursor-pointer" type="button" onclick="alert('Đã sao chép cấu hình quyền của vai trò hiện tại.')">
                    <span class="material-symbols-outlined text-[16px]">content_copy</span>
                    <span>Sao chép cấu hình quyền</span>
                </button>
                <button class="px-3 py-1.5 rounded-xl bg-surface-container text-on-surface hover:bg-surface-container-high transition-colors font-label-sm text-label-sm font-semibold flex items-center gap-1.5 cursor-pointer" type="button" onclick="alert('Đã khôi phục cấu hình phân quyền mặc định theo quy định của Bộ Y Tế.')">
                    <span class="material-symbols-outlined text-[16px]">restart_alt</span>
                    <span>Khôi phục mặc định</span>
                </button>
            </div>
        </div>

        <!-- SCROLLABLE CONTENT BODY -->
        <div class="p-space-lg space-y-space-lg">
            <!-- Role Overview Banner -->
            <div class="p-space-md rounded-xl bg-secondary-container/40 flex items-center justify-between gap-space-md border border-secondary-container">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-primary-container text-on-primary flex items-center justify-center font-bold shrink-0">
                        <span class="material-symbols-outlined text-[22px]">verified</span>
                    </div>
                    <div>
                        <div id="bannerRoleTitle" class="font-title-md text-title-md font-bold text-on-surface">Vai trò: Quản Trị Viên Hệ Thống</div>
                        <div id="bannerRoleScope" class="font-body-sm text-body-sm text-on-surface-variant">Phạm vi phụ trách: Điều hành toàn diện hệ thống, quản lý tài khoản người dùng, đơn vị tổ chức, đợt hiến máu và báo cáo tổng hợp.</div>
                    </div>
                </div>
                <div class="text-right shrink-0">
                    <span id="bannerRoleLevel" class="px-3 py-1 rounded-full bg-emerald-100 text-emerald-800 font-label-sm text-label-sm font-bold">
                        Cấp Quản Trị Hệ Thống
                    </span>
                </div>
            </div>

            <!-- PERMISSION MATRIX GRID -->
            <div class="space-y-space-md">
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <span class="material-symbols-outlined text-primary text-[20px]">grid_view</span>
                        <h2 class="font-headline-sm text-headline-sm text-on-surface font-bold">Bảng Phân Quyền Chức Năng Nghiệp Vụ</h2>
                    </div>
                    <div class="flex items-center gap-4 font-label-sm text-label-sm text-on-surface-variant">
                        <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded bg-primary"></span> Được phép thực hiện</span>
                        <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded bg-surface-container-high"></span> Không có quyền</span>
                        <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded bg-amber-500"></span> Cần phê duyệt</span>
                    </div>
                </div>

                <!-- MATRIX TABLE -->
                <div class="overflow-x-auto rounded-xl shadow-sm bg-surface-container-lowest border border-surface-container">
                    <table class="w-full text-left border-collapse min-w-[800px]">
                        <thead>
                            <tr class="bg-surface-container font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider">
                                <th class="py-3 px-4 w-2/5">Danh mục chức năng nghiệp vụ</th>
                                <th class="py-3 px-2 text-center">Xem thông tin</th>
                                <th class="py-3 px-2 text-center">Thêm mới</th>
                                <th class="py-3 px-2 text-center">Cập nhật</th>
                                <th class="py-3 px-2 text-center">Thẩm định / Duyệt</th>
                                <th class="py-3 px-2 text-center">Xuất báo cáo</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-surface-container font-body-sm text-body-sm text-on-surface">
                            <!-- NHÓM 1: Quản Trị Đợt & Tiếp Nhận Hiến Máu -->
                            <tr class="bg-surface-container-low font-title-md text-title-md font-bold text-primary">
                                <td class="py-2.5 px-4 flex items-center gap-2" colspan="6">
                                    <span class="material-symbols-outlined text-[18px]">volunteer_activism</span>
                                    <span>Nhóm 1: Quản Lý Đợt Hiến Máu &amp; Tiếp Nhận Đăng Ký</span>
                                </td>
                            </tr>
                            <tr class="hover:bg-surface-container-low/60 transition-colors">
                                <td class="py-3 px-4">
                                    <div class="font-semibold text-on-surface">Tra cứu thông tin hồ sơ người hiến máu</div>
                                    <div class="font-body-sm text-xs text-on-surface-variant">Kiểm tra lịch sử các lần hiến máu và thời gian giãn cách tối thiểu</div>
                                </td>
                                <td class="text-center py-3 px-2"><input checked class="w-4 h-4 rounded text-primary accent-primary cursor-pointer" type="checkbox"></td>
                                <td class="text-center py-3 px-2"><input checked class="w-4 h-4 rounded text-primary accent-primary cursor-pointer" type="checkbox"></td>
                                <td class="text-center py-3 px-2"><input checked class="w-4 h-4 rounded text-primary accent-primary cursor-pointer" type="checkbox"></td>
                                <td class="text-center py-3 px-2"><span class="inline-flex items-center px-1.5 py-0.5 rounded bg-amber-100 text-amber-900 font-label-sm text-[10px] font-bold">Xác minh hồ sơ</span></td>
                                <td class="text-center py-3 px-2"><input checked class="w-4 h-4 rounded text-primary accent-primary cursor-pointer" type="checkbox"></td>
                            </tr>
                            <tr class="hover:bg-surface-container-low/60 transition-colors">
                                <td class="py-3 px-4">
                                    <div class="font-semibold text-on-surface">Tiếp nhận phiếu đăng ký hiến máu &amp; Xếp lịch khám</div>
                                    <div class="font-body-sm text-xs text-on-surface-variant">Duyệt phiếu đăng ký, từ chối phiếu không hợp lệ và sắp xếp lịch khám sàng lọc</div>
                                </td>
                                <td class="text-center py-3 px-2"><input checked class="w-4 h-4 accent-primary cursor-pointer" type="checkbox"></td>
                                <td class="text-center py-3 px-2"><input checked class="w-4 h-4 accent-primary cursor-pointer" type="checkbox"></td>
                                <td class="text-center py-3 px-2"><input checked class="w-4 h-4 accent-primary cursor-pointer" type="checkbox"></td>
                                <td class="text-center py-3 px-2"><span class="inline-flex items-center px-1.5 py-0.5 rounded bg-primary text-on-primary font-label-sm text-[10px] font-bold">Duyệt phiếu</span></td>
                                <td class="text-center py-3 px-2"><input checked class="w-4 h-4 accent-primary cursor-pointer" type="checkbox"></td>
                            </tr>
                            <tr class="hover:bg-surface-container-low/60 transition-colors">
                                <td class="py-3 px-4">
                                    <div class="font-semibold text-on-surface">Đánh giá thể lực &amp; Khám sàng lọc trước hiến máu</div>
                                    <div class="font-body-sm text-xs text-on-surface-variant">Kiểm tra huyết áp, cân nặng, nồng độ huyết sắc tố và kết luận đủ điều kiện hiến</div>
                                </td>
                                <td class="text-center py-3 px-2"><input checked class="w-4 h-4 accent-primary cursor-pointer" type="checkbox"></td>
                                <td class="text-center py-3 px-2"><input checked class="w-4 h-4 accent-primary cursor-pointer" type="checkbox"></td>
                                <td class="text-center py-3 px-2"><input checked class="w-4 h-4 accent-primary cursor-pointer" type="checkbox"></td>
                                <td class="text-center py-3 px-2"><span class="inline-flex items-center px-1.5 py-0.5 rounded bg-primary text-on-primary font-label-sm text-[10px] font-bold">Bác sĩ kết luận</span></td>
                                <td class="text-center py-3 px-2"><input checked class="w-4 h-4 accent-primary cursor-pointer" type="checkbox"></td>
                            </tr>
                            <tr class="hover:bg-surface-container-low/60 transition-colors">
                                <td class="py-3 px-4">
                                    <div class="font-semibold text-on-surface">Chỉ định thể tích máu tiếp nhận (250 / 350 / 450 ml)</div>
                                    <div class="font-body-sm text-xs text-on-surface-variant">Xác định lượng máu hiến phù hợp với thể trạng của người hiến máu</div>
                                </td>
                                <td class="text-center py-3 px-2"><input checked class="w-4 h-4 accent-primary cursor-pointer" type="checkbox"></td>
                                <td class="text-center py-3 px-2"><input checked class="w-4 h-4 accent-primary cursor-pointer" type="checkbox"></td>
                                <td class="text-center py-3 px-2"><input checked class="w-4 h-4 accent-primary cursor-pointer" type="checkbox"></td>
                                <td class="text-center py-3 px-2"><span class="inline-flex items-center px-1.5 py-0.5 rounded bg-primary text-on-primary font-label-sm text-[10px] font-bold">Bác sĩ chỉ định</span></td>
                                <td class="text-center py-3 px-2"><input checked class="w-4 h-4 accent-primary cursor-pointer" type="checkbox"></td>
                            </tr>

                            <!-- NHÓM 2: Xét Nghiệm Lâm Sàng & Phân Loại Máu -->
                            <tr class="bg-surface-container-low font-title-md text-title-md font-bold text-primary">
                                <td class="py-2.5 px-4 flex items-center gap-2" colspan="6">
                                    <span class="material-symbols-outlined text-[18px]">biotech</span>
                                    <span>Nhóm 2: Xét Nghiệm Sàng Lọc &amp; Ghi Nhận Kết Quả Hiến Máu</span>
                                </td>
                            </tr>
                            <tr class="hover:bg-surface-container-low/60 transition-colors">
                                <td class="py-3 px-4">
                                    <div class="font-semibold text-on-surface">Ghi nhận kết quả hiến máu &amp; Sàng lọc bệnh truyền nhiễm</div>
                                    <div class="font-body-sm text-xs text-on-surface-variant">Kiểm tra an toàn truyền máu đối với viêm gan B, viêm gan C, HIV, giang mai</div>
                                </td>
                                <td class="text-center py-3 px-2"><input checked class="w-4 h-4 accent-primary cursor-pointer" type="checkbox"></td>
                                <td class="text-center py-3 px-2"><input checked class="w-4 h-4 accent-primary cursor-pointer" type="checkbox"></td>
                                <td class="text-center py-3 px-2"><input checked class="w-4 h-4 accent-primary cursor-pointer" type="checkbox"></td>
                                <td class="text-center py-3 px-2"><span class="inline-flex items-center px-1.5 py-0.5 rounded bg-amber-100 text-amber-900 font-label-sm text-[10px] font-bold">Trưởng khoa duyệt</span></td>
                                <td class="text-center py-3 px-2"><input checked class="w-4 h-4 accent-primary cursor-pointer" type="checkbox"></td>
                            </tr>
                            <tr class="hover:bg-surface-container-low/60 transition-colors">
                                <td class="py-3 px-4">
                                    <div class="font-semibold text-on-surface">Xác nhận nhóm máu hệ ABO và hệ Rh</div>
                                    <div class="font-body-sm text-xs text-on-surface-variant">Định danh nhóm máu chính xác và cập nhật vào hồ sơ người hiến máu</div>
                                </td>
                                <td class="text-center py-3 px-2"><input checked class="w-4 h-4 accent-primary cursor-pointer" type="checkbox"></td>
                                <td class="text-center py-3 px-2"><input checked class="w-4 h-4 accent-primary cursor-pointer" type="checkbox"></td>
                                <td class="text-center py-3 px-2"><input checked class="w-4 h-4 accent-primary cursor-pointer" type="checkbox"></td>
                                <td class="text-center py-3 px-2"><span class="inline-flex items-center px-1.5 py-0.5 rounded bg-primary text-on-primary font-label-sm text-[10px] font-bold">Xác nhận KQ</span></td>
                                <td class="text-center py-3 px-2"><input checked class="w-4 h-4 accent-primary cursor-pointer" type="checkbox"></td>
                            </tr>
                            <tr class="hover:bg-surface-container-low/60 transition-colors">
                                <td class="py-3 px-4">
                                    <div class="font-semibold text-on-surface">Lập biên bản hủy đơn vị máu không đạt tiêu chuẩn</div>
                                    <div class="font-body-sm text-xs text-on-surface-variant">Xử lý các đơn vị máu không đủ điều kiện an toàn theo quy trình y tế</div>
                                </td>
                                <td class="text-center py-3 px-2"><input checked class="w-4 h-4 accent-primary cursor-pointer" type="checkbox"></td>
                                <td class="text-center py-3 px-2"><input checked class="w-4 h-4 accent-primary cursor-pointer" type="checkbox"></td>
                                <td class="text-center py-3 px-2"><input checked class="w-4 h-4 accent-primary cursor-pointer" type="checkbox"></td>
                                <td class="text-center py-3 px-2"><span class="inline-flex items-center px-2 py-0.5 rounded bg-error text-on-error font-label-sm text-[10px] font-bold">Hội đồng duyệt</span></td>
                                <td class="text-center py-3 px-2"><input checked class="w-4 h-4 accent-primary cursor-pointer" type="checkbox"></td>
                            </tr>

                            <!-- NHÓM 3: Kho Lưu Trữ & Điều Phối Túi Máu -->
                            <tr class="bg-surface-container-low font-title-md text-title-md font-bold text-primary">
                                <td class="py-2.5 px-4 flex items-center gap-2" colspan="6">
                                    <span class="material-symbols-outlined text-[18px]">ac_unit</span>
                                    <span>Nhóm 3: Quản Lý Lưu Trữ &amp; Điều Phối Cung Cấp Máu</span>
                                </td>
                            </tr>
                            <tr class="hover:bg-surface-container-low/60 transition-colors">
                                <td class="py-3 px-4">
                                    <div class="font-semibold text-on-surface">Tiếp nhận lưu kho &amp; Theo dõi nhiệt độ bảo quản máu</div>
                                    <div class="font-body-sm text-xs text-on-surface-variant">Phân loại bảo quản khối hồng cầu, huyết tương và tiểu cầu theo tiêu chuẩn</div>
                                </td>
                                <td class="text-center py-3 px-2"><input checked class="w-4 h-4 accent-primary cursor-pointer" type="checkbox"></td>
                                <td class="text-center py-3 px-2"><input checked class="w-4 h-4 accent-primary cursor-pointer" type="checkbox"></td>
                                <td class="text-center py-3 px-2"><input checked class="w-4 h-4 accent-primary cursor-pointer" type="checkbox"></td>
                                <td class="text-center py-3 px-2"><span class="text-on-surface-variant text-xs">-</span></td>
