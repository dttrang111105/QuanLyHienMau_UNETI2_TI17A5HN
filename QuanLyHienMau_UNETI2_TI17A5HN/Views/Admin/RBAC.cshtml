<script>
    document.addEventListener('DOMContentLoaded', function () {
        const tabButtons = document.querySelectorAll('.role-tab-btn');
        const bannerTitle = document.getElementById('bannerRoleTitle');
        const bannerScope = document.getElementById('bannerRoleScope');
        const bannerLevel = document.getElementById('bannerRoleLevel');

        tabButtons.forEach(btn => {
            btn.addEventListener('click', function () {
                tabButtons.forEach(b => {
                    b.classList.remove('bg-primary', 'text-on-primary', 'shadow-sm');
                    b.classList.add('text-on-surface', 'hover:bg-surface-container-highest');
                });

                this.classList.add('bg-primary', 'text-on-primary', 'shadow-sm');
                this.classList.remove('text-on-surface', 'hover:bg-surface-container-highest');

                if (bannerTitle) bannerTitle.textContent = 'Vai trò: ' + (this.getAttribute('data-role-name') || '');
                if (bannerScope) bannerScope.textContent = this.getAttribute('data-role-scope') || '';
                if (bannerLevel) bannerLevel.textContent = this.getAttribute('data-role-level') || '';
            });
        });
    });
</script>
