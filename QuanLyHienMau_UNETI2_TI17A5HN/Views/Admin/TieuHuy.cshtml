@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Kiểm định & Tiêu hủy túi máu (QC / Biohazard Disposal)";
}

<div class="flex flex-col w-full">
    <!-- Top Ambient Glow Line -->
    <div class="h-1.5 w-full bg-gradient-to-r from-error via-tertiary-container to-primary"></div>

    <!-- Inner Page Container -->
    <div class="px-gutter lg:px-margin py-space-lg max-w-[1520px] mx-auto w-full flex flex-col gap-space-lg">
        <!-- 1. HEADER & ACTION TOOLBAR -->
        <header class="flex flex-col xl:flex-row xl:items-end justify-between gap-space-md">
            <div class="space-y-space-xs max-w-4xl">
                <!-- Breadcrumb -->
                <nav aria-label="Đường dẫn hệ thống" class="flex items-center gap-2 font-label-sm text-label-sm text-on-surface-variant">
                    <span class="flex items-center gap-1.5 hover:text-primary transition-colors">
                        <span class="material-symbols-outlined text-[16px]">domain_verification</span>
                        Hệ thống Quản trị Y tế
                    </span>
                    <span class="text-outline/40">/</span>
                    <span class="hover:text-primary transition-colors">Quản lý Y tế</span>
                    <span class="text-outline/40">/</span>
                    <span class="text-primary font-bold flex items-center gap-1">
                        <span class="material-symbols-outlined text-[16px] text-primary" style="font-variation-settings: 'FILL' 1;">dangerous</span>
                        Kiểm định &amp; Tiêu hủy túi máu (QC &amp; Biohazard Disposal)
                    </span>
                </nav>
                <!-- Main Title -->
                <div class="flex flex-wrap items-center gap-3">
                    <h1 class="font-headline-lg text-headline-lg text-on-surface font-extrabold tracking-tight">
                        Kiểm Định Chất Lượng &amp; Tiêu Hủy Túi Máu Nhiễm Vi Sinh / Nhiễm Khuẩn
                    </h1>
                    <span class="px-2.5 py-1 rounded-full bg-error-container text-on-error-container font-label-sm text-label-sm font-bold flex items-center gap-1">
                        <span class="w-1.5 h-1.5 rounded-full bg-error animate-ping"></span>
                        BIOHAZARD LEVEL-2
                    </span>
                </div>
                <p class="font-body-md text-body-md text-on-surface-variant leading-relaxed">
                    Quy trình kiểm soát chất lượng mẫu máu, cách ly túi máu không đạt chuẩn (NAT / ECLIA Dương tính, tan máu, đông vón, rò rỉ bao bì) và thực hiện tiêu hủy rác thải y tế lây nhiễm nguy hại theo <strong class="text-on-surface font-semibold">Thông tư liên tịch 20/2021/TT-BYT</strong> &amp; <strong class="text-on-surface font-semibold">Chuẩn an toàn ISBT 128</strong>.
                </p>
            </div>
            <!-- Action Toolbar -->
            <div class="flex flex-wrap items-center gap-2.5 shrink-0">
                <button class="h-11 px-4 rounded-xl bg-surface-container-lowest text-on-surface font-label-md text-label-md flex items-center gap-2 shadow-sm hover:bg-surface-container-low transition-all" type="button" onclick="alert('Đang trích xuất biên bản tiêu hủy có đóng dấu thời gian TSA RFC 3161...')">
                    <span class="material-symbols-outlined text-[19px] text-on-surface-variant">picture_as_pdf</span>
                    Biên Bản Hủy Mẫu (PDF Có Ký Số)
                </button>
                <button class="h-11 px-4 rounded-xl bg-surface-container-lowest text-on-surface font-label-md text-label-md flex items-center gap-2 shadow-sm hover:bg-surface-container-low transition-all" type="button" onclick="alert('Đang kết nối cổng máy chủ LIMS Lab Vi sinh TW...')">
                    <span class="material-symbols-outlined text-[19px] text-on-surface-variant">terminal</span>
                    Tra Cứu Lô LIMS
                </button>
                <button class="h-11 px-4 rounded-xl bg-surface-container-lowest text-primary font-label-md text-label-md flex items-center gap-2 shadow-sm hover:bg-primary/5 transition-all font-semibold" type="button" onclick="alert('Mở biểu mẫu tiếp nhận khai báo túi lỗi vật lý / hỏng niêm phong!')">
                    <span class="material-symbols-outlined text-[19px]">add_circle</span>
                    Khai Báo Túi Lỗi Mới
                </button>
                <button class="h-11 px-5 rounded-xl bg-primary text-on-primary font-label-md text-label-md font-bold flex items-center gap-2 shadow-md hover:bg-primary-container transition-all" type="button" onclick="alert('Đang kích hoạt quy trình thẩm định ký số kép SmartCA!')">
                    <span class="material-symbols-outlined text-[20px]" style="font-variation-settings: 'FILL' 1;">verified_user</span>
                    Ký Phê Duyệt Tiêu Hủy Kép (SmartCA)
                </button>
            </div>
        </header>

        <!-- 2. DẢI 4 THẺ KPI CHỈ SỐ KIỂM ĐỊNH & NGUY CƠ AN TOÀN SINH HỌC -->
        <section aria-label="Chỉ số kiểm định &amp; an toàn" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-space-md">
            <!-- Card 1 -->
            <div class="relative overflow-hidden rounded-2xl bg-surface-container-lowest p-5 shadow-sm flex flex-col justify-between group hover:shadow-md transition-all">
                <div class="flex items-start justify-between">
                    <div>
                        <span class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider block font-semibold">Tổng túi máu kiểm định</span>
                        <span class="font-label-sm text-[12px] text-secondary">Tháng 05/2025 • Hệ thống TW</span>
                    </div>
                    <div class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center">
                        <span class="material-symbols-outlined text-[22px]">verified</span>
                    </div>
                </div>
                <div class="mt-4">
                    <div class="flex items-baseline gap-2">
                        <span class="font-headline-lg text-headline-lg font-bold text-on-surface">14,850</span>
                        <span class="font-label-md text-label-md text-on-surface-variant">túi</span>
                    </div>
                    <div class="mt-2 flex items-center gap-2">
                        <span class="px-2 py-0.5 rounded-full bg-emerald-100/80 text-emerald-800 font-label-sm text-[11px] font-bold flex items-center gap-0.5">
                            <span class="material-symbols-outlined text-[13px]">trending_up</span> +8.4%
                        </span>
                        <span class="font-body-sm text-body-sm text-on-surface-variant">Đạt chuẩn: <strong class="text-emerald-700 font-semibold">99.42%</strong></span>
                    </div>
                </div>
            </div>

            <!-- Card 2 -->
            <div class="relative overflow-hidden rounded-2xl bg-surface-container-lowest p-5 shadow-sm flex flex-col justify-between group hover:shadow-md transition-all">
                <div class="flex items-start justify-between">
                    <div>
                        <span class="font-label-sm text-label-sm text-error font-bold uppercase tracking-wider block">Cách ly chờ tiêu hủy</span>
                        <span class="font-label-sm text-[12px] text-secondary">Xử lý khẩn cấp trong 24h</span>
                    </div>
                    <div class="w-10 h-10 rounded-xl bg-error-container text-error flex items-center justify-center animate-pulse">
                        <span class="material-symbols-outlined text-[22px]" style="font-variation-settings: 'FILL' 1;">warning</span>
                    </div>
                </div>
                <div class="mt-4">
                    <div class="flex items-baseline gap-2">
                        <span class="font-headline-lg text-headline-lg font-bold text-error">18</span>
                        <span class="font-label-md text-label-md text-error">túi lây nhiễm</span>
                    </div>
                    <div class="mt-2 flex items-center justify-between">
                        <span class="font-body-sm text-body-sm text-on-surface-variant">Thể tích hủy: <strong class="text-on-surface font-semibold">6,850 mL</strong></span>
                        <span class="px-2 py-0.5 rounded bg-error text-on-error font-label-sm text-[10px] font-bold uppercase tracking-wider">Khóa ISBT</span>
                    </div>
                </div>
            </div>

            <!-- Card 3 -->
            <div class="relative overflow-hidden rounded-2xl bg-surface-container-lowest p-5 shadow-sm flex flex-col justify-between group hover:shadow-md transition-all">
                <div class="flex items-start justify-between">
                    <div>
                        <span class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider block font-semibold">Dương tính vi sinh</span>
                        <span class="font-label-sm text-[12px] text-secondary">Sàng lọc NAT &amp; ECLIA</span>
                    </div>
                    <div class="w-10 h-10 rounded-xl bg-tertiary-fixed text-tertiary flex items-center justify-center">
                        <span class="material-symbols-outlined text-[22px]">coronavirus</span>
                    </div>
                </div>
                <div class="mt-3">
                    <div class="flex items-baseline gap-2">
                        <span class="font-headline-lg text-headline-lg font-bold text-tertiary">11</span>
                        <span class="font-label-md text-label-md text-on-surface-variant">mẫu phát hiện</span>
                    </div>
                    <div class="mt-2 flex flex-wrap gap-1">
                        <span class="px-1.5 py-0.5 rounded bg-surface-container-high text-on-surface font-label-sm text-[11px] font-medium">HBV: 05</span>
                        <span class="px-1.5 py-0.5 rounded bg-surface-container-high text-on-surface font-label-sm text-[11px] font-medium">HCV: 03</span>
                        <span class="px-1.5 py-0.5 rounded bg-error/10 text-error font-label-sm text-[11px] font-bold">HIV: 02</span>
                        <span class="px-1.5 py-0.5 rounded bg-surface-container-high text-on-surface font-label-sm text-[11px] font-medium">Syph: 01</span>
                    </div>
                </div>
            </div>

            <!-- Card 4 -->
            <div class="relative overflow-hidden rounded-2xl bg-surface-container-lowest p-5 shadow-sm flex flex-col justify-between group hover:shadow-md transition-all">
                <div class="flex items-start justify-between">
                    <div>
                        <span class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider block font-semibold">Lỗi vật lý &amp; chuỗi lạnh</span>
                        <span class="font-label-sm text-[12px] text-secondary">Ngoại kiểm thể tích/bao bì</span>
                    </div>
                    <div class="w-10 h-10 rounded-xl bg-secondary-fixed text-on-secondary-container flex items-center justify-center">
                        <span class="material-symbols-outlined text-[22px]">thermostat</span>
                    </div>
                </div>
                <div class="mt-3">
                    <div class="flex items-baseline gap-2">
                        <span class="font-headline-lg text-headline-lg font-bold text-on-surface">07</span>
                        <span class="font-label-md text-label-md text-on-surface-variant">túi lỗi kỹ thuật</span>
                    </div>
                    <div class="mt-2 flex items-center gap-1.5 text-on-surface-variant font-body-sm text-[12px]">
                        <span class="inline-block w-2 h-2 rounded-full bg-amber-500"></span>
                        <span>03 Tan máu</span> •
                        <span>02 Fibrin vón</span> •
                        <span>02 Rách túi</span>
                    </div>
                </div>
            </div>
        </section>

        <!-- 3. CẢNH BÁO QUY TRÌNH PHÁP LÝ & AN TOÀN SINH HỌC CẤP 2 (BIOHAZARD PROTOCOL BANNER) -->
        <div class="relative overflow-hidden rounded-2xl bg-error-container/35 p-5 shadow-sm border-l-4 border-error">
            <div class="flex flex-col md:flex-row items-start gap-4">
                <div class="w-12 h-12 rounded-xl bg-error text-on-error flex items-center justify-center shrink-0 shadow-sm">
                    <span class="material-symbols-outlined text-[30px]" style="font-variation-settings: 'FILL' 1;">play_pause</span>
                </div>
                <div class="flex-1 space-y-1">
                    <div class="flex flex-wrap items-center gap-2">
                        <h2 class="font-title-md text-title-md font-bold text-error uppercase tracking-wide">
                            QUY TRÌNH CÁCH LY PHÁP LÝ Y TẾ &amp; AN TOÀN SINH HỌC CẤP 2 (BSL-2 PROTOCOL)
                        </h2>
                        <span class="px-2 py-0.5 rounded-full bg-error text-on-error font-label-sm text-[10px] font-extrabold uppercase tracking-wider">
                            Khóa điện tử toàn hệ thống
                        </span>
                    </div>
                    <p class="font-body-md text-body-md text-on-surface leading-relaxed">
                        Toàn bộ túi máu có kết quả xét nghiệm huyết thanh học / NAT khẳng định <strong class="text-error font-semibold">DƯƠNG TÍNH</strong> hoặc suy giảm phẩm chất vật lý đã được máy chủ phân phối tự động áp đặt khóa mã số <strong class="font-mono text-on-surface font-semibold">ISBT 128 Electronic Lockout</strong>. Tuyệt đối không thể xuất kho lâm sàng hoặc vận chuyển viện ngoại viện. Bắt buộc hoàn tất <strong class="text-on-surface font-semibold">02 Chữ ký số thẩm định độc lập</strong> (01 Kỹ thuật viên Trưởng Lab Xét Nghiệm và 01 Bác sĩ Trưởng Kíp Trực) trước khi mở niêm phong lò hấp tiệt trùng Autoclave hoặc chuyển giao lò đốt rác nguy hại theo <strong class="underline decoration-error font-semibold">Thông tư 26/2013/TT-BYT</strong>.
                    </p>
                </div>
                <div class="shrink-0 flex items-center self-center md:self-auto gap-2">
                    <button class="h-10 px-4 rounded-xl bg-error text-on-error font-label-md text-label-md font-semibold hover:bg-primary transition-all flex items-center gap-1.5 shadow-sm" type="button" onclick="alert('Đã kiểm tra nhật ký Audit Log: Toàn bộ 18 túi máu cách ly được ghi nhận bất biến.')">
                        <span class="material-symbols-outlined text-[18px]">verified</span>
                        Kiểm tra Log Audit
                    </button>
                </div>
            </div>
        </div>

        <!-- 5. QUY TRÌNH TIÊU HỦY RÁC THẢI Y TẾ NGUY HẠI 4 BƯỚC (BENTO FLOW) -->
        <section class="rounded-2xl bg-surface-container-lowest p-6 shadow-sm space-y-space-md">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                <div class="flex items-center gap-2.5">
                    <div class="w-8 h-8 rounded-lg bg-primary/10 text-primary flex items-center justify-center">
                        <span class="material-symbols-outlined text-[20px]">account_tree</span>
                    </div>
                    <h2 class="font-title-md text-title-md font-bold text-on-surface">
                        Quy Trình Tiêu Hủy Rác Thải Y Tế Lây Nhiễm 4 Bước Chuẩn Hóa (Standard Operating Procedure)
                    </h2>
                </div>
                <span class="font-label-sm text-label-sm text-on-surface-variant flex items-center gap-1">
                    <span class="material-symbols-outlined text-[16px] text-emerald-600">sync</span> Đồng bộ thời gian thực theo mốc ISO 15189
                </span>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-4 relative">
                <!-- Step 1 -->
                <div class="p-4 rounded-xl bg-surface-container-low flex flex-col justify-between relative overflow-hidden group border border-surface-container">
                    <div class="space-y-2">
                        <div class="flex items-center justify-between">
                            <span class="w-7 h-7 rounded-full bg-emerald-600 text-white font-label-sm text-label-sm font-bold flex items-center justify-center">
                                <span class="material-symbols-outlined text-[16px]">check</span>
                            </span>
                            <span class="font-label-sm text-[11px] text-emerald-700 font-bold bg-emerald-100 px-2 py-0.5 rounded-full">Tự động 100%</span>
                        </div>
                        <h3 class="font-label-lg text-label-lg font-bold text-on-surface pt-1">Bước 1: Phát hiện &amp; Khóa điện tử ISBT</h3>
                        <p class="font-body-sm text-body-sm text-on-surface-variant">
                            Máy xét nghiệm LIMS trả kết quả phản ứng dương tính (HBV/HCV/HIV/Syphilis) hoặc cảm biến báo vỡ hồng cầu &gt; 0.8%. Hệ thống tự động khóa mã số phân phối.
                        </p>
                    </div>
                    <div class="mt-4 pt-3 flex items-center justify-between text-on-surface-variant font-label-sm text-[12px] bg-surface-container-lowest/80 px-2.5 py-1.5 rounded-lg">
                        <span>Thời gian khóa:</span>
                        <span class="font-mono font-semibold text-error">&lt; 0.05 giây</span>
                    </div>
                </div>

                <!-- Step 2 -->
                <div class="p-4 rounded-xl bg-surface-container-low flex flex-col justify-between relative overflow-hidden group border border-surface-container">
                    <div class="space-y-2">
                        <div class="flex items-center justify-between">
                            <span class="w-7 h-7 rounded-full bg-amber-500 text-white font-label-sm text-label-sm font-bold flex items-center justify-center">
                                2
                            </span>
                            <span class="font-label-sm text-[11px] text-amber-800 font-bold bg-amber-100 px-2 py-0.5 rounded-full">Phòng Lab &amp; Kho</span>
                        </div>
                        <h3 class="font-label-lg text-label-lg font-bold text-on-surface pt-1">Bước 2: Niêm phong Thùng Vàng Biohazard</h3>
                        <p class="font-body-sm text-body-sm text-on-surface-variant">
                            Chuyển túi máu vào thùng vàng chuyên dụng dày &ge; 0.1mm, lót hạt hút ẩm, kẹp chì niêm phong có mã vạch RFID truy vết số seri thùng chứa.
                        </p>
                    </div>
                    <div class="mt-4 pt-3 flex items-center justify-between text-on-surface-variant font-label-sm text-[12px] bg-surface-container-lowest/80 px-2.5 py-1.5 rounded-lg">
                        <span>Tiêu chuẩn túi:</span>
                        <span class="font-semibold text-on-surface">TCVN 7380:2004</span>
                    </div>
                </div>

                <!-- Step 3 -->
                <div class="p-4 rounded-xl bg-primary-fixed/40 flex flex-col justify-between relative overflow-hidden group border-2 border-primary">
                    <div class="space-y-2">
                        <div class="flex items-center justify-between">
                            <span class="w-7 h-7 rounded-full bg-primary text-on-primary font-label-sm text-label-sm font-bold flex items-center justify-center">
                                3
                            </span>
                            <span class="font-label-sm text-[11px] text-primary font-bold bg-primary-fixed px-2 py-0.5 rounded-full">Giai đoạn kích hoạt</span>
                        </div>
                        <h3 class="font-label-lg text-label-lg font-bold text-on-surface pt-1">Bước 3: Khử khuẩn Autoclave / Lò đốt 1200°C</h3>
                        <p class="font-body-sm text-body-sm text-on-surface-variant">
                            Hấp tiệt trùng hơi nước áp suất cao 121°C trong 45 phút để bất hoạt hoàn toàn mầm bệnh hoặc chuyển giao xe chuyên dụng URENCO thiêu hủy nhiệt độ cao.
                        </p>
                    </div>
                    <div class="mt-4 pt-3 flex items-center justify-between text-on-surface-variant font-label-sm text-[12px] bg-surface-container-lowest/80 px-2.5 py-1.5 rounded-lg">
                        <span>Áp suất lò:</span>
                        <span class="font-semibold text-primary font-mono">1.2 Bar • 121°C</span>
                    </div>
                </div>

                <!-- Step 4 -->
                <div class="p-4 rounded-xl bg-surface-container-low flex flex-col justify-between relative overflow-hidden group border border-surface-container">
                    <div class="space-y-2">
                        <div class="flex items-center justify-between">
                            <span class="w-7 h-7 rounded-full bg-secondary text-white font-label-sm text-label-sm font-bold flex items-center justify-center">
                                4
                            </span>
                            <span class="font-label-sm text-[11px] text-secondary font-bold bg-secondary-fixed px-2 py-0.5 rounded-full">Pháp lý số</span>
                        </div>
                        <h3 class="font-label-lg text-label-lg font-bold text-on-surface pt-1">Bước 4: Ký số Kép &amp; Đóng Hồ sơ Vĩnh viễn</h3>
                        <p class="font-body-sm text-body-sm text-on-surface-variant">
                            KTV Trưởng và Bác sĩ Trưởng Kíp ký xác thực biên bản điện tử, hệ thống phát sinh chuỗi băm SHA-256 đóng gói hồ sơ lưu trữ 10 năm theo quy định Bộ Y tế.
                        </p>
                    </div>
                    <div class="mt-4 pt-3 flex items-center justify-between text-on-surface-variant font-label-sm text-[12px] bg-surface-container-lowest/80 px-2.5 py-1.5 rounded-lg">
                        <span>Thời hạn lưu trữ:</span>
                        <span class="font-semibold text-on-surface">10 năm pháp lý</span>
                    </div>
                </div>
            </div>
        </section>

        <!-- 4 & 6. SPLIT LAYOUT: BẢNG CÁCH LY CHỜ XỬ LÝ & MODULE KÝ DUYỆT BIÊN BẢN KÉP -->
        <div class="grid grid-cols-1 2xl:grid-cols-12 gap-space-lg items-start">
            <!-- LEFT COLUMN: 4. BẢNG QUẢN LÝ TÚI MÁU CÁCH LY (8 Cols on 2xl) -->
            <section class="2xl:col-span-8 flex flex-col rounded-2xl bg-surface-container-lowest p-6 shadow-sm space-y-space-md">
                <!-- Table Filter Header -->
                <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-space-md">
                    <div>
                        <div class="flex items-center gap-2">
                            <h2 class="font-title-md text-title-md font-bold text-on-surface">
                                Danh Sách Túi Máu Đang Cách Ly &amp; Chờ Tiêu Hủy
                            </h2>
                            <span class="px-2 py-0.5 rounded-full bg-error text-on-error font-label-sm text-label-sm font-bold">18 túi</span>
                        </div>
                        <p class="font-body-sm text-body-sm text-on-surface-variant mt-0.5">
                            Cập nhật đồng bộ theo thời gian thực từ máy phân tích tự động Cobas 6800 &amp; Alinity s
                        </p>
                    </div>
                    <!-- Quick Actions / Filters -->
                    <div class="flex items-center gap-2">
                        <div class="relative w-64">
                            <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant text-[18px]">filter_alt</span>
                            <input class="w-full h-9 pl-9 pr-3 rounded-lg bg-surface-container-low font-body-sm text-body-sm text-on-surface placeholder:text-on-surface-variant/60 focus:outline-none focus:bg-surface-container" placeholder="Lọc theo mã ISBT / DIN..." type="text">
                        </div>
                        <button class="h-9 px-3 rounded-lg bg-surface-container-low hover:bg-surface-container text-on-surface font-label-sm text-label-sm font-semibold flex items-center gap-1 transition-all" type="button" onclick="alert('Đang in mã vạch niêm phong Biohazard...')">
