@{
    ViewData["Title"] = "Theo Dõi Trạng Thái Phiếu Đăng Ký Hiến Máu";
    var ticketCode = ViewData["TicketCode"] as string ?? "#VTL-UNETI-08991";
}

<div class="flex flex-col w-full">
    <!-- Top Breadcrumb & Quick Tracker Lookup -->
    <div class="max-w-[1240px] w-full mx-auto px-6 py-6 flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div class="flex items-center gap-2 font-body-sm text-body-sm text-secondary">
            <a asp-controller="Home" asp-action="Index" class="hover:text-primary transition-colors flex items-center gap-1">
                <span class="material-symbols-outlined text-[16px]">home</span>
                Trang chủ
            </a>
            <span>/</span>
            <a asp-controller="DangKy" asp-action="TheoDoi" class="hover:text-primary transition-colors">Tra cứu &amp; Theo dõi phiếu</a>
            <span>/</span>
            <span class="text-on-surface font-semibold">Phiếu đăng ký @ticketCode</span>
        </div>
        <div class="flex items-center gap-3">
            <div class="flex items-center gap-1.5 px-3 py-1 rounded-full bg-surface-container-high text-secondary font-label-sm text-label-sm">
                <span class="inline-block w-2 h-2 rounded-full bg-primary animate-pulse"></span>
                Cập nhật hệ thống: 10 phút trước
            </div>
            <button class="hidden sm:inline-flex items-center gap-1 px-3 py-1.5 rounded-lg bg-surface-container-lowest text-on-surface hover:text-primary hover:bg-surface-container shadow-sm transition-all font-label-md text-label-md" onclick="window.print()">
                <span class="material-symbols-outlined text-[18px]">print</span>
                In trang
            </button>
        </div>
    </div>

    <!-- Main Content Wrap -->
    <div class="max-w-[1240px] w-full mx-auto px-6 pb-20 space-y-8">
        <!-- 1. Hero Summary Card -->
        <div class="w-full bg-surface-container-lowest rounded-2xl p-6 lg:p-8 shadow-sm relative overflow-hidden">
            <div class="absolute -right-24 -top-24 w-80 h-80 rounded-full bg-primary/5 blur-3xl pointer-events-none"></div>
            <div class="absolute -left-20 -bottom-20 w-60 h-60 rounded-full bg-primary-fixed/20 blur-2xl pointer-events-none"></div>
            <div class="relative z-10 flex flex-col lg:flex-row lg:items-center justify-between gap-6 pb-6 border-b border-surface-container-high">
                <div class="space-y-3">
                    <div class="flex flex-wrap items-center gap-3">
                        <span class="font-headline-md text-headline-md text-on-surface tracking-tight font-bold">
                            Mã hồ sơ: <span class="text-primary">@ticketCode</span>
                        </span>
                        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-50 text-emerald-700 font-label-sm text-label-sm font-semibold">
                            <span class="material-symbols-outlined text-[16px] text-emerald-600">verified</span>
                            ĐÃ XÁC NHẬN - CHỜ KHÁM SÀNG LỌC
                        </span>
                    </div>
                    <div class="flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-6 text-on-surface-variant font-body-md text-body-md">
                        <div class="flex items-center gap-2">
                            <span class="material-symbols-outlined text-primary text-[20px]">campaign</span>
                            <span class="font-semibold text-on-surface">Chiến dịch:</span> Giọt Hồng UNETI – Trao Đời Sự Sống 2026
                        </div>
                        <div class="flex items-center gap-2">
                            <span class="material-symbols-outlined text-primary text-[20px]">badge</span>
                            <span class="font-semibold text-on-surface">Người hiến:</span> Nguyễn Hoàng Nam
                            <span class="bg-surface-container-high text-secondary px-2 py-0.5 rounded text-[11px] font-label-sm">CCCD: ••••••••8891 (VNeID L2)</span>
                        </div>
                    </div>
                </div>
                <div class="flex flex-wrap items-center gap-3">
                    <button class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-surface-container-low hover:bg-surface-container text-on-surface font-label-md text-label-md transition-all shadow-sm" onclick="alert('Đang xuất phiếu đăng ký dạng PDF...');">
                        <span class="material-symbols-outlined text-[18px] text-primary">picture_as_pdf</span>
                        Tải phiếu PDF
                    </button>
                    <button class="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-xl bg-secondary-fixed/40 hover:bg-secondary-fixed text-primary font-label-md text-label-md transition-all" onclick="toggleRescheduleModal()">
                        <span class="material-symbols-outlined text-[18px]">edit_calendar</span>
                        Đổi ca hẹn / Hủy
                    </button>
                </div>
            </div>

            <!-- Quick Metrics Strip -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 pt-6">
                <div class="flex items-start gap-3 p-3.5 rounded-xl bg-surface-container-low/70">
                    <div class="w-10 h-10 rounded-xl bg-primary-fixed flex items-center justify-center text-primary shrink-0">
                        <span class="material-symbols-outlined text-[22px]">schedule</span>
                    </div>
                    <div>
                        <div class="font-label-sm text-label-sm text-secondary uppercase">Khung giờ hẹn</div>
                        <div class="font-title-md text-title-md text-on-surface mt-0.5">07:30 - 09:30</div>
                        <div class="font-body-sm text-body-sm text-on-surface-variant">15/11/2026</div>
                    </div>
                </div>
                <div class="flex items-start gap-3 p-3.5 rounded-xl bg-surface-container-low/70">
                    <div class="w-10 h-10 rounded-xl bg-secondary-fixed flex items-center justify-center text-secondary shrink-0">
                        <span class="material-symbols-outlined text-[22px]">pin_drop</span>
                    </div>
                    <div>
                        <div class="font-label-sm text-label-sm text-secondary uppercase">Địa điểm tiếp nhận</div>
                        <div class="font-title-md text-title-md text-on-surface mt-0.5">Hội trường Nhà C - UNETI</div>
                        <div class="font-body-sm text-body-sm text-on-surface-variant truncate max-w-[200px]">218 Lĩnh Nam, Hoàng Mai</div>
                    </div>
                </div>
                <div class="flex items-start gap-3 p-3.5 rounded-xl bg-surface-container-low/70">
                    <div class="w-10 h-10 rounded-xl bg-rose-100 flex items-center justify-center text-primary-container shrink-0">
                        <span class="material-symbols-outlined text-[22px]">water_drop</span>
                    </div>
                    <div>
                        <div class="font-label-sm text-label-sm text-secondary uppercase">Nhóm máu &amp; Thể tích</div>
                        <div class="font-title-md text-title-md text-primary font-bold mt-0.5">Nhóm O Rh(+) • 350ml</div>
                        <div class="font-body-sm text-body-sm text-on-surface-variant">Hiến máu toàn phần</div>
                    </div>
                </div>
                <div class="flex items-start gap-3 p-3.5 rounded-xl bg-surface-container-low/70">
                    <div class="w-10 h-10 rounded-xl bg-emerald-100 flex items-center justify-center text-emerald-700 shrink-0">
                        <span class="material-symbols-outlined text-[22px]">qr_code_scanner</span>
                    </div>
                    <div>
                        <div class="font-label-sm text-label-sm text-secondary uppercase">Cổng Check-in</div>
                        <div class="font-title-md text-title-md text-emerald-800 font-bold mt-0.5">Bàn tiếp nhận Số 03</div>
                        <div class="font-body-sm text-body-sm text-emerald-700">Khám sơ bộ &amp; Đo HA</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 2. INTERACTIVE STATUS TIMELINE -->
        <div class="w-full bg-surface-container-lowest rounded-2xl p-6 lg:p-8 shadow-sm space-y-6">
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-4 border-b border-surface-container-high">
                <div>
                    <span class="font-label-sm text-label-sm uppercase tracking-wider text-primary font-bold">Lộ Trình Minh Bạch</span>
                    <h2 class="font-headline-md text-headline-md text-on-surface mt-0.5">Quy Trình 5 Chặng &amp; Trạng Thái Theo Thời Gian Thực</h2>
                </div>
                <div class="flex items-center gap-2">
                    <button class="px-3.5 py-1.5 rounded-lg text-label-md font-label-md bg-primary text-on-primary shadow-sm transition-all" id="btnStandard" onclick="setFlowView('standard')">
                        Lộ trình thực tế
                    </button>
                    <button class="px-3.5 py-1.5 rounded-lg text-label-md font-label-md bg-surface-container-low hover:bg-surface-container text-secondary transition-all" id="btnBranches" onclick="setFlowView('branches')">
                        Sơ đồ rẽ nhánh ngoại lệ
                    </button>
                </div>
            </div>

            <!-- Main Interactive Horizontal 5-Step Stepper -->
            <div class="pt-4 pb-2" id="standardTimelineView">
                <div class="grid grid-cols-1 md:grid-cols-5 gap-6 relative">
                    <div class="hidden md:block absolute top-7 left-10 right-10 h-1 bg-surface-container-high z-0">
                        <div class="h-full bg-gradient-to-r from-emerald-500 via-emerald-500 to-primary w-[52%] rounded-full transition-all duration-700"></div>
                    </div>
                    <!-- Step 1 -->
                    <div class="relative z-10 flex flex-col items-start md:items-center text-left md:text-center group">
                        <div class="w-14 h-14 rounded-2xl bg-emerald-600 text-on-primary flex items-center justify-center shadow-md shadow-emerald-500/20 mb-3">
                            <span class="material-symbols-outlined text-[28px]">task_alt</span>
                        </div>
                        <span class="inline-block px-2.5 py-0.5 rounded-full bg-emerald-100 text-emerald-800 font-label-sm text-[11px] font-bold mb-1">
                            CHẶNG 1 • XONG
                        </span>
                        <h3 class="font-title-md text-title-md text-on-surface">Đăng ký hồ sơ</h3>
                        <p class="font-body-sm text-body-sm text-secondary mt-1">10/11/2026 • 14:32</p>
                    </div>
                    <!-- Step 2 -->
                    <div class="relative z-10 flex flex-col items-start md:items-center text-left md:text-center group">
                        <div class="w-14 h-14 rounded-2xl bg-emerald-600 text-on-primary flex items-center justify-center shadow-md shadow-emerald-500/20 mb-3">
                            <span class="material-symbols-outlined text-[28px]">verified_user</span>
                        </div>
                        <span class="inline-block px-2.5 py-0.5 rounded-full bg-emerald-100 text-emerald-800 font-label-sm text-[11px] font-bold mb-1">
                            CHẶNG 2 • XONG
                        </span>
                        <h3 class="font-title-md text-title-md text-on-surface">Phê duyệt y tế</h3>
                        <p class="font-body-sm text-body-sm text-secondary mt-1">10/11/2026 • 16:45</p>
                    </div>
                    <!-- Step 3 (Current) -->
                    <div class="relative z-10 flex flex-col items-start md:items-center text-left md:text-center">
                        <div class="w-14 h-14 rounded-2xl bg-primary text-on-primary flex items-center justify-center shadow-lg shadow-primary/30 ring-4 ring-primary-fixed mb-3 animate-bounce">
                            <span class="material-symbols-outlined text-[28px]">stethoscope</span>
                        </div>
                        <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-primary text-on-primary font-label-sm text-[11px] font-bold mb-1">
                            <span class="w-1.5 h-1.5 rounded-full bg-on-primary animate-ping"></span>
                            HIỆN TẠI (CHỜ KHÁM)
                        </span>
                        <h3 class="font-title-md text-title-md text-primary font-bold">Khám sàng lọc tại chỗ</h3>
                        <p class="font-body-sm text-body-sm text-on-surface font-semibold mt-1">15/11/2026 • 07:30</p>
                    </div>
                    <!-- Step 4 -->
                    <div class="relative z-10 flex flex-col items-start md:items-center text-left md:text-center opacity-65 group">
                        <div class="w-14 h-14 rounded-2xl bg-surface-container-high text-secondary flex items-center justify-center mb-3">
                            <span class="material-symbols-outlined text-[28px]">bloodtype</span>
                        </div>
                        <span class="inline-block px-2.5 py-0.5 rounded-full bg-surface-container text-secondary font-label-sm text-[11px] font-semibold mb-1">
                            CHẶNG 4 • DỰ KIẾN
                        </span>
                        <h3 class="font-title-md text-title-md text-on-surface">Tiếp nhận lấy máu</h3>
                        <p class="font-body-sm text-body-sm text-secondary mt-1">~08:00 - 08:30</p>
                    </div>
                    <!-- Step 5 -->
                    <div class="relative z-10 flex flex-col items-start md:items-center text-left md:text-center opacity-65 group">
                        <div class="w-14 h-14 rounded-2xl bg-surface-container-high text-secondary flex items-center justify-center mb-3">
                            <span class="material-symbols-outlined text-[28px]">card_membership</span>
                        </div>
                        <span class="inline-block px-2.5 py-0.5 rounded-full bg-surface-container text-secondary font-label-sm text-[11px] font-semibold mb-1">
                            CHẶNG 5 • DỰ KIẾN
                        </span>
                        <h3 class="font-title-md text-title-md text-on-surface">Nghỉ ngơi &amp; Cấp thẻ</h3>
                        <p class="font-body-sm text-body-sm text-secondary mt-1">~08:45 - 09:15</p>
                    </div>
                </div>
            </div>

            <!-- Alternate View: Sơ đồ rẽ nhánh ngoại lệ -->
            <div class="hidden pt-4 pb-2 space-y-4" id="branchesView">
                <div class="p-4 rounded-xl bg-amber-50 text-amber-900 font-body-sm text-body-sm flex items-start gap-3">
                    <span class="material-symbols-outlined text-amber-700 text-[22px] mt-0.5 shrink-0">account_tree</span>
                    <div>
                        <span class="font-semibold block">Hệ thống xử lý kịch bản y tế thông minh (Exception Pathways)</span>
                        Để đảm bảo an toàn tuyệt đối cho người hiến và nguồn máu tiếp nhận, hệ thống hỗ trợ 3 nhánh tự động:
                    </div>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div class="p-5 rounded-xl bg-surface-container-low flex flex-col justify-between space-y-3">
                        <div class="space-y-2">
                            <div class="flex items-center justify-between">
                                <span class="px-2.5 py-1 rounded bg-rose-100 text-error font-label-sm text-label-sm font-bold">Nhánh Ngoại lệ A</span>
                                <span class="material-symbols-outlined text-error text-[20px]">cancel</span>
                            </div>
                            <h4 class="font-title-md text-title-md text-on-surface font-bold">Từ chối duyệt sơ bộ</h4>
                            <p class="font-body-sm text-body-sm text-on-surface-variant">
                                Kích hoạt khi: Khoảng cách giữa 2 lần hiến chưa đủ 84 ngày, hoặc người hiến đang dùng kháng sinh.
                            </p>
                        </div>
                    </div>
                    <div class="p-5 rounded-xl bg-surface-container-low flex flex-col justify-between space-y-3">
                        <div class="space-y-2">
                            <div class="flex items-center justify-between">
                                <span class="px-2.5 py-1 rounded bg-amber-100 text-amber-800 font-label-sm text-label-sm font-bold">Nhánh Ngoại lệ B</span>
                                <span class="material-symbols-outlined text-amber-700 text-[20px]">health_and_safety</span>
                            </div>
                            <h4 class="font-title-md text-title-md text-on-surface font-bold">Hoãn hiến tại bàn khám</h4>
                            <p class="font-body-sm text-body-sm text-on-surface-variant">
                                Kích hoạt khi: Bác sĩ đo HA không ổn định (&lt;90 hoặc &gt;140mmHg), thiếu máu Hb &lt; 120g/l.
                            </p>
                        </div>
                    </div>
                    <div class="p-5 rounded-xl bg-surface-container-low flex flex-col justify-between space-y-3">
                        <div class="space-y-2">
                            <div class="flex items-center justify-between">
                                <span class="px-2.5 py-1 rounded bg-surface-container-high text-secondary font-label-sm text-label-sm font-bold">Nhánh Ngoại lệ C</span>
                                <span class="material-symbols-outlined text-secondary text-[20px]">event_busy</span>
                            </div>
                            <h4 class="font-title-md text-title-md text-on-surface font-bold">Người hiến hủy ca hẹn</h4>
                            <p class="font-body-sm text-body-sm text-on-surface-variant">
                                Kích hoạt khi: Người đăng ký có lịch bận đột xuất, chủ động bấm hủy trước giờ hẹn.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 3. TWO-COLUMN WORKFLOW SECTION -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
            <div class="lg:col-span-7 space-y-6">
                <!-- Panel 3.1: Thông tin người hiến -->
                <div class="bg-surface-container-lowest rounded-2xl p-6 lg:p-7 shadow-sm space-y-5">
                    <div class="flex items-center justify-between">
                        <h3 class="font-headline-sm text-headline-sm text-on-surface flex items-center gap-2">
                            <span class="material-symbols-outlined text-primary text-[24px]">folder_shared</span>
                            Hồ Sơ Đăng Ký Y Tế
                        </h3>
                        <span class="text-xs px-2.5 py-1 bg-surface-container font-label-sm text-secondary rounded-md">Khớp dữ liệu UNETI</span>
                    </div>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
                        <div class="space-y-1">
                            <span class="font-label-sm text-label-sm text-secondary">Họ và tên người hiến</span>
                            <p class="font-title-md text-title-md text-on-surface font-semibold">Nguyễn Hoàng Nam</p>
                        </div>
                        <div class="space-y-1">
                            <span class="font-label-sm text-label-sm text-secondary">Ngày sinh &amp; Giới tính</span>
                            <p class="font-title-md text-title-md text-on-surface">14/08/2003 (23 tuổi) • Nam</p>
                        </div>
                        <div class="space-y-1">
                            <span class="font-label-sm text-label-sm text-secondary">Số điện thoại liên hệ</span>
                            <p class="font-title-md text-title-md text-on-surface">0988 123 456</p>
                        </div>
                        <div class="space-y-1">
                            <span class="font-label-sm text-label-sm text-secondary">Cân nặng &amp; Chiều cao</span>
                            <p class="font-title-md text-title-md text-on-surface">64 kg • 172 cm</p>
                        </div>
                    </div>
                </div>

                <!-- Panel 3.2: Checklist chuẩn bị -->
                <div class="bg-surface-container-lowest rounded-2xl p-6 lg:p-7 shadow-sm space-y-5">
                    <h3 class="font-headline-sm text-headline-sm text-on-surface flex items-center gap-2">
                        <span class="material-symbols-outlined text-primary text-[24px]">fact_check</span>
                        Checklist Chuẩn Bị Trước Giờ Hẹn
                    </h3>
                    <div class="space-y-3">
                        <label class="flex items-start gap-3.5 p-3 rounded-xl hover:bg-surface-container-low transition-colors cursor-pointer group">
                            <input checked="" class="mt-1 w-5 h-5 rounded accent-primary text-on-primary cursor-pointer" type="checkbox">
                            <div class="space-y-0.5">
                                <span class="font-title-md text-title-md text-on-surface group-hover:text-primary transition-colors">Mang theo CCCD gắn chip hoặc App VNeID mức 2</span>
                            </div>
                        </label>
                        <label class="flex items-start gap-3.5 p-3 rounded-xl hover:bg-surface-container-low transition-colors cursor-pointer group">
                            <input checked="" class="mt-1 w-5 h-5 rounded accent-primary text-on-primary cursor-pointer" type="checkbox">
                            <div class="space-y-0.5">
                                <span class="font-title-md text-title-md text-on-surface group-hover:text-primary transition-colors">Đảm bảo ngủ đủ ít nhất 6 tiếng đêm hôm trước</span>
                            </div>
                        </label>
                        <label class="flex items-start gap-3.5 p-3 rounded-xl hover:bg-surface-container-low transition-colors cursor-pointer group">
                            <input class="mt-1 w-5 h-5 rounded accent-primary text-on-primary cursor-pointer" type="checkbox">
                            <div class="space-y-0.5">
                                <span class="font-title-md text-title-md text-on-surface group-hover:text-primary transition-colors">Ăn sáng nhẹ, tuyệt đối KHÔNG ăn dầu mỡ &amp; uống sữa</span>
                            </div>
                        </label>
                        <label class="flex items-start gap-3.5 p-3 rounded-xl hover:bg-surface-container-low transition-colors cursor-pointer group">
                            <input class="mt-1 w-5 h-5 rounded accent-primary text-on-primary cursor-pointer" type="checkbox">
                            <div class="space-y-0.5">
                                <span class="font-title-md text-title-md text-on-surface group-hover:text-primary transition-colors">Uống từ 300ml - 500ml nước ấm trước khi đến</span>
                            </div>
                        </label>
                    </div>
                </div>
            </div>

            <!-- CỘT PHẢI (5 cols) - E-Ticket QR Code -->
            <div class="lg:col-span-5 space-y-6">
                <div class="bg-gradient-to-b from-primary via-primary-container to-tertiary-container rounded-3xl p-6 text-on-primary shadow-xl shadow-primary/20 relative overflow-hidden">
                    <div class="flex items-center justify-between pb-4 border-b border-white/20">
                        <div class="flex items-center gap-2">
                            <span class="material-symbols-outlined text-[24px]">bloodtype</span>
                            <span class="font-headline-sm text-headline-sm font-bold tracking-tight">VITALIS PASS</span>
                        </div>
                        <span class="px-2.5 py-1 rounded-full bg-white/20 text-on-primary text-xs font-label-sm font-semibold tracking-wide uppercase">
                            Check-in 1 Chạm
                        </span>
                    </div>
                    <div class="py-6 flex flex-col items-center text-center">
                        <div class="p-4 rounded-2xl bg-surface-container-lowest text-on-surface shadow-2xl relative group">
                            <svg class="w-44 h-44" fill="currentColor" viewBox="0 0 100 100">
                                <path d="M5,5 h30 v30 h-30 z M10,10 v20 h20 v-20 z M15,15 h10 v10 h-10 z"></path>
                                <path d="M65,5 h30 v30 h-30 z M70,10 v20 h20 v-20 z M75,15 h10 v10 h-10 z"></path>
                                <path d="M5,65 h30 v30 h-30 z M10,70 v20 h20 v-20 z M15,75 h10 v10 h-10 z"></path>
                                <rect height="6" width="6" x="42" y="8"></rect>
                                <rect height="6" width="6" x="52" y="16"></rect>
                                <rect height="6" width="6" x="42" y="24"></rect>
                                <rect height="6" width="6" x="8" y="42"></rect>
                                <rect height="6" width="6" x="18" y="50"></rect>
                                <circle cx="50" cy="50" fill="#ffffff" r="13"></circle>
                                <circle cx="50" cy="50" fill="#c6283d" r="11"></circle>
                            </svg>
                            <div class="text-[11px] font-label-sm text-secondary mt-2 tracking-widest font-mono">
                                CODE: @ticketCode
                            </div>
                        </div>
                        <div class="mt-4 space-y-1">
                            <p class="font-title-md text-title-md font-bold text-on-primary">
                                Nguyễn Hoàng Nam • O Rh(+)
                            </p>
                            <p class="text-xs text-on-primary/80">
                                Khung giờ hiệu lực: <strong class="text-on-primary">07:30 – 09:30, 15/11/2026</strong>
                            </p>
                        </div>
                    </div>
                </div>

                <!-- BÁC SĨ PHỤ TRÁCH -->
                <div class="bg-surface-container-lowest rounded-2xl p-6 shadow-sm space-y-4">
                    <div class="flex items-center justify-between">
                        <h4 class="font-headline-sm text-headline-sm text-on-surface">Bác Sĩ Phụ Trách</h4>
                        <span class="px-2 py-0.5 rounded bg-emerald-100 text-emerald-800 text-xs font-semibold">Trực điểm khám</span>
                    </div>
                    <div class="flex items-center gap-4 pt-1">
                        <img class="w-16 h-16 rounded-2xl object-cover shrink-0 shadow-sm" src="~/images/doctor_nurse.png" alt="BS. CKI Trần Mai Linh">
                        <div class="space-y-1">
                            <p class="font-title-md text-title-md text-on-surface font-bold">BS. CKI Trần Mai Linh</p>
                            <p class="font-body-sm text-body-sm text-secondary">Trưởng kíp khám sàng lọc UNETI</p>
                            <p class="text-xs text-primary font-medium">Bệnh viện Huyết học Truyền máu</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- MODAL: ĐỔI CA HẸN -->
    <div class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-inverse-surface/40 backdrop-blur-sm transition-opacity" id="rescheduleModal">
        <div class="bg-surface-container-lowest max-w-lg w-full rounded-3xl p-6 lg:p-8 shadow-2xl space-y-6">
            <div class="flex items-center justify-between pb-3 border-b border-surface-container-high">
                <div class="flex items-center gap-2">
                    <span class="material-symbols-outlined text-primary text-[24px]">edit_calendar</span>
                    <h3 class="font-headline-sm text-headline-sm text-on-surface">Thay Đổi / Hủy Ca Hẹn</h3>
                </div>
                <button class="w-8 h-8 rounded-full hover:bg-surface-container flex items-center justify-center text-secondary" onclick="toggleRescheduleModal()">
                    <span class="material-symbols-outlined text-[20px]">close</span>
                </button>
            </div>
            <p class="font-body-md text-body-md text-on-surface-variant">
                Quý khách đang thao tác cho hồ sơ <strong class="text-on-surface">@ticketCode</strong>. Vui lòng chọn hành động:
            </p>
            <div class="space-y-3">
                <label class="flex items-start gap-3 p-3.5 rounded-xl border border-surface-container-high hover:border-primary/40 cursor-pointer transition-all">
                    <input checked="" class="mt-1 w-4 h-4 accent-primary" name="rescheduleAction" type="radio">
                    <div>
                        <span class="font-title-md text-title-md text-on-surface block">Chuyển sang khung giờ khác cùng ngày</span>
                        <p class="text-xs text-secondary mt-0.5">Ca 09:30 - 11:30 ngày 15/11/2026 (Còn 18 chỗ trống)</p>
                    </div>
                </label>
                <label class="flex items-start gap-3 p-3.5 rounded-xl border border-surface-container-high hover:border-error/40 cursor-pointer transition-all">
                    <input class="mt-1 w-4 h-4 accent-error" name="rescheduleAction" type="radio">
                    <div>
                        <span class="font-title-md text-title-md text-error block">Hủy phiếu đăng ký này</span>
                    </div>
                </label>
            </div>
            <div class="flex items-center justify-end gap-3 pt-4 border-t border-surface-container-high">
                <button class="px-4 py-2.5 rounded-xl text-on-surface font-label-md text-label-md hover:bg-surface-container transition-colors" onclick="toggleRescheduleModal()">
                    Đóng
                </button>
                <button class="px-5 py-2.5 rounded-xl bg-primary text-on-primary font-label-md text-label-md hover:bg-primary-container transition-all shadow-md" onclick="alert('Yêu cầu điều chỉnh ca hẹn đã được gửi đến Ban Điều Phối Vitalis.'); toggleRescheduleModal();">
                    Xác nhận thay đổi
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function setFlowView(type) {
            const standardView = document.getElementById('standardTimelineView');
            const branchesView = document.getElementById('branchesView');
            const btnStandard = document.getElementById('btnStandard');
            const btnBranches = document.getElementById('btnBranches');

            if (type === 'standard') {
                standardView.classList.remove('hidden');
                branchesView.classList.add('hidden');
                btnStandard.className = 'px-3.5 py-1.5 rounded-lg text-label-md font-label-md bg-primary text-on-primary shadow-sm transition-all';
                btnBranches.className = 'px-3.5 py-1.5 rounded-lg text-label-md font-label-md bg-surface-container-low hover:bg-surface-container text-secondary transition-all';
            } else {
                standardView.classList.add('hidden');
                branchesView.classList.remove('hidden');
                btnBranches.className = 'px-3.5 py-1.5 rounded-lg text-label-md font-label-md bg-primary text-on-primary shadow-sm transition-all';
                btnStandard.className = 'px-3.5 py-1.5 rounded-lg text-label-md font-label-md bg-surface-container-low hover:bg-surface-container text-secondary transition-all';
            }
        }

        function toggleRescheduleModal() {
            const modal = document.getElementById('rescheduleModal');
            modal.classList.toggle('hidden');
        }
    </script>
}
