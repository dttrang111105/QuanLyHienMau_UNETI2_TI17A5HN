@*
Họ và tên: NGUYỄN THỊ PHƯƠNG THẢO
Mã sinh viên: 23103100272
Nội dung thực hiện: Quản lý đợt hiến máu,
tìm kiếm, lọc, sắp xếp và phân trang.
*@
@model IEnumerable<QuanLyHienMau_UNETI2_TI17A5HN.Models.DotHienMau>

@{
    ViewData["Title"] = "Danh Sách Đợt Hiến Máu Vì Cộng Đồng";

    var donViList =
        ViewBag.DonViList
        as List<QuanLyHienMau_UNETI2_TI17A5HN.Models.DonViToChuc>
        ?? new List<QuanLyHienMau_UNETI2_TI17A5HN.Models.DonViToChuc>();

    var currentSearch = ViewBag.CurrentSearch as string;
    var currentStatus = ViewBag.CurrentStatus as string;
    var currentDonViId = ViewBag.CurrentDonViId as int?;
    var currentNhomMau = ViewBag.CurrentNhomMau as string;
    var currentCanNang = ViewBag.CurrentCanNang as double?;

    var currentThoiHan = ViewBag.CurrentThoiHan as string;
    var currentSort = ViewBag.CurrentSort as string;

    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 0;
    int totalItems = ViewBag.TotalItems ?? 0;
}

<div class="flex flex-col w-full">
    <!-- Search & Page Header Section -->
    <section class="relative bg-gradient-to-b from-surface-container-low via-surface to-surface pb-12 pt-8">
        <div class="max-w-[1240px] mx-auto px-6">
            <!-- Breadcrumb -->
            <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-on-surface-variant font-label-md text-label-md mb-6">
                <a asp-controller="Home" asp-action="Index" class="hover:text-primary transition-colors flex items-center gap-1">
                    <span class="material-symbols-outlined text-[18px]">home</span>
                    <span>Trang chủ</span>
                </a>
                <span class="material-symbols-outlined text-[14px] text-outline">chevron_right</span>
                <span class="text-primary font-bold">Đợt hiến máu</span>
            </nav>

            <!-- Title & Subtitle with Accent Accentuation -->
            <div class="max-w-3xl mb-8">
                <div class="inline-flex items-center gap-2 bg-secondary-container text-on-secondary-container px-3.5 py-1.5 rounded-full mb-3 shadow-sm">
                    <span class="material-symbols-outlined text-primary text-[18px]" style="font-variation-settings: 'FILL' 1;">volunteer_activism</span>
                    <span class="font-label-sm text-label-sm tracking-wide uppercase">Cộng Đồng Hiến Máu UNETI</span>
                </div>
                <h1 class="font-display-hero text-headline-lg lg:text-display-hero text-on-surface tracking-tight leading-tight">
                    Tìm một đợt hiến máu <span class="text-primary">gần bạn</span>
                </h1>
                <p class="font-body-lg text-body-lg text-on-surface-variant mt-3 leading-relaxed">
                    Tham gia các chiến dịch hiến máu nhân đạo do các bệnh viện, trường đại học UNETI và hội chữ thập đỏ tổ chức trên toàn quốc.
                </p>
            </div>

            <!-- Large Center Search Bar -->
            <form method="get" asp-controller="DotHienMau" asp-action="Index" class="bg-surface-container-lowest p-2.5 rounded-2xl shadow-[0_12px_32px_-4px_rgba(198,40,61,0.08),0_4px_12px_-2px_rgba(0,0,0,0.03)] flex flex-col md:flex-row items-center gap-2 max-w-4xl">
                <div class="flex items-center gap-3 px-4 py-2 w-full flex-1">
                    <span class="material-symbols-outlined text-primary text-[24px]">search</span>
                    <input name="search" value="@currentSearch" class="w-full bg-transparent font-body-md text-body-md text-on-surface placeholder:text-outline focus:outline-none" placeholder="Tìm theo tên chiến dịch, đơn vị tổ chức, mô tả..." type="text">
                </div>
                <div class="h-8 w-px bg-surface-container-high hidden md:block"></div>
                <div class="flex items-center gap-2.5 px-4 py-2 w-full md:w-auto md:min-w-[240px]">
                    <span class="material-symbols-outlined text-secondary text-[22px]">apartment</span>
                    <select name="donViId" class="w-full bg-transparent font-body-md text-body-md text-on-surface focus:outline-none cursor-pointer">
                        <option value="">Tất cả đơn vị</option>
                        @foreach (var dv in donViList)
                        {
                            if (currentDonViId == dv.MaDonViToChuc)
                            {
                                <option value="@dv.MaDonViToChuc" selected>@dv.TenDonViToChuc</option>
                            }
                            else
                            {
                                <option value="@dv.MaDonViToChuc">@dv.TenDonViToChuc</option>
                            }
                        }
                    </select>
                </div>
                <button type="submit" class="w-full md:w-auto inline-flex items-center justify-center gap-2 bg-gradient-to-r from-primary to-primary-container text-on-primary font-label-lg text-label-lg px-8 py-3.5 rounded-xl shadow-[0_4px_16px_-2px_rgba(198,40,61,0.35)] hover:shadow-[0_8px_24px_-2px_rgba(198,40,61,0.45)] hover:-translate-y-0.5 active:translate-y-0 transition-all shrink-0 cursor-pointer">
                    <span class="material-symbols-outlined text-[20px]">search</span>
                    <span>Tìm kiếm</span>
                </button>
            </form>
        </div>
    </section>

    <!-- Main Content Layout (Filter + Grid) -->
    <section class="max-w-[1240px] mx-auto px-6 py-6 w-full">
        <!-- Filter Control Bar -->
        <form method="get" asp-controller="DotHienMau" asp-action="Index" class="bg-surface-container-lowest p-6 rounded-2xl shadow-[0_4px_20px_-2px_rgba(198,40,61,0.04)] mb-8">
            <input type="hidden" name="search" value="@currentSearch" />
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                <!-- Tổ chức -->
                <div class="flex flex-col gap-1.5">
                    <label class="font-label-md text-label-md text-on-surface flex items-center gap-1">
                        <span class="material-symbols-outlined text-[16px] text-primary">apartment</span>
                        <span>Đơn vị tổ chức</span>
                    </label>
                    <div class="relative">
                        <select name="donViId" onchange="this.form.submit()" class="w-full h-12 bg-surface-container-low text-on-surface font-body-sm text-body-sm rounded-xl px-3.5 appearance-none focus:outline-none focus:bg-surface-container-lowest cursor-pointer shadow-sm pr-9">
                            <option value="">Tất cả đơn vị</option>
                            @foreach (var dv in donViList)
                            {
                                if (currentDonViId == dv.MaDonViToChuc)
                                {
                                    <option value="@dv.MaDonViToChuc" selected>@dv.TenDonViToChuc</option>
                                }
                                else
                                {
                                    <option value="@dv.MaDonViToChuc">@dv.TenDonViToChuc</option>
                                }
                            }
                        </select>
                        <span class="material-symbols-outlined absolute right-3 top-3.5 text-on-surface-variant pointer-events-none text-[18px]">expand_more</span>
                    </div>
                </div>
                <!-- Nhóm máu ưu tiên -->
                <div class="flex flex-col gap-1.5">
                    <label class="font-label-md text-label-md text-on-surface flex items-center gap-1">
                        <span class="material-symbols-outlined text-[16px] text-primary">bloodtype</span>
                        <span>Nhóm máu ưu tiên</span>
                    </label>
                    <div class="relative">
                        <select name="nhomMau" onchange="this.form.submit()" class="w-full h-12 bg-surface-container-low text-on-surface font-body-sm text-body-sm rounded-xl px-3.5 appearance-none focus:outline-none focus:bg-surface-container-lowest cursor-pointer shadow-sm pr-9">
                            <option value="">Tất cả nhóm máu</option>
                            <option value="O" selected="@(currentNhomMau == "O")">Nhóm O</option>
                            <option value="A" selected="@(currentNhomMau == "A")">Nhóm A</option>
                            <option value="B" selected="@(currentNhomMau == "B")">Nhóm B</option>
                            <option value="AB" selected="@(currentNhomMau == "AB")">Nhóm AB</option>
                        </select>
                        <span class="material-symbols-outlined absolute right-3 top-3.5 text-on-surface-variant pointer-events-none text-[18px]">expand_more</span>
                    </div>
                </div>
                <!-- Trạng thái -->
                <div class="flex flex-col gap-1.5">
                    <label class="font-label-md text-label-md text-on-surface flex items-center gap-1">
                        <span class="material-symbols-outlined text-[16px] text-primary">sync_saved_locally</span>
                        <span>Trạng thái</span>
                    </label>
                    <div class="relative">
                        <select name="status" onchange="this.form.submit()" class="w-full h-12 bg-surface-container-low text-on-surface font-body-sm text-body-sm rounded-xl px-3.5 appearance-none focus:outline-none focus:bg-surface-container-lowest cursor-pointer shadow-sm pr-9">
                            <option value="all" selected="@(string.IsNullOrEmpty(currentStatus) || currentStatus == "all")">Tất cả trạng thái</option>
                            <option value="Đang mở đăng ký" selected="@(currentStatus == "Đang mở đăng ký")">Đang mở đăng ký</option>
                            <option value="Chưa mở" selected="@(currentStatus == "Chưa mở")">Chưa mở</option>
                            <option value="Tạm dừng" selected="@(currentStatus == "Tạm dừng")">Tạm dừng</option>
                            <option value="Đã đóng" selected="@(currentStatus == "Đã đóng")">Đã đóng</option>
                        </select>
                        <span class="material-symbols-outlined absolute right-3 top-3.5 text-on-surface-variant pointer-events-none text-[18px]">expand_more</span>
                    </div>
                </div>
                <!-- Cân nặng tối thiểu -->
                <div class="flex flex-col gap-1.5">
                    <label class="font-label-md text-label-md text-on-surface flex items-center gap-1">
                        <span class="material-symbols-outlined text-[16px] text-primary">fitness_center</span>
                        <span>Cân nặng tối thiểu</span>
                    </label>
                    <div class="relative">
                        <select name="canNang" onchange="this.form.submit()" class="w-full h-12 bg-surface-container-low text-on-surface font-body-sm text-body-sm rounded-xl px-3.5 appearance-none focus:outline-none focus:bg-surface-container-lowest cursor-pointer shadow-sm pr-9">
                            <option value="">Tất cả thể trạng</option>
                            <option value="42" selected="@(currentCanNang == 42)">Từ 42kg (Nữ giới)</option>
                            <option value="45" selected="@(currentCanNang == 45)">Từ 45kg trở lên</option>
                            <option value="50" selected="@(currentCanNang == 50)">Từ 50kg (Hiến 450ml)</option>
                        </select>
                        <span class="material-symbols-outlined absolute right-3 top-3.5 text-on-surface-variant pointer-events-none text-[18px]">expand_more</span>
                    </div>
                    <!-- Thời hạn đăng ký -->
                    <div class="flex flex-col gap-1.5">
                        <label class="font-label-md text-label-md text-on-surface flex items-center gap-1">
                            <span class="material-symbols-outlined text-[16px] text-primary">
                                event_available
                            </span>
                            <span>Thời hạn đăng ký</span>
                        </label>

                        <div class="relative">
                            <select name="thoiHan"
                                    onchange="this.form.submit()"
                                    class="w-full h-12 bg-surface-container-low text-on-surface font-body-sm text-body-sm rounded-xl px-3.5 appearance-none focus:outline-none focus:bg-surface-container-lowest cursor-pointer shadow-sm pr-9">

                                <option value=""
                                        selected="@(string.IsNullOrEmpty(currentThoiHan))">
                                    Tất cả thời hạn
                                </option>

                                <option value="conhan"
                                        selected="@(currentThoiHan == "conhan")">
                                    Còn hạn đăng ký
                                </option>

                                <option value="hethan"
                                        selected="@(currentThoiHan == "hethan")">
                                    Hết hạn đăng ký
                                </option>
                            </select>

                            <span class="material-symbols-outlined absolute right-3 top-3.5 text-on-surface-variant pointer-events-none text-[18px]">
                                expand_more
                            </span>
                        </div>
                    </div>
                    <!-- Sắp xếp -->
                    <div class="flex flex-col gap-1.5">
                        <label class="font-label-md text-label-md text-on-surface flex items-center gap-1">
                            <span class="material-symbols-outlined text-[16px] text-primary">
                                sort
                            </span>
                            <span>Sắp xếp</span>
                        </label>

                        <div class="relative">
                            <select name="sort"
                                    onchange="this.form.submit()"
                                    class="w-full h-12 bg-surface-container-low text-on-surface font-body-sm text-body-sm rounded-xl px-3.5 appearance-none focus:outline-none focus:bg-surface-container-lowest cursor-pointer shadow-sm pr-9">

                                <option value=""
                                        selected="@(string.IsNullOrEmpty(currentSort))">
                                    Mặc định
                                </option>

                                <option value="name_asc"
                                        selected="@(currentSort == "name_asc")">
                                    Tên A → Z
                                </option>

                                <option value="name_desc"
                                        selected="@(currentSort == "name_desc")">
                                    Tên Z → A
                                </option>

                                <option value="deadline_asc"
                                        selected="@(currentSort == "deadline_asc")">
                                    Hạn đăng ký tăng dần
                                </option>

                                <option value="deadline_desc"
                                        selected="@(currentSort == "deadline_desc")">
                                    Hạn đăng ký giảm dần
                                </option>

                                <option value="quota_asc"
                                        selected="@(currentSort == "quota_asc")">
                                    Chỉ tiêu tăng dần
                                </option>

                                <option value="quota_desc"
                                        selected="@(currentSort == "quota_desc")">
                                    Chỉ tiêu giảm dần
                                </option>
                            </select>

                            <span class="material-symbols-outlined absolute right-3 top-3.5 text-on-surface-variant pointer-events-none text-[18px]">
                                expand_more
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Bottom Sub-Row: Results Count, Sort, and Reset Filter -->
            <div class="mt-6 pt-5 border-t border-surface-container-high/60 flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
                <!-- Result Counter & Quick Chips -->
                <div class="flex flex-wrap items-center gap-3">
                    <div class="inline-flex items-center gap-1.5 bg-primary/10 text-primary px-3.5 py-1.5 rounded-full font-label-md text-label-md font-bold">
                        <span class="material-symbols-outlined text-[16px]">done_all</span>
                        <span>Tìm thấy @totalItems đợt hiến máu</span>
                    </div>
                    @if (
                            !string.IsNullOrEmpty(currentSearch)
                            || (!string.IsNullOrEmpty(currentStatus) && currentStatus != "all")
                            || currentDonViId.HasValue
                            || !string.IsNullOrEmpty(currentNhomMau)
                            || currentCanNang.HasValue
                            || !string.IsNullOrEmpty(currentThoiHan)
                            || !string.IsNullOrEmpty(currentSort)
)
                    {
                        <span class="text-on-surface-variant text-body-sm font-body-sm hidden sm:inline">•</span>
                        <span class="text-on-surface-variant text-body-sm font-body-sm">Đang áp dụng lọc</span>
                    }
                </div>
                <!-- Reset button -->
                <div class="flex items-center gap-3 w-full md:w-auto justify-between md:justify-end">
                    <a asp-controller="DotHienMau" asp-action="Index" class="inline-flex items-center gap-1 text-on-surface-variant hover:text-primary transition-colors px-3 py-2 rounded-xl hover:bg-surface-container font-label-md text-label-md">
                        <span class="material-symbols-outlined text-[16px]">restart_alt</span>
                        <span>Đặt lại bộ lọc</span>
                    </a>
                </div>
            </div>
        </form>

        <!-- Campaign Cards Grid -->
        @if (Model != null && Model.Any())
        {
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                @foreach (var item in Model)
                {
                    var isDangMo = item.TrangThai == "Đang mở đăng ký";
                    var isChuaMo = item.TrangThai == "Chưa mở";
                    var isTamDung = item.TrangThai == "Tạm dừng";
                    var isDaDong = item.TrangThai == "Đã đóng";

                    var cardImage = "https://images.unsplash.com/photo-1615461066841-6116e61058f4?auto=format&fit=crop&w=600&q=80";
                    if (item.MaDot % 3 == 2)
                    {
                        cardImage = "https://images.unsplash.com/photo-1579154204601-01588f351e67?auto=format&fit=crop&w=600&q=80";
                    }
                    else if (item.MaDot % 3 == 0)
                    {
                        cardImage = "https://images.unsplash.com/photo-1584515979956-d9f6e5d09982?auto=format&fit=crop&w=600&q=80";
                    }

                    <article class="bg-surface-container-lowest rounded-2xl shadow-[0_4px_20px_-2px_rgba(198,40,61,0.05),0_2px_6px_-1px_rgba(0,0,0,0.04)] hover:shadow-[0_12px_28px_-3px_rgba(198,40,61,0.12)] hover:-translate-y-1 transition-all duration-200 flex flex-col justify-between overflow-hidden group">
                        <div>
                            <div class="relative h-48 w-full overflow-hidden bg-surface-container">
                                <img class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" src="@cardImage" alt="@item.TenDot">
                                <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
                                <div class="absolute top-3.5 left-3.5 right-3.5 flex items-center justify-between">
                                    @if (isDangMo)
                                    {
                                        <span class="inline-flex items-center gap-1.5 bg-emerald-50 text-emerald-700 px-3 py-1 rounded-full font-label-sm text-label-sm font-bold shadow-sm">
                                            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                                            <span>ĐANG MỞ</span>
                                        </span>
                                    }
                                    else if (isChuaMo)
                                    {
                                        <span class="inline-flex items-center gap-1.5 bg-blue-50 text-blue-700 px-3 py-1 rounded-full font-label-sm text-label-sm font-bold shadow-sm">
                                            <span class="w-2 h-2 rounded-full bg-blue-500"></span>
                                            <span>CHƯA MỞ</span>
                                        </span>
                                    }
                                    else if (isTamDung)
                                    {
                                        <span class="inline-flex items-center gap-1.5 bg-amber-50 text-amber-700 px-3 py-1 rounded-full font-label-sm text-label-sm font-bold shadow-sm">
                                            <span class="w-2 h-2 rounded-full bg-amber-500"></span>
                                            <span>TẠM DỪNG</span>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1.5 bg-gray-100 text-gray-700 px-3 py-1 rounded-full font-label-sm text-label-sm font-bold shadow-sm">
                                            <span class="w-2 h-2 rounded-full bg-gray-400"></span>
                                            <span>ĐÃ ĐÓNG</span>
                                        </span>
                                    }

                                    <span class="inline-flex items-center gap-1 bg-surface-container-lowest/95 backdrop-blur-sm text-on-surface px-2.5 py-1 rounded-full font-label-sm text-label-sm font-semibold shadow-sm">
                                        <span class="material-symbols-outlined text-primary text-[15px]">event</span>
                                        <span>Hạn: @item.HanDangKy.ToString("dd/MM/yyyy")</span>
                                    </span>
                                </div>
                                <div class="absolute bottom-3 left-3.5 right-3.5">
                                    <div class="inline-flex items-center gap-1.5 text-on-primary font-label-sm text-label-sm drop-shadow">
                                        <span class="material-symbols-outlined text-[16px]">account_balance</span>
                                        <span class="truncate">@(item.DonViToChuc?.TenDonViToChuc ?? "UNETI")</span>
                                    </div>
                                </div>
                            </div>
                            <div class="p-5">
                                <h2 class="font-headline-sm text-headline-sm text-on-surface font-bold leading-tight group-hover:text-primary transition-colors mb-2.5 line-clamp-1">
                                    @item.TenDot
                                </h2>
                                <div class="space-y-2 mb-4">
                                    <div class="flex items-start gap-2 text-on-surface-variant font-body-sm text-body-sm">
                                        <span class="material-symbols-outlined text-primary text-[18px] shrink-0 mt-0.5">date_range</span>
                                        <span><strong>@item.NgayBatDauDangKy.ToString("dd/MM/yyyy")</strong> - <strong>@item.HanDangKy.ToString("dd/MM/yyyy")</strong></span>
                                    </div>
                                    <div class="flex items-start gap-2 text-on-surface-variant font-body-sm text-body-sm">
                                        <span class="material-symbols-outlined text-secondary text-[18px] shrink-0 mt-0.5">pin_drop</span>
                                        <span class="line-clamp-1">@(string.IsNullOrEmpty(item.MoTaDot) ? "Cơ sở UNETI Hà Nội / Nam Định" : item.MoTaDot)</span>
                                    </div>
                                </div>
                                <div class="flex flex-wrap items-center gap-1.5 mb-4">
                                    <span class="font-label-sm text-label-sm text-secondary uppercase">Ưu tiên:</span>
                                    @if (!string.IsNullOrWhiteSpace(item.NhomMauUuTien))
                                    {
                                        var groups = item.NhomMauUuTien.Split(',', StringSplitOptions.RemoveEmptyEntries);
                                        foreach (var g in groups)
                                        {
                                            <span class="px-2 py-0.5 bg-primary-fixed text-on-primary-fixed-variant rounded-md font-label-sm text-label-sm font-bold">@g.Trim()</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="px-2 py-0.5 bg-secondary-fixed text-on-secondary-fixed-variant rounded-md font-label-sm text-label-sm font-bold">Tất cả nhóm máu</span>
                                    }
                                    <span class="ml-auto text-on-surface-variant font-label-sm text-label-sm bg-surface-container px-2 py-0.5 rounded-md">≥ @item.CanNangToiThieu kg</span>
                                </div>
                                <div class="bg-surface-container-low p-3 rounded-xl mb-2">
                                    <div class="flex items-center justify-between font-label-sm text-label-sm mb-1.5">
                                        <span class="text-on-surface-variant">Chỉ tiêu tiếp nhận</span>
                                        <span class="font-bold text-primary">@item.ChiTieuDonViMau đơn vị</span>
                                    </div>
                                    <div class="w-full h-2 bg-surface-container rounded-full overflow-hidden">
                                        <div class="bg-gradient-to-r from-primary to-primary-container h-full rounded-full transition-all" style="width: 75%"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="p-5 pt-0 flex items-center gap-2">
                            <a asp-controller="DotHienMau" asp-action="Details" asp-route-id="@item.MaDot" class="flex-1 text-center py-2.5 rounded-xl font-label-md text-label-md text-on-surface-variant hover:text-primary hover:bg-surface-container transition-all">
                                Xem chi tiết
                            </a>
                            <a asp-controller="DotHienMau" asp-action="Details" asp-route-id="@item.MaDot" class="flex-1 inline-flex items-center justify-center gap-1.5 py-2.5 rounded-xl font-label-md text-label-md bg-gradient-to-r from-primary to-primary-container text-on-primary shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all">
                                <span class="material-symbols-outlined text-[16px]">favorite</span>
                                <span>Đăng ký ngay</span>
                            </a>
                        </div>
                    </article>
                }
            </div>
        }
        else
        {
            <div class="bg-surface-container-lowest rounded-3xl p-12 text-center shadow-sm max-w-2xl mx-auto my-8">
                <div class="w-16 h-16 rounded-full bg-primary/10 text-primary flex items-center justify-center mx-auto mb-4">
                    <span class="material-symbols-outlined text-[32px]">search_off</span>
                </div>
                <h3 class="font-headline-sm text-headline-sm font-bold text-on-surface mb-2">Không tìm thấy đợt hiến máu phù hợp</h3>
                <p class="font-body-md text-body-md text-on-surface-variant mb-6">
                    Không có kết quả nào phù hợp với điều kiện tìm kiếm hoặc bộ lọc hiện tại. Vui lòng thử tìm với từ khóa khác hoặc đặt lại bộ lọc.
                </p>
                <a asp-controller="DotHienMau" asp-action="Index" class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-primary text-on-primary font-label-md text-label-md font-bold shadow-md hover:bg-primary-container transition-all">
                    <span class="material-symbols-outlined text-[18px]">restart_alt</span>
                    <span>Xem tất cả đợt hiến máu</span>
                </a>
            </div>
        }
        @if (totalPages > 1)
        {
            <div class="mt-10 flex flex-col sm:flex-row items-center justify-between gap-4">

                <!-- Thông tin trang -->
                <div class="font-body-sm text-body-sm text-on-surface-variant">
                    Trang
                    <strong class="text-on-surface">@currentPage</strong>
                    /
                    <strong class="text-on-surface">@totalPages</strong>
                </div>

                <!-- Các nút phân trang -->
                <div class="flex items-center gap-2">

                    <!-- Trang trước -->
                    @if (currentPage > 1)
                    {
                        <a asp-controller="DotHienMau"
                            asp-action="Index"
                            asp-route-page="@(currentPage - 1)"
                            asp-route-search="@currentSearch"
                            asp-route-status="@currentStatus"
                            asp-route-donViId="@currentDonViId"
                            asp-route-nhomMau="@currentNhomMau"
                            asp-route-canNang="@currentCanNang"
                            asp-route-thoiHan="@currentThoiHan"
                            asp-route-sort="@currentSort"
                            class="inline-flex items-center justify-center h-10 px-3 rounded-xl bg-surface-container-lowest text-on-surface border border-surface-container-high hover:text-primary hover:bg-surface-container transition-all shadow-sm">

                            <span class="material-symbols-outlined text-[18px]">
                                chevron_left
                            </span>

                            <span class="hidden sm:inline">
                                Trước
                            </span>
                        </a>
                    }

                    <!-- Các số trang -->
                    @for (int i = 1; i <= totalPages; i++)
                    {
                        if (i == currentPage)
                        {
                            <span class="inline-flex items-center justify-center w-10 h-10 rounded-xl bg-primary text-on-primary font-label-md font-bold shadow-sm">
                                @i
                            </span>
                        }
                        else
                        {
                            <a asp-controller="DotHienMau"
                                asp-action="Index"
                                asp-route-page="@i"
                                asp-route-search="@currentSearch"
                                asp-route-status="@currentStatus"
                                asp-route-donViId="@currentDonViId"
                                asp-route-nhomMau="@currentNhomMau"
                                asp-route-canNang="@currentCanNang"
                                asp-route-thoiHan="@currentThoiHan"
                                asp-route-sort="@currentSort"
                                class="inline-flex items-center justify-center w-10 h-10 rounded-xl bg-surface-container-lowest text-on-surface hover:bg-surface-container hover:text-primary transition-all shadow-sm">

                                @i
                            </a>
                        }
                    }

                    <!-- Trang sau -->
                    @if (currentPage < totalPages)
                    {
                        <a asp-controller="DotHienMau"
                            asp-action="Index"
                            asp-route-page="@(currentPage + 1)"
                            asp-route-search="@currentSearch"
                            asp-route-status="@currentStatus"
                            asp-route-donViId="@currentDonViId"
                            asp-route-nhomMau="@currentNhomMau"
                            asp-route-canNang="@currentCanNang"
                            asp-route-thoiHan="@currentThoiHan"
                            asp-route-sort="@currentSort"
                            class="inline-flex items-center justify-center h-10 px-3 rounded-xl bg-surface-container-lowest text-on-surface border border-surface-container-high hover:text-primary hover:bg-surface-container transition-all shadow-sm">

                            <span class="hidden sm:inline">
                                Sau
                            </span>

                            <span class="material-symbols-outlined text-[18px]">
                                chevron_right
                            </span>
                        </a>
                    }

                </div>
            </div>
        }

        <!-- Quick Guidance Banner: Chưa biết nhóm máu -->
        <div class="relative overflow-hidden bg-gradient-to-r from-primary-fixed to-surface-container-high rounded-3xl p-8 lg:p-10 my-10 shadow-[0_10px_30px_-5px_rgba(198,40,61,0.08)]">
            <div class="relative z-10 flex flex-col lg:flex-row lg:items-center justify-between gap-6">
                <div class="flex items-start gap-5 max-w-2xl">
                    <div class="w-14 h-14 rounded-2xl bg-primary text-on-primary flex items-center justify-center shrink-0 shadow-lg shadow-primary/25">
                        <span class="material-symbols-outlined text-[32px]">biotech</span>
                    </div>
                    <div>
                        <h3 class="font-headline-md text-headline-md text-on-surface font-bold mb-2">
                            Chưa biết nhóm máu của mình?
                        </h3>
                        <p class="font-body-md text-body-md text-on-surface-variant leading-relaxed">
                            Đừng lo lắng! Bác sĩ sẽ tiến hành xét nghiệm định lượng và xác định nhóm máu hoàn toàn miễn phí ngay trong buổi khám sàng lọc trước khi hiến máu.
                        </p>
                    </div>
                </div>
                <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 shrink-0">
                    <a class="inline-flex items-center justify-center gap-2 bg-surface-container-lowest text-primary font-label-md text-label-md px-5 py-3.5 rounded-xl shadow-sm hover:shadow-md hover:bg-surface-bright transition-all" asp-controller="Home" asp-action="Index">
                        <span class="material-symbols-outlined text-[18px]">verified</span>
                        <span>Xem quy trình hiến máu</span>
                    </a>
                </div>
            </div>
        </div>
    </section>
</div>
