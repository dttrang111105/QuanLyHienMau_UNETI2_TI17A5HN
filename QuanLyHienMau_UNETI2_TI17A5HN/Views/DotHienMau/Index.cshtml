@{
    ViewData["Title"] = "Danh Sách Đợt Hiến Máu Vì Cộng Đồng";
}

<div class="flex flex-col w-full">
    <!-- Search & Page Header Section -->
    <section class="relative bg-gradient-to-b from-surface-container-low via-surface to-surface pb-12 pt-8">
        <div class="max-w-[1240px] mx-auto px-6">
            <!-- Breadcrumb -->
            <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-on-surface-variant font-label-md text-label-md mb-6">
                <a asp-controller="Home" asp-action="Index" class="hover:text-primary transition-colors flex items-center gap-1">
                    <span class="material-symbols-outlined text-[18px]">home</span>
                    <span>Trang chủ</span>
                </a>
                <span class="material-symbols-outlined text-[14px] text-outline">chevron_right</span>
                <span class="text-primary font-bold">Đợt hiến máu</span>
            </nav>

            <!-- Title & Subtitle with Accent Accentuation -->
            <div class="max-w-3xl mb-8">
                <div class="inline-flex items-center gap-2 bg-secondary-container text-on-secondary-container px-3.5 py-1.5 rounded-full mb-3 shadow-sm">
                    <span class="material-symbols-outlined text-primary text-[18px]" style="font-variation-settings: 'FILL' 1;">volunteer_activism</span>
                    <span class="font-label-sm text-label-sm tracking-wide uppercase">Cộng Đồng Hiến Máu UNETI</span>
                </div>
                <h1 class="font-display-hero text-headline-lg lg:text-display-hero text-on-surface tracking-tight leading-tight">
                    Tìm một đợt hiến máu <span class="text-primary">gần bạn</span>
                </h1>
                <p class="font-body-lg text-body-lg text-on-surface-variant mt-3 leading-relaxed">
                    Tham gia các chiến dịch hiến máu nhân đạo do các bệnh viện, trường đại học UNETI và hội chữ thập đỏ tổ chức trên toàn quốc.
                </p>
            </div>

            <!-- Large Center Search Bar -->
            <div class="bg-surface-container-lowest p-2.5 rounded-2xl shadow-[0_12px_32px_-4px_rgba(198,40,61,0.08),0_4px_12px_-2px_rgba(0,0,0,0.03)] flex flex-col md:flex-row items-center gap-2 max-w-4xl">
                <div class="flex items-center gap-3 px-4 py-2 w-full flex-1">
                    <span class="material-symbols-outlined text-primary text-[24px]">search</span>
                    <input class="w-full bg-transparent font-body-md text-body-md text-on-surface placeholder:text-outline focus:outline-none" placeholder="Tìm theo tên chiến dịch, bệnh viện, trường học..." type="text">
                </div>
                <div class="h-8 w-px bg-surface-container-high hidden md:block"></div>
                <div class="flex items-center gap-2.5 px-4 py-2 w-full md:w-auto md:min-w-[240px]">
                    <span class="material-symbols-outlined text-secondary text-[22px]">location_on</span>
                    <select class="w-full bg-transparent font-body-md text-body-md text-on-surface focus:outline-none cursor-pointer">
                        <option value="">Toàn quốc (Tất cả tỉnh thành)</option>
                        <option value="hn">Hà Nội (Cơ sở Lĩnh Nam / Minh Khai)</option>
                        <option value="nd">Nam Định (Cơ sở 353 Trần Hưng Đạo)</option>
                        <option value="hcm">TP. Hồ Chí Minh</option>
                        <option value="dn">Đà Nẵng</option>
                    </select>
                </div>
                <button class="w-full md:w-auto inline-flex items-center justify-center gap-2 bg-gradient-to-r from-primary to-primary-container text-on-primary font-label-lg text-label-lg px-8 py-3.5 rounded-xl shadow-[0_4px_16px_-2px_rgba(198,40,61,0.35)] hover:shadow-[0_8px_24px_-2px_rgba(198,40,61,0.45)] hover:-translate-y-0.5 active:translate-y-0 transition-all shrink-0">
                    <span class="material-symbols-outlined text-[20px]">search</span>
                    <span>Tìm kiếm</span>
                </button>
            </div>
        </div>
    </section>

    <!-- Main Content Layout (Filter + Grid) -->
    <section class="max-w-[1240px] mx-auto px-6 py-6 w-full">
        <!-- Filter Control Bar -->
        <div class="bg-surface-container-lowest p-6 rounded-2xl shadow-[0_4px_20px_-2px_rgba(198,40,61,0.04)] mb-8">
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
                <!-- Tổ chức -->
                <div class="flex flex-col gap-1.5">
                    <label class="font-label-md text-label-md text-on-surface flex items-center gap-1">
                        <span class="material-symbols-outlined text-[16px] text-primary">apartment</span>
                        <span>Đơn vị tổ chức</span>
                    </label>
                    <div class="relative">
                        <select class="w-full h-12 bg-surface-container-low text-on-surface font-body-sm text-body-sm rounded-xl px-3.5 appearance-none focus:outline-none focus:bg-surface-container-lowest cursor-pointer shadow-sm pr-9">
                            <option value="">Tất cả đơn vị</option>
                            <option value="uneti">Đoàn Thanh Niên UNETI</option>
                            <option value="vien-huyet-hoc">Viện Huyết học TW</option>
                            <option value="cho-ray">Bệnh viện Chợ Rẫy</option>
                            <option value="chu-thap-do">Hội Chữ Thập Đỏ</option>
                        </select>
                        <span class="material-symbols-outlined absolute right-3 top-3.5 text-on-surface-variant pointer-events-none text-[18px]">expand_more</span>
                    </div>
                </div>
                <!-- Nhóm máu ưu tiên -->
                <div class="flex flex-col gap-1.5">
                    <label class="font-label-md text-label-md text-on-surface flex items-center gap-1">
                        <span class="material-symbols-outlined text-[16px] text-primary">bloodtype</span>
                        <span>Nhóm máu ưu tiên</span>
                    </label>
                    <div class="relative">
                        <select class="w-full h-12 bg-surface-container-low text-on-surface font-body-sm text-body-sm rounded-xl px-3.5 appearance-none focus:outline-none focus:bg-surface-container-lowest cursor-pointer shadow-sm pr-9">
                            <option value="">Tất cả nhóm máu</option>
                            <option value="O">Nhóm O (Khẩn cấp)</option>
                            <option value="A">Nhóm A</option>
                            <option value="B">Nhóm B</option>
                            <option value="AB">Nhóm AB</option>
                            <option value="urgent">Khẩn cấp cần gấp</option>
                        </select>
                        <span class="material-symbols-outlined absolute right-3 top-3.5 text-on-surface-variant pointer-events-none text-[18px]">expand_more</span>
                    </div>
                </div>
                <!-- Trạng thái -->
                <div class="flex flex-col gap-1.5">
                    <label class="font-label-md text-label-md text-on-surface flex items-center gap-1">
                        <span class="material-symbols-outlined text-[16px] text-primary">sync_saved_locally</span>
                        <span>Trạng thái</span>
                    </label>
                    <div class="relative">
                        <select class="w-full h-12 bg-surface-container-low text-on-surface font-body-sm text-body-sm rounded-xl px-3.5 appearance-none focus:outline-none focus:bg-surface-container-lowest cursor-pointer shadow-sm pr-9">
                            <option selected="" value="open">Đang mở đăng ký</option>
                            <option value="upcoming">Sắp diễn ra</option>
                            <option value="filled">Đã đủ chỉ tiêu</option>
                            <option value="closed">Đã đóng</option>
                        </select>
                        <span class="material-symbols-outlined absolute right-3 top-3.5 text-on-surface-variant pointer-events-none text-[18px]">expand_more</span>
                    </div>
                </div>
                <!-- Cân nặng tối thiểu -->
                <div class="flex flex-col gap-1.5">
                    <label class="font-label-md text-label-md text-on-surface flex items-center gap-1">
                        <span class="material-symbols-outlined text-[16px] text-primary">fitness_center</span>
                        <span>Cân nặng tối thiểu</span>
                    </label>
                    <div class="relative">
                        <select class="w-full h-12 bg-surface-container-low text-on-surface font-body-sm text-body-sm rounded-xl px-3.5 appearance-none focus:outline-none focus:bg-surface-container-lowest cursor-pointer shadow-sm pr-9">
                            <option value="">Tất cả thể trạng</option>
                            <option value="42">Từ 42kg (Nữ giới)</option>
                            <option selected="" value="45">Từ 45kg trở lên</option>
                            <option value="50">Từ 50kg (Hiến 450ml)</option>
                        </select>
                        <span class="material-symbols-outlined absolute right-3 top-3.5 text-on-surface-variant pointer-events-none text-[18px]">expand_more</span>
                    </div>
                </div>
                <!-- Thời gian hạn đăng ký -->
                <div class="flex flex-col gap-1.5">
                    <label class="font-label-md text-label-md text-on-surface flex items-center gap-1">
                        <span class="material-symbols-outlined text-[16px] text-primary">calendar_clock</span>
                        <span>Thời gian / Hạn</span>
                    </label>
                    <div class="relative">
                        <select class="w-full h-12 bg-surface-container-low text-on-surface font-body-sm text-body-sm rounded-xl px-3.5 appearance-none focus:outline-none focus:bg-surface-container-lowest cursor-pointer shadow-sm pr-9">
                            <option value="all">Còn hạn đăng ký</option>
                            <option value="urgent_3days">Sắp hết hạn (trong 3 ngày)</option>
                            <option value="this_week">Trong tuần này</option>
                            <option value="this_month">Trong tháng này</option>
                        </select>
                        <span class="material-symbols-outlined absolute right-3 top-3.5 text-on-surface-variant pointer-events-none text-[18px]">expand_more</span>
                    </div>
                </div>
            </div>

            <!-- Bottom Sub-Row: Results Count, Sort, and Reset Filter -->
            <div class="mt-6 pt-5 border-t border-surface-container-high/60 flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
                <!-- Result Counter & Quick Chips -->
                <div class="flex flex-wrap items-center gap-3">
                    <div class="inline-flex items-center gap-1.5 bg-primary/10 text-primary px-3.5 py-1.5 rounded-full font-label-md text-label-md font-bold">
                        <span class="material-symbols-outlined text-[16px]">done_all</span>
                        <span>Tìm thấy 48 đợt hiến máu</span>
                    </div>
                    <span class="text-on-surface-variant text-body-sm font-body-sm hidden sm:inline">•</span>
                    <span class="text-on-surface-variant text-body-sm font-body-sm">Đang áp dụng lọc:</span>
                    <span class="inline-flex items-center gap-1 bg-surface-container text-on-surface px-2.5 py-1 rounded-lg text-label-sm font-label-sm">
                        <span>≥ 45kg</span>
                        <button class="hover:text-primary transition-colors flex items-center"><span class="material-symbols-outlined text-[14px]">close</span></button>
                    </span>
                    <span class="inline-flex items-center gap-1 bg-surface-container text-on-surface px-2.5 py-1 rounded-lg text-label-sm font-label-sm">
                        <span>Đang mở</span>
                        <button class="hover:text-primary transition-colors flex items-center"><span class="material-symbols-outlined text-[14px]">close</span></button>
                    </span>
                </div>
                <!-- Sort selector and Reset button -->
                <div class="flex items-center gap-3 w-full md:w-auto justify-between md:justify-end">
                    <div class="flex items-center gap-2">
                        <span class="font-label-sm text-label-sm text-secondary uppercase tracking-wider shrink-0">Sắp xếp:</span>
                        <div class="relative">
                            <select class="h-10 bg-surface-container text-on-surface font-label-md text-label-md rounded-xl pl-3 pr-8 appearance-none focus:outline-none cursor-pointer">
                                <option selected="" value="nearest">Hạn đăng ký gần nhất</option>
                                <option value="quota_high">Chỉ tiêu tiếp nhận cao nhất</option>
                                <option value="alphabet">Tên A → Z</option>
                                <option value="newest">Mới nhất</option>
                            </select>
                            <span class="material-symbols-outlined absolute right-2.5 top-2.5 text-on-surface-variant pointer-events-none text-[16px]">arrow_drop_down</span>
                        </div>
                    </div>
                    <button class="inline-flex items-center gap-1 text-on-surface-variant hover:text-primary transition-colors px-3 py-2 rounded-xl hover:bg-surface-container font-label-md text-label-md">
                        <span class="material-symbols-outlined text-[16px]">restart_alt</span>
                        <span>Đặt lại bộ lọc</span>
                    </button>
                </div>
            </div>
        </div>

        <!-- Campaign Cards Grid (6 Cards) -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            <!-- CARD 1 -->
            <article class="bg-surface-container-lowest rounded-2xl shadow-[0_4px_20px_-2px_rgba(198,40,61,0.05),0_2px_6px_-1px_rgba(0,0,0,0.04)] hover:shadow-[0_12px_28px_-3px_rgba(198,40,61,0.12)] hover:-translate-y-1 transition-all duration-200 flex flex-col justify-between overflow-hidden group">
                <div>
                    <div class="relative h-48 w-full overflow-hidden bg-surface-container">
                        <img class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" src="https://images.unsplash.com/photo-1615461066841-6116e61058f4?auto=format&fit=crop&w=600&q=80" alt="Giọt Hồng Thanh Niên">
                        <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
                        <div class="absolute top-3.5 left-3.5 right-3.5 flex items-center justify-between">
                            <span class="inline-flex items-center gap-1.5 bg-emerald-50 text-emerald-700 px-3 py-1 rounded-full font-label-sm text-label-sm font-bold shadow-sm">
                                <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                                <span>ĐANG MỞ</span>
                            </span>
                            <span class="inline-flex items-center gap-1 bg-surface-container-lowest/95 backdrop-blur-sm text-on-surface px-2.5 py-1 rounded-full font-label-sm text-label-sm font-semibold shadow-sm">
                                <span class="material-symbols-outlined text-primary text-[15px]">event</span>
                                <span>Còn 5 ngày</span>
                            </span>
                        </div>
                        <div class="absolute bottom-3 left-3.5 right-3.5">
                            <div class="inline-flex items-center gap-1.5 text-on-primary font-label-sm text-label-sm drop-shadow">
                                <span class="material-symbols-outlined text-[16px]">account_balance</span>
                                <span class="truncate">Đoàn Thanh Niên &amp; Viện Huyết học TW</span>
                            </div>
                        </div>
                    </div>
                    <div class="p-5">
                        <h2 class="font-headline-sm text-headline-sm text-on-surface font-bold leading-tight group-hover:text-primary transition-colors mb-2.5 line-clamp-1">
                            Giọt Hồng Thanh Niên – Trao Đời Sự Sống
                        </h2>
                        <div class="space-y-2 mb-4">
                            <div class="flex items-start gap-2 text-on-surface-variant font-body-sm text-body-sm">
                                <span class="material-symbols-outlined text-primary text-[18px] shrink-0 mt-0.5">date_range</span>
                                <span><strong>15/11/2026</strong> - <strong>25/11/2026</strong> (07:30 - 16:30)</span>
                            </div>
                            <div class="flex items-start gap-2 text-on-surface-variant font-body-sm text-body-sm">
                                <span class="material-symbols-outlined text-secondary text-[18px] shrink-0 mt-0.5">pin_drop</span>
                                <span class="line-clamp-1">Cơ sở 218 Lĩnh Nam, Hoàng Mai, Hà Nội</span>
                            </div>
                        </div>
                        <div class="flex flex-wrap items-center gap-1.5 mb-4">
                            <span class="font-label-sm text-label-sm text-secondary uppercase">Ưu tiên:</span>
                            <span class="px-2 py-0.5 bg-primary-fixed text-on-primary-fixed-variant rounded-md font-label-sm text-label-sm font-bold">Nhóm O</span>
                            <span class="px-2 py-0.5 bg-primary-fixed text-on-primary-fixed-variant rounded-md font-label-sm text-label-sm font-bold">Nhóm A</span>
                            <span class="px-2 py-0.5 bg-primary-fixed text-on-primary-fixed-variant rounded-md font-label-sm text-label-sm font-bold">Nhóm B</span>
                            <span class="ml-auto text-on-surface-variant font-label-sm text-label-sm bg-surface-container px-2 py-0.5 rounded-md">≥ 45kg</span>
                        </div>
                        <div class="bg-surface-container-low p-3 rounded-xl mb-2">
                            <div class="flex items-center justify-between font-label-sm text-label-sm mb-1.5">
                                <span class="text-on-surface-variant">Chỉ tiêu tiếp nhận</span>
                                <span class="font-bold text-primary">142/200 đơn vị (71%)</span>
                            </div>
                            <div class="w-full h-2 bg-surface-container rounded-full overflow-hidden">
                                <div class="bg-gradient-to-r from-primary to-primary-container h-full rounded-full transition-all" style="width: 71%"></div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="p-5 pt-0 flex items-center gap-2">
                    <a asp-controller="DotHienMau" asp-action="Details" asp-route-id="1" class="flex-1 text-center py-2.5 rounded-xl font-label-md text-label-md text-on-surface-variant hover:text-primary hover:bg-surface-container transition-all">
                        Xem chi tiết
                    </a>
                    <a asp-controller="DotHienMau" asp-action="Details" asp-route-id="1" class="flex-1 inline-flex items-center justify-center gap-1.5 py-2.5 rounded-xl font-label-md text-label-md bg-gradient-to-r from-primary to-primary-container text-on-primary shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all">
                        <span class="material-symbols-outlined text-[16px]">favorite</span>
                        <span>Đăng ký ngay</span>
                    </a>
                </div>
            </article>

            <!-- CARD 2 (Urgent O-) -->
            <article class="bg-surface-container-lowest rounded-2xl shadow-[0_4px_20px_-2px_rgba(198,40,61,0.05),0_2px_6px_-1px_rgba(0,0,0,0.04)] hover:shadow-[0_12px_28px_-3px_rgba(198,40,61,0.12)] hover:-translate-y-1 transition-all duration-200 flex flex-col justify-between overflow-hidden group">
                <div>
                    <div class="relative h-48 w-full overflow-hidden bg-surface-container">
                        <img class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" src="https://images.unsplash.com/photo-1579154204601-01588f351e67?auto=format&fit=crop&w=600&q=80" alt="Trái Tim Đỏ">
                        <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
                        <div class="absolute top-3.5 left-3.5 right-3.5 flex items-center justify-between">
                            <span class="inline-flex items-center gap-1.5 bg-emerald-50 text-emerald-700 px-3 py-1 rounded-full font-label-sm text-label-sm font-bold shadow-sm">
                                <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                                <span>ĐANG MỞ</span>
                            </span>
                            <span class="inline-flex items-center gap-1 bg-error-container text-on-error-container px-2.5 py-1 rounded-full font-label-sm text-label-sm font-bold shadow-sm animate-pulse">
                                <span class="material-symbols-outlined text-[14px]">emergency</span>
                                <span>Khẩn cấp O-</span>
                            </span>
                        </div>
                        <div class="absolute bottom-3 left-3.5 right-3.5">
                            <div class="inline-flex items-center gap-1.5 text-on-primary font-label-sm text-label-sm drop-shadow">
                                <span class="material-symbols-outlined text-[16px]">local_hospital</span>
                                <span class="truncate">UNETI Minh Khai &amp; BV Chợ Rẫy</span>
                            </div>
                        </div>
                    </div>
                    <div class="p-5">
                        <h2 class="font-headline-sm text-headline-sm text-on-surface font-bold leading-tight group-hover:text-primary transition-colors mb-2.5 line-clamp-1">
                            Trái Tim Đỏ – Chung Tay Vì Người Bệnh
                        </h2>
                        <div class="space-y-2 mb-4">
                            <div class="flex items-start gap-2 text-on-surface-variant font-body-sm text-body-sm">
                                <span class="material-symbols-outlined text-primary text-[18px] shrink-0 mt-0.5">date_range</span>
                                <span><strong>18/11/2026</strong> - <strong>28/11/2026</strong> (07:00 - 16:00)</span>
                            </div>
                            <div class="flex items-start gap-2 text-on-surface-variant font-body-sm text-body-sm">
                                <span class="material-symbols-outlined text-secondary text-[18px] shrink-0 mt-0.5">pin_drop</span>
                                <span class="line-clamp-1">456 Minh Khai, Hai Bà Trưng, Hà Nội</span>
                            </div>
                        </div>
                        <div class="flex flex-wrap items-center gap-1.5 mb-4">
                            <span class="font-label-sm text-label-sm text-secondary uppercase">Ưu tiên:</span>
                            <span class="px-2 py-0.5 bg-error text-on-error rounded-md font-label-sm text-label-sm font-bold">O- (Khẩn cấp)</span>
                            <span class="px-2 py-0.5 bg-primary-fixed text-on-primary-fixed-variant rounded-md font-label-sm text-label-sm font-bold">O+</span>
                            <span class="px-2 py-0.5 bg-primary-fixed text-on-primary-fixed-variant rounded-md font-label-sm text-label-sm font-bold">AB</span>
                            <span class="ml-auto text-on-surface-variant font-label-sm text-label-sm bg-surface-container px-2 py-0.5 rounded-md">≥ 45kg</span>
                        </div>
                        <div class="bg-surface-container-low p-3 rounded-xl mb-2">
                            <div class="flex items-center justify-between font-label-sm text-label-sm mb-1.5">
                                <span class="text-on-surface-variant">Chỉ tiêu tiếp nhận</span>
                                <span class="font-bold text-primary">88/150 đơn vị (58%)</span>
                            </div>
                            <div class="w-full h-2 bg-surface-container rounded-full overflow-hidden">
                                <div class="bg-gradient-to-r from-primary to-primary-container h-full rounded-full transition-all" style="width: 58%"></div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="p-5 pt-0 flex items-center gap-2">
                    <a asp-controller="DotHienMau" asp-action="Details" asp-route-id="2" class="flex-1 text-center py-2.5 rounded-xl font-label-md text-label-md text-on-surface-variant hover:text-primary hover:bg-surface-container transition-all">
                        Xem chi tiết
                    </a>
                    <a asp-controller="DotHienMau" asp-action="Details" asp-route-id="2" class="flex-1 inline-flex items-center justify-center gap-1.5 py-2.5 rounded-xl font-label-md text-label-md bg-gradient-to-r from-primary to-primary-container text-on-primary shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all">
                        <span class="material-symbols-outlined text-[16px]">favorite</span>
                        <span>Đăng ký ngay</span>
                    </a>
                </div>
            </article>

            <!-- CARD 3 -->
