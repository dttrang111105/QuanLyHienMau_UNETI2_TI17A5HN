@* Nguyễn Thị Phương Thảo - 23103100272 - Module 2: Form đợt hiến máu dùng chung *@
@model QuanLyHienMau_UNETI2_TI17A5HN.Models.DotHienMau
<div asp-validation-summary="All" class="text-error" role="alert"></div>
<input type="hidden" asp-for="MaDot" />
<p class="text-on-surface-variant text-sm">Các trường có dấu * là bắt buộc.</p>
<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
<div class="md:col-span-2"><label for="TenDot" class="block mb-2 font-medium text-on-surface">Tên đợt hiến máu *</label><input asp-for="TenDot" class="w-full px-4 py-3 rounded-xl bg-surface-container-low border border-outline-variant focus:outline-none focus:ring-2 focus:ring-primary/30" placeholder="Nhập tên đợt hiến máu" /><span asp-validation-for="TenDot" class="block mt-1 text-sm text-error"></span></div>
<div class=""><label for="MaDonViToChuc" class="block mb-2 font-medium text-on-surface">Đơn vị tổ chức *</label><select asp-for="MaDonViToChuc" data-val-required="Vui lòng chọn đơn vị tổ chức." class="w-full px-4 py-3 rounded-xl bg-surface-container-low border border-outline-variant focus:outline-none focus:ring-2 focus:ring-primary/30"><option value="">Chọn đơn vị tổ chức</option>@foreach (var dv in ViewBag.DonViList) { <option value="@dv.MaDonViToChuc">@dv.TenDonViToChuc</option> }</select><span asp-validation-for="MaDonViToChuc" class="block mt-1 text-sm text-error"></span></div>
<div class=""><label for="NhomMauUuTien" class="block mb-2 font-medium text-on-surface">Nhóm máu ưu tiên</label><select asp-for="NhomMauUuTien" class="w-full px-4 py-3 rounded-xl bg-surface-container-low border border-outline-variant focus:outline-none focus:ring-2 focus:ring-primary/30"><option value="">Không ưu tiên</option>@if (!string.IsNullOrWhiteSpace(Model.NhomMauUuTien) && !QuanLyHienMau_UNETI2_TI17A5HN.Models.DotHienMau.NhomMauOptions.Contains(Model.NhomMauUuTien)) { <option value="@Model.NhomMauUuTien">@Model.NhomMauUuTien</option> }@foreach (var group in QuanLyHienMau_UNETI2_TI17A5HN.Models.DotHienMau.NhomMauOptions) { <option value="@group">@group</option> }</select><span asp-validation-for="NhomMauUuTien" class="block mt-1 text-sm text-error"></span></div>
<div class=""><label for="ChiTieuDonViMau" class="block mb-2 font-medium text-on-surface">Chỉ tiêu đơn vị máu *</label><input asp-for="ChiTieuDonViMau" type="number" min="1" data-msg-min="Chỉ tiêu đơn vị máu phải lớn hơn 0." data-msg-number="Vui lòng nhập số hợp lệ." class="w-full px-4 py-3 rounded-xl bg-surface-container-low border border-outline-variant focus:outline-none focus:ring-2 focus:ring-primary/30" /><span asp-validation-for="ChiTieuDonViMau" class="block mt-1 text-sm text-error"></span></div>
<div class=""><label for="CanNangToiThieu" class="block mb-2 font-medium text-on-surface">Cân nặng tối thiểu (kg) *</label><input asp-for="CanNangToiThieu" type="number" min="0" step="0.1" data-msg-min="Cân nặng tối thiểu phải lớn hơn hoặc bằng 0." data-msg-number="Vui lòng nhập số hợp lệ." class="w-full px-4 py-3 rounded-xl bg-surface-container-low border border-outline-variant focus:outline-none focus:ring-2 focus:ring-primary/30" /><span asp-validation-for="CanNangToiThieu" class="block mt-1 text-sm text-error"></span></div>
<div class=""><label for="NgayBatDauDangKy" class="block mb-2 font-medium text-on-surface">Ngày bắt đầu đăng ký *</label><input asp-for="NgayBatDauDangKy" type="date"  class="w-full px-4 py-3 rounded-xl bg-surface-container-low border border-outline-variant focus:outline-none focus:ring-2 focus:ring-primary/30" /><span asp-validation-for="NgayBatDauDangKy" class="block mt-1 text-sm text-error"></span></div>
<div class=""><label for="HanDangKy" class="block mb-2 font-medium text-on-surface">Hạn đăng ký *</label><input asp-for="HanDangKy" type="date"  class="w-full px-4 py-3 rounded-xl bg-surface-container-low border border-outline-variant focus:outline-none focus:ring-2 focus:ring-primary/30" /><span asp-validation-for="HanDangKy" class="block mt-1 text-sm text-error"></span></div>
<div class="md:col-span-2"><label for="MoTaDot" class="block mb-2 font-medium text-on-surface">Mô tả đợt hiến máu</label><textarea asp-for="MoTaDot" rows="4" class="w-full px-4 py-3 rounded-xl bg-surface-container-low border border-outline-variant focus:outline-none focus:ring-2 focus:ring-primary/30"></textarea><span asp-validation-for="MoTaDot" class="block mt-1 text-sm text-error"></span></div>
<div class="md:col-span-2"><label for="DieuKienNguoiHien" class="block mb-2 font-medium text-on-surface">Điều kiện người hiến máu</label><textarea asp-for="DieuKienNguoiHien" rows="4" class="w-full px-4 py-3 rounded-xl bg-surface-container-low border border-outline-variant focus:outline-none focus:ring-2 focus:ring-primary/30"></textarea><span asp-validation-for="DieuKienNguoiHien" class="block mt-1 text-sm text-error"></span></div>
</div>