<div class="space-y-2"><label asp-for="TenDangNhap" class="font-label-md text-on-surface font-semibold">Tên đăng nhập</label><div class="relative"><span class="material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-secondary text-[20px]">person</span><input asp-for="TenDangNhap" autocomplete="username" class="w-full h-12 pl-11 pr-4 rounded-xl border border-outline-variant focus:border-primary focus:ring-2 focus:ring-primary/20 font-body-md text-on-surface bg-surface-container-lowest" required autofocus/></div><span asp-validation-for="TenDangNhap" class="text-error text-xs"></span></div>
<div class="space-y-2"><label asp-for="MatKhau" class="font-label-md text-on-surface font-semibold">Mật khẩu</label><div class="relative"><span class="material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-secondary text-[20px]">lock</span><input asp-for="MatKhau" type="password" autocomplete="current-password" class="w-full h-12 pl-11 pr-12 rounded-xl border border-outline-variant focus:border-primary focus:ring-2 focus:ring-primary/20 font-body-md text-on-surface bg-surface-container-lowest" required/><button type="button" aria-label="Hiện mật khẩu" class="absolute right-3 top-3 text-secondary" onclick="const p=document.getElementById('MatKhau');p.type=p.type==='password'?'text':'password'"><span class="material-symbols-outlined">visibility</span></button></div><span asp-validation-for="MatKhau" class="text-error text-xs"></span></div>
<button class="w-full py-3.5 px-6 rounded-xl bg-primary-container hover:bg-primary text-on-primary font-label-lg font-bold flex items-center justify-center gap-2 shadow-md shadow-primary/25" type="submit"><span class="material-symbols-outlined text-[20px]">login</span>Đăng nhập</button>
