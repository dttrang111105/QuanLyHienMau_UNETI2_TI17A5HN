                            <circle cx="0" cy="12" fill="currentColor" r="2.5"></circle>
                            <circle cx="33" cy="10" fill="currentColor" r="2.5"></circle>
                            <circle cx="66" cy="14" fill="currentColor" r="2.5"></circle>
                            <circle cx="100" cy="11" fill="currentColor" r="3.5"></circle>
