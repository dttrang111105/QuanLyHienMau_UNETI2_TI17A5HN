@*
    ============================================================================
    DỰ ÁN QUẢN LÝ HIẾN MÁU NHÂN ĐẠO VITALIS - UNETI (TI17A5HN)
    MODULE 3: QUẢN LÝ NGƯỜI HIẾN MÁU & PHIẾU ĐĂNG KÝ HIẾN MÁU
    Màn hình: Hồ sơ cá nhân người hiến máu & Chứng nhận điện tử
    ============================================================================
*@
@model QuanLyHienMau_UNETI2_TI17A5HN.Models.NguoiHienMau

@{
    ViewData["Title"] = "Hồ Sơ Người Hiến Máu & Chứng Nhận Điện Tử";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var phieuList = Model?.PhieuDangKyHienMaus?.OrderByDescending(p => p.NgayNop).ToList() ?? new List<QuanLyHienMau_UNETI2_TI17A5HN.Models.PhieuDangKyHienMau>();
    var successfulDonations = phieuList.Where(p => p.TrangThai == "Hiến máu thành công" || p.KetQuaHienMau?.KetQua == "Hiến máu thành công").ToList();
    var totalCount = successfulDonations.Count > 0 ? successfulDonations.Count : phieuList.Count(p => p.TrangThai != "Đã hủy");
    var totalVolume = totalCount * 350;
    var peopleSaved = totalCount * 3;

    var latestDonation = successfulDonations.FirstOrDefault() ?? phieuList.FirstOrDefault();
    var latestDateStr = latestDonation?.NgayNop.ToString("dd/MM/yyyy") ?? "Chưa có";
    var latestDotName = latestDonation?.DotHienMau?.TenDot ?? "Chưa tham gia đợt nào";

    var age = Model?.NgaySinh.HasValue == true ? (DateTime.Now.Year - Model.NgaySinh.Value.Year) : 23;
    var nhomMauDisplay = string.IsNullOrEmpty(Model?.NhomMau) ? "O Rh(+)" : Model.NhomMau;
    var rankName = totalCount >= 5 ? "Huy Hiệu Vàng" : totalCount >= 3 ? "Huy Hiệu Bạc" : totalCount >= 1 ? "Huy Hiệu Đồng" : "Thành Viên Mới";
    var rankBadge = totalCount >= 5 ? "Vàng" : totalCount >= 3 ? "Bạc" : totalCount >= 1 ? "Đồng" : "Mới";
}

<div class="flex flex-col w-full pb-12">
    <!-- ALERT NOTIFICATIONS -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="w-full max-w-[1366px] mx-auto px-4 sm:px-6 lg:px-8 pt-4">
            <div class="p-4 rounded-2xl bg-emerald-50 border border-emerald-200 text-emerald-800 flex items-center gap-3 shadow-sm">
                <span class="material-symbols-outlined text-emerald-600 text-[24px]">check_circle</span>
                <span class="font-body-md text-sm font-semibold">@TempData["SuccessMessage"]</span>
            </div>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="w-full max-w-[1366px] mx-auto px-4 sm:px-6 lg:px-8 pt-4">
            <div class="p-4 rounded-2xl bg-rose-50 border border-rose-200 text-rose-800 flex items-center gap-3 shadow-sm">
                <span class="material-symbols-outlined text-rose-600 text-[24px]">error</span>
                <span class="font-body-md text-sm font-semibold">@TempData["ErrorMessage"]</span>
            </div>
        </div>
    }

    <!-- BREADCRUMB & PAGE HEADER -->
    <div class="w-full max-w-[1366px] mx-auto px-4 sm:px-6 lg:px-8 pt-6 pb-4">
        <!-- Breadcrumb -->
        <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-on-surface-variant font-body-sm text-xs sm:text-sm mb-3">
            <a asp-controller="Home" asp-action="Index" class="hover:text-primary transition-colors flex items-center gap-1">
                <span class="material-symbols-outlined text-[16px]">home</span>
                <span>Trang chủ</span>
            </a>
            <span class="material-symbols-outlined text-[14px]">chevron_right</span>
            <span class="hover:text-primary transition-colors">Cổng tình nguyện viên</span>
            <span class="material-symbols-outlined text-[14px]">chevron_right</span>
            <span class="font-title-md text-on-surface font-semibold">Hồ sơ &amp; Giấy chứng nhận điện tử</span>
        </nav>

        <!-- Header Actions Stack -->
        <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4">
            <div class="flex flex-col gap-1 max-w-3xl">
                <div class="flex items-center gap-2">
                    <span class="material-symbols-outlined text-primary text-[28px]" style="font-variation-settings: 'FILL' 1;">verified</span>
                    <h1 class="font-headline-lg text-xl sm:text-2xl lg:text-3xl text-on-surface tracking-tight font-extrabold">Hồ Sơ Người Hiến Máu &amp; Chứng Nhận Điện Tử</h1>
                </div>
                <p class="font-body-md text-sm sm:text-base text-on-surface-variant">
                    Quản lý hành trình trao tặng sự sống, tra cứu kết quả xét nghiệm an toàn sinh học và giấy chứng nhận hiến máu tình nguyện tích hợp VNeID.
                </p>
            </div>
            <!-- Action Buttons -->
            <div class="flex flex-wrap items-center gap-2 sm:gap-3 shrink-0">
                <button onclick="openEditProfileModal()" class="bg-surface-container-high hover:bg-surface-container text-on-surface font-label-lg text-sm px-4 py-2.5 rounded-xl shadow-sm flex items-center gap-2 transition-colors cursor-pointer border border-outline-variant/40">
                    <span class="material-symbols-outlined text-[20px] text-primary">edit</span>
                    <span>Cập nhật hồ sơ</span>
                </button>
                <a asp-controller="DotHienMau" asp-action="Index" class="bg-primary hover:bg-primary-container text-on-primary font-label-lg text-sm px-4 py-2.5 rounded-xl shadow-md flex items-center gap-2 transition-all duration-200 hover:-translate-y-0.5 active:translate-y-0 cursor-pointer">
                    <span class="material-symbols-outlined text-[20px]">bloodtype</span>
                    <span>Đăng ký đợt hiến mới</span>
                </a>
                <button onclick="downloadCertificate()" class="bg-surface-container-lowest hover:bg-surface-container-high text-on-surface font-label-lg text-sm px-4 py-2.5 rounded-xl shadow-sm flex items-center gap-2 transition-colors cursor-pointer border border-outline-variant/40">
                    <span class="material-symbols-outlined text-[20px] text-primary">download</span>
                    <span>Tải chứng nhận (ZIP/PDF)</span>
                </button>
                <button onclick="shareBadge()" class="bg-surface-container-low hover:bg-surface-container text-primary font-label-lg text-sm px-4 py-2.5 rounded-xl flex items-center gap-2 transition-colors cursor-pointer">
                    <span class="material-symbols-outlined text-[20px]">share</span>
                    <span>Chia sẻ huy hiệu</span>
                </button>
            </div>
        </div>
    </div>

    <!-- DONOR PROFILE BANNER -->
    <div class="w-full max-w-[1366px] mx-auto px-4 sm:px-6 lg:px-8 mb-6">
        <div class="bg-surface-container-lowest rounded-2xl shadow-md p-5 sm:p-6 border border-surface-container-high/60">
            <div class="flex flex-col xl:flex-row items-stretch xl:items-center justify-between gap-6">
                <!-- Part 1: Avatar & Personal Identity Details -->
                <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4 sm:gap-5 flex-1 min-w-0">
                    <!-- Avatar Frame with Badge -->
                    <div class="relative shrink-0">
                        <div class="w-20 h-20 sm:w-24 sm:h-24 rounded-2xl overflow-hidden shadow-md bg-surface-container border-2 border-white">
                            <img class="w-full h-full object-cover" src="~/images/donor_portrait.png" onerror="this.src='/images/hero_donor.png'" alt="Chân dung người hiến máu tình nguyện">
                        </div>
                        <div class="absolute -bottom-1.5 -right-1.5 bg-secondary text-on-secondary px-2 py-0.5 rounded-full font-label-sm text-[11px] shadow flex items-center gap-1">
                            <span class="material-symbols-outlined text-[13px]">military_tech</span>
                            <span>@rankBadge (@totalCount lần)</span>
                        </div>
                    </div>
                    <!-- Identity Details -->
                    <div class="flex flex-col gap-1 min-w-0">
                        <div class="flex flex-wrap items-center gap-2">
                            <h2 class="font-headline-md text-xl sm:text-2xl text-on-surface font-extrabold truncate">@(Model?.HoTen ?? "Người Hiến Máu")</h2>
                            <div class="inline-flex items-center gap-1 bg-surface-container-high px-2 py-0.5 rounded-md text-on-surface">
                                <span class="material-symbols-outlined text-[16px] text-primary" style="font-variation-settings: 'FILL' 1;">verified_user</span>
                                <span class="font-label-sm text-xs font-semibold">Đã định danh VNeID Mức 2</span>
                            </div>
                        </div>
                        <div class="flex flex-wrap items-center gap-x-3 gap-y-1 font-body-sm text-xs sm:text-sm text-on-surface-variant mt-0.5">
                            <span class="font-medium text-on-surface">Mã định danh: <span class="font-mono font-bold">#NHM-@(Model?.MaNguoiHien.ToString("D5") ?? "00001")</span></span>
                            <span>•</span>
                            <span>@(Model?.NgaySinh?.ToString("dd/MM/yyyy") ?? "Chưa cập nhật") (@age tuổi)</span>
                            <span>•</span>
                            <span>@(Model?.GioiTinh ?? "Nam")</span>
                            <span>•</span>
                            <span class="flex items-center gap-1"><span class="material-symbols-outlined text-[14px] text-primary">call</span>@(Model?.SoDienThoai ?? "Chưa có SĐT")</span>
                            <span>•</span>
                            <span class="flex items-center gap-1 truncate"><span class="material-symbols-outlined text-[14px] text-primary">mail</span>@(Model?.Email ?? "Chưa có Email")</span>
                        </div>
                        <div class="flex items-center gap-1.5 text-on-surface-variant font-body-sm text-xs sm:text-sm mt-1">
                            <span class="material-symbols-outlined text-[16px] text-primary shrink-0">event_available</span>
                            <span class="truncate">Đợt hiến gần nhất: <strong class="text-on-surface font-semibold">@latestDateStr</strong> tại <span class="italic">@latestDotName</span></span>
                        </div>
                    </div>
                </div>

                <!-- Part 2 & Part 3: Blood Type Card + Donation Next Date -->
                <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 shrink-0">
                    <!-- Part 2: Blood Type Card -->
                    <div class="bg-primary-fixed text-on-primary-fixed rounded-2xl p-4 flex flex-col items-center justify-center min-w-[140px] shadow-sm text-center border border-primary-fixed-dim">
                        <span class="font-label-sm text-xs text-primary uppercase font-bold tracking-wider">Nhóm Máu ABO/Rh</span>
                        <span class="font-display-hero text-3xl sm:text-4xl leading-tight font-extrabold text-primary my-0.5">@nhomMauDisplay</span>
                        <span class="font-label-sm text-[11px] text-on-primary-fixed-variant bg-surface-container-lowest/90 px-2 py-0.5 rounded-full font-semibold">Phổ biến &amp; Cấp cứu</span>
                    </div>

                    <!-- Part 3: Next Donation Eligibility Cooldown Box -->
                    <div class="bg-surface-container-low rounded-2xl p-4 flex flex-col justify-between sm:w-72 lg:w-80 border border-surface-container-high/60 shadow-sm">
                        <div class="flex items-start justify-between gap-2 mb-1">
                            <div class="flex items-center gap-1 text-primary">
                                <span class="material-symbols-outlined text-[18px]">timelapse</span>
                                <span class="font-label-md text-xs sm:text-sm font-bold">Chu kỳ hiến tiếp theo</span>
                            </div>
                            <span class="bg-secondary-fixed text-on-secondary-fixed font-label-sm text-xs px-2 py-0.5 rounded font-bold">Sẵn sàng</span>
                        </div>
                        <p class="font-body-sm text-xs sm:text-sm text-on-surface-variant leading-relaxed">
                            Đủ điều kiện hiến đợt tiếp theo.
                            <span class="block text-[11px] text-on-surface-variant/80 mt-0.5">Quy chuẩn khoảng cách: <strong class="text-on-surface font-semibold">84 ngày theo Bộ Y Tế</strong></span>
                        </p>
                        <!-- Progress Bar -->
                        <div class="w-full bg-surface-container-high h-2 rounded-full overflow-hidden mt-2">
                            <div class="bg-primary h-full rounded-full transition-all duration-500" style="width: 100%;"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- IMPACT METRICS: 4 METRIC CARDS -->
    <div class="w-full max-w-[1366px] mx-auto px-4 sm:px-6 lg:px-8 mb-6">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            <!-- Metric 1: Total Donations -->
            <div class="bg-surface-container-lowest rounded-2xl p-4 sm:p-5 shadow-sm border border-surface-container flex items-center justify-between group hover:shadow-md transition-shadow">
                <div class="flex flex-col">
                    <span class="font-label-sm text-xs text-on-surface-variant uppercase font-semibold">Tổng số lần hiến</span>
                    <div class="flex items-baseline gap-1 mt-1">
                        <span class="font-display-hero text-2xl sm:text-3xl font-extrabold text-primary">@totalCount.ToString("D2")</span>
                        <span class="font-label-md text-xs sm:text-sm text-on-surface-variant font-bold">lần</span>
                    </div>
                    <span class="font-body-sm text-xs text-on-surface-variant mt-1">Đã trao tặng @totalVolume.ToString("N0") mL máu</span>
                </div>
                <div class="w-12 h-12 rounded-xl bg-primary-fixed flex items-center justify-center text-primary group-hover:scale-105 transition-transform shrink-0">
                    <span class="material-symbols-outlined text-[26px]" style="font-variation-settings: 'FILL' 1;">volunteer_activism</span>
                </div>
            </div>

            <!-- Metric 2: Estimated Lives Impacted -->
            <div class="bg-surface-container-lowest rounded-2xl p-4 sm:p-5 shadow-sm border border-surface-container flex items-center justify-between group hover:shadow-md transition-shadow">
                <div class="flex flex-col">
                    <span class="font-label-sm text-xs text-on-surface-variant uppercase font-semibold">Bệnh nhân được tiếp sức</span>
                    <div class="flex items-baseline gap-1 mt-1">
                        <span class="font-display-hero text-2xl sm:text-3xl font-extrabold text-tertiary">@peopleSaved.ToString("D2")</span>
                        <span class="font-label-md text-xs sm:text-sm text-on-surface-variant font-bold">người</span>
                    </div>
                    <span class="font-body-sm text-xs text-on-surface-variant mt-1">Quy đổi: 1 túi cứu 3 sinh mệnh</span>
                </div>
                <div class="w-12 h-12 rounded-xl bg-secondary-fixed flex items-center justify-center text-tertiary group-hover:scale-105 transition-transform shrink-0">
                    <span class="material-symbols-outlined text-[26px]" style="font-variation-settings: 'FILL' 1;">cardiology</span>
                </div>
            </div>

            <!-- Metric 3: Contribution Rank Badge -->
            <div class="bg-surface-container-lowest rounded-2xl p-4 sm:p-5 shadow-sm border border-surface-container flex items-center justify-between group hover:shadow-md transition-shadow">
                <div class="flex flex-col">
                    <span class="font-label-sm text-xs text-on-surface-variant uppercase font-semibold">Hạng cống hiến</span>
                    <div class="flex items-center gap-1.5 mt-1">
                        <span class="font-headline-md text-lg sm:text-xl font-extrabold text-on-surface">@rankName</span>
                    </div>
                    <span class="font-body-sm text-xs text-primary font-semibold mt-1">Đóng góp tích cực cho cộng đồng</span>
                </div>
                <div class="w-12 h-12 rounded-xl bg-surface-container flex items-center justify-center text-secondary group-hover:scale-105 transition-transform shrink-0">
                    <span class="material-symbols-outlined text-[26px]" style="font-variation-settings: 'FILL' 1;">military_tech</span>
                </div>
            </div>

            <!-- Metric 4: Biological Safety Score -->
            <div class="bg-surface-container-lowest rounded-2xl p-4 sm:p-5 shadow-sm border border-surface-container flex items-center justify-between group hover:shadow-md transition-shadow">
                <div class="flex flex-col">
                    <span class="font-label-sm text-xs text-on-surface-variant uppercase font-semibold">An toàn sinh học</span>
                    <div class="flex items-baseline gap-1 mt-1">
                        <span class="font-display-hero text-2xl sm:text-3xl font-extrabold text-primary">100%</span>
                        <span class="font-label-md text-xs sm:text-sm text-on-surface-variant font-bold">chuẩn y tế</span>
                    </div>
                    <span class="font-body-sm text-xs text-on-surface-variant mt-1">NAT &amp; ELISA âm tính hoàn toàn</span>
                </div>
                <div class="w-12 h-12 rounded-xl bg-surface-container-low flex items-center justify-center text-primary group-hover:scale-105 transition-transform shrink-0">
                    <span class="material-symbols-outlined text-[26px]">health_and_safety</span>
                </div>
            </div>
        </div>
    </div>

    <!-- MAIN 2-COLUMN SECTION: TỶ LỆ CỘT 60% (LỊCH SỬ HIẾN MÁU) / 40% (GIẤY CHỨNG NHẬN) -->
    <div class="w-full max-w-[1366px] mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-5 gap-6 items-start">
            <!-- LEFT COLUMN: 3 COLS (~60%) -> Tabs, Donation History, Live Blood Journey & Lab Results -->
            <div class="lg:col-span-3 flex flex-col gap-6 w-full">
                <!-- Interactive Tabs Container -->
                <div class="bg-surface-container-lowest rounded-2xl shadow-sm p-5 sm:p-6 border border-surface-container">
                    <!-- Tab Navigation -->
                    <div class="flex items-center gap-2 pb-4 overflow-x-auto border-b border-surface-container">
                        <button id="btn-tab-history" onclick="switchDonorTab('history')" class="bg-primary text-on-primary font-label-md text-sm px-4 py-2.5 rounded-xl shrink-0 transition-colors shadow-sm flex items-center gap-1.5 cursor-pointer font-bold">
                            <span class="material-symbols-outlined text-[18px]">history_edu</span>
                            <span>Lịch sử đăng ký / hiến máu (@phieuList.Count)</span>
                        </button>
                        <button id="btn-tab-journey" onclick="switchDonorTab('journey')" class="bg-surface-container-low hover:bg-surface-container text-on-surface font-label-md text-sm px-4 py-2.5 rounded-xl shrink-0 transition-colors flex items-center gap-1.5 cursor-pointer font-semibold">
                            <span class="material-symbols-outlined text-[18px] text-primary">timeline</span>
                            <span>Hành trình giọt máu</span>
                        </button>
                        <button id="btn-tab-lab" onclick="switchDonorTab('lab')" class="bg-surface-container-low hover:bg-surface-container text-on-surface font-label-md text-sm px-4 py-2.5 rounded-xl shrink-0 transition-colors flex items-center gap-1.5 cursor-pointer font-semibold">
                            <span class="material-symbols-outlined text-[18px] text-primary">biotech</span>
                            <span>Hồ sơ xét nghiệm</span>
                        </button>
                    </div>

                    <!-- TAB 1: DONATION HISTORY LIST -->
                    <div id="tab-content-history" class="flex flex-col gap-4 mt-4">
                        @if (phieuList.Count == 0)
                        {
                            <div class="p-8 text-center bg-surface-container-low rounded-2xl border border-surface-container">
                                <span class="material-symbols-outlined text-outline text-[48px]">volunteer_activism</span>
                                <h3 class="font-headline-sm text-base text-on-surface font-bold mt-2">Bạn chưa đăng ký đợt hiến máu nào</h3>
                                <p class="font-body-sm text-xs text-on-surface-variant mt-1">Hãy tham gia đăng ký đợt hiến máu gần nhất để trao tặng sự sống cho cộng đồng.</p>
                                <a asp-controller="DotHienMau" asp-action="Index" class="mt-4 inline-flex items-center gap-2 bg-primary text-on-primary px-4 py-2 rounded-xl text-xs font-bold shadow hover:bg-primary-container transition-all">
                                    <span class="material-symbols-outlined text-[18px]">bloodtype</span>
                                    <span>Xem danh sách đợt hiến máu</span>
                                </a>
                            </div>
                        }
                        else
                        {
                            @for (int i = 0; i < phieuList.Count; i++)
                            {
                                var item = phieuList[i];
                                var isFirst = i == 0;
                                var statusClass = item.TrangThai == "Hiến máu thành công" ? "bg-emerald-100 text-emerald-800" :
                                                  item.TrangThai == "Đã hủy" ? "bg-rose-100 text-rose-800" :
                                                  item.TrangThai == "Chờ xác nhận" ? "bg-amber-100 text-amber-800" :
                                                  "bg-blue-100 text-blue-800";

                                <div class="bg-surface-container-low rounded-2xl p-4 sm:p-5 relative overflow-hidden transition-all duration-200 hover:shadow-md border @(isFirst ? "border-primary/20" : "border-surface-container")">
                                    <div class="flex items-start justify-between gap-2 flex-wrap">
                                        <div class="flex items-center gap-2">
                                            <span class="bg-primary text-on-primary font-label-md text-xs px-2.5 py-1 rounded-lg font-bold">Lần @(phieuList.Count - i)</span>
                                            <span class="font-title-md text-sm sm:text-base text-on-surface font-extrabold">@(item.DotHienMau?.TenDot ?? "Đợt hiến máu nhân đạo")</span>
                                        </div>
                                        <div class="flex items-center gap-2">
                                            <span class="px-2.5 py-1 rounded-full font-label-sm text-xs font-bold @statusClass">
                                                @item.TrangThai
                                            </span>
                                            <span class="bg-surface-container-high text-on-surface font-label-sm text-xs px-2.5 py-1 rounded-full flex items-center gap-1 font-semibold">
                                                <span>@item.NgayNop.ToString("dd/MM/yyyy")</span>
                                            </span>
                                        </div>
                                    </div>
                                    <!-- Metadata Grid -->
                                    <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 sm:gap-3 my-3 bg-surface-container-lowest/90 p-3 rounded-xl border border-surface-container">
                                        <div class="flex flex-col">
                                            <span class="font-body-sm text-[11px] text-on-surface-variant">Mã phiếu</span>
                                            <span class="font-label-md text-xs sm:text-sm font-mono text-primary font-bold">#DKHM-@item.MaPhieu.ToString("D5")</span>
                                        </div>
                                        <div class="flex flex-col">
                                            <span class="font-body-sm text-[11px] text-on-surface-variant">Đơn vị tiếp nhận</span>
                                            <span class="font-title-md text-xs sm:text-sm text-on-surface font-bold truncate">@(item.DotHienMau?.DonViToChuc?.TenDonViToChuc ?? "UNETI")</span>
                                        </div>
                                        <div class="flex flex-col">
                                            <span class="font-body-sm text-[11px] text-on-surface-variant">Nhóm máu</span>
                                            <span class="font-title-md text-xs sm:text-sm text-primary font-bold">@nhomMauDisplay</span>
                                        </div>
                                        <div class="flex flex-col">
                                            <span class="font-body-sm text-[11px] text-on-surface-variant">Kết quả lâm sàng</span>
                                            <span class="font-title-md text-xs sm:text-sm text-on-surface font-bold">@(item.KetQuaHienMau?.KetQua ?? item.TrangThai)</span>
                                        </div>
                                    </div>
                                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pt-1">
                                        <div class="flex items-center gap-1.5 text-on-surface">
                                            <span class="material-symbols-outlined text-[18px] text-primary" style="font-variation-settings: 'FILL' 1;">task_alt</span>
                                            <span class="font-body-sm text-xs sm:text-sm font-medium">@(item.LyDoHienMau ?? "Đã đăng ký tham gia chương trình")</span>
                                        </div>
                                        <div class="flex items-center gap-2 shrink-0">
                                            <a asp-controller="DangKy" asp-action="TheoDoi" asp-route-id="@item.MaPhieu" class="bg-primary text-on-primary font-label-sm text-xs px-3 py-1.5 rounded-lg flex items-center gap-1 hover:bg-primary-container transition-colors cursor-pointer font-semibold">
                                                <span class="material-symbols-outlined text-[16px]">visibility</span>
                                                <span>Chi tiết phiếu</span>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                    </div>

                    <!-- TAB 2: LIVE BLOOD JOURNEY -->
                    <div id="tab-content-journey" class="hidden flex-col gap-4 mt-4">
                        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                            <div class="flex items-center gap-2">
                                <span class="material-symbols-outlined text-primary text-[24px]">route</span>
                                <h3 class="font-headline-md text-base sm:text-lg text-on-surface font-bold">Hành Trình Giọt Máu Của Bạn</h3>
                            </div>
                            <span class="font-label-md text-xs sm:text-sm font-mono text-primary bg-primary-fixed px-2.5 py-0.5 rounded-md font-bold">Mã hồ sơ: #NHM-@(Model?.MaNguoiHien.ToString("D5") ?? "00001")</span>
                        </div>
                        <p class="font-body-sm text-xs sm:text-sm text-on-surface-variant mb-2">
                            Hệ thống phân tách và vận chuyển máu thời gian thực theo tiêu chuẩn quản lý ngân hàng máu quốc gia.
                        </p>

                        <!-- Stepper Flow -->
                        <div class="relative pl-6 flex flex-col gap-5">
                            <div class="absolute left-2.5 top-3 bottom-3 w-0.5 bg-surface-container-high"></div>

                            <!-- Step 1 -->
                            <div class="relative flex items-start gap-4">
                                <div class="absolute -left-6 top-0 w-6 h-6 rounded-full bg-primary text-on-primary flex items-center justify-center shadow-sm">
                                    <span class="material-symbols-outlined text-[14px]">check</span>
                                </div>
                                <div class="flex flex-col">
                                    <div class="flex items-center gap-2">
                                        <span class="font-title-md text-sm sm:text-base text-on-surface font-bold">Tiếp nhận &amp; Lấy máu toàn phần</span>
                                        <span class="font-label-sm text-xs text-primary font-semibold">@latestDateStr</span>
                                    </div>
                                    <p class="font-body-sm text-xs sm:text-sm text-on-surface-variant mt-0.5">
                                        Thực hiện tại Điểm tiếp nhận @latestDotName. Quy trình đảm bảo tuyệt đối an toàn vô trùng.
                                    </p>
                                </div>
                            </div>

                            <!-- Step 2 -->
                            <div class="relative flex items-start gap-4">
                                <div class="absolute -left-6 top-0 w-6 h-6 rounded-full bg-primary text-on-primary flex items-center justify-center shadow-sm">
                                    <span class="material-symbols-outlined text-[14px]">check</span>
                                </div>
                                <div class="flex flex-col">
                                    <div class="flex items-center gap-2">
                                        <span class="font-title-md text-sm sm:text-base text-on-surface font-bold">Xét nghiệm sinh học sàng lọc (NAT &amp; ELISA)</span>
                                        <span class="font-label-sm text-xs text-primary font-semibold">Chuẩn Quốc Gia</span>
                                    </div>
                                    <p class="font-body-sm text-xs sm:text-sm text-on-surface-variant mt-0.5">
                                        Tại Lab kiểm định ISO 15189. Kết quả: Âm tính HIV, HBV, HCV, Giang mai, Sốt rét.
                                    </p>
                                </div>
                            </div>

                            <!-- Step 3 -->
                            <div class="relative flex items-start gap-4">
                                <div class="absolute -left-6 top-0 w-6 h-6 rounded-full bg-primary text-on-primary flex items-center justify-center shadow-sm">
                                    <span class="material-symbols-outlined text-[14px]">check</span>
                                </div>
                                <div class="flex flex-col">
                                    <div class="flex items-center gap-2">
                                        <span class="font-title-md text-sm sm:text-base text-on-surface font-bold">Nhập kho lạnh bảo quản trung tâm (2°C - 6°C)</span>
                                        <span class="font-label-sm text-xs text-primary font-semibold">Kho Lưu Trữ</span>
                                    </div>
                                    <p class="font-body-sm text-xs sm:text-sm text-on-surface-variant mt-0.5">
                                        Phân tách thành Khối hồng cầu, Huyết tương đông lạnh và Khối tiểu cầu.
                                    </p>
                                </div>
                            </div>

                            <!-- Step 4 -->
                            <div class="relative flex items-start gap-4">
                                <div class="absolute -left-6 top-0 w-6 h-6 rounded-full bg-tertiary text-on-tertiary flex items-center justify-center shadow-sm">
                                    <span class="material-symbols-outlined text-[14px]">local_shipping</span>
                                </div>
                                <div class="flex flex-col">
                                    <div class="flex items-center gap-2">
                                        <span class="font-title-md text-sm sm:text-base text-tertiary font-bold">Điều phối tới các cơ sở y tế tuyến đầu</span>
                                        <span class="bg-secondary-fixed text-on-secondary-fixed font-label-sm text-[11px] px-2 py-0.5 rounded-full font-bold">Sẵn sàng</span>
                                    </div>
                                    <p class="font-body-sm text-xs sm:text-sm text-on-surface-variant mt-0.5">
                                        Sẵn sàng phục vụ cấp cứu và điều trị cho các bệnh nhân nặng.
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- TAB 3: LAB RESULTS -->
                    <div id="tab-content-lab" class="hidden flex-col gap-4 mt-4">
                        <div class="flex items-center justify-between">
                            <h4 class="font-title-md text-sm sm:text-base font-bold text-on-surface">Kết Quả Xét Nghiệm Sinh Học Lâm Sàng</h4>
                            <span class="bg-emerald-100 text-emerald-800 font-label-sm text-xs px-2.5 py-1 rounded-full font-bold">Chuẩn ISO 15189</span>
                        </div>
                        <div class="overflow-x-auto">
                            <table class="w-full text-left font-body-sm text-xs sm:text-sm">
                                <thead class="bg-surface-container text-on-surface font-label-md">
                                    <tr>
                                        <th class="p-3 rounded-l-lg">Chỉ tiêu xét nghiệm</th>
                                        <th class="p-3">Phương pháp</th>
                                        <th class="p-3">Ngưỡng tham chiếu</th>
                                        <th class="p-3">Kết quả</th>
                                        <th class="p-3 rounded-r-lg">Đánh giá</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-surface-container">
                                    <tr>
                                        <td class="p-3 font-semibold">Kháng nguyên HIV Ag/Ab combo</td>
                                        <td class="p-3 text-secondary">ELISA thế hệ 4</td>
                                        <td class="p-3 text-secondary">S/CO &lt; 1.0</td>
                                        <td class="p-3 font-mono font-bold text-emerald-700">Âm tính</td>
                                        <td class="p-3"><span class="px-2 py-0.5 rounded bg-emerald-50 text-emerald-700 font-bold text-xs">Đạt</span></td>
                                    </tr>
                                    <tr>
                                        <td class="p-3 font-semibold">Kháng nguyên HBsAg (Viêm gan B)</td>
                                        <td class="p-3 text-secondary">NAT Nucleic Acid</td>
                                        <td class="p-3 text-secondary">Âm tính</td>
                                        <td class="p-3 font-mono font-bold text-emerald-700">Âm tính</td>
                                        <td class="p-3"><span class="px-2 py-0.5 rounded bg-emerald-50 text-emerald-700 font-bold text-xs">Đạt</span></td>
                                    </tr>
                                    <tr>
                                        <td class="p-3 font-semibold">Kháng thể HCV Ab (Viêm gan C)</td>
                                        <td class="p-3 text-secondary">NAT Nucleic Acid</td>
                                        <td class="p-3 text-secondary">Âm tính</td>
                                        <td class="p-3 font-mono font-bold text-emerald-700">Âm tính</td>
                                        <td class="p-3"><span class="px-2 py-0.5 rounded bg-emerald-50 text-emerald-700 font-bold text-xs">Đạt</span></td>
                                    </tr>
                                    <tr>
                                        <td class="p-3 font-semibold">Giang mai (Syphilis TP)</td>
                                        <td class="p-3 text-secondary">ECLIA Miễn dịch</td>
                                        <td class="p-3 text-secondary">Âm tính</td>
                                        <td class="p-3 font-mono font-bold text-emerald-700">Âm tính</td>
                                        <td class="p-3"><span class="px-2 py-0.5 rounded bg-emerald-50 text-emerald-700 font-bold text-xs">Đạt</span></td>
                                    </tr>
                                    <tr>
                                        <td class="p-3 font-semibold">Ký sinh trùng Sốt rét</td>
                                        <td class="p-3 text-secondary">Kính hiển vi &amp; Test nhanh</td>
                                        <td class="p-3 text-secondary">Âm tính</td>
                                        <td class="p-3 font-mono font-bold text-emerald-700">Âm tính</td>
                                        <td class="p-3"><span class="px-2 py-0.5 rounded bg-emerald-50 text-emerald-700 font-bold text-xs">Đạt</span></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- RIGHT COLUMN: 2 COLS (~40%) -> Digital Certificate Card -->
            <div class="lg:col-span-2 flex flex-col gap-4 w-full">
                <!-- Certificate Frame Card -->
                <div id="digital-certificate-card" class="bg-surface-container-lowest rounded-2xl shadow-lg p-5 sm:p-6 relative border-2 border-primary/20">
                    <!-- Certificate Watermark -->
                    <div class="absolute inset-0 opacity-[0.03] pointer-events-none flex items-center justify-center overflow-hidden">
                        <span class="material-symbols-outlined text-[280px] text-primary">health_and_safety</span>
                    </div>

                    <!-- Certificate Header -->
                    <div class="text-center pb-3 relative z-10">
                        <span class="font-label-sm text-[10px] sm:text-xs text-on-surface-variant font-bold tracking-widest uppercase block">CỘNG HÒA XÃ HỘI CHỦ NGHĨA VIỆT NAM</span>
                        <span class="font-label-sm text-[10px] sm:text-xs text-on-surface italic block">Độc lập - Tự do - Hạnh phúc</span>
                        <div class="w-16 h-0.5 bg-primary/40 mx-auto my-1.5 rounded-full"></div>
                        <div class="mt-2">
                            <span class="font-label-sm text-[10px] sm:text-xs text-primary tracking-wider uppercase font-bold block">BAN CHỈ ĐẠO QUỐC GIA VẬN ĐỘNG HIẾN MÁU TÌNH NGUYỆN</span>
                            <h3 class="font-headline-md text-base sm:text-lg text-primary font-extrabold uppercase mt-0.5 tracking-tight">
                                GIẤY CHỨNG NHẬN
                            </h3>
                            <span class="font-title-md text-xs sm:text-sm text-on-surface font-extrabold uppercase tracking-wider block">
                                HIẾN MÁU TÌNH NGUYỆN
                            </span>
                            <span class="inline-block mt-1 font-mono text-[10px] sm:text-[11px] text-on-surface-variant bg-surface-container-high px-2.5 py-0.5 rounded-full font-bold">
                                SỐ ĐỊNH DANH GCN: #GCN-@(Model?.MaNguoiHien.ToString("D5") ?? "00001")-UNETI
                            </span>
                        </div>
                    </div>

                    <!-- Certificate Body Content -->
                    <div class="py-3 relative z-10 flex flex-col gap-2.5 text-center">
                        <p class="font-body-sm text-xs text-on-surface-variant italic">
                            Ban Chỉ Đạo Vận Động Hiến Máu Tình Nguyện Trân Trọng Chứng Nhận:
                        </p>
                        <div class="bg-surface-container-low py-2.5 px-3 rounded-xl border border-surface-container-high">
                            <span class="font-headline-sm text-sm sm:text-base text-on-surface font-extrabold uppercase tracking-wide block">
                                @(Model?.HoTen?.ToUpper() ?? "NGUYỄN HOÀNG NAM")
                            </span>
                            <div class="flex items-center justify-center gap-3 font-body-sm text-xs text-on-surface-variant mt-0.5">
                                <span>Ngày sinh: <strong class="text-on-surface">@(Model?.NgaySinh?.ToString("dd/MM/yyyy") ?? "18/06/1998")</strong></span>
                                <span>•</span>
                                <span>SĐT: <strong class="text-on-surface font-mono font-bold">@(Model?.SoDienThoai ?? "0988 123 456")</strong></span>
                            </div>
                        </div>
                        <div class="text-on-surface font-body-md text-xs sm:text-sm leading-relaxed px-1">
                            Đã tình nguyện hiến <strong class="text-primary font-bold">350 mL Máu toàn phần</strong> (Nhóm máu @nhomMauDisplay) vì sự sống của người bệnh.
                            <span class="block text-xs text-on-surface-variant mt-0.5">
                                Đợt gần nhất: <strong class="text-on-surface font-bold">@latestDotName</strong> - Ngày @latestDateStr.
                            </span>
                        </div>

                        <!-- Legal Donor Right Clause -->
                        <div class="bg-surface-container p-2.5 rounded-xl text-left mt-1 border border-surface-container-high">
                            <div class="flex items-start gap-1.5">
                                <span class="material-symbols-outlined text-[16px] text-primary shrink-0 mt-0.5">policy</span>
                                <p class="font-body-sm text-[11px] sm:text-xs text-on-surface leading-normal">
                                    <strong class="font-bold">Quyền lợi quốc gia:</strong> Được bồi hoàn máu miễn phí tại tất cả các bệnh viện và cơ sở y tế công lập trên toàn quốc tương đương số lượng máu đã hiến theo quy định Bộ Y Tế.
                                </p>
                            </div>
                        </div>
                    </div>

                    <!-- Certificate Footer: QR Code & Digital Signature Stamp -->
                    <div class="pt-3 relative z-10 grid grid-cols-2 gap-3 items-center border-t border-surface-container-high/60">
                        <!-- QR Verification -->
                        <div class="flex flex-col items-center text-center">
                            <div class="w-16 h-16 bg-surface-container-lowest p-1 rounded-lg shadow-sm flex items-center justify-center border border-surface-container">
                                <svg class="w-full h-full text-on-surface" fill="currentColor" viewBox="0 0 100 100">
                                    <path d="M0 0h30v30H0zM10 10h10v10H10zM70 0h30v30H70zM80 10h10v10H80zM0 70h30v30H0zM10 80h10v10H10zM40 10h10v10H40zM50 20h10v10H50zM10 40h10v10H10zM20 50h10v10H20zM40 40h20v20H40zM70 40h10v10H70zM90 40h10v10H90zM80 50h10v10H80zM40 70h10v20H40zM60 70h10v10H60zM80 70h20v10H80zM50 90h20v10H50zM80 90h10v10H80z"></path>
                                </svg>
                            </div>
                            <span class="font-label-sm text-[9px] text-on-surface-variant mt-1 font-semibold">Quét kiểm tra trên VNeID</span>
                        </div>
                        <!-- Digital Seal Stamp -->
                        <div class="flex flex-col items-end text-right">
                            <div class="p-2 rounded-xl bg-surface-container-high/60 flex flex-col items-end border border-surface-container-high">
                                <div class="flex items-center gap-1 text-primary">
                                    <span class="material-symbols-outlined text-[14px]" style="font-variation-settings: 'FILL' 1;">verified</span>
                                    <span class="font-label-sm text-[10px] uppercase font-extrabold">KÝ SỐ HỢP LỆ</span>
                                </div>
                                <span class="font-label-sm text-[10px] text-on-surface font-bold mt-0.5">UNETI VITALIS</span>
                                <span class="font-mono text-[9px] text-on-surface-variant">@DateTime.Now.ToString("dd/MM/yyyy HH:mm")</span>
                                <span class="font-mono text-[8px] text-on-surface-variant">SHA256: 7f8a...9c4b</span>
                            </div>
                        </div>
                    </div>

                    <!-- Direct Certificate Action Buttons -->
                    <div class="mt-4 pt-3 flex flex-col sm:flex-row items-center gap-2 relative z-10">
                        <button onclick="downloadPdf()" class="w-full bg-primary hover:bg-primary-container text-on-primary font-label-md text-xs sm:text-sm py-2 px-3 rounded-xl flex items-center justify-center gap-1.5 transition-colors shadow-sm cursor-pointer font-bold">
                            <span class="material-symbols-outlined text-[16px]">picture_as_pdf</span>
                            <span>Tải PDF ký số</span>
                        </button>
                        <button onclick="saveToVNeID()" class="w-full bg-surface-container-high hover:bg-surface-container text-on-surface font-label-md text-xs sm:text-sm py-2 px-3 rounded-xl flex items-center justify-center gap-1.5 transition-colors cursor-pointer font-bold">
                            <span class="material-symbols-outlined text-[16px] text-primary">wallet</span>
                            <span>Lưu vào VNeID</span>
                        </button>
                        <button onclick="window.print()" class="bg-surface-container-low hover:bg-surface-container text-on-surface p-2 rounded-xl shrink-0 transition-colors cursor-pointer" title="In trực tiếp">
                            <span class="material-symbols-outlined text-[18px]">print</span>
                        </button>
                    </div>
                </div>

                <!-- VNeID Security Assurance Card -->
                <div class="bg-surface-container-low rounded-2xl p-4 shadow-sm flex items-start gap-3 border border-surface-container-high/60">
                    <div class="w-9 h-9 rounded-xl bg-surface-container-high flex items-center justify-center text-primary shrink-0">
                        <span class="material-symbols-outlined text-[20px]" style="font-variation-settings: 'FILL' 1;">security</span>
                    </div>
                    <div class="flex flex-col">
                        <h4 class="font-title-md text-xs sm:text-sm text-on-surface font-bold">Dữ Liệu Quốc Gia Đồng Bộ</h4>
                        <p class="font-body-sm text-xs text-on-surface-variant mt-0.5 leading-relaxed">
                            Mã chứng nhận điện tử được tự động liên thông với Hồ sơ sức khỏe điện tử trên VNeID, có giá trị pháp lý tương đương bản gốc phôi đỏ trên toàn quốc.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- MODAL: CẬP NHẬT HỒ SƠ NGƯỜI HIẾN MÁU -->
<div id="editProfileModal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-inverse-surface/40 backdrop-blur-sm hidden opacity-0 transition-opacity duration-300">
    <div class="relative w-full max-w-2xl bg-surface-container-lowest rounded-3xl p-6 sm:p-8 shadow-2xl space-y-6 max-h-[90vh] overflow-y-auto">
        <div class="flex items-center justify-between pb-3 border-b border-surface-container-high">
            <div class="flex items-center gap-2">
                <span class="material-symbols-outlined text-primary text-[24px]">manage_accounts</span>
                <h3 class="font-headline-md text-lg sm:text-xl text-on-surface font-bold">Cập Nhật Hồ Sơ Người Hiến Máu</h3>
            </div>
            <button onclick="closeEditProfileModal()" class="w-8 h-8 rounded-full hover:bg-surface-container flex items-center justify-center text-secondary">
                <span class="material-symbols-outlined text-[20px]">close</span>
            </button>
        </div>

        <form asp-controller="NguoiHienMau" asp-action="HoSoCaNhan" method="post" class="space-y-4">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="p-3 mb-2 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-xs font-semibold"></div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div class="space-y-1 sm:col-span-2">
                    <label asp-for="HoTen" class="font-label-md text-xs text-on-surface font-semibold">Họ và tên <span class="text-primary">*</span></label>
                    <input asp-for="HoTen" class="w-full h-11 bg-surface-container-lowest text-on-surface px-4 rounded-xl text-sm border border-outline-variant/40 focus:ring-2 focus:ring-primary focus:outline-none" placeholder="VD: Nguyễn Văn An" />
                    <span asp-validation-for="HoTen" class="text-rose-600 text-xs font-semibold block mt-1"></span>
                </div>

                <div class="space-y-1">
                    <label asp-for="NgaySinh" class="font-label-md text-xs text-on-surface font-semibold">Ngày sinh (18 – 60 tuổi)</label>
                    <input asp-for="NgaySinh" type="date" value="@(Model?.NgaySinh?.ToString("yyyy-MM-dd"))" class="w-full h-11 bg-surface-container-lowest text-on-surface px-3 rounded-xl text-sm border border-outline-variant/40 focus:ring-2 focus:ring-primary focus:outline-none" />
                    <span asp-validation-for="NgaySinh" class="text-rose-600 text-xs font-semibold block mt-1"></span>
                </div>

                <div class="space-y-1">
                    <label asp-for="GioiTinh" class="font-label-md text-xs text-on-surface font-semibold">Giới tính</label>
                    <select asp-for="GioiTinh" class="w-full h-11 bg-surface-container-lowest text-on-surface px-3 rounded-xl text-sm border border-outline-variant/40 focus:ring-2 focus:ring-primary focus:outline-none">
                        <option value="Nam" selected="@(Model?.GioiTinh == "Nam")">Nam</option>
                        <option value="Nữ" selected="@(Model?.GioiTinh == "Nữ")">Nữ</option>
                        <option value="Khác" selected="@(Model?.GioiTinh == "Khác")">Khác</option>
                    </select>
                    <span asp-validation-for="GioiTinh" class="text-rose-600 text-xs font-semibold block mt-1"></span>
                </div>

                <div class="space-y-1">
                    <label asp-for="SoDienThoai" class="font-label-md text-xs text-on-surface font-semibold">Số điện thoại</label>
                    <input asp-for="SoDienThoai" type="tel" placeholder="VD: 0912345678" class="w-full h-11 bg-surface-container-lowest text-on-surface px-4 rounded-xl text-sm border border-outline-variant/40 focus:ring-2 focus:ring-primary focus:outline-none" />
                    <span asp-validation-for="SoDienThoai" class="text-rose-600 text-xs font-semibold block mt-1"></span>
                </div>

                <div class="space-y-1">
                    <label asp-for="Email" class="font-label-md text-xs text-on-surface font-semibold">Email</label>
                    <input asp-for="Email" type="email" placeholder="VD: donor@uneti.edu.vn" class="w-full h-11 bg-surface-container-lowest text-on-surface px-4 rounded-xl text-sm border border-outline-variant/40 focus:ring-2 focus:ring-primary focus:outline-none" />
                    <span asp-validation-for="Email" class="text-rose-600 text-xs font-semibold block mt-1"></span>
                </div>

                <div class="space-y-1">
                    <label asp-for="NhomMau" class="font-label-md text-xs text-on-surface font-semibold">Nhóm máu</label>
                    <select asp-for="NhomMau" class="w-full h-11 bg-surface-container-lowest text-on-surface px-3 rounded-xl text-sm border border-outline-variant/40 focus:ring-2 focus:ring-primary focus:outline-none">
                        <option value="O+" selected="@(Model?.NhomMau == "O+" || Model?.NhomMau == "O Rh(+)")">O+ (O Rh+)</option>
                        <option value="A+" selected="@(Model?.NhomMau == "A+" || Model?.NhomMau == "A Rh(+)")">A+ (A Rh+)</option>
                        <option value="B+" selected="@(Model?.NhomMau == "B+" || Model?.NhomMau == "B Rh(+)")">B+ (B Rh+)</option>
                        <option value="AB+" selected="@(Model?.NhomMau == "AB+" || Model?.NhomMau == "AB Rh(+)")">AB+ (AB Rh+)</option>
                        <option value="O-" selected="@(Model?.NhomMau == "O-" || Model?.NhomMau == "O Rh(-)")">O- (O Rh- Máu hiếm)</option>
                        <option value="A-" selected="@(Model?.NhomMau == "A-" || Model?.NhomMau == "A Rh(-)")">A- (A Rh- Máu hiếm)</option>
                        <option value="B-" selected="@(Model?.NhomMau == "B-" || Model?.NhomMau == "B Rh(-)")">B- (B Rh- Máu hiếm)</option>
                        <option value="AB-" selected="@(Model?.NhomMau == "AB-" || Model?.NhomMau == "AB Rh(-)")">AB- (AB Rh- Máu hiếm)</option>
                        <option value="Chưa rõ" selected="@(string.IsNullOrEmpty(Model?.NhomMau) || Model?.NhomMau == "Chưa rõ")">Chưa rõ (Khám sàng lọc tại chỗ)</option>
                    </select>
                    <span asp-validation-for="NhomMau" class="text-rose-600 text-xs font-semibold block mt-1"></span>
                </div>

                <div class="space-y-1">
                    <label asp-for="CanNang" class="font-label-md text-xs text-on-surface font-semibold">Cân nặng (kg) <span class="text-primary">*</span></label>
                    <input asp-for="CanNang" type="number" step="0.5" min="30" max="200" class="w-full h-11 bg-surface-container-lowest text-on-surface px-4 rounded-xl text-sm border border-outline-variant/40 focus:ring-2 focus:ring-primary focus:outline-none" />
                    <span asp-validation-for="CanNang" class="text-rose-600 text-xs font-semibold block mt-1"></span>
                </div>

                <div class="space-y-1 sm:col-span-2">
                    <label asp-for="NgheNghiep" class="font-label-md text-xs text-on-surface font-semibold">Nghề nghiệp / Lớp / Khoa</label>
                    <input asp-for="NgheNghiep" placeholder="VD: Sinh viên DHTI17A5HN - UNETI" class="w-full h-11 bg-surface-container-lowest text-on-surface px-4 rounded-xl text-sm border border-outline-variant/40 focus:ring-2 focus:ring-primary focus:outline-none" />
                    <span asp-validation-for="NgheNghiep" class="text-rose-600 text-xs font-semibold block mt-1"></span>
                </div>

                <div class="space-y-1 sm:col-span-2">
                    <label asp-for="DiaChi" class="font-label-md text-xs text-on-surface font-semibold">Địa chỉ liên hệ</label>
                    <input asp-for="DiaChi" placeholder="VD: 218 Lĩnh Nam, Hoàng Mai, Hà Nội" class="w-full h-11 bg-surface-container-lowest text-on-surface px-4 rounded-xl text-sm border border-outline-variant/40 focus:ring-2 focus:ring-primary focus:outline-none" />
                    <span asp-validation-for="DiaChi" class="text-rose-600 text-xs font-semibold block mt-1"></span>
                </div>

                <div class="space-y-1 sm:col-span-2">
                    <label asp-for="GhiChuSucKhoe" class="font-label-md text-xs text-on-surface font-semibold">Ghi chú sức khỏe (nếu có)</label>
                    <textarea asp-for="GhiChuSucKhoe" rows="2" placeholder="Ghi chú về tiền sử dị ứng, thuốc đang dùng..." class="w-full bg-surface-container-lowest text-on-surface p-3 rounded-xl text-sm border border-outline-variant/40 focus:ring-2 focus:ring-primary focus:outline-none"></textarea>
                    <span asp-validation-for="GhiChuSucKhoe" class="text-rose-600 text-xs font-semibold block mt-1"></span>
                </div>
            </div>

            <div class="flex items-center justify-end gap-3 pt-4 border-t border-surface-container-high">
                <button type="button" onclick="closeEditProfileModal()" class="px-4 py-2.5 rounded-xl text-on-surface font-label-md text-sm hover:bg-surface-container transition-colors">
                    Hủy
                </button>
                <button type="submit" class="px-6 py-2.5 rounded-xl bg-primary text-on-primary font-label-md text-sm hover:bg-primary-container transition-all shadow-md font-bold">
                    Lưu thay đổi
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
    function switchDonorTab(tab) {
        const btnHistory = document.getElementById('btn-tab-history');
        const btnJourney = document.getElementById('btn-tab-journey');
        const btnLab = document.getElementById('btn-tab-lab');
        const contentHistory = document.getElementById('tab-content-history');
        const contentJourney = document.getElementById('tab-content-journey');
        const contentLab = document.getElementById('tab-content-lab');

        // Reset classes
        [btnHistory, btnJourney, btnLab].forEach(btn => {
            if (btn) btn.className = "bg-surface-container-low hover:bg-surface-container text-on-surface font-label-md text-sm px-4 py-2.5 rounded-xl shrink-0 transition-colors flex items-center gap-1.5 cursor-pointer font-semibold";
        });
        [contentHistory, contentJourney, contentLab].forEach(c => {
            if (c) {
                c.classList.add('hidden');
                c.classList.remove('flex');
            }
        });

        if (tab === 'history' && btnHistory && contentHistory) {
            btnHistory.className = "bg-primary text-on-primary font-label-md text-sm px-4 py-2.5 rounded-xl shrink-0 transition-colors shadow-sm flex items-center gap-1.5 cursor-pointer font-bold";
            contentHistory.classList.remove('hidden');
            contentHistory.classList.add('flex');
        } else if (tab === 'journey' && btnJourney && contentJourney) {
            btnJourney.className = "bg-primary text-on-primary font-label-md text-sm px-4 py-2.5 rounded-xl shrink-0 transition-colors shadow-sm flex items-center gap-1.5 cursor-pointer font-bold";
            contentJourney.classList.remove('hidden');
            contentJourney.classList.add('flex');
        } else if (tab === 'lab' && btnLab && contentLab) {
            btnLab.className = "bg-primary text-on-primary font-label-md text-sm px-4 py-2.5 rounded-xl shrink-0 transition-colors shadow-sm flex items-center gap-1.5 cursor-pointer font-bold";
            contentLab.classList.remove('hidden');
            contentLab.classList.add('flex');
        }
    }

    function openEditProfileModal() {
        const modal = document.getElementById('editProfileModal');
        if (modal) {
            modal.classList.remove('hidden');
            setTimeout(() => { modal.classList.remove('opacity-0'); }, 20);
        }
    }

    function closeEditProfileModal() {
        const modal = document.getElementById('editProfileModal');
        if (modal) {
            modal.classList.add('opacity-0');
            setTimeout(() => { modal.classList.add('hidden'); }, 300);
        }
    }

    function downloadCertificate() {
        alert("Đang chuẩn bị gói dữ liệu chứng nhận hiến máu điện tử (PDF ký số + Giấy chứng nhận phôi đỏ số hóa). File ZIP sẽ tự động tải xuống.");
    }

    function downloadPdf() {
        alert("Đang tải file PDF Giấy Chứng Nhận Hiến Máu Tình Nguyện có chữ ký số xác thực SHA-256 từ Ban Chỉ Đạo Vận Động Hiến Máu Tình Nguyện.");
    }

    function saveToVNeID() {
        alert("Đã gửi yêu cầu đồng bộ Giấy Chứng Nhận vào Ví Giấy Tờ trên ứng dụng VNeID (Mức 2).");
    }

    function shareBadge() {
        if (navigator.share) {
            navigator.share({
                title: 'Huy Hiệu Hiến Máu Vitalis - @(Model?.HoTen ?? "Người Hiến Máu")',
                text: 'Tôi vừa tham gia hiến máu nhân đạo tại Vitalis Blood Community! Mỗi giọt máu cho đi, một cuộc đời ở lại.',
                url: window.location.href
            }).catch(() => {});
        } else {
            alert('Đã sao chép liên kết chia sẻ huy hiệu hiến máu của bạn vào bộ nhớ tạm!');
        }
    }

    @if (ViewBag.OpenEditModal == true || !ViewData.ModelState.IsValid)
    {
        <text>
        document.addEventListener("DOMContentLoaded", function () {
            openEditProfileModal();
        });
        </text>
    }
</script>
<partial name="_ValidationScriptsPartial" />
}
