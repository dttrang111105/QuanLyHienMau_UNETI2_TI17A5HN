@model PhieuDangKy
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Chi tiết phiếu " + Model.MaPhieu;
    var badge = Model.TrangThai == TrangThaiPhieu.ChoXacNhan ? "bg-amber-50 text-amber-800 ring-amber-200" : Model.TrangThai == TrangThaiPhieu.DaXacNhan || Model.TrangThai == TrangThaiPhieu.HienMauThanhCong ? "bg-emerald-50 text-emerald-800 ring-emerald-200" : Model.TrangThai == TrangThaiPhieu.TuChoi || Model.TrangThai == TrangThaiPhieu.KhongDuDieuKien || Model.TrangThai == TrangThaiPhieu.DaHuy ? "bg-rose-50 text-rose-800 ring-rose-200" : "bg-blue-50 text-blue-800 ring-blue-200";
}

<div class="min-h-screen bg-[#f5f7fb]">
    <div class="mx-auto max-w-[1250px] space-y-6 p-5 lg:p-8">
        <a asp-action="Index" class="group inline-flex items-center gap-2 text-sm font-semibold text-slate-500 transition hover:text-rose-800"><span class="material-symbols-outlined text-lg transition group-hover:-translate-x-1">arrow_back</span>Quay lại danh sách phiếu</a>

        <section class="overflow-hidden rounded-[26px] border border-slate-200/80 bg-white shadow-sm">
            <div class="flex flex-col justify-between gap-6 border-b border-slate-100 p-6 md:flex-row md:items-center md:p-8">
                <div class="flex items-start gap-4"><span class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-gradient-to-br from-rose-100 to-orange-50 text-rose-800"><span class="material-symbols-outlined text-3xl">assignment_ind</span></span><div><div class="flex flex-wrap items-center gap-2"><span class="text-xs font-bold uppercase tracking-[.16em] text-slate-400">Hồ sơ đăng ký</span><span class="text-slate-300">/</span><span class="font-mono text-sm font-bold text-slate-600">@Model.MaPhieu</span></div><h1 class="mt-2 text-2xl font-bold tracking-tight text-slate-900 md:text-3xl">@Model.HoTenNguoiHien</h1><p class="mt-1 text-sm text-slate-500">Nộp ngày @Model.NgayNop.ToString("dd/MM/yyyy 'lúc' HH:mm")</p></div></div>
                <div class="flex flex-wrap items-center gap-3"><span class="inline-flex items-center gap-2 rounded-full px-4 py-2 text-sm font-bold ring-1 ring-inset @badge"><span class="h-2 w-2 rounded-full bg-current"></span>@Model.TrangThai</span><span class="inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-slate-50 px-3 py-2 text-xs font-semibold text-slate-600"><span class="material-symbols-outlined text-base text-rose-700">bloodtype</span>Nhóm máu @Model.NhomMau</span></div>
            </div>
            <div class="grid divide-y divide-slate-100 bg-slate-50/60 md:grid-cols-3 md:divide-x md:divide-y-0"><div class="flex items-center gap-3 px-6 py-4"><span class="material-symbols-outlined text-xl text-slate-400">confirmation_number</span><div><p class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Mã phiếu</p><p class="mt-0.5 text-sm font-bold text-slate-700">@Model.MaPhieu</p></div></div><div class="flex items-center gap-3 px-6 py-4"><span class="material-symbols-outlined text-xl text-slate-400">calendar_month</span><div><p class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Ngày tiếp nhận</p><p class="mt-0.5 text-sm font-bold text-slate-700">@Model.NgayNop.ToString("dd/MM/yyyy")</p></div></div><div class="flex items-center gap-3 px-6 py-4"><span class="material-symbols-outlined text-xl text-slate-400">verified_user</span><div><p class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Tình trạng người hiến</p><p class="mt-0.5 text-sm font-bold @(Model.NguoiHienConHoatDong ? "text-emerald-700" : "text-rose-700")">@(Model.NguoiHienConHoatDong ? "Đang hoạt động" : "Ngừng hoạt động")</p></div></div></div>
        </section>

        @if (TempData["ThongBao"] is string ok) { <div class="flex items-start gap-3 rounded-2xl border border-emerald-200 bg-emerald-50 p-4 text-emerald-900 shadow-sm"><span class="material-symbols-outlined">check_circle</span><span>@ok</span></div> }
        @if (TempData["Loi"] is string err) { <div class="flex items-start gap-3 rounded-2xl border border-rose-200 bg-rose-50 p-4 text-rose-900 shadow-sm"><span class="material-symbols-outlined">error</span><span>@err</span></div> }

        <div class="grid gap-6 lg:grid-cols-[1.1fr_.9fr]">
            <section class="overflow-hidden rounded-[24px] border border-slate-200/80 bg-white shadow-sm">
                <div class="flex items-center gap-3 border-b border-slate-100 px-6 py-5"><span class="flex h-10 w-10 items-center justify-center rounded-xl bg-blue-50 text-blue-700"><span class="material-symbols-outlined">person</span></span><div><h2 class="font-bold text-slate-900">Thông tin người hiến</h2><p class="text-xs text-slate-500">Thông tin liên quan đến hồ sơ đăng ký</p></div></div>
                <div class="space-y-5 p-6"><div class="grid gap-5 sm:grid-cols-2"><div><p class="text-xs font-semibold text-slate-400">Họ và tên</p><p class="mt-1 font-semibold text-slate-800">@Model.HoTenNguoiHien</p></div><div><p class="text-xs font-semibold text-slate-400">Nhóm máu ưu tiên</p><p class="mt-1 inline-flex items-center gap-1 font-bold text-rose-800"><span class="material-symbols-outlined text-lg">bloodtype</span>@Model.NhomMau</p></div></div><div class="rounded-2xl border border-slate-100 bg-slate-50 p-4"><div class="flex items-start gap-3"><span class="material-symbols-outlined text-xl @(Model.NguoiHienConHoatDong ? "text-emerald-600" : "text-rose-600")">@(Model.NguoiHienConHoatDong ? "check_circle" : "person_off")</span><div><p class="text-sm font-bold text-slate-800">@(Model.NguoiHienConHoatDong ? "Người hiến đang hoạt động" : "Người hiến đã ngừng hoạt động")</p><p class="mt-1 text-xs leading-5 text-slate-500">Trạng thái tài khoản được hiển thị để nhân viên y tế xem xét trước khi xác nhận phiếu.</p></div></div></div></div>
            </section>

            <section class="overflow-hidden rounded-[24px] border border-slate-200/80 bg-white shadow-sm">
                <div class="flex items-center gap-3 border-b border-slate-100 px-6 py-5"><span class="flex h-10 w-10 items-center justify-center rounded-xl bg-rose-50 text-rose-700"><span class="material-symbols-outlined">event_available</span></span><div><h2 class="font-bold text-slate-900">Đợt hiến máu</h2><p class="text-xs text-slate-500">Đơn vị tổ chức và tiêu chí tiếp nhận</p></div></div>
                <div class="space-y-5 p-6"><div><p class="text-xs font-semibold text-slate-400">Tên đợt</p><p class="mt-1 font-bold text-slate-800">@Model.TenDot</p></div><div><p class="text-xs font-semibold text-slate-400">Đơn vị tổ chức</p><p class="mt-1 font-semibold text-slate-700">@Model.DonViToChuc</p></div><div class="rounded-2xl border border-amber-200 bg-amber-50/70 p-4"><p class="flex items-center gap-2 text-xs font-bold uppercase tracking-wide text-amber-900"><span class="material-symbols-outlined text-lg">fact_check</span>Yêu cầu của đợt</p><p class="mt-2 text-sm leading-6 text-amber-950">@Model.YeuCauDot</p></div><div class="flex items-start gap-2 text-xs leading-5 text-slate-500"><span class="material-symbols-outlined text-base text-slate-400">info</span><span>Nhóm máu chỉ là thông tin tham khảo. Nhân viên y tế đánh giá tổng thể hồ sơ và yêu cầu của đợt trước khi quyết định.</span></div></div>
            </section>
        </div>

        @if (Model.NgayXuLy.HasValue) {
            <section class="rounded-[24px] border border-slate-200/80 bg-white shadow-sm"><div class="flex items-center gap-3 border-b border-slate-100 px-6 py-5"><span class="flex h-10 w-10 items-center justify-center rounded-xl bg-emerald-50 text-emerald-700"><span class="material-symbols-outlined">task_alt</span></span><div><h2 class="font-bold text-slate-900">Lịch sử xác nhận</h2><p class="text-xs text-slate-500">Thông tin xử lý do nhân viên y tế ghi nhận</p></div></div><div class="grid gap-5 p-6 md:grid-cols-[220px_1fr]"><div><p class="text-xs font-semibold text-slate-400">Ngày xử lý</p><p class="mt-1 font-semibold text-slate-800">@Model.NgayXuLy.Value.ToString("dd/MM/yyyy 'lúc' HH:mm")</p></div><div><p class="text-xs font-semibold text-slate-400">Ghi chú xác nhận</p><p class="mt-1 whitespace-pre-line text-sm leading-6 text-slate-700">@Model.GhiChuXacNhan</p></div></div></section>
        }

        @if (Model.TrangThai == TrangThaiPhieu.ChoXacNhan) {
            <section class="overflow-hidden rounded-[24px] border border-rose-200 bg-white shadow-md shadow-rose-900/[0.04]"><div class="flex items-start gap-3 border-b border-rose-100 bg-gradient-to-r from-rose-50 to-white px-6 py-5"><span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-rose-100 text-rose-800"><span class="material-symbols-outlined">fact_check</span></span><div><h2 class="font-bold text-slate-900">Xác nhận hồ sơ</h2><p class="mt-1 text-sm text-slate-500">Đọc thông tin người hiến và yêu cầu đợt trước khi chọn kết quả.</p></div></div>
                <form asp-action="XuLy" method="post" class="space-y-5 p-6">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id" /><label class="block text-sm font-semibold text-slate-700">Ghi chú xác nhận hoặc lý do từ chối <span class="text-rose-600">*</span><textarea name="ghiChuXacNhan" required maxlength="1000" rows="4" class="mt-2 w-full rounded-xl border border-slate-200 bg-slate-50/60 p-4 text-sm leading-6 text-slate-800 outline-none transition placeholder:text-slate-400 focus:border-rose-400 focus:bg-white focus:ring-4 focus:ring-rose-100" placeholder="Ghi lại nội dung đã kiểm tra, cơ sở xác nhận hoặc lý do từ chối..."></textarea><span class="mt-1 block text-xs font-normal text-slate-400">Ghi chú và thời điểm xử lý sẽ được lưu cùng kết quả phiếu.</span></label><div class="flex flex-col-reverse gap-3 border-t border-slate-100 pt-5 sm:flex-row sm:justify-end"><button name="trangThaiMoi" value="@TrangThaiPhieu.TuChoi" class="inline-flex h-11 items-center justify-center gap-2 rounded-xl border border-rose-200 bg-white px-5 text-sm font-bold text-rose-800 transition hover:bg-rose-50" type="submit"><span class="material-symbols-outlined text-lg">close</span>Từ chối phiếu</button><button name="trangThaiMoi" value="@TrangThaiPhieu.DaXacNhan" class="inline-flex h-11 items-center justify-center gap-2 rounded-xl bg-emerald-700 px-6 text-sm font-bold text-white shadow-md shadow-emerald-900/15 transition hover:-translate-y-0.5 hover:bg-emerald-800" type="submit"><span class="material-symbols-outlined text-lg">verified</span>Xác nhận hồ sơ</button></div></form>
            </section>
        } else if (Model.TrangThai is TrangThaiPhieu.DaXacNhan or TrangThaiPhieu.ChoKham or TrangThaiPhieu.DaKham) {
            <section class="rounded-[24px] border border-slate-200/80 bg-white p-6 shadow-sm"><div class="mb-5 flex items-center gap-3"><span class="flex h-10 w-10 items-center justify-center rounded-xl bg-blue-50 text-blue-700"><span class="material-symbols-outlined">conversion_path</span></span><div><h2 class="font-bold text-slate-900">Cập nhật trạng thái</h2><p class="text-xs text-slate-500">Chỉ các bước tiếp theo hợp lệ được cung cấp.</p></div></div><form asp-action="XuLy" method="post" class="flex flex-col gap-3 sm:flex-row sm:items-end">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id" /><label class="flex-1 text-xs font-bold uppercase tracking-wide text-slate-500">Bước tiếp theo<select name="trangThaiMoi" class="mt-2 h-11 w-full rounded-xl border border-slate-200 bg-slate-50 px-3 text-sm font-semibold normal-case tracking-normal text-slate-700 outline-none focus:border-rose-400 focus:ring-4 focus:ring-rose-100">@if (Model.TrangThai == TrangThaiPhieu.DaXacNhan) { <option value="@TrangThaiPhieu.ChoKham">@TrangThaiPhieu.ChoKham</option> } else if (Model.TrangThai == TrangThaiPhieu.ChoKham) { <option value="@TrangThaiPhieu.DaKham">@TrangThaiPhieu.DaKham</option> } else { <option value="@TrangThaiPhieu.HienMauThanhCong">@TrangThaiPhieu.HienMauThanhCong</option><option value="@TrangThaiPhieu.KhongDuDieuKien">@TrangThaiPhieu.KhongDuDieuKien</option> }</select></label><button class="inline-flex h-11 items-center justify-center gap-2 rounded-xl bg-slate-800 px-5 text-sm font-bold text-white transition hover:bg-slate-900"><span class="material-symbols-outlined text-lg">sync_alt</span>Cập nhật trạng thái</button></form></section>
        }

        @if (Model.TrangThai is not TrangThaiPhieu.DaHuy and not TrangThaiPhieu.HienMauThanhCong and not TrangThaiPhieu.KhongDuDieuKien and not TrangThaiPhieu.TuChoi) {
            <form asp-action="XuLy" method="post" class="flex items-center justify-between gap-4 rounded-2xl border border-slate-200 bg-white px-5 py-4">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id" /><input type="hidden" name="trangThaiMoi" value="@TrangThaiPhieu.DaHuy" /><div><p class="text-sm font-semibold text-slate-700">Cần dừng hồ sơ này?</p><p class="mt-0.5 text-xs text-slate-500">Phiếu đã hủy sẽ không thể tiếp tục xử lý.</p></div><button class="inline-flex shrink-0 items-center gap-2 rounded-lg px-3 py-2 text-sm font-semibold text-slate-500 transition hover:bg-rose-50 hover:text-rose-800" onclick="return confirm('Bạn có chắc muốn hủy phiếu này?')" type="submit"><span class="material-symbols-outlined text-lg">block</span>Hủy phiếu</button></form>
        }
    </div>
</div>
