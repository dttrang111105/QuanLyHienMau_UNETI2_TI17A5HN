<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta content="web_dashboard" name="shell-type" />
    <title>@ViewData["Title"] - Vitalis Blood Community Medical Staff Portal</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Plus+Jakarta+Sans:wght@600;700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <style>
        @@layer base {
            html, body { margin: 0; padding: 0; }
            body { overscroll-behavior: none; }
            main > :first-child { margin-top: 0 !important; }
            main > :last-child { margin-bottom: 0 !important; }
        }
        ::-webkit-scrollbar { display: none; }
    </style>
    <script src="https://cdn.tailwindcss.com"></script>
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "tertiary-fixed": "#ffdad8",
                        "on-primary": "#ffffff",
                        "error": "#ba1a1a",
                        "secondary": "#685b5e",
                        "on-primary-container": "#ffe1e1",
                        "tertiary": "#8d3033",
                        "primary-fixed": "#ffdad9",
                        "inverse-on-surface": "#e6f3fb",
                        "surface-variant": "#d7e4ec",
                        "tertiary-fixed-dim": "#ffb3b1",
                        "surface-bright": "#f4faff",
                        "surface-dim": "#cfdce4",
                        "surface-container-highest": "#d7e4ec",
                        "inverse-primary": "#ffb3b3",
                        "primary": "#a30428",
                        "outline": "#8e706f",
                        "inverse-surface": "#263238",
                        "surface-container": "#e3f0f8",
                        "surface-tint": "#b81c34",
                        "surface": "#f4faff",
                        "on-background": "#111d23",
                        "on-tertiary-fixed-variant": "#81272b",
                        "on-secondary-fixed": "#23191c",
                        "primary-fixed-dim": "#ffb3b3",
                        "surface-container-high": "#ddeaf2",
                        "on-tertiary-container": "#ffe1df",
                        "on-primary-fixed-variant": "#920022",
                        "surface-container-lowest": "#ffffff",
                        "surface-container-low": "#e9f6fd",
                        "on-secondary-fixed-variant": "#504447",
                        "secondary-fixed-dim": "#d4c2c6",
                        "on-error-container": "#93000a",
                        "on-secondary": "#ffffff",
                        "on-primary-fixed": "#400009",
                        "on-secondary-container": "#6f6164",
                        "on-tertiary-fixed": "#410007",
                        "on-error": "#ffffff",
                        "tertiary-container": "#ac4749",
                        "on-tertiary": "#ffffff",
                        "background": "#f4faff",
                        "secondary-fixed": "#f1dee2",
                        "error-container": "#ffdad6",
                        "outline-variant": "#e2bebd",
                        "secondary-container": "#f1dee2",
                        "on-surface": "#111d23",
                        "on-surface-variant": "#5a4040",
                        "primary-container": "#c6283d"
                    },
                    borderRadius: {
                        DEFAULT: "0.25rem",
                        lg: "0.5rem",
                        xl: "0.75rem",
                        full: "9999px"
                    },
                    spacing: {
                        "margin-mobile": "1rem",
                        margin: "2rem",
                        "space-md": "1rem",
                        "gutter-mobile": "1rem",
                        "space-xl": "2.5rem",
                        "space-lg": "1.5rem",
                        gutter: "1.5rem",
                        "space-xs": "0.25rem",
                        "space-sm": "0.5rem"
                    },
                    fontFamily: {
                        "body-lg": ["Inter"],
                        "headline-sm": ["Plus Jakarta Sans"],
                        "title-md": ["Plus Jakarta Sans"],
                        "display-hero": ["Plus Jakarta Sans"],
                        "body-sm": ["Inter"],
                        "label-lg": ["Plus Jakarta Sans"],
                        "display-hero-mobile": ["Plus Jakarta Sans"],
                        "headline-lg-mobile": ["Plus Jakarta Sans"],
                        "headline-md": ["Plus Jakarta Sans"],
                        "label-sm": ["Plus Jakarta Sans"],
                        "headline-lg": ["Plus Jakarta Sans"],
                        "label-md": ["Plus Jakarta Sans"],
                        "body-md": ["Inter"]
                    },
                    fontSize: {
                        "body-lg": ["18px", { lineHeight: "28px", fontWeight: "400" }],
                        "headline-sm": ["20px", { lineHeight: "28px", fontWeight: "600" }],
                        "title-md": ["16px", { lineHeight: "24px", fontWeight: "600" }],
                        "display-hero": ["48px", { lineHeight: "56px", letterSpacing: "-0.02em", fontWeight: "700" }],
                        "body-sm": ["13px", { lineHeight: "20px", fontWeight: "400" }],
                        "label-lg": ["15px", { lineHeight: "20px", fontWeight: "600" }],
                        "display-hero-mobile": ["32px", { lineHeight: "40px", letterSpacing: "-0.01em", fontWeight: "700" }],
                        "headline-lg-mobile": ["24px", { lineHeight: "32px", letterSpacing: "-0.01em", fontWeight: "700" }],
                        "headline-md": ["24px", { lineHeight: "32px", letterSpacing: "-0.01em", fontWeight: "600" }],
                        "label-sm": ["11px", { lineHeight: "16px", letterSpacing: "0.04em", fontWeight: "700" }],
                        "headline-lg": ["32px", { lineHeight: "40px", letterSpacing: "-0.015em", fontWeight: "700" }],
                        "label-md": ["13px", { lineHeight: "18px", fontWeight: "600" }],
                        "body-md": ["15px", { lineHeight: "24px", fontWeight: "400" }]
                    }
                }
            }
        };
    </script>
</head>
<body class="bg-surface font-body-md text-on-surface antialiased">
    @{
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    }
    <!-- ASIDE / SIDEBAR -->
    <aside class="fixed left-0 top-0 h-screen w-72 bg-inverse-surface text-inverse-on-surface z-50 flex flex-col justify-between shadow-[0_1px_8px_rgba(0,0,0,0.06)]">
        <div class="flex flex-col h-full overflow-hidden">
            <!-- Brand Logo -->
            <a asp-controller="Admin" asp-action="Dashboard" class="h-16 px-space-lg flex items-center gap-space-sm shrink-0 bg-inverse-surface hover:opacity-95 transition-opacity">
                <img alt="Vitalis Blood Community Logo" class="h-8 w-auto object-contain" src="https://lh3.googleusercontent.com/aida/AEtjO1XMAnpwzAoiZfIb2ps07L5-qPxD01D5Afsv6hH8cTtMsue5VjoEtavGToUPZ6V1OavAUvc0eHKgEdN-nxL-isiibHim0XC8YAcfrg8qpMdlEoumN5-jlmS_4qmKro4EBKm1SSz2ytO0KDSejWPciQcI0WRPlGH0Jf7A5qvjE8xdLS5peTLM5x80ju9yl69YkhfYvaklOVOisizxxbfONr3Y_gpSm6VBYp3lpltkq3kHe6gUt3B333X9HN5z">
                <div class="flex flex-col">
                    <span class="font-label-lg text-label-lg text-white font-bold leading-tight tracking-tight">Vitalis Blood</span>
                    <span class="font-label-sm text-label-sm text-surface-variant uppercase tracking-wider">Medical Portal</span>
                </div>
            </a>

            <!-- Navigation Links -->
            <div class="flex-1 overflow-y-auto px-space-md py-space-sm space-y-space-md">
                <!-- Group 1: Tổng quan -->
                <nav class="space-y-space-xs">
                    <p class="px-space-sm font-label-sm text-label-sm text-surface-variant uppercase tracking-wider font-semibold mb-space-xs">Tổng quan</p>
                    <a asp-controller="Admin" asp-action="Dashboard" class="flex items-center gap-space-sm px-space-md py-2.5 transition-all duration-150 @(currentController == "Admin" && currentAction == "Dashboard" ? "bg-primary text-on-primary font-bold shadow-md rounded-xl" : "rounded-xl text-inverse-on-surface hover:bg-surface-container-highest hover:text-on-surface")">
                        <span class="material-symbols-outlined text-[20px]">dashboard</span>
                        <span class="font-label-md text-label-md">Dashboard Điều hành</span>
                    </a>
                    <a asp-controller="Admin" asp-action="BaoCao" class="flex items-center gap-space-sm px-space-md py-2.5 transition-all duration-150 @(currentController == "Admin" && currentAction == "BaoCao" ? "bg-primary text-on-primary font-bold shadow-md rounded-xl" : "rounded-xl text-inverse-on-surface hover:bg-surface-container-highest hover:text-on-surface")">
                        <span class="material-symbols-outlined text-[20px]">analytics</span>
                        <span class="font-label-md text-label-md">Thống kê &amp; Báo cáo</span>
                    </a>
                </nav>

                <!-- Group 2: Quản lý y tế -->
                <nav class="space-y-space-xs">
                    <p class="px-space-sm font-label-sm text-label-sm text-surface-variant uppercase tracking-wider font-semibold mb-space-xs">Quản lý y tế</p>
                    <a asp-controller="Admin" asp-action="PhieuDangKyHienMau" class="flex items-center justify-between px-space-md py-2.5 transition-all duration-150 @(currentController == "Admin" && (currentAction == "PhieuDangKyHienMau" || currentAction == "ChiTietPhieuDangKy") ? "bg-primary text-on-primary font-bold shadow-md rounded-xl" : "rounded-xl text-inverse-on-surface hover:bg-surface-container-highest hover:text-on-surface")">
                        <div class="flex items-center gap-space-sm">
                            <span class="material-symbols-outlined text-[20px]">assignment_turned_in</span>
                            <span class="font-label-md text-label-md">Phiếu đăng ký &amp; Duyệt</span>
                        </div>
                    </a>
                    <a asp-controller="Admin" asp-action="LichKhamSangLoc" class="flex items-center gap-space-sm px-space-md py-2.5 transition-all duration-150 @(currentController == "Admin" && currentAction == "LichKhamSangLoc" ? "bg-primary text-on-primary font-bold shadow-md rounded-xl" : "rounded-xl text-inverse-on-surface hover:bg-surface-container-highest hover:text-on-surface")">
                        <span class="material-symbols-outlined text-[20px]">medical_services</span>
                        <span class="font-label-md text-label-md">Lịch khám sàng lọc</span>
                    </a>
                    <a asp-controller="Admin" asp-action="KetQuaHienMau" class="flex items-center gap-space-sm px-space-md py-2.5 transition-all duration-150 @(currentController == "Admin" && (currentAction == "KetQuaHienMau" || currentAction == "ChiTietKetQua" || currentAction == "KetQuaXetNghiem") ? "bg-primary text-on-primary font-bold shadow-md rounded-xl" : "rounded-xl text-inverse-on-surface hover:bg-surface-container-highest hover:text-on-surface")">
                        <span class="material-symbols-outlined text-[20px]">biotech</span>
                        <span class="font-label-md text-label-md">Kết quả hiến máu</span>
                    </a>
                    <a asp-controller="Admin" asp-action="HoSoBenhSu" class="flex items-center gap-space-sm px-space-md py-2.5 transition-all duration-150 @(currentController == "Admin" && currentAction == "HoSoBenhSu" ? "bg-primary text-on-primary font-bold shadow-md rounded-xl" : "rounded-xl text-inverse-on-surface hover:bg-surface-container-highest hover:text-on-surface")">
                        <span class="material-symbols-outlined text-[20px]">clinical_notes</span>
                        <span class="font-label-md text-label-md">Hồ sơ bệnh sử lâm sàng</span>
                    </a>
                    <a asp-controller="Admin" asp-action="TieuHuy" class="flex items-center gap-space-sm px-space-md py-2.5 transition-all duration-150 @(currentController == "Admin" && currentAction == "TieuHuy" ? "bg-primary text-on-primary font-bold shadow-md rounded-xl" : "rounded-xl text-inverse-on-surface hover:bg-surface-container-highest hover:text-on-surface")">
                        <span class="material-symbols-outlined text-[20px]">gavel</span>
                        <span class="font-label-md text-label-md">Kiểm định &amp; Tiêu hủy túi máu</span>
                    </a>
                    <a asp-controller="Admin" asp-action="GiamSatTuiMau" class="flex items-center gap-space-sm px-space-md py-2.5 transition-all duration-150 @(currentController == "Admin" && currentAction == "GiamSatTuiMau" ? "bg-primary text-on-primary font-bold shadow-md rounded-xl" : "rounded-xl text-inverse-on-surface hover:bg-surface-container-highest hover:text-on-surface")">
                        <span class="material-symbols-outlined text-[20px]">route</span>
                        <span class="font-label-md text-label-md">Chuỗi hành trình &amp; Giám sát túi máu</span>
                    </a>
                </nav>

                <!-- Group 3: Đối tác & Dữ liệu -->
                <nav class="space-y-space-xs">
                    <p class="px-space-sm font-label-sm text-label-sm text-surface-variant uppercase tracking-wider font-semibold mb-space-xs">Đối tác &amp; Dữ liệu</p>
                    <a asp-controller="Admin" asp-action="DonViToChuc" class="flex items-center gap-space-sm px-space-md py-2.5 transition-all duration-150 @(currentController == "Admin" && currentAction == "DonViToChuc" ? "bg-primary text-on-primary font-bold shadow-md rounded-xl" : "rounded-xl text-inverse-on-surface hover:bg-surface-container-highest hover:text-on-surface")">
                        <span class="material-symbols-outlined text-[20px]">apartment</span>
                        <span class="font-label-md text-label-md">Đơn vị tổ chức</span>
                    </a>
                    <a asp-controller="Admin" asp-action="NguoiHienMau" class="flex items-center gap-space-sm px-space-md py-2.5 transition-all duration-150 @(currentController == "Admin" && currentAction == "NguoiHienMau" ? "bg-primary text-on-primary font-bold shadow-md rounded-xl" : "rounded-xl text-inverse-on-surface hover:bg-surface-container-highest hover:text-on-surface")">
                        <span class="material-symbols-outlined text-[20px]">groups</span>
                        <span class="font-label-md text-label-md">Người hiến máu (Donors)</span>
                    </a>
                    <a asp-controller="Admin" asp-action="KhoLuuTruMau" class="flex items-center gap-space-sm px-space-md py-2.5 transition-all duration-150 @(currentController == "Admin" && currentAction == "KhoLuuTruMau" ? "bg-primary text-on-primary font-bold shadow-md rounded-xl" : "rounded-xl text-inverse-on-surface hover:bg-surface-container-highest hover:text-on-surface")">
                        <span class="material-symbols-outlined text-[20px]">bloodtype</span>
                        <span class="font-label-md text-label-md">Kho lưu trữ máu</span>
                    </a>
                </nav>

                <!-- Group 4: Hệ thống -->
                <nav class="space-y-space-xs">
                    <p class="px-space-sm font-label-sm text-label-sm text-surface-variant uppercase tracking-wider font-semibold mb-space-xs">Hệ thống</p>
                    <a asp-controller="Home" asp-action="Index" class="flex items-center gap-space-sm px-space-md py-2.5 rounded-xl text-inverse-on-surface hover:bg-surface-container-highest hover:text-on-surface transition-all duration-150">
                        <span class="material-symbols-outlined text-[20px]">public</span>
                        <span class="font-label-md text-label-md">Cổng thông tin cộng đồng</span>
                    </a>
                    <a asp-controller="Admin" asp-action="NhanSu" class="flex items-center gap-space-sm px-space-md py-2.5 transition-all duration-150 @(currentController == "Admin" && currentAction == "NhanSu" ? "bg-primary text-on-primary font-bold shadow-md rounded-xl" : "rounded-xl text-inverse-on-surface hover:bg-surface-container-highest hover:text-on-surface")">
                        <span class="material-symbols-outlined text-[20px]">shield_person</span>
                        <span class="font-label-md text-label-md">Phân quyền nhân sự</span>
                    </a>
                    <a asp-controller="Admin" asp-action="RBAC" class="flex items-center gap-space-sm px-space-md py-2.5 transition-all duration-150 @(currentController == "Admin" && currentAction == "RBAC" ? "bg-primary text-on-primary font-bold shadow-md rounded-xl" : "rounded-xl text-inverse-on-surface hover:bg-surface-container-highest hover:text-on-surface")">
                        <span class="material-symbols-outlined text-[20px]">admin_panel_settings</span>
                        <span class="font-label-md text-label-md">Cấu hình RBAC</span>
                    </a>
                    <a asp-controller="Admin" asp-action="KhoLanhIoT" class="flex items-center gap-space-sm px-space-md py-2.5 transition-all duration-150 @(currentController == "Admin" && currentAction == "KhoLanhIoT" ? "bg-primary text-on-primary font-bold shadow-md rounded-xl" : "rounded-xl text-inverse-on-surface hover:bg-surface-container-highest hover:text-on-surface")">
                        <span class="material-symbols-outlined text-[20px]">sensors</span>
                        <span class="font-label-md text-label-md">Kho lạnh IoT &amp; Cảnh báo</span>
                    </a>
                </nav>
            </div>
        </div>

        <!-- Sidebar Footer -->
        <div class="p-space-md shrink-0 bg-inverse-surface/80">
            <div class="flex items-center justify-between text-surface-variant font-label-sm text-label-sm mb-space-xs">
                <span class="flex items-center gap-1"><span class="h-2 w-2 rounded-full bg-emerald-500 inline-block"></span> ASP.NET Core 10</span>
                <span class="px-1.5 py-0.5 rounded bg-surface-container-highest text-inverse-surface font-semibold">v2.4.0</span>
            </div>
            <div class="flex items-center justify-between pt-space-xs">
                <span class="font-label-sm text-label-sm text-surface-variant">Chế độ trạm y tế</span>
                <button aria-label="Chế độ hiển thị" class="w-8 h-8 rounded-lg flex items-center justify-center text-surface-variant hover:bg-surface-container-highest hover:text-inverse-surface transition-colors" type="button">
                    <span class="material-symbols-outlined text-[18px]">light_mode</span>
                </button>
            </div>
        </div>
    </aside>

    <!-- MAIN WRAPPER WITH TOPBAR -->
    <div class="pl-72 flex flex-col min-h-screen">
        <!-- FIXED TOPBAR -->
        <header class="fixed top-0 left-72 right-0 h-16 bg-surface-container-lowest/90 backdrop-blur-xl shadow-[0_1px_8px_rgba(0,0,0,0.04)] z-40 flex items-center justify-between px-space-lg">
            <div class="flex items-center gap-space-lg flex-1 max-w-2xl">
                <div class="relative w-full max-w-md">
                    <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant text-[20px]">search</span>
                    <input class="w-full h-10 pl-10 pr-space-md bg-surface-container-low rounded-xl font-body-sm text-body-sm text-on-surface placeholder:text-on-surface-variant/70 focus:outline-none focus:ring-2 focus:ring-primary/20 focus:bg-surface-container-lowest transition-all" placeholder="Tìm mã phiếu, CCCD/VNeID, họ tên người hiến, tên đợt..." type="search" />
                </div>
                <div class="hidden xl:flex items-center gap-2 px-3 py-1.5 rounded-full bg-surface-container font-label-sm text-label-sm text-on-surface-variant">
                    <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                    <span>VNeID Live Sync: <strong class="text-on-surface font-semibold">Kết nối an toàn</strong></span>
                </div>
            </div>
            <div class="flex items-center gap-space-md shrink-0">
                <button aria-label="Thông báo khẩn cấp" class="relative p-2 rounded-xl text-on-surface-variant hover:bg-surface-container-low hover:text-on-surface transition-colors" type="button" onclick="alert('14 thông báo: 24 phiếu cần duyệt, 3 ca xung đột lịch.')">
                    <span class="material-symbols-outlined text-[22px]">notifications</span>
                    <span class="absolute top-1.5 right-1.5 flex h-4 min-w-4 px-1 items-center justify-center rounded-full bg-primary font-label-sm text-[10px] font-bold text-on-primary leading-none">14</span>
                </button>
                <div class="h-8 w-px bg-surface-container"></div>
                <div class="flex items-center gap-space-sm pl-space-xs">
                    <div class="w-8 h-8 rounded-full bg-primary flex items-center justify-center text-on-primary font-bold text-xs shrink-0">
                        @(User.Identity?.Name?.Length > 0 ? User.Identity.Name[0].ToString().ToUpper() : "A")
                    </div>
                    <div class="hidden md:flex flex-col text-left">
                        <span class="font-label-md text-label-md text-on-surface font-semibold leading-tight">@(User.Identity?.Name ?? "Quản trị viên")</span>
                        <span class="font-label-sm text-[11px] text-primary font-bold uppercase leading-tight">@(User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "Admin")</span>
                    </div>
                    <form method="post" asp-controller="Account" asp-action="Logout" class="inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="p-2 text-on-surface-variant hover:text-error hover:bg-error-container/40 rounded-xl transition-colors ml-1 cursor-pointer" title="Đăng xuất">
                            <span class="material-symbols-outlined text-[20px]">logout</span>
                        </button>
                    </form>
                </div>
            </div>
        </header>

        <!-- MAIN PAGE CONTENT -->
        <main class="w-full pt-16 flex-1 bg-surface">
            @RenderBody()
        </main>
    </div>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
