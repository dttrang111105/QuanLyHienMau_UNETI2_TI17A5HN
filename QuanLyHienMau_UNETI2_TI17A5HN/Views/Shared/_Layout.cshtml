<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Vitalis Blood Community | Quản Lý Hiến Máu UNETI</title>
    
    <!-- Google Fonts & Material Symbols -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet">
    
    <!-- Tailwind CSS with Stitch Theme Config -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#a30428",
                        "primary-container": "#c6283d",
                        "on-primary": "#ffffff",
                        "on-primary-container": "#ffe1e1",
                        "primary-fixed": "#ffdad9",
                        "primary-fixed-dim": "#ffb3b3",
                        "secondary": "#685b5e",
                        "secondary-container": "#f1dee2",
                        "on-secondary": "#ffffff",
                        "on-secondary-container": "#6f6164",
                        "secondary-fixed": "#f1dee2",
                        "tertiary": "#8d3033",
                        "tertiary-container": "#ac4749",
                        "tertiary-fixed": "#ffdad8",
                        "surface": "#f4faff",
                        "surface-dim": "#cfdce4",
                        "surface-bright": "#f4faff",
                        "surface-container-lowest": "#ffffff",
                        "surface-container-low": "#e9f6fd",
                        "surface-container": "#e3f0f8",
                        "surface-container-high": "#ddeaf2",
                        "surface-container-highest": "#d7e4ec",
                        "on-surface": "#111d23",
                        "on-surface-variant": "#5a4040",
                        "inverse-surface": "#263238",
                        "inverse-on-surface": "#e6f3fb",
                        "outline": "#8e706f",
                        "outline-variant": "#e2bebd",
                        "error": "#ba1a1a",
                        "error-container": "#ffdad6",
                        "background": "#f4faff"
                    },
                    fontFamily: {
                        "body-lg": ["Inter", "sans-serif"],
                        "body-md": ["Inter", "sans-serif"],
                        "body-sm": ["Inter", "sans-serif"],
                        "headline-lg": ["Plus Jakarta Sans", "sans-serif"],
                        "headline-md": ["Plus Jakarta Sans", "sans-serif"],
                        "headline-sm": ["Plus Jakarta Sans", "sans-serif"],
                        "display-hero": ["Plus Jakarta Sans", "sans-serif"],
                        "title-md": ["Plus Jakarta Sans", "sans-serif"],
                        "label-lg": ["Plus Jakarta Sans", "sans-serif"],
                        "label-md": ["Plus Jakarta Sans", "sans-serif"],
                        "label-sm": ["Plus Jakarta Sans", "sans-serif"]
                    },
                    fontSize: {
                        "display-hero": ["48px", { "lineHeight": "56px", "letterSpacing": "-0.02em", "fontWeight": "700" }],
                        "headline-lg": ["32px", { "lineHeight": "40px", "letterSpacing": "-0.015em", "fontWeight": "700" }],
                        "headline-md": ["24px", { "lineHeight": "32px", "letterSpacing": "-0.01em", "fontWeight": "600" }],
                        "headline-sm": ["20px", { "lineHeight": "28px", "fontWeight": "600" }],
                        "title-md": ["16px", { "lineHeight": "24px", "fontWeight": "600" }],
                        "body-lg": ["18px", { "lineHeight": "28px", "fontWeight": "400" }],
                        "body-md": ["15px", { "lineHeight": "24px", "fontWeight": "400" }],
                        "body-sm": ["13px", { "lineHeight": "20px", "fontWeight": "400" }],
                        "label-lg": ["15px", { "lineHeight": "20px", "fontWeight": "600" }],
                        "label-md": ["13px", { "lineHeight": "18px", "fontWeight": "600" }],
                        "label-sm": ["11px", { "lineHeight": "16px", "letterSpacing": "0.04em", "fontWeight": "700" }]
                    }
                }
            }
        };
    </script>
    
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-surface font-body-md text-on-surface antialiased flex flex-col min-h-screen">
    <!-- Main Public Header / Navbar -->
    <header class="fixed top-0 left-0 w-full z-50 bg-surface-container-lowest/95 backdrop-blur-md shadow-[0_1px_8px_rgba(0,0,0,0.04)]">
        <div class="h-20 max-w-[1240px] mx-auto px-6 flex items-center justify-between gap-4">
            <!-- Brand Logo -->
            <a asp-controller="Home" asp-action="Index" class="flex items-center gap-3 decoration-transparent">
                <div class="w-10 h-10 rounded-xl bg-primary-fixed flex items-center justify-center text-primary shadow-sm">
                    <span class="material-symbols-outlined text-[24px]" style="font-variation-settings: 'FILL' 1;">water_drop</span>
                </div>
                <div class="flex flex-col">
                    <span class="font-headline-sm text-headline-sm text-primary leading-tight tracking-tight">Vitalis</span>
                    <span class="font-label-sm text-label-sm text-secondary tracking-wider uppercase">Hiến Máu UNETI</span>
                </div>
            </a>

            <!-- Desktop Navigation Links -->
            <nav class="hidden xl:flex items-center gap-6">
                <a asp-controller="Home" asp-action="Index" class="font-label-md text-label-md text-on-surface-variant hover:text-primary transition-colors py-2">Trang chủ</a>
                <a asp-controller="DotHienMau" asp-action="Index" class="font-label-md text-label-md text-on-surface-variant hover:text-primary transition-colors py-2">Đợt hiến máu</a>
                <a asp-controller="DangKy" asp-action="Create" class="font-label-md text-label-md text-on-surface-variant hover:text-primary transition-colors py-2">Quy trình</a>
                <a asp-controller="DangKy" asp-action="TheoDoi" class="font-label-md text-label-md text-on-surface-variant hover:text-primary transition-colors py-2">Tra cứu phiếu</a>
                <a asp-controller="NguoiHienMau" asp-action="HoSoCaNhan" class="font-label-md text-label-md text-on-surface-variant hover:text-primary transition-colors py-2">Hồ sơ cá nhân</a>
            </nav>

            <!-- Actions Right -->
            <div class="flex items-center gap-3">
                <a asp-controller="Account" asp-action="Login" class="hidden sm:inline-flex font-label-md text-label-md text-on-surface-variant hover:text-primary hover:bg-surface-container px-3.5 py-2 rounded-xl transition-all">
                    Đăng nhập
                </a>
                <a asp-controller="DangKy" asp-action="Create" class="inline-flex items-center gap-2 bg-gradient-to-r from-primary to-primary-container text-on-primary font-label-md text-label-md px-5 py-2.5 rounded-xl shadow-[0_4px_20px_-2px_rgba(198,40,61,0.25)] hover:shadow-[0_10px_25px_-3px_rgba(198,40,61,0.35)] hover:-translate-y-0.5 active:translate-y-0 transition-all">
                    <span class="material-symbols-outlined text-[18px]">favorite</span>
                    <span>ĐĂNG KÝ HIẾN MÁU</span>
                </a>
            </div>
        </div>
    </header>

    <!-- Main Content Area -->
    <main class="w-full pt-20 bg-surface flex-grow">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="w-full bg-surface-container-low mt-auto">
        <div class="max-w-[1240px] mx-auto px-6 pt-16 pb-12">
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
                <!-- Col 1: About -->
                <div class="flex flex-col">
                    <div class="flex items-center gap-2 mb-4">
                        <span class="material-symbols-outlined text-primary text-[24px]" style="font-variation-settings: 'FILL' 1;">water_drop</span>
                        <span class="font-headline-sm text-headline-sm text-primary">Vitalis Community</span>
                    </div>
                    <p class="font-body-sm text-body-sm text-on-surface-variant mb-4">
                        Nền tảng gắn kết nghĩa cử cao đẹp, số hóa quy trình đăng ký hiến máu nhân đạo và hỗ trợ điều phối nguồn máu cứu người kịp thời.
                    </p>
                    <div class="font-label-sm text-label-sm text-secondary bg-surface-container px-3 py-2 rounded-lg inline-block">
                        Đồ án chuyên ngành ASP.NET Core MVC - UNETI
                    </div>
                </div>

                <!-- Col 2: Navigation -->
                <div class="flex flex-col">
                    <h4 class="font-headline-sm text-title-md text-on-surface mb-4">Hiến Máu Nhân Đạo</h4>
                    <ul class="space-y-2.5 font-body-sm text-body-sm text-on-surface-variant">
                        <li><a asp-controller="DotHienMau" asp-action="Index" class="hover:text-primary transition-colors">Các đợt hiến máu</a></li>
                        <li><a asp-controller="DangKy" asp-action="Create" class="hover:text-primary transition-colors">Đăng ký hiến máu</a></li>
                        <li><a asp-controller="DangKy" asp-action="TheoDoi" class="hover:text-primary transition-colors">Tra cứu phiếu đăng ký</a></li>
                        <li><a asp-controller="NguoiHienMau" asp-action="HoSoCaNhan" class="hover:text-primary transition-colors">Chứng nhận điện tử</a></li>
                    </ul>
                </div>

                <!-- Col 3: Guidelines -->
                <div class="flex flex-col">
                    <h4 class="font-headline-sm text-title-md text-on-surface mb-4">Hỗ Trợ &amp; Quy Định</h4>
                    <ul class="space-y-2.5 font-body-sm text-body-sm text-on-surface-variant">
                        <li><a href="tel:19006868" class="hover:text-primary transition-colors flex items-center gap-1.5"><span class="material-symbols-outlined text-error text-[16px]">e911_emergency</span>Liên hệ khẩn cấp</a></li>
                        <li><a href="#eligibility" class="hover:text-primary transition-colors">Chính sách bảo mật thông tin</a></li>
                        <li><a href="#eligibility" class="hover:text-primary transition-colors">Điều khoản sử dụng</a></li>
                        <li><a href="#news" class="hover:text-primary transition-colors">Chăm sóc sau hiến máu</a></li>
                    </ul>
                </div>

                <!-- Col 4: Contact -->
                <div class="flex flex-col">
                    <h4 class="font-headline-sm text-title-md text-on-surface mb-4">Liên Hệ Trực Tiếp</h4>
                    <div class="space-y-3 font-body-sm text-body-sm text-on-surface-variant">
                        <div class="flex items-start gap-2">
                            <span class="material-symbols-outlined text-primary text-[18px] mt-0.5">call</span>
                            <div>
                                <span class="block font-semibold text-on-surface">Hotline Hỗ Trợ:</span>
                                <span class="text-primary font-bold">1900 6868</span> (24/7)
                            </div>
                        </div>
                        <div class="flex items-start gap-2">
                            <span class="material-symbols-outlined text-primary text-[18px] mt-0.5">mail</span>
                            <div>
                                <span class="block font-semibold text-on-surface">Email:</span>
                                <span>hienmau@vitalis.community</span>
                            </div>
                        </div>
                        <div class="flex items-start gap-2">
                            <span class="material-symbols-outlined text-primary text-[18px] mt-0.5">location_on</span>
                            <div>
                                <span class="block font-semibold text-on-surface">Địa chỉ phối hợp:</span>
                                <span>Viện Huyết học - Truyền máu Trung ương & UNETI</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="bg-surface-container py-4">
            <div class="max-w-[1240px] mx-auto px-6 flex flex-col sm:flex-row items-center justify-between gap-3 text-center sm:text-left">
                <p class="font-body-sm text-body-sm text-on-surface-variant">
                    Bản quyền © 2026 Vitalis Blood Community - Quản Lý Hiến Máu UNETI.
                </p>
                <div class="flex items-center gap-2">
                    <span class="inline-block w-2 h-2 rounded-full bg-primary"></span>
                    <span class="font-label-sm text-label-sm text-on-surface-variant">Mỗi giọt máu cho đi, một cuộc đời ở lại</span>
                </div>
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
