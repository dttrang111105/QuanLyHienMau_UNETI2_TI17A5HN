@model LichKhamSangLoc
<div class="flex items-center flex-wrap gap-1 pt-1 module5-actions">
@if(Model.TrangThai==TrangThaiLich.DaLenLich)
{
    <a href="/Admin/LichKhamSangLoc?editId=@Model.MaLichKhamSangLoc&ngay=@Model.ThoiGianBatDau.ToString("yyyy-MM-dd")" class="px-2 py-1 rounded-lg bg-surface-container text-on-surface font-label-sm text-[11px] font-semibold" title="Sửa lịch">Sửa lịch</a>
    <form action="/LichKhamSangLoc/Complete" method="post">@Html.AntiForgeryToken()<input name="id" type="hidden" value="@Model.MaLichKhamSangLoc"/><input name="returnUrl" type="hidden" value="@(ViewData["CalendarReturnUrl"]??"/Admin/LichKhamSangLoc?view=table")"/><button class="px-2 py-1 rounded-lg bg-emerald-600 text-white font-label-sm text-[11px] font-semibold" type="submit">Hoàn thành</button></form>
    <form action="/LichKhamSangLoc/Cancel" method="post" onsubmit="return confirm('Hủy lịch khám này?')">@Html.AntiForgeryToken()<input name="id" type="hidden" value="@Model.MaLichKhamSangLoc"/><input name="returnUrl" type="hidden" value="@(ViewData["CalendarReturnUrl"]??"/Admin/LichKhamSangLoc?view=table")"/><button class="px-2 py-1 rounded-lg bg-error-container text-error font-label-sm text-[11px] font-semibold" type="submit">Hủy lịch</button></form>
}
else if(Model.TrangThai==TrangThaiLich.HoanThanh&&Model.Phieu.TrangThai==TrangThaiPhieu.DaKham)
{
    <a href="/Admin/KetQuaXetNghiem?id=@Model.MaPhieu" class="px-2 py-1 rounded-lg bg-primary text-on-primary font-label-sm text-[11px] font-semibold">Nhập kết quả</a>
}
</div>
