@* Họ và tên: ĐIỀN HỌ TÊN CỦA BẠN | Mã sinh viên: ĐIỀN MSSV CỦA BẠN | Nội dung: Module 5. *@
@model LichKhamSangLoc
<div class="actions">@if(Model.TrangThai==TrangThaiLich.DaLenLich){<a class="button small quiet" asp-controller="LichKhamSangLoc" asp-action="Edit" asp-route-id="@Model.MaLichKhamSangLoc">Sửa lịch</a><form asp-controller="LichKhamSangLoc" asp-action="Complete" method="post"><input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString"/><input type="hidden" name="id" value="@Model.MaLichKhamSangLoc"/><button class="small good">Hoàn thành</button></form><form asp-controller="LichKhamSangLoc" asp-action="Cancel" method="post" onsubmit="return confirm('Hủy lịch khám này?')"><input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString"/><input type="hidden" name="id" value="@Model.MaLichKhamSangLoc"/><button class="small danger">Hủy lịch</button></form>}else if(Model.TrangThai==TrangThaiLich.HoanThanh&&Model.Phieu.TrangThai==TrangThaiPhieu.DaKham){<a class="button small" asp-controller="KetQuaHienMau" asp-action="Create" asp-route-id="@Model.MaPhieu">Nhập kết quả</a>}</div>
