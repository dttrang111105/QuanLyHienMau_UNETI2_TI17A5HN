@model List<PhieuDangKyHienMau>
@{ Layout="_Layout";ViewData["Title"]="Theo Dõi Trạng Thái Phiếu Đăng Ký Hiến Máu";var p=Model.FirstOrDefault();var lich=p?.LichKhams.Where(x=>x.TrangThai!=TrangThaiLich.DaHuy).OrderByDescending(x=>x.ThoiGianBatDau).FirstOrDefault(); }
<partial name="_Module5Feedback"/>
<div class="flex flex-col w-full">
    <div class="max-w-[1240px] w-full mx-auto px-6 py-6 flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div class="flex items-center gap-2 font-body-sm text-body-sm text-secondary"><a href="/" class="hover:text-primary transition-colors flex items-center gap-1"><span class="material-symbols-outlined text-[16px]">home</span>Trang chủ</a><span>/</span><a href="/TheoDoiCuaToi" class="hover:text-primary">Tra cứu &amp; Theo dõi phiếu</a><span>/</span><span class="text-on-surface font-semibold">Phiếu của tôi</span></div>
        <div class="flex items-center gap-2"><select aria-label="Chọn phiếu của tôi" class="h-10 px-3 rounded-xl bg-surface-container-low" onchange="if(this.value)location.href='/TheoDoiCuaToi/ChiTiet/'+this.value"><option value="">Chọn phiếu đã nộp</option>@foreach(var ticket in Model){<option value="@ticket.MaPhieu" selected="@(ticket.MaPhieu==p?.MaPhieu)">Phiếu #@ticket.MaPhieu · @ticket.Dot.TenDot</option>}</select><button type="button" class="px-3 py-2 rounded-xl bg-surface-container-low font-label-sm text-label-sm" onclick="window.print()">In trang</button><form action="/Module5Access/Logout" method="post">@Html.AntiForgeryToken()<button class="px-3 py-2 rounded-xl bg-primary text-on-primary font-label-sm text-label-sm">Đăng xuất</button></form></div>
    </div>
    <div class="max-w-[1240px] w-full mx-auto px-6 pb-20 space-y-8">
    @if(p==null){<div class="w-full bg-surface-container-lowest rounded-2xl p-8 shadow-sm text-center">Bạn chưa có phiếu đăng ký hiến máu.</div>}
    else{
        <div class="w-full bg-surface-container-lowest rounded-2xl p-6 lg:p-8 shadow-sm relative overflow-hidden"><div class="absolute -right-24 -top-24 w-80 h-80 rounded-full bg-primary/5 blur-3xl pointer-events-none"></div><div class="absolute -left-20 -bottom-20 w-60 h-60 rounded-full bg-primary-fixed/20 blur-2xl pointer-events-none"></div><div class="relative z-10 flex flex-col lg:flex-row lg:items-center justify-between gap-6 pb-6 border-b border-surface-container-high"><div class="space-y-3"><div class="flex flex-wrap items-center gap-3"><span class="font-headline-md text-headline-md text-on-surface tracking-tight font-bold">Mã hồ sơ: <span class="text-primary">#PHIEU-@p.MaPhieu.ToString("00000")</span></span><span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-50 text-emerald-700 font-label-sm text-label-sm font-semibold"><span class="material-symbols-outlined text-[16px]">verified</span>@p.TrangThai</span></div><div class="flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-6 text-on-surface-variant font-body-md text-body-md"><div class="flex items-center gap-2"><span class="material-symbols-outlined text-primary text-[20px]">campaign</span><span class="font-semibold text-on-surface">Chiến dịch:</span>@p.Dot.TenDot</div><div class="flex items-center gap-2"><span class="material-symbols-outlined text-primary text-[20px]">badge</span><span class="font-semibold text-on-surface">Người hiến:</span>@p.NguoiHien.HoTen</div></div></div><div class="flex gap-3"><button onclick="window.print()" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-surface-container-low hover:bg-surface-container font-label-md text-label-md shadow-sm"><span class="material-symbols-outlined text-[18px] text-primary">picture_as_pdf</span>In phiếu PDF</button><a href="#myClinicalRecords" class="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-xl bg-secondary-fixed/40 text-primary font-label-md text-label-md"><span class="material-symbols-outlined text-[18px]">edit_calendar</span>Lịch khám &amp; Kết quả</a></div></div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 pt-6">@foreach(var metric in new[]{("schedule","Khung giờ hẹn",lich==null?"Chưa lập lịch":lich.ThoiGianBatDau.ToString("HH:mm")+" – "+lich.ThoiGianKetThuc.ToString("HH:mm"),lich?.ThoiGianBatDau.ToString("dd/MM/yyyy")??"Chờ nhân viên y tế"),("pin_drop","Địa điểm tiếp nhận",lich?.DiaDiemHoacLienKet??"Chưa có địa điểm",lich?.HinhThucTiepNhan??""),("water_drop","Nhóm máu & Cân nặng",p.NguoiHien.NhomMau+" · "+p.NguoiHien.CanNang+" kg",p.NguoiHien.GioiTinh),("stethoscope","Bác sĩ phụ trách",lich?.BacSiSangLoc??"Chưa phân công",lich?.TrangThai??"")}){<div class="flex items-start gap-3 p-3.5 rounded-xl bg-surface-container-low/70"><div class="w-10 h-10 rounded-xl bg-primary-fixed flex items-center justify-center text-primary shrink-0"><span class="material-symbols-outlined text-[22px]">@metric.Item1</span></div><div><div class="font-label-sm text-label-sm text-secondary uppercase">@metric.Item2</div><div class="font-title-md text-title-md text-on-surface mt-0.5">@metric.Item3</div><div class="font-body-sm text-body-sm text-on-surface-variant">@metric.Item4</div></div></div>}</div></div>
        <div class="w-full bg-surface-container-lowest rounded-2xl p-6 lg:p-8 shadow-sm space-y-6"><div class="flex justify-between items-center gap-4 pb-4 border-b border-surface-container-high"><div><span class="font-label-sm text-label-sm uppercase tracking-wider text-primary font-bold">Lộ Trình Minh Bạch</span><h2 class="font-headline-md text-headline-md text-on-surface mt-0.5">Quy Trình 5 Chặng &amp; Trạng Thái Theo Thời Gian Thực</h2></div></div><div class="grid grid-cols-1 md:grid-cols-5 gap-6 relative">@{var stages=new[]{("Đăng ký hồ sơ",p.NgayNop.ToString("dd/MM/yyyy HH:mm"),true),("Phê duyệt y tế",p.NgayXuLy?.ToString("dd/MM/yyyy HH:mm")??"Chờ xác nhận",TrangThaiPhieu.DaQuaXacNhan.Contains(p.TrangThai)),("Khám sàng lọc",lich?.TrangThai??"Chưa lập lịch",p.LichKhams.Any(x=>x.TrangThai==TrangThaiLich.HoanThanh)),("Ghi nhận kết quả",p.KetQuaHienMau==null?"Chờ nhân viên y tế":"Đã ghi nhận",p.KetQuaHienMau!=null),("Công bố kết quả",p.KetQuaHienMau?.KetQua??"Chưa có kết quả",p.KetQuaHienMau!=null)};}@for(var i=0;i<stages.Length;i++){var step=stages[i];<div class="relative z-10 flex flex-col items-start md:items-center text-left md:text-center"><div class="w-14 h-14 rounded-2xl @(step.Item3?"bg-emerald-600 text-on-primary":"bg-surface-container text-secondary") flex items-center justify-center shadow-md mb-3"><span class="material-symbols-outlined text-[28px]">@(step.Item3?"task_alt":"pending_actions")</span></div><span class="inline-block px-2.5 py-0.5 rounded-full bg-surface-container-low font-label-sm text-[11px] font-bold mb-1">CHẶNG @(i+1)</span><h3 class="font-title-md text-title-md text-on-surface">@step.Item1</h3><p class="font-body-sm text-body-sm text-secondary mt-1">@step.Item2</p></div>}</div></div>
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6" id="myClinicalRecords"><div class="lg:col-span-7 bg-surface-container-lowest rounded-2xl p-6 shadow-sm"><h3 class="font-headline-sm text-headline-sm text-on-surface mb-4">Lịch Khám Sàng Lọc</h3>@foreach(var l in p.LichKhams.OrderByDescending(x=>x.ThoiGianBatDau)){<div class="p-4 rounded-xl bg-surface-container-low mb-3"><strong>@l.ThoiGianBatDau.ToString("dd/MM/yyyy HH:mm") – @l.ThoiGianKetThuc.ToString("HH:mm")</strong><p class="font-body-sm text-body-sm mt-1">@l.BacSiSangLoc · @l.DiaDiemHoacLienKet</p><span class="inline-block px-2 py-0.5 mt-2 rounded-full bg-primary-fixed text-primary font-label-sm text-label-sm">@l.TrangThai</span>@if(!string.IsNullOrEmpty(l.GhiChu)){<p class="font-body-sm text-body-sm text-secondary mt-2">@l.GhiChu</p>}</div>}@if(p.LichKhams.Count==0){<p class="text-secondary font-body-sm text-body-sm">Chưa có lịch khám sàng lọc.</p>}</div><div class="lg:col-span-5 bg-surface-container-lowest rounded-2xl p-6 shadow-sm"><h3 class="font-headline-sm text-headline-sm text-on-surface mb-4">Kết Quả Hiến Máu</h3>@if(p.KetQuaHienMau is {} k){<div class="p-4 rounded-xl bg-primary-fixed/30"><strong class="text-primary">@k.KetQua</strong><p class="font-body-md text-body-md mt-3">@k.NhanXet</p><p class="font-body-sm text-body-sm text-secondary mt-3">Điểm đánh giá: @(k.DiemDanhGia?.ToString()??"Không sử dụng")</p><p class="font-body-sm text-body-sm text-secondary">Cập nhật: @k.NgayCapNhat?.ToString("dd/MM/yyyy HH:mm")</p></div>}else{<p class="text-secondary font-body-sm text-body-sm">Chưa có kết quả cuối cùng.</p>}</div></div>
        <a href="/TheoDoiCuaToi" class="inline-flex items-center gap-2 text-primary font-semibold"><span class="material-symbols-outlined">arrow_back</span>Tất cả phiếu của tôi</a>
    }
    </div>
</div>
